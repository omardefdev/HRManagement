<?xml version="1.0" encoding="utf-8"?>
<!--
  BLD-001 / SAN-001 — Sovereign NuGet package mirror policy.

  Production / air-gapped builds MUST use an in-country mirror. Add a package
  source named sovereign-mirror with the national registry URL before national
  production, and disable nuget.org in that overlay config.

  Dev/lab: nuget.org only. See docs/BLD_001_BUILD_PROVENANCE.md and
  docs/SAN_001_SANCTIONS.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />
    <add key="sovereign-mirror"
         value="https://SOVEREIGN_NUGET_MIRROR/v3/index.json"
         protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <!-- Placeholder until national mirror is provisioned — disable to avoid restore failures. -->
    <add key="sovereign-mirror" value="true" />
  </disabledPackageSources>
</configuration>
