# Normalize line endings for cross-platform CI (Linux runners).
* text=auto eol=lf

# Windows scripts may keep CRLF where required.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.nupkg binary
*.jar binary

# PLAN-37: legal packs are fingerprinted (SHA-256 in the start-up line, readiness and smoke); every checkout must have the
# committed bytes, so no CRLF conversion on Windows.
docs/syr/*.json text eol=lf
