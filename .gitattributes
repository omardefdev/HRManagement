# Normalize line endings for cross-platform CI (Linux runners).
* text=auto eol=lf

# Windows scripts may keep CRLF where required.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.nupkg binary
*.jar binary
