# Copy to .env and fill in EVERY blank value before running compose.
# Do not commit .env with real secrets. Production fails closed if required vars are missing.

# PostgreSQL (required)
POSTGRES_USER=
POSTGRES_PASSWORD=
# IAM-004: shared fallback password for per-service *_app roles (prefer unique per service)
POSTGRES_APP_PASSWORD=
# PLAN-38 (D-38-3): one password per *_app, *_migrator and hrm_backup role. Required by docker-compose.production.yml
# (no shared fallback there); hrm-bootstrap sets them in PostgreSQL on every deploy (rotate = change + redeploy).
# Development falls back to POSTGRES_APP_PASSWORD. Generate the missing ones: scripts/vps/init-secrets.ps1 -EnvFile .env
POSTGRES_GATEWAY_AUDIT_APP_PASSWORD=
POSTGRES_GATEWAY_AUDIT_MIGRATOR_PASSWORD=
POSTGRES_HR_CORE_APP_PASSWORD=
POSTGRES_HR_CORE_MIGRATOR_PASSWORD=
POSTGRES_HR_CONTRACTS_APP_PASSWORD=
POSTGRES_HR_CONTRACTS_MIGRATOR_PASSWORD=
POSTGRES_PAYROLL_APP_PASSWORD=
POSTGRES_PAYROLL_MIGRATOR_PASSWORD=
POSTGRES_HR_HEALTH_APP_PASSWORD=
POSTGRES_HR_HEALTH_MIGRATOR_PASSWORD=
POSTGRES_HR_MOVEMENTS_APP_PASSWORD=
POSTGRES_HR_MOVEMENTS_MIGRATOR_PASSWORD=
POSTGRES_HR_TRAINING_APP_PASSWORD=
POSTGRES_HR_TRAINING_MIGRATOR_PASSWORD=
POSTGRES_IDCARD_APP_PASSWORD=
POSTGRES_IDCARD_MIGRATOR_PASSWORD=
POSTGRES_ARCHIVE_APP_PASSWORD=
POSTGRES_ARCHIVE_MIGRATOR_PASSWORD=
POSTGRES_ADMIN_APP_PASSWORD=
POSTGRES_ADMIN_MIGRATOR_PASSWORD=
POSTGRES_IT_INFRA_APP_PASSWORD=
POSTGRES_IT_INFRA_MIGRATOR_PASSWORD=
POSTGRES_ANALYTICS_APP_PASSWORD=
POSTGRES_ANALYTICS_MIGRATOR_PASSWORD=
POSTGRES_COMPLIANCE_APP_PASSWORD=
POSTGRES_COMPLIANCE_MIGRATOR_PASSWORD=
POSTGRES_AUTH_DIRECTORY_APP_PASSWORD=
POSTGRES_AUTH_DIRECTORY_MIGRATOR_PASSWORD=
POSTGRES_FILE_STORAGE_APP_PASSWORD=
POSTGRES_FILE_STORAGE_MIGRATOR_PASSWORD=
POSTGRES_BACKUP_PASSWORD=

# RabbitMQ (required — no guest/guest fallback in application code)
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
# (PLAN-38: the shared mq_* fallback RABBITMQ_SERVICE_PASSWORD is gone; every user has its own password below.)
# PLAN-38: one password per mq_* user (deploy/bootstrap/rabbitmq-users.json), required by docker-compose.production.yml;
# hrm-bootstrap sets them through the management API on every deploy. Development uses the administrator above.
RABBITMQ_HR_CORE_PASS=
RABBITMQ_HR_CONTRACTS_PASS=
RABBITMQ_HR_HEALTH_PASS=
RABBITMQ_HR_MOVEMENTS_PASS=
RABBITMQ_HR_TRAINING_PASS=
RABBITMQ_PAYROLL_PASS=
RABBITMQ_IDCARD_PASS=
RABBITMQ_RECORDS_ARCHIVE_PASS=
RABBITMQ_ADMIN_LOGISTICS_PASS=
RABBITMQ_IT_INFRA_PASS=
RABBITMQ_DEV_ANALYTICS_PASS=
RABBITMQ_COMPLIANCE_PASS=
RABBITMQ_AUTH_DIRECTORY_PASS=
RABBITMQ_FILE_STORAGE_PASS=
# PLAN-38 postures of the single host: HRM_MQ_POSTURE=least-privilege|admin (D-38-2), HRM_DB_POSTURE=demo|least-privilege (D-38-1)
HRM_MQ_POSTURE=least-privilege
HRM_DB_POSTURE=demo
# PLAN-38 (section 5): optional pool sizes (defaults 10 and 20). deploy refuses a total of 90 % of max_connections or more.
# HRM_PG_POOL_MAX=10
# HRM_PG_POOL_MAX_HR_CORE=20

# Keycloak admin (initial setup)
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak database (required by docker-compose)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgresql:5432/keycloak_db
KC_DB_USERNAME=
KC_DB_PASSWORD=

# Keycloak OIDC clients (required)
KEYCLOAK_HR_GATEWAY_CLIENT_SECRET=
KEYCLOAK_DIRECTORY_SYNC_SECRET=
KEYCLOAK_HR_WEB_CLIENT_SECRET=

# IAM-004: service confidential client secrets (one per workload — rotate independently)
SVC_HR_CORE_CLIENT_SECRET=
SVC_PAYROLL_CLIENT_SECRET=
SVC_IT_INFRA_CLIENT_SECRET=
SVC_HR_CONTRACTS_CLIENT_SECRET=
SVC_HR_TRAINING_CLIENT_SECRET=
SVC_IDCARD_CLIENT_SECRET=
SVC_RECORDS_ARCHIVE_CLIENT_SECRET=
SVC_FILE_STORAGE_CLIENT_SECRET=
SVC_AUTH_DIRECTORY_CLIENT_SECRET=
# PLAN-37 clients that PLAN-38 found missing here (every client of deploy/wiring/service-wiring.json, secretEnv).
SVC_HR_HEALTH_CLIENT_SECRET=
SVC_HR_MOVEMENTS_CLIENT_SECRET=
SVC_DEV_ANALYTICS_CLIENT_SECRET=
SVC_COMPLIANCE_CLIENT_SECRET=

# HCM-030 (PLAN-30 H): HMAC key of the /careers/my one-time codes (at least 32 random characters; production requires it)
HR_CORE_OTP_HMAC_KEY=
SVC_ADMIN_LOGISTICS_CLIENT_SECRET=

# PLAN-36/38: shared gateway caller-proof secret (gateway and the 14 modules, at least 32 characters; required in production).
GATEWAY_CALLER_PROOF_SECRET=
# PLAN-36/38 single host (docker-compose.vps.yml): public names, the demo users' password (at least 16 characters), the
# image registry and the release tag (deploy/vps/.env.vps.example is the full single-host list).
APP_DOMAIN=
SSO_DOMAIN=
DEMO_USERS_PASSWORD=
HRM_IMAGE_REPO=
IMAGE_TAG=

# Production hostnames (override for TLS/reverse proxy)
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/hrmanagement
KEYCLOAK_REQUIRE_HTTPS_METADATA=false
KEYCLOAK_HTTP_PORT=8080
GATEWAY_HTTP_PORT=5000

# DEP-001: production image pull (required when using docker-compose.images.yml)
# IMAGE_TAG (above) = 12-char Git SHA from CI (never use "latest" for releases)
# GITHUB_REPOSITORY_OWNER = GHCR namespace / GitHub org or user that owns the packages
# GITHUB_REPOSITORY_OWNER=

# Grafana administrator of the full observability stack (docker-compose.observability.production.yml requires both).
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Observability (optional local ports)
SEQ_HTTP_PORT=5341
PROMETHEUS_HTTP_PORT=9090
ALERTMANAGER_HTTP_PORT=9093

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# MinIO object storage (required in production — no default secret)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# IAM-004: File.Storage app credentials (not root) — inject only on file-storage service
MINIO_FILESTORAGE_ACCESS_KEY=
MINIO_FILESTORAGE_SECRET_KEY=
MINIO_HTTP_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local development (dotnet run outside Docker):
# Set ConnectionStrings__* / RabbitMQ__* / FileStorage__* / ServiceIdentity__* via environment
# or: dotnet user-secrets set "ConnectionStrings:HRCoreDb" "Host=...;Password=..."
# appsettings*.json must not contain real passwords.

# BLD-002 Docker build (optional — defaults work in most shells)
# DOCKER_BUILDKIT=1
# COMPOSE_PARALLEL_LIMIT=2

# PLAN-00 acceptance seed (docker-compose.local.yml maps this to hr-core-web)
# SEED_ACCEPTANCE=true
