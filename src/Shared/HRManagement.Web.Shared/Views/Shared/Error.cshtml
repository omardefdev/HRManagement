@{
    ViewData["Title"] = "خطأ";
    Layout = "_HrSharedLayout";
    var requestId = ViewData["RequestId"] as string;
    if (string.IsNullOrWhiteSpace(requestId) && ViewData.Model is not null)
    {
        var showProp = ViewData.Model.GetType().GetProperty("RequestId");
        requestId = showProp?.GetValue(ViewData.Model)?.ToString();
    }
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-md-8">
        <div class="card card-outline card-danger">
            <div class="card-header text-center">
                <h3 class="card-title w-100">
                    <i class="fas fa-exclamation-triangle text-danger"></i>
                    حدث خطأ
                </h3>
            </div>
            <div class="card-body text-center">
                <p class="lead">عذراً، حدث خطأ أثناء معالجة طلبك.</p>
                <p class="text-muted">يرجى المحاولة مرة أخرى لاحقاً أو التواصل مع الدعم الفني.</p>

                @if (!string.IsNullOrWhiteSpace(requestId))
                {
                    <div class="alert alert-light mt-3 text-start" dir="ltr">
                        <small><strong>Request ID:</strong> @requestId</small>
                    </div>
                }

                <a href="/" class="btn btn-primary mt-3">
                    <i class="fas fa-home"></i>
                    العودة للرئيسية
                </a>
            </div>
        </div>
    </div>
</div>
