@using Microsoft.AspNetCore.Routing
@using HRManagement.SharedKernel.ViewModels
@model HrPaginationModel?

@{
    int pageIndex;
    int totalPages;
    int totalCount;
    bool hasPrev;
    bool hasNext;
    string action;
    string controller;

    if (Model != null)
    {
        pageIndex = Model.PageIndex;
        totalPages = Model.TotalPages;
        totalCount = Model.TotalCount;
        hasPrev = Model.HasPreviousPage;
        hasNext = Model.HasNextPage;
    }
    else
    {
        pageIndex = (int)(ViewData["CurrentPage"] ?? 1);
        totalPages = (int)(ViewData["TotalPages"] ?? 1);
        totalCount = (int)(ViewData["TotalCount"] ?? 0);
        hasPrev = pageIndex > 1;
        hasNext = pageIndex < totalPages;
    }

    action = ViewContext.RouteData.Values["action"]?.ToString()
        ?? (string?)ViewData["PaginationAction"]
        ?? "Index";
    controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";

    var routeValues = new RouteValueDictionary(ViewContext.RouteData.Values);
    foreach (var key in ViewContext.HttpContext.Request.Query.Keys)
    {
        if (string.Equals(key, "page", StringComparison.OrdinalIgnoreCase)) continue;
        var v = ViewContext.HttpContext.Request.Query[key].FirstOrDefault();
        if (string.IsNullOrEmpty(v)) continue;
        routeValues[key] = v;
    }
}

@if (totalPages > 1)
{
    <div class="hr-pagination d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="hr-pagination-summary">
            عرض صفحة <strong>@pageIndex</strong> من <strong>@totalPages</strong>@if (totalCount > 0) { <text> — إجمالي <strong>@totalCount</strong> سجل</text> }
        </div>
        <nav class="hr-pagination-nav" aria-label="التنقل بين الصفحات">
            <ul class="hr-pagination-list">
                <li>
                    @if (hasPrev)
                    {
                        routeValues["page"] = pageIndex - 1;
                        <a class="hr-pagination-btn hr-pagination-prev" href="@Url.Action(action, controller, routeValues)" aria-label="السابق">
                            <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            <span>السابق</span>
                        </a>
                    }
                    else
                    {
                        <span class="hr-pagination-btn hr-pagination-prev disabled" aria-disabled="true">
                            <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            <span>السابق</span>
                        </span>
                    }
                </li>
                @for (int i = Math.Max(1, pageIndex - 2); i <= Math.Min(totalPages, pageIndex + 2); i++)
                {
                    routeValues["page"] = i;
                    if (i == pageIndex)
                    {
                        <li>
                            <span class="hr-pagination-btn hr-pagination-num active" aria-current="page">@i</span>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="hr-pagination-btn hr-pagination-num" href="@Url.Action(action, controller, routeValues)">@i</a>
                        </li>
                    }
                }
                <li>
                    @if (hasNext)
                    {
                        routeValues["page"] = pageIndex + 1;
                        <a class="hr-pagination-btn hr-pagination-next" href="@Url.Action(action, controller, routeValues)" aria-label="التالي">
                            <span>التالي</span>
                            <i class="fas fa-chevron-left" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <span class="hr-pagination-btn hr-pagination-next disabled" aria-disabled="true">
                            <span>التالي</span>
                            <i class="fas fa-chevron-left" aria-hidden="true"></i>
                        </span>
                    }
                </li>
            </ul>
        </nav>
    </div>
}
