@model Guid?
@{
    var fileId = Model;
    var cssClass = ViewData["ImageClass"] as string ?? "img-thumbnail";
    var maxHeightClass = ViewData["MaxHeightClass"] as string ?? "hr-img-maxh-120";
}

@if (fileId.HasValue)
{
    <img src="@FileUrls.DownloadUrl(fileId.Value)" alt="" class="@cssClass @maxHeightClass" />
}
