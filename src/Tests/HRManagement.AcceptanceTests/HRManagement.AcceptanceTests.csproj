<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>HRManagement.AcceptanceTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRManagement.E2E\HRManagement.E2E.csproj" />
    <ProjectReference Include="..\..\Shared\HRManagement.ServiceDefaults\HRManagement.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Shared\HRManagement.MessageContracts\HRManagement.MessageContracts.csproj" />
    <ProjectReference Include="..\..\Services\Compliance\Compliance.Domain\Compliance.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\testdata\acceptance\**\*"
          Link="testdata\acceptance\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\testdata\e2e\manifest.json"
          Link="testdata\e2e\manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\testdata\e2e\personas.json"
          Link="testdata\e2e\personas.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docker\keycloak\realm-acceptance.json"
          Link="docker\keycloak\realm-acceptance.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
