<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\testdata\e2e\**\*"
          Link="testdata\e2e\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\testdata\e2e\axe.min.js"
          Link="testdata\e2e\axe.min.js"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\docker\keycloak\realm-qa004-e2e.json"
          Link="docker\keycloak\realm-qa004-e2e.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
