@model HR.Contracts.Web.ViewModels.SeparationPanelModel
@using HR.Contracts.Domain.Enums
@{ ViewData["Title"] = "معالج الفصل - الخطوة 2"; ViewData["HideExecute"] = false; var r = Model.Record; }
@if (TempData["Success"] != null) { <div class="alert alert-success" role="status">@TempData["Success"]</div> }
@if (TempData["Warning"] != null) { <div class="alert alert-warning" role="alert">@TempData["Warning"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-magic" aria-hidden="true"></i> معالج الفصل - الخطوة 2: المراجعة والاعتماد</h3>
    </div>
    <div class="card-body">
        <div class="bs-stepper-header mb-4" role="tablist">
            <div class="step"><span class="bs-stepper-circle">1</span><span class="bs-stepper-label">البيانات</span></div>
            <div class="line"></div>
            <div class="step active"><span class="bs-stepper-circle">2</span><span class="bs-stepper-label">المراجعة والاعتماد</span></div>
            <div class="line"></div>
            <div class="step"><span class="bs-stepper-circle">3</span><span class="bs-stepper-label">القرار والتنفيذ</span></div>
            <div class="line"></div>
            <div class="step"><span class="bs-stepper-circle">4</span><span class="bs-stepper-label">المتابعة</span></div>
        </div>
        <div class="alert alert-light border mb-3"><strong>الموظف:</strong> @await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(r.EmployeeId, Model.EmployeeName)) — @Html.HrEnumDisplay(r.SeparationType) — نافذ @Html.HrDate(r.EffectiveDate)</div>
        <p>أكمل تبليغ الموظف بدليل، ثم قدّم السجل للاعتماد. يعتمده موظف الموارد البشرية ثم صاحب الصلاحية من صندوق العمل في السجل المركزي؛ لا يعتمد المنشئ أبداً.</p>
        <form asp-action="Step2Confirm" asp-route-id="@r.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">المتابعة إلى القرار والتنفيذ</button>
        </form>
        <a asp-controller="SeparationRecords" asp-action="Index" class="btn btn-secondary">القائمة</a>
    </div>
</div>
<partial name="~/Views/SeparationRecords/_SeparationPanel.cshtml" model="Model" />
