@model HR.Contracts.Web.ViewModels.SeparationPanelModel
@using HR.Contracts.Domain.Enums
@{ ViewData["Title"] = "معالج الفصل - الخطوة 3"; ViewData["HideExecute"] = true; var r = Model.Record; }
@if (TempData["Success"] != null) { <div class="alert alert-success" role="status">@TempData["Success"]</div> }
@if (TempData["Warning"] != null) { <div class="alert alert-warning" role="alert">@TempData["Warning"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-magic" aria-hidden="true"></i> معالج الفصل - الخطوة 3: القرار والتنفيذ</h3>
    </div>
    <div class="card-body">
        <div class="bs-stepper-header mb-4" role="tablist">
            <div class="step"><span class="bs-stepper-circle">1</span><span class="bs-stepper-label">البيانات</span></div>
            <div class="line"></div>
            <div class="step"><span class="bs-stepper-circle">2</span><span class="bs-stepper-label">المراجعة والاعتماد</span></div>
            <div class="line"></div>
            <div class="step active"><span class="bs-stepper-circle">3</span><span class="bs-stepper-label">القرار والتنفيذ</span></div>
            <div class="line"></div>
            <div class="step"><span class="bs-stepper-circle">4</span><span class="bs-stepper-label">المتابعة</span></div>
        </div>
        <div class="alert alert-light border mb-3"><strong>الموظف:</strong> @await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(r.EmployeeId, Model.EmployeeName)) — @Html.HrEnumDisplay(r.SeparationType) — نافذ @Html.HrDate(r.EffectiveDate)</div>
        <div class="alert alert-warning" role="note">
            <strong>تنبيه:</strong> التنفيذ يُنهي العقد بتاريخ النفاذ، ويبدأ رحلة الأطراف (الرواتب، البطاقة، الحساب، العهدة، الأنظمة التقنية، السجل المركزي، الأرشيف). لا يُنفَّذ قبل قرار إداري مرقّم وتبليغ الموظف وبلوغ تاريخ النفاذ بتوقيت دمشق، ولا يُلغى بعده إلا بمسار التعويض.
        </div>
        @if (Model.CanExecute)
        {
            <form asp-action="Step3Execute" asp-route-id="@r.Id" method="post" class="d-inline" data-sep-action="wizard-execute"
                  data-hr-confirm="التنفيذ يُنهي العقد ويبدأ رحلة الأطراف، ولا يُلغى بعده إلا بمسار التعويض. هل أنت متأكد؟">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">تنفيذ الفصل</button>
            </form>
        }
        <a asp-action="Step2" asp-route-id="@r.Id" class="btn btn-secondary">العودة للمراجعة</a>
    </div>
</div>
<partial name="~/Views/SeparationRecords/_SeparationPanel.cshtml" model="Model" />
