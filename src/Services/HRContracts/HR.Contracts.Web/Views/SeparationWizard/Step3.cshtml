@model HR.Contracts.Domain.Entities.SeparationRecord
@{ ViewData["Title"] = "معالج الفصل - الخطوة 3"; }
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-magic"></i> معالج الفصل - الخطوة 3: التنفيذ</h3>
    </div>
    <div class="card-body">
        <div class="bs-stepper-header mb-4" role="tablist">
            <div class="step"><span class="bs-stepper-circle">1</span><span class="bs-stepper-label">البيانات</span></div>
            <div class="line"></div>
            <div class="step"><span class="bs-stepper-circle">2</span><span class="bs-stepper-label">المراجعة</span></div>
            <div class="line"></div>
            <div class="step active"><span class="bs-stepper-circle">3</span><span class="bs-stepper-label">التنفيذ</span></div>
            <div class="line"></div>
            <div class="step"><span class="bs-stepper-circle">4</span><span class="bs-stepper-label">المتابعة</span></div>
        </div>

        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>تحذير:</strong> سيؤدي الضغط على "تنفيذ الفصل" إلى:
            <ul class="mt-2">
                <li>تحديث حالة العقد إلى "منتهي"</li>
                <li>نشر حدث إكمال الفصل لجميع الأنظمة المرتبطة</li>
                <li>لا يمكن التراجع عن هذا الإجراء</li>
            </ul>
        </div>

        <div class="mb-3">
            <strong>الموظف:</strong> @await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(Model.EmployeeId, ViewBag.EmployeeName as string))<br />
            <strong>نوع الإنهاء:</strong> @Html.HrEnumDisplay(Model.SeparationType)<br />
            <strong>تاريخ النفاذ:</strong> @Model.EffectiveDate.ToString("yyyy/MM/dd")
        </div>

        @if (Model.SeparationEventPublished)
        {
            <div class="alert alert-info"><i class="fas fa-info-circle"></i> تم تنفيذ الفصل مسبقاً.</div>
            <a asp-action="Step4" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fas fa-arrow-left"></i> الانتقال للمتابعة</a>
        }
        else
        {
            <form asp-action="Step3Execute" asp-route-id="@Model.Id" method="post"
                  data-hr-confirm="هل أنت متأكد من تنفيذ الفصل؟"
                  data-hr-confirm-title="تنفيذ الفصل"
                  data-hr-confirm-variant="danger"
                  data-hr-confirm-label="تنفيذ الفصل">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"><i class="fas fa-bolt"></i> تنفيذ الفصل</button>
                <a asp-action="Step2" asp-route-id="@Model.Id" class="btn btn-secondary">العودة</a>
            </form>
        }
    </div>
</div>
