@model IReadOnlyList<AdministrativeDecision>
@{ ViewData["Title"] = "القرارات الإدارية"; var q = ViewBag.Q as string; var issuedFrom = ViewBag.IssuedFrom as DateOnly?; var issuedTo = ViewBag.IssuedTo as DateOnly?; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-gavel"></i> القرارات الإدارية</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> إضافة</a>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="q" value="@q" class="form-control form-control-sm" placeholder="بحث بالموضوع أو الرقم..." />
            </div>
            <div class="col-auto">
                <input type="date" name="issuedFrom" value="@issuedFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" title="من تاريخ" />
            </div>
            <div class="col-auto">
                <input type="date" name="issuedTo" value="@issuedTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" title="إلى تاريخ" />
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-search"></i> بحث</button></div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الرقم</th><th>الموضوع</th><th>التاريخ</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.DecisionNumber</td>
                        <td>@x.Subject</td>
                        <td>@(x.IssuedDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = x.Id })" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">لا توجد قرارات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
