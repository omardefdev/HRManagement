@model IReadOnlyList<ContractTypeRegimeMap>
@using HR.Contracts.Web.Controllers
@using HRManagement.ServiceDefaults
@{
    ViewData["Title"] = "ربط أنواع العقود بأنظمة الخدمة";
    var canWrite = User.IsInRole(HrManagementRoles.Admin) || User.IsInRole(HrManagementRoles.HrContracts);
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-random"></i> ربط أنواع العقود بأنظمة الخدمة</h3>
        @if (canWrite)
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> إضافة</a>
        }
    </div>
    <div class="card-body">
        <p class="text-muted mb-0">
            يُختار نوع العقد عند التعيين بالأكثر تحديداً: (النظام، النوع) ثم (النظام، أي نوع) ثم (أي نظام، النوع) ثم (أي نظام، أي نوع).
            إن لم يوجد ربط يُفتح تدخل في معالج التعيين (أو يُستخدم DEFAULT إذا كان الرجوع الافتراضي مفعّلاً).
        </p>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr><th>نظام الخدمة</th><th>نوع التوظيف</th><th>نوع العقد</th><th>الحالة</th><th>إجراءات</th></tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@ContractTypeRegimeMapsController.RegimeLabel(m.LegalRegimeId)</td>
                        <td>@ContractTypeRegimeMapsController.EmploymentTypeLabel(m.EmploymentType)</td>
                        <td>@(m.ContractType is null ? "—" : $"{m.ContractType.Code} — {m.ContractType.NameAr}")</td>
                        <td><span class="badge @(m.IsActive ? "bg-success" : "bg-secondary")">@(m.IsActive ? "فعال" : "موقوف")</span></td>
                        <td>
                            @if (canWrite)
                            {
                                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                                @if (m.IsActive)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@m.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-xs" data-hr-confirm="إيقاف هذا الربط؟" aria-label="إيقاف"><i aria-hidden="true" class="fas fa-ban"></i></button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">لا توجد روابط — كل تعيين سيستخدم DEFAULT أو يفتح تدخلاً.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
