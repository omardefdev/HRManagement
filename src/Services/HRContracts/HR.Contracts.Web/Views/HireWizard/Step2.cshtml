@model HireWizardStep2ViewModel
@using HRManagement.ServiceDefaults
@{
    ViewData["Title"] = "معالج التعيين - الخطوة 2";
    var canExecute = User.IsInRole(HrManagementRoles.Admin) || User.IsInRole(HrManagementRoles.HrContracts);
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">
            قائمة التحقق — @Html.HrEnumDisplay(Model.Txn.State)
            @if (Model.Txn.CommencementOverdueAt is not null)
            {
                <span class="badge bg-danger fs-6 ms-1" title="تأخر المباشرة عن المهلة منذ @Model.Txn.CommencementOverdueAt.Value.ToString("yyyy/MM/dd")">متأخر عن المباشرة</span>
            }
        </h3>
        @if (Model.Contract is not null)
        {
            <span class="text-muted small">
                العقد: @Model.Contract.ContractType?.Code — الدرجة @(Model.Contract.GradeCode ?? "—")
                — الراتب @(Model.Contract.AgreedBaseSalary?.ToString("#,0.##") ?? "—")
                — النظام @(Model.Contract.LegalRegimeId ?? "—") — @(Model.Contract.EmploymentType ?? "—")
            </span>
        }
    </div>
    <div class="card-body">
        @if (Model.NeedsContractType)
        {
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                @(Model.UnresolvedReason ?? "لا يوجد نوع عقد مطابق لنظام الخدمة — يتطلب تدخلاً")
                <div class="small mt-1">
                    أضف ربطاً في <a asp-controller="ContractTypeRegimeMaps" asp-action="Index">ربط أنواع العقود بأنظمة الخدمة</a>،
                    أو أنشئ العقد المعلّق يدوياً بنوع عقد مختار.
                </div>
                @if (canExecute)
                {
                    <form asp-action="CreatePendingContract" method="post" class="row g-2 mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="transactionId" value="@Model.Txn.Id" />
                        <div class="col-auto">
                            <select name="contractTypeId" class="form-select form-select-sm" asp-items="Model.ContractTypes" required>
                                <option value="">— نوع العقد —</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-danger">إنشاء العقد المعلّق</button>
                        </div>
                    </form>
                }
            </div>
        }
        <table class="table table-sm mb-3">
            <thead><tr><th>الخطوة</th><th>المالك</th><th>المهلة</th><th>الحالة</th><th>الدليل</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Checklist)
            {
                <tr>
                    <td>
                        @(Model.Labels.GetValueOrDefault(item.Step, item.Step.ToString()))
                        @if (!item.IsCompleted && !string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <div class="small text-muted">@item.Notes</div>
                        }
                    </td>
                    <td>@(item.OwnerRole ?? "—")</td>
                    <td>@item.SlaHours ساعة</td>
                    <td>
                        <span class="badge @(item.IsCompleted ? "bg-success" : "bg-secondary")">
                            @(item.IsCompleted ? "مكتمل" : "معلق")
                        </span>
                    </td>
                    <td class="small">@(item.EvidenceRef ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.HasDecisionStep)
        {
            <div class="border rounded p-2 mb-3">
                <strong>إصدار قرار التعيين</strong>
                @if (Model.Decision is not null)
                {
                    <div class="small mt-1">
                        <i class="fas fa-check text-success"></i>
                        القرار رقم <code>@Model.Decision.DecisionNumber</code> — @Model.Decision.Subject
                        (@(Model.Decision.IssuedDate?.ToString("yyyy/MM/dd") ?? "—"))
                    </div>
                }
                else if (canExecute)
                {
                    <form asp-action="IssueAppointmentDecision" method="post" class="mt-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="transactionId" value="@Model.Txn.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-primary" data-hr-confirm="إصدار قرار التعيين لهذه المعاملة؟">إصدار قرار التعيين</button>
                    </form>
                }
                else
                {
                    <div class="small text-muted mt-1">لم يصدر قرار التعيين بعد.</div>
                }
            </div>
        }
        @if (Model.MedicalStep is { } medical)
        {
            <div class="border rounded p-2 mb-3">
                <strong>الفحص الطبي قبل التعيين</strong>
                @if (medical.IsCompleted)
                {
                    <div class="small mt-1"><i class="fas fa-check text-success"></i> الدليل: @medical.EvidenceRef — @(medical.CompletedByName ?? "—")</div>
                }
                else if (canExecute)
                {
                    <form asp-action="CompleteMedicalStep" method="post" class="row g-2 mt-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="transactionId" value="@Model.Txn.Id" />
                        <div class="col-auto">
                            <input type="text" name="evidenceRef" class="form-control form-control-sm" maxlength="256" required placeholder="رقم تقرير اللياقة أو الوثيقة" />
                        </div>
                        <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">تسجيل الفحص الطبي</button></div>
                    </form>
                }
            </div>
        }
        <form asp-action="Step2Confirm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="transactionId" value="@Model.Txn.Id" />
            <button type="submit" class="btn btn-primary">التالي — الاعتماد</button>
        </form>
    </div>
</div>
