@model IReadOnlyList<Contract>
@using HR.Contracts.Domain.Enums
@{
    ViewData["Title"] = "العقود";
    var employeeNames = ViewBag.EmployeeNames as IReadOnlyDictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var statusFilter = ViewBag.StatusFilter as ContractStatus?;
    var filterEmployeeId = ViewBag.EmployeeId as Guid?;
    string StatusBadge(ContractStatus status) => status switch
    {
        ContractStatus.Pending => "bg-warning",
        ContractStatus.Active => "bg-success",
        ContractStatus.Expired => "bg-secondary",
        ContractStatus.Terminated => "bg-danger",
        _ => "bg-secondary"
    };
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-file-contract"></i> قائمة العقود</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> عقد جديد</a>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <select name="status" class="form-select form-select-sm">
                    <option value="">جميع الحالات</option>
                    @foreach (var s in Enum.GetValues<ContractStatus>())
                    {
                        <option value="@s" selected="@(statusFilter == s ? "selected" : null)">@Html.HrEnumDisplay(s)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="employeeId" class="form-select form-select-sm" data-hr-picker="employee" data-placeholder="كل الموظفين">
                    <option value="">كل الموظفين</option>
                    @if (filterEmployeeId is Guid empId)
                    {
                        <option value="@empId" selected="selected">@(employeeNames.GetValueOrDefault(empId, empId.ToString()))</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-filter"></i> تصفية</button></div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <div class="table-responsive">
<table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>الموظف</th>
                    <th>نوع العقد</th>
                    <th>البداية</th>
                    <th>النهاية</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(c.EmployeeId, employeeNames.GetValueOrDefault(c.EmployeeId)))</td>
                        <td>@c.ContractType.NameAr</td>
                        <td>@c.StartDate.ToString("yyyy/MM/dd")</td>
                        <td>@(c.EndDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                        <td>
                            <span class="badge @StatusBadge(c.Status)">@Html.HrEnumDisplay(c.Status)</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-info btn-xs" aria-label="تفاصيل"><i aria-hidden="true" class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = c.Id })" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">لا توجد عقود</td></tr>
                }
            </tbody>
        </table>
</div>
    </div>
</div>
