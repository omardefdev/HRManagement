@model IReadOnlyList<LeaveRequest>
@using HRManagement.SharedKernel.Enums
@{ ViewData["Title"] = "طلبات الإجازة"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-calendar-alt"></i> طلبات الإجازة</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> طلب جديد</a>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الموظف</th><th>النوع</th><th>من</th><th>إلى</th><th>الأيام</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.EmployeeId</td>
                        <td>@x.LeaveType</td>
                        <td>@x.StartDate.ToString("yyyy/MM/dd")</td>
                        <td>@x.EndDate.ToString("yyyy/MM/dd")</td>
                        <td>@x.DurationDays</td>
                        <td>@x.Status</td>
                        <td>
                            @if (x.Status == ApprovalStatus.Pending)
                            {
                                <form asp-action="Approve" asp-route-id="@x.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-xs">اعتماد</button></form>
                                <form asp-action="Reject" asp-route-id="@x.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger btn-xs">رفض</button></form>
                            }
                            @if (x.Status == ApprovalStatus.Approved)
                            {
                                <form asp-action="Cancel" asp-route-id="@x.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-warning btn-xs">إلغاء</button></form>
                            }
                            @if (x.Status == ApprovalStatus.Pending)
                            {
                                <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = x.Id })" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">لا توجد طلبات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
