@model LeaveRequestViewModel
@{ ViewData["Title"] = "طلب إجازة جديد"; }
<div class="card">
    <div class="card-header"><h3 class="card-title">طلب إجازة</h3></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select></div>
            <div class="mb-3"><label asp-for="LeaveType" class="form-label"></label><select asp-for="LeaveType" class="form-control" asp-items="Html.GetEnumSelectList<LeaveType>()"></select></div>
            <div class="row">
                <div class="col-md-4 mb-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" type="date" /></div>
                <div class="col-md-4 mb-3"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control" type="date" /></div>
                <div class="col-md-4 mb-3"><label asp-for="DurationDays" class="form-label"></label><input asp-for="DurationDays" class="form-control" type="number" readonly /><div class="form-text">يُحسب تلقائياً من التواريخ (أيام عمل، بدون الجمعة والسبت).</div></div>
            </div>
            <div class="mb-3">
                <label class="form-label">الحالة</label>
                <input class="form-control" value="قيد الانتظار" disabled />
                <div class="form-text">يُعتمد الطلب من صاحب الصلاحية عبر إجراء الموافقة.</div>
            </div>
            <div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
