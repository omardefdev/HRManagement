@model IList<HR.Contracts.Domain.Entities.LeaveBalance>
@using HR.Contracts.Domain.Enums
@{
    ViewData["Title"] = "أرصدة الإجازات";
    var employeeNames = ViewBag.EmployeeNames as IReadOnlyDictionary<Guid, string>
                        ?? new Dictionary<Guid, string>();
    Guid? filterEmployee = ViewBag.EmployeeId as Guid?;
    var leaveTypeFilter = ViewBag.LeaveTypeFilter as LeaveType?;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-balance-scale"></i> أرصدة الإجازات - @ViewBag.Year</h3>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> إضافة رصيد</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <select name="employeeId" class="form-select form-select-sm" data-hr-picker="employee" data-placeholder="كل الموظفين">
                    <option value="">كل الموظفين</option>
                    @if (filterEmployee is Guid empId)
                    {
                        <option value="@empId" selected="selected">@(employeeNames.GetValueOrDefault(empId, empId.ToString()))</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="leaveType" class="form-select form-select-sm">
                    <option value="">جميع الأنواع</option>
                    @foreach (var lt in Enum.GetValues<LeaveType>())
                    {
                        <option value="@lt" selected="@(leaveTypeFilter == lt ? "selected" : null)">@Html.HrEnumDisplay(lt)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <input type="number" name="year" value="@ViewBag.Year" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
            </div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr><th>الموظف</th><th>نوع الإجازة</th><th>السنة</th><th>الاستحقاق</th><th>المستخدم</th><th>المتبقي</th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    var pct = b.TotalEntitlement > 0 ? (int)(100.0 * b.Used / b.TotalEntitlement) : 0;
                    var barColor = pct > 80 ? "bg-danger" : pct > 50 ? "bg-warning" : "bg-success";
                    <tr>
                        <td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(b.EmployeeId, employeeNames.GetValueOrDefault(b.EmployeeId)))</td>
                        <td>@Html.HrEnumDisplay(b.LeaveType)</td>
                        <td>@b.Year</td>
                        <td>@b.TotalEntitlement</td>
                        <td>@b.Used</td>
                        <td>
                            <strong>@b.Remaining</strong>
                            <div class="progress progress-xs mt-1" style="width:80px">
                                <div class="progress-bar @barColor" style="width:@(pct)%"></div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا توجد أرصدة</td></tr> }
            </tbody>
        </table>
    </div>
</div>
