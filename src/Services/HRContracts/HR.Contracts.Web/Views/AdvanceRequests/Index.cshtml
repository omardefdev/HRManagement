@model IReadOnlyList<AdvanceRequest>
@using HRManagement.SharedKernel.Enums
@{
    ViewData["Title"] = "طلبات السلف";
    var employeeNames = ViewBag.EmployeeNames as IReadOnlyDictionary<Guid, string>
                        ?? new Dictionary<Guid, string>();
    var statusFilter = ViewBag.StatusFilter as ApprovalStatus?;
    var filterEmployeeId = ViewBag.EmployeeId as Guid?;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-hand-holding-usd"></i> طلبات السلف</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> طلب جديد</a>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <select name="status" class="form-select form-select-sm">
                    <option value="">جميع الحالات</option>
                    @foreach (var s in Enum.GetValues<ApprovalStatus>())
                    {
                        <option value="@s" selected="@(statusFilter == s ? "selected" : null)">@Html.HrEnumDisplay(s)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="employeeId" class="form-select form-select-sm" data-hr-picker="employee" data-placeholder="كل الموظفين">
                    <option value="">كل الموظفين</option>
                    @if (filterEmployeeId is Guid empId)
                    {
                        <option value="@empId" selected="selected">@(employeeNames.GetValueOrDefault(empId, empId.ToString()))</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-filter"></i> تصفية</button></div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الموظف</th><th>المبلغ</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(x.EmployeeId, employeeNames.GetValueOrDefault(x.EmployeeId)))</td>
                        <td>@x.Amount.ToString("N2")</td>
                        <td>@Html.HrEnumDisplay(x.Status)</td>
                        <td>
                            @if (x.Status == ApprovalStatus.Pending)
                            {
                                <form asp-action="Approve" asp-route-id="@x.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-xs">اعتماد</button></form>
                                <form asp-action="Reject" asp-route-id="@x.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger btn-xs">رفض</button></form>
                            }
                            <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = x.Id })" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">لا توجد طلبات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
