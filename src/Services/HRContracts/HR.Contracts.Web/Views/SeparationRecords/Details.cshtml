@model HR.Contracts.Web.ViewModels.SeparationPanelModel
@using HR.Contracts.Domain.Enums
@{
    ViewData["Title"] = "تفاصيل إنهاء الخدمة";
    var r = Model.Record;
}
@if (TempData["Success"] != null) { <div class="alert alert-success" role="status">@TempData["Success"]</div> }
@if (TempData["Warning"] != null) { <div class="alert alert-warning" role="alert">@TempData["Warning"]</div> }
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title mb-0">إنهاء خدمة — @await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(r.EmployeeId, Model.EmployeeName))</h3>
        <div>
            <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
            @if (Model.CanWrite && r.Status == SeparationStatus.Draft)
            {
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-warning btn-sm">تعديل</a>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-sm mb-0">
            <tr><th>نوع الإنهاء</th><td>@Html.HrEnumDisplay(r.SeparationType)</td></tr>
            <tr><th>السبب</th><td>@(r.Reason ?? "—")</td></tr>
            <tr><th>العقد</th><td>@(r.ContractId.HasValue ? "مرتبط بعقد الموظف" : "بدون عقد")</td></tr>
            <tr><th>المستندات</th><td>@(r.Documents ?? "—")</td></tr>
        </table>
    </div>
</div>
<partial name="_SeparationPanel" model="Model" />
