@model IList<HR.Contracts.Domain.Entities.LeavePolicy>
@{ ViewData["Title"] = "سياسات الإجازات"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-clipboard-list"></i> سياسات الإجازات</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> سياسة جديدة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <div class="table-responsive">
<table class="table table-striped mb-0">
            <thead><tr><th>نوع الإجازة</th><th>الحد الأقصى (أيام/سنة)</th><th>مدفوعة</th><th>شهادة طبية</th><th>إشعار مسبق (أيام)</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.LeaveType</td>
                        <td>@p.MaxDaysPerYear</td>
                        <td>@(p.IsPaid ? "نعم" : "لا")</td>
                        <td>@(p.RequiresMedicalCertificate ? "نعم" : "لا")</td>
                        <td>@p.MinNoticeDays</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger btn-xs" onclick="return confirm('تأكيد الحذف؟')" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button></form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا توجد سياسات</td></tr> }
            </tbody>
        </table>
</div>
    </div>
</div>
