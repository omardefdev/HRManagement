@model IList<HR.Contracts.Domain.Entities.ServiceTransaction>
@using HR.Contracts.Domain.Enums
@{ ViewData["Title"] = "المعاملات"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-exchange-alt"></i> المعاملات</h3>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <select name="state" class="form-select form-select-sm">
                    <option value="">جميع الحالات</option>
                    @foreach (var s in Enum.GetValues<ServiceTransactionState>())
                    {
                        <option value="@s" selected="@(ViewBag.StateFilter != null && (ServiceTransactionState)ViewBag.StateFilter == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="type" class="form-select form-select-sm">
                    <option value="">جميع الأنواع</option>
                    @foreach (var t in Enum.GetValues<ServiceTransactionType>())
                    {
                        <option value="@t" selected="@(ViewBag.TypeFilter != null && (ServiceTransactionType)ViewBag.TypeFilter == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-filter"></i> تصفية</button></div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الرقم المرجعي</th><th>الموظف</th><th>النوع</th><th>الحالة</th><th>تاريخ الإنشاء</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@(t.ReferenceNumber ?? t.Id.ToString()[..8])</td>
                        <td>@t.EmployeeId</td>
                        <td>@t.TransactionType</td>
                        <td><span class="badge bg-info">@t.State</span></td>
                        <td>@t.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-primary btn-xs" aria-label="تفاصيل"><i aria-hidden="true" class="fas fa-eye"></i></a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا توجد معاملات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
