@model IReadOnlyList<ProbationRecord>
@using HR.Contracts.Domain.Enums
@{
    ViewData["Title"] = "فترات الاختبار";
    var employeeNames = ViewBag.EmployeeNames as IReadOnlyDictionary<Guid, string>
                        ?? new Dictionary<Guid, string>();
    var resultFilter = ViewBag.ResultFilter as ProbationResult?;
    var filterEmployeeId = ViewBag.EmployeeId as Guid?;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-hourglass-half"></i> فترات الاختبار</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> إضافة</a>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <select name="result" class="form-select form-select-sm">
                    <option value="">جميع النتائج</option>
                    @foreach (var r in Enum.GetValues<ProbationResult>())
                    {
                        <option value="@r" selected="@(resultFilter == r ? "selected" : null)">@Html.HrEnumDisplay(r)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="employeeId" class="form-select form-select-sm" data-hr-picker="employee" data-placeholder="كل الموظفين">
                    <option value="">كل الموظفين</option>
                    @if (filterEmployeeId is Guid empId)
                    {
                        <option value="@empId" selected="selected">@(employeeNames.GetValueOrDefault(empId, empId.ToString()))</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-filter"></i> تصفية</button></div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الموظف</th><th>العقد</th><th>من</th><th>إلى</th><th>النتيجة</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(x.EmployeeId, employeeNames.GetValueOrDefault(x.EmployeeId)))</td>
                        <td>@x.Contract.ContractType.NameAr</td>
                        <td>@x.StartDate.ToString("yyyy/MM/dd")</td>
                        <td>@x.EndDate.ToString("yyyy/MM/dd")</td>
                        <td>@Html.HrEnumDisplay(x.Result)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = x.Id })" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا توجد سجلات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
