@model IReadOnlyList<ContractType>
@{
    ViewData["Title"] = "أنواع العقود";
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-tags"></i> أنواع العقود</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> إضافة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr><th>الرمز</th><th>الاسم</th><th>الإنكليزي</th><th>إجراءات</th></tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Code</td>
                        <td>@t.NameAr</td>
                        <td>@(t.NameEn ?? "—")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = t.Id })" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">لا توجد أنواع</td></tr> }
            </tbody>
        </table>
    </div>
</div>
