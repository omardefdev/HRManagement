@model Payroll.Domain.Entities.PaymentHold
@using Payroll.Domain.Constants
@{
    ViewData["Title"] = "تفاصيل حجز الصرف";
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">حجز الصرف</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

        <table class="table table-bordered">
            <tr><th>الموظف</th><td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(Model.EmployeeId, ViewBag.EmployeeName as string))</td></tr>
            <tr><th>تشغيل الرواتب</th><td>@if (Model.PayrollRunId is Guid runId) { <a asp-controller="PayrollRuns" asp-action="Details" asp-route-id="@runId">عرض مسير الرواتب</a> } else { <span>—</span> }</td></tr>
            <tr><th>تنبيه الاحتيال</th><td>@if (Model.FraudAlertId is Guid alertId) { <a asp-controller="FraudAlerts" asp-action="Details" asp-route-id="@alertId">عرض تنبيه الاحتيال</a> } else { <span>—</span> }</td></tr>
            <tr><th>النوع</th><td>@Html.HrStoredEnumDisplay("PaymentHoldType", Model.HoldType)</td></tr>
            <tr><th>الحالة</th><td>@Html.HrStoredEnumDisplay("Code", Model.Status)</td></tr>
            <tr><th>السبب</th><td>@Model.Reason</td></tr>
            <tr><th>وقت الحجز</th><td>@Html.HrDateTime(Model.HeldAtUtc)</td></tr>
            <tr><th>أُفرج بواسطة</th><td>@Html.HrUserName(Model.ReleasedBy)</td></tr>
            <tr><th>اعتمد الإفراج</th><td>@Html.HrUserName(Model.ReleaseApprovedBy)</td></tr>
            <tr><th>سبب الإفراج</th><td>@(Model.ReleaseReason ?? "—")</td></tr>
        </table>

        @if (Model.Status == PaymentHoldStatus.Active)
        {
            <p class="text-muted small">الإفراج فعلان من شخصين: تطلبه هنا بسبب، ويقرّره معتمد آخر من جلسته في «طلبات بانتظار قرارك». حجز حاجز نظام الخدمة لا يُفرج عنه ما دام HR.Core يحجب الموظف.</p>
            <form asp-action="Release" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-md-9">
                        <label class="form-label" for="releaseReason">سبب الإفراج</label>
                        <input id="releaseReason" name="releaseReason" class="form-control" required />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-warning">طلب الإفراج (أربع عيون)</button>
                    </div>
                </div>
            </form>
        }
    </div>
</div>
