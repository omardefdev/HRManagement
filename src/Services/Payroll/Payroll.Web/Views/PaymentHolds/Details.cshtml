@model Payroll.Domain.Entities.PaymentHold
@using Payroll.Domain.Constants
@{
    ViewData["Title"] = "تفاصيل حجز الصرف";
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">حجز الصرف</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

        <table class="table table-bordered">
            <tr><th>الموظف</th><td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(Model.EmployeeId, ViewBag.EmployeeName as string))</td></tr>
            <tr><th>تشغيل الرواتب</th><td>@(Model.PayrollRunId?.ToString() ?? "—")</td></tr>
            <tr><th>تنبيه الاحتيال</th><td>@(Model.FraudAlertId?.ToString() ?? "—")</td></tr>
            <tr><th>النوع</th><td>@Model.HoldType</td></tr>
            <tr><th>الحالة</th><td>@Html.HrStoredEnumDisplay("Code", Model.Status)</td></tr>
            <tr><th>السبب</th><td>@Model.Reason</td></tr>
            <tr><th>وقت الحجز</th><td>@Model.HeldAtUtc.ToString("yyyy/MM/dd HH:mm")</td></tr>
            <tr><th>أُفرج بواسطة</th><td>@(Model.ReleasedBy?.ToString() ?? "—")</td></tr>
            <tr><th>اعتمد الإفراج</th><td>@(Model.ReleaseApprovedBy?.ToString() ?? "—")</td></tr>
            <tr><th>سبب الإفراج</th><td>@(Model.ReleaseReason ?? "—")</td></tr>
        </table>

        @if (Model.Status == PaymentHoldStatus.Active)
        {
            <form asp-action="Release" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">المعتمد (يجب أن يختلف عن المُفرج)</label>
                        <input name="ReleaseApprovedBy" class="form-control" required placeholder="Guid" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">سبب الإفراج</label>
                        <input name="releaseReason" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">سجل الأدلة (اختياري)</label>
                        <input name="evidenceRecordId" class="form-control" placeholder="Guid" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-warning">إفراج (أربعة عيون)</button>
                    </div>
                </div>
            </form>
        }
    </div>
</div>
