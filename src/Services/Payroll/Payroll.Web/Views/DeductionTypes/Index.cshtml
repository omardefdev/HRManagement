@model IList<Payroll.Domain.Entities.DeductionType>
@{ ViewData["Title"] = "أنواع الخصومات"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-percentage"></i> أنواع الخصومات</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> جديد</a>
    </div>
    <div class="card-body">@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }</div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الكود</th><th>الاسم</th><th>إلزامي</th><th>نسبة %</th><th>مبلغ ثابت</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Code</td><td>@d.NameAr</td><td>@(d.IsStatutory ? "نعم" : "لا")</td>
                        <td>@(d.Percentage?.ToString("N2") ?? "—")</td><td>@(d.FixedAmount?.ToString("N2") ?? "—")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger btn-xs" onclick="return confirm('حذف؟')" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button></form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا توجد أنواع</td></tr> }
            </tbody>
        </table>
    </div>
</div>
