@model IList<Payroll.Domain.Entities.DeductionType>
@{
    ViewData["Title"] = "أنواع الخصومات";
    var q = ViewBag.Q as string;
    bool? isStatutory = ViewBag.IsStatutory;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-percentage"></i> أنواع الخصومات</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> جديد</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="q" value="@q" class="form-control form-control-sm" placeholder="بحث بالرمز أو الاسم..." />
            </div>
            <div class="col-auto">
                <select name="isStatutory" class="form-select form-select-sm">
                    <option value="">الكل</option>
                    <option value="true" selected="@(isStatutory == true ? "selected" : null)">إلزامي</option>
                    <option value="false" selected="@(isStatutory == false ? "selected" : null)">غير إلزامي</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح الفلاتر"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الكود</th><th>الاسم</th><th>إلزامي</th><th>نسبة %</th><th>مبلغ ثابت</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Code</td><td>@d.NameAr</td><td>@(d.IsStatutory ? "نعم" : "لا")</td>
                        <td>@(d.Percentage?.ToString("N2") ?? "—")</td><td>@(d.FixedAmount?.ToString("N2") ?? "—")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                                  data-hr-confirm="حذف؟"
                                  data-hr-confirm-title="تأكيد الحذف"
                                  data-hr-confirm-variant="danger"
                                  data-hr-confirm-label="حذف">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger btn-xs" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button></form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا توجد أنواع</td></tr> }
            </tbody>
        </table>
    </div>
</div>
