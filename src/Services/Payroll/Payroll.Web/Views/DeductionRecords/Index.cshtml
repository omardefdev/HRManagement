@model IReadOnlyList<Payroll.Domain.Entities.DeductionRecord>
@{ ViewData["Title"] = "الخصومات"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">الخصومات</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">خصم جديد</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>النوع</th><th>المبلغ</th></tr></thead>
            <tbody>
            @foreach (var x in Model) { <tr><td>@x.EmployeeId</td><td>@x.DeductionType</td><td>@x.Amount</td></tr> }
            @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-3">لا توجد خصومات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
