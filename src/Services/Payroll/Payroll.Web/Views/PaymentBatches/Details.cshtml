@model Payroll.Web.ViewModels.PaymentBatchDetailsViewModel
@using Payroll.Domain.Entities
@using Payroll.Domain.Enums
@{
    ViewData["Title"] = "دفعة الصرف";
    var batch = Model.Batch;
    var run = batch.PayrollRun;
    var sent = batch.Status is PaymentBatchStatus.Submitted or PaymentBatchStatus.Acked or PaymentBatchStatus.Settled;
}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">دفعة الصرف — @Html.HrDate(run?.PeriodStart) إلى @Html.HrDate(run?.PeriodEnd)</h3>
        <span class="badge bg-secondary">@Html.HrEnumDisplay(batch.Status)</span>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            المال يخرج من مسار واحد: ترحيل التشغيل ينشئ الدفعة وأوامرها، ثم قرار التمويل إن لزم، ثم «تنفيذ الصرف» بيد المُرحِّل مع فحص الاحتيال والبوابة لكل موظف،
            ثم ملف مصرفي يُنشأ مرة واحدة لكل إرسال. أوامر المحجوزين تبقى خارج الإرسال حتى يُفرج عنهم بأربع عيون، ثم تُرسل بملف تكميلي.
        </p>
        <dl class="row mb-0">
            <dt class="col-sm-3">التشغيل</dt>
            <dd class="col-sm-9"><a asp-controller="PayrollRuns" asp-action="Details" asp-route-id="@batch.PayrollRunId">عرض التشغيل</a></dd>
            <dt class="col-sm-3">صافي التشغيل</dt>
            <dd class="col-sm-9">@batch.TotalAmount.ToString("N2")</dd>
            <dt class="col-sm-3">المتأخرات بقرار التمويل</dt>
            <dd class="col-sm-9">@batch.ArrearsAmount.ToString("N2")</dd>
            <dt class="col-sm-3">مصدر الدفعة</dt>
            <dd class="col-sm-9">@Html.HrEnumDisplay(batch.Source)</dd>
            <dt class="col-sm-3">تاريخ الإرسال</dt>
            <dd class="col-sm-9">@Html.HrDateTime(batch.SubmittedAt)</dd>
            <dt class="col-sm-3">إشعار القناة</dt>
            <dd class="col-sm-9">@Html.HrDateTime(batch.AckedAt)</dd>
            <dt class="col-sm-3">التسوية</dt>
            <dd class="col-sm-9">@Html.HrDateTime(batch.SettledAt) @(batch.SettlementReference is { Length: > 0 } settlementReference ? $"— مرجع الكشف {settlementReference}" : "")</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">الأوامر حسب الحالة</h5></div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead><tr><th>الحالة</th><th>العدد</th><th>المبلغ</th></tr></thead>
            <tbody>
            @foreach (var tally in Model.Orders)
            {
                <tr><td>@Html.HrEnumDisplay(tally.Status)</td><td>@tally.Count</td><td>@tally.Amount.ToString("N2")</td></tr>
            }
            @if (Model.Orders.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted py-3">لا توجد أوامر لهذه الدفعة</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">المحجوزون</h5></div>
    <div class="card-body p-0">
        <p class="text-muted small px-3 pt-2">أمر المحجوز خارج الإرسال والملف، ويُصرف للباقين. حجز الصرف والتنبيه الحرج يُرفعان بطلب وقرار من شخصين؛ وحجز «لا حساب» يُرفع بالتحقق من حساب الموظف.</p>
        <table class="table table-sm mb-0">
            <thead><tr><th>الموظف</th><th>السبب</th><th>المبلغ</th></tr></thead>
            <tbody>
            @foreach (var held in Model.Held)
            {
                <tr><td>@(held.EmployeeName ?? "موظف غير متاح اسمه")</td><td>@PaymentOrderHoldReasons.Describe(held.HoldReason)</td><td>@held.Amount.ToString("N2")</td></tr>
            }
            @if (Model.Held.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted py-3">لا يوجد محجوزون في هذه الدفعة</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">ملفات الصرف المصرفية</h5></div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead><tr><th>التسلسل</th><th>النوع</th><th>عدد الأوامر</th><th>المجموع</th><th>أنشأه</th><th>التاريخ</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
            @foreach (var file in Model.Files)
            {
                <tr>
                    <td>@file.Sequence</td>
                    <td>@Html.HrEnumDisplay(file.Kind)</td>
                    <td>@file.ControlCount</td>
                    <td>@file.ControlTotal.ToString("N2")</td>
                    <td>@Html.HrUserName(file.GeneratedBy)</td>
                    <td>@Html.HrDateTime(file.GeneratedAt)</td>
                    <td>@(file.SupersededById is null ? "ساري" : "أُبطل بإعادة إصدار")</td>
                    <td>
                        @if (Model.MayPost || Model.MayApprove)
                        {
                            <a asp-action="DownloadFile" asp-route-id="@batch.Id" asp-route-fileId="@file.Id" class="btn btn-outline-primary btn-sm">تنزيل</a>
                        }
                    </td>
                </tr>
            }
            @if (Model.Files.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-3">لا يوجد ملف بعد: يُنشأ الملف مع الإرسال</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">قرار التمويل</h5></div>
    <div class="card-body">
        @if (Model.Funding is { } funding)
        {
            <p class="mb-0">نسبة التمويل @funding.FundingRatio.ToString("P0") — المبلغ المعتمد @funding.ApprovedAmount.ToString("N2") — قرّره @Html.HrUserName(funding.ApprovedBy) في @Html.HrDateTime(funding.DecisionDate)</p>
        }
        else if (Model.MayApprove && batch.Status == PaymentBatchStatus.Pending)
        {
            <form asp-action="Fund" asp-route-id="@batch.Id" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label" for="fundingRatio">نسبة التمويل (من 0 إلى 1)</label>
                    <input id="fundingRatio" name="fundingRatio" type="number" step="0.01" min="0" max="1" value="1" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="approvedAmount">المبلغ المعتمد (اختياري)</label>
                    <input id="approvedAmount" name="approvedAmount" type="number" step="0.01" min="0" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="notes">ملاحظات</label>
                    <input id="notes" name="notes" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary btn-sm">تسجيل قرار التمويل</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted mb-0">لا قرار تمويل: تُصرف الأوامر بكامل صافيها.</p>
        }
    </div>
</div>

@if (Model.MayPost)
{
    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">الإرسال</h5></div>
        <div class="card-body d-flex flex-wrap gap-2">
            @if (batch.Status == PaymentBatchStatus.Pending)
            {
                <form asp-action="Process" asp-route-id="@batch.Id" method="post" data-hr-confirm="إرسال الدفعة إلى القناة وإنشاء ملفها المصرفي؟">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">تنفيذ الصرف</button>
                </form>
            }
            @if (sent && Model.Held.Count > 0)
            {
                <form asp-action="SubmitHeld" asp-route-id="@batch.Id" method="post" data-hr-confirm="إرسال أوامر من رُفع حجزهم بملف تكميلي؟">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm">إرسال المُفرَج عنهم</button>
                </form>
            }
        </div>
    </div>
}
