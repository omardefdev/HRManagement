@model IReadOnlyList<Payroll.Domain.Entities.FraudAlert>
@using Payroll.Domain.Constants
@{
    ViewData["Title"] = "تنبيهات الاحتيال";
    var employeeNames = ViewBag.EmployeeNames as IReadOnlyDictionary<Guid, string>
                        ?? new Dictionary<Guid, string>();
    var filterEmployeeId = ViewBag.EmployeeId as Guid?;
    var status = ViewBag.Status as string;
    var severity = ViewBag.Severity as string;
    var category = ViewBag.Category as string;
    DateTime? detectedFrom = ViewBag.DetectedFrom;
    DateTime? detectedTo = ViewBag.DetectedTo;
    var statusOptions = new[] { FraudAlertStatus.Open, FraudAlertStatus.UnderReview, FraudAlertStatus.Resolved, FraudAlertStatus.Dismissed };
    var severityOptions = new[] { FraudAlertSeverity.Critical, FraudAlertSeverity.High, FraudAlertSeverity.Medium };
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">تنبيهات الاحتيال المفتوحة</h3>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">مفتوحة (افتراضي)</option>
                    @foreach (var item in statusOptions)
                    {
                        <option value="@item" selected="@(status == item ? "selected" : null)">@Html.HrStoredEnumDisplay("Code", item)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الخطورة</label>
                <select name="severity" class="form-select form-select-sm">
                    <option value="">كل المستويات</option>
                    @foreach (var item in severityOptions)
                    {
                        <option value="@item" selected="@(severity == item ? "selected" : null)">@Html.HrStoredEnumDisplay("Code", item)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الفئة</label>
                <input type="text" name="category" value="@category" class="form-control form-control-sm" placeholder="الفئة" />
            </div>
            <div class="col-md-2">
                <label class="form-label">الموظف</label>
                <select name="employeeId" class="form-select form-select-sm" data-hr-picker="employee" data-placeholder="كل الموظفين">
                    <option value="">كل الموظفين</option>
                    @if (filterEmployeeId is Guid empId)
                    {
                        <option value="@empId" selected="selected">@(employeeNames.GetValueOrDefault(empId, empId.ToString()))</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">اكتُشف من</label>
                <input type="date" name="detectedFrom" value="@detectedFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">اكتُشف إلى</label>
                <input type="date" name="detectedTo" value="@detectedTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-12 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-filter"></i> تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح الفلاتر"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead>
            <tr>
                <th>القاعدة</th>
                <th>الفئة</th>
                <th>الخطورة</th>
                <th>الموظف</th>
                <th>الحالة</th>
                <th>الاكتشاف</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.RuleId</td>
                    <td>@x.Category</td>
                    <td>@Html.HrStoredEnumDisplay("Code", x.Severity)</td>
                    <td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(x.EmployeeId, employeeNames.GetValueOrDefault(x.EmployeeId)))</td>
                    <td>@Html.HrStoredEnumDisplay("Code", x.Status)</td>
                    <td>@x.DetectedAtUtc.ToString("yyyy/MM/dd HH:mm")</td>
                    <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">تفاصيل</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-3">لا توجد تنبيهات مفتوحة</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
