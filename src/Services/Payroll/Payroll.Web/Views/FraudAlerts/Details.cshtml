@model Payroll.Domain.Entities.FraudAlert
@using Payroll.Domain.Constants
@{
    ViewData["Title"] = "تفاصيل تنبيه الاحتيال";
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">تنبيه احتيال @Html.HrTextWithCodes(Model.RuleId)</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

        <table class="table table-bordered">
            <tr><th>القاعدة</th><td>@Html.HrTextWithCodes(Model.RuleId)</td></tr>
            <tr><th>الفئة</th><td>@Html.HrStoredEnumDisplay("FraudAlertCategory", Model.Category)</td></tr>
            <tr><th>الخطورة</th><td>@Html.HrStoredEnumDisplay("Code", Model.Severity)</td></tr>
            <tr><th>الموظف</th><td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(Model.EmployeeId, ViewBag.EmployeeName as string))</td></tr>
            <tr><th>تشغيل الرواتب</th><td>@if (Model.PayrollRunId is Guid runId) { <a asp-controller="PayrollRuns" asp-action="Details" asp-route-id="@runId">عرض مسير الرواتب</a> } else { <span>—</span> }</td></tr>
            <tr><th>الحالة</th><td>@Html.HrStoredEnumDisplay("Code", Model.Status)</td></tr>
            <tr><th>المالك</th><td>@Html.HrUserName(Model.OwnerId)</td></tr>
            <tr><th>التفاصيل</th><td>@(Model.Details ?? "—")</td></tr>
            <tr><th>حجز الصرف</th><td>@if (Model.PaymentHoldId is Guid holdId) { <a asp-controller="PaymentHolds" asp-action="Details" asp-route-id="@holdId">عرض حجز الصرف</a> } else { <span>—</span> }</td></tr>
            <tr><th>وقت الاكتشاف</th><td>@Html.HrDateTime(Model.DetectedAtUtc)</td></tr>
        </table>

        @if (Model.Status is FraudAlertStatus.Open or FraudAlertStatus.UnderReview)
        {
            <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">تعيين مالك (اتركه فارغاً لتعيينك)</label>
                        <input name="ownerId" class="form-control" placeholder="Guid" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">تعيين</button>
                    </div>
                </div>
            </form>

            @if (Model.Severity == FraudAlertSeverity.Critical)
            {
                <p class="text-muted small">التنبيه حرج: حله فعلان من شخصين. تطلبه هنا بسبب، ويقرّره معتمد آخر من «طلبات بانتظار قرارك»، فيُحل التنبيه ويُفرج عن حجزه المرتبط.</p>
            }
            else
            {
                <p class="text-muted small">التنبيه غير حرج: يُحل بفعل واحد. حجز الصرف المرتبط به (إن وجد) لا يُفرج عنه من هنا: الإفراج طلب يقرّره معتمد آخر من صفحة الحجز.</p>
            }
            <form asp-action="Resolve" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label" for="resolutionReason">سبب الحل</label>
                        <input id="resolutionReason" name="resolutionReason" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="targetStatus">الحالة المستهدفة</label>
                        <select id="targetStatus" name="targetStatus" class="form-select">
                            <option value="@FraudAlertStatus.Resolved">محلول</option>
                            <option value="@FraudAlertStatus.Dismissed">مُستبعد</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-success">@(Model.Severity == FraudAlertSeverity.Critical ? "طلب حل التنبيه (أربع عيون)" : "حل التنبيه")</button>
                    </div>
                </div>
            </form>
        }
    </div>
</div>
