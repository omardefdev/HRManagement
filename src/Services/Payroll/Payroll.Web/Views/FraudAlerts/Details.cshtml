@model Payroll.Domain.Entities.FraudAlert
@using Payroll.Domain.Constants
@{ ViewData["Title"] = "تفاصيل تنبيه الاحتيال"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">تنبيه @Model.RuleId</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

        <table class="table table-bordered">
            <tr><th>القاعدة</th><td>@Model.RuleId</td></tr>
            <tr><th>الفئة</th><td>@Model.Category</td></tr>
            <tr><th>الخطورة</th><td>@Model.Severity</td></tr>
            <tr><th>الموظف</th><td>@Model.EmployeeId</td></tr>
            <tr><th>تشغيل الرواتب</th><td>@(Model.PayrollRunId?.ToString() ?? "—")</td></tr>
            <tr><th>الحالة</th><td>@Model.Status</td></tr>
            <tr><th>المالك</th><td>@(Model.OwnerId?.ToString() ?? "—")</td></tr>
            <tr><th>التفاصيل</th><td>@(Model.Details ?? "—")</td></tr>
            <tr><th>حجز الصرف</th><td>@(Model.PaymentHoldId?.ToString() ?? "—")</td></tr>
            <tr><th>وقت الاكتشاف</th><td>@Model.DetectedAtUtc.ToString("yyyy/MM/dd HH:mm")</td></tr>
        </table>

        @if (Model.Status is FraudAlertStatus.Open or FraudAlertStatus.UnderReview)
        {
            <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">تعيين مالك (اتركه فارغاً لتعيينك)</label>
                        <input name="ownerId" class="form-control" placeholder="Guid" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">تعيين</button>
                    </div>
                </div>
            </form>

            <form asp-action="Resolve" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">سبب الحل</label>
                        <input name="resolutionReason" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">الحالة المستهدفة</label>
                        <select name="targetStatus" class="form-select">
                            <option value="@FraudAlertStatus.Resolved">Resolved</option>
                            <option value="@FraudAlertStatus.Dismissed">Dismissed</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">المعتمد (أربعة عيون)</label>
                        <input name="ApprovedBy" class="form-control" placeholder="Guid" />
                    </div>
                    <div class="col-12 form-check ms-2">
                        <input class="form-check-input" type="checkbox" name="releaseHold" value="true" id="releaseHold" />
                        <label class="form-check-label" for="releaseHold">إفراج حجز الصرف المرتبط</label>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-success">حل التنبيه</button>
                    </div>
                </div>
            </form>
        }
    </div>
</div>
