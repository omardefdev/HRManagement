@model Payroll.Domain.Entities.EndOfServiceSettlement
@{ ViewData["Title"] = "تسوية نهاية خدمة جديدة"; }
<div class="card">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-plus"></i> تسوية نهاية خدمة جديدة</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-6 mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select></div>
                <div class="col-md-6 mb-3"><label asp-for="SeparationRecordId" class="form-label"></label><input asp-for="SeparationRecordId" class="form-control" /></div>
                <div class="col-md-3 mb-3"><label asp-for="ServiceYears" class="form-label"></label><input asp-for="ServiceYears" class="form-control" type="number" step="0.01" /></div>
                <div class="col-md-3 mb-3"><label asp-for="BaseSalary" class="form-label"></label><input asp-for="BaseSalary" class="form-control" type="number" step="0.01" /></div>
                <div class="col-md-3 mb-3"><label asp-for="GratuityAmount" class="form-label"></label><input asp-for="GratuityAmount" class="form-control" type="number" step="0.01" /></div>
                <div class="col-md-3 mb-3"><label asp-for="LeaveBalancePayout" class="form-label"></label><input asp-for="LeaveBalancePayout" class="form-control" type="number" step="0.01" /></div>
                <div class="col-md-4 mb-3"><label asp-for="OtherCompensation" class="form-label"></label><input asp-for="OtherCompensation" class="form-control" type="number" step="0.01" /></div>
                <div class="col-md-4 mb-3"><label asp-for="TotalDeductions" class="form-label"></label><input asp-for="TotalDeductions" class="form-control" type="number" step="0.01" /></div>
                <div class="col-md-4 mb-3"><label asp-for="NetSettlement" class="form-label"></label><input asp-for="NetSettlement" class="form-control" type="number" step="0.01" /></div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </form>
    </div>
</div>
