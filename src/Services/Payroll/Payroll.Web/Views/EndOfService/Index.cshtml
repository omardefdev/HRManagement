@model IList<Payroll.Domain.Entities.EndOfServiceSettlement>
@using Payroll.Domain.Enums
@{
    ViewData["Title"] = "مستحقات نهاية الخدمة";
    var employeeNames = ViewBag.EmployeeNames as IReadOnlyDictionary<Guid, string>
                        ?? new Dictionary<Guid, string>();
    var filterEmployeeId = ViewBag.EmployeeId as Guid?;
    var selectedStatus = ViewBag.Status as EosStatus?;
    DateTime? calculatedFrom = ViewBag.CalculatedFrom;
    DateTime? calculatedTo = ViewBag.CalculatedTo;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-file-invoice-dollar"></i> مستحقات نهاية الخدمة</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> تسوية جديدة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label">الموظف</label>
                <select name="employeeId" class="form-select form-select-sm" data-hr-picker="employee" data-placeholder="كل الموظفين">
                    <option value="">كل الموظفين</option>
                    @if (filterEmployeeId is Guid empId)
                    {
                        <option value="@empId" selected="selected">@(employeeNames.GetValueOrDefault(empId, empId.ToString()))</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">كل الحالات</option>
                    @foreach (var item in Enum.GetValues<EosStatus>())
                    {
                        <option value="@item" selected="@(selectedStatus == item ? "selected" : null)">@Html.HrEnumDisplay(item)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">حُسب من</label>
                <input type="date" name="calculatedFrom" value="@calculatedFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">حُسب إلى</label>
                <input type="date" name="calculatedTo" value="@calculatedTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 d-flex align-items-end gap-1">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-filter"></i> تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح الفلاتر"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الموظف</th><th>سنوات الخدمة</th><th>المكافأة</th><th>رصيد الإجازات</th><th>الصافي</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var badge = e.Status.ToString() switch { "Draft" => "bg-warning", "Approved" => "bg-success", "Paid" => "bg-info", _ => "bg-secondary" };
                    <tr>
                        <td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(e.EmployeeId, employeeNames.GetValueOrDefault(e.EmployeeId)))</td><td>@e.ServiceYears</td>
                        <td>@e.GratuityAmount.ToString("N2")</td><td>@e.LeaveBalancePayout.ToString("N2")</td>
                        <td><strong>@e.NetSettlement.ToString("N2")</strong></td>
                        <td><span class="badge @badge">@Html.HrEnumDisplay(e.Status)</span></td>
                        <td><a asp-action="Details" asp-route-id="@e.Id" class="btn btn-primary btn-xs" aria-label="تفاصيل"><i aria-hidden="true" class="fas fa-eye"></i></a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">لا توجد تسويات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
