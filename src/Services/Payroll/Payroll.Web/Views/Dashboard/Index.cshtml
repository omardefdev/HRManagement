@{ ViewData["Title"] = "لوحة تحكم الرواتب"; }
@if (ViewBag.NoPublishedFramework == true)
{
    <div class="alert alert-danger" role="alert" data-testid="no-published-framework">
        <strong>@Payroll.Domain.Services.PayrollFrameworkMessages.NoPublishedFramework.</strong>
        لا يُحسب أي تشغيل رواتب قبل نشر إطار قانوني: استورد حزمة قانونية، ثم يعتمدها شخص ثانٍ ويصادق عليها قانونياً شخص ثالث وتُنشر.
        <a asp-controller="PayrollConfigurations" asp-action="Import" class="alert-link">استيراد حزمة قانونية</a>
    </div>
}
@foreach (var warning in ViewBag.ExceptionWarnings as IReadOnlyList<Payroll.Application.Features.PayrollConfigurations.PayrollExceptionExpiryWarning> ?? [])
{
    <div class="alert @(warning.Expired ? "alert-danger" : "alert-warning")" role="alert" data-testid="exception-expiry-warning">
        @if (warning.ExpiresOn is null)
        {
            <span><strong>الاستثناء القانوني @warning.Citation غير نافذ في كتالوج الضوابط القانونية.</strong></span>
        }
        else if (warning.Expired)
        {
            <span><strong>انتهى الاستثناء القانوني @warning.Citation في @Html.HrDate(warning.ExpiresOn).</strong></span>
        }
        else
        {
            <span><strong>ينتهي الاستثناء القانوني @warning.Citation في @Html.HrDate(warning.ExpiresOn)</strong> (بعد @warning.DaysLeft يوماً).</span>
        }
        <span>بعد آخر يوم له لا يُحسب ولا يُنشر الإطار المؤقت الذي يستشهد به: @string.Join("، ", warning.Frameworks). تجديد الاستثناء أو استبدال القيم بقيم موقّعة قرار قانوني.</span>
    </div>
}
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner"><h3>@ViewBag.TotalRuns</h3><p>إجمالي التشغيلات</p></div>
            <div class="icon"><i class="fas fa-calculator"></i></div>
            <a asp-controller="PayrollRuns" asp-action="Index" class="small-box-footer">عرض الكل <i class="fas fa-arrow-circle-left"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner"><h3>@ViewBag.TotalProfiles</h3><p>ملفات رواتب نشطة</p></div>
            <div class="icon"><i class="fas fa-users"></i></div>
            <a asp-controller="EmployeePayProfiles" asp-action="Index" class="small-box-footer">عرض الكل <i class="fas fa-arrow-circle-left"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner"><h3>@ViewBag.TotalPosted</h3><p>تشغيلات مرحّلة</p></div>
            <div class="icon"><i class="fas fa-check-double"></i></div>
            <a href="#" class="small-box-footer">&nbsp;</a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner"><h3>@(((decimal)ViewBag.LastRunNet).ToString("N0"))</h3><p>صافي آخر تشغيل</p></div>
            <div class="icon"><i class="fas fa-money-bill-wave"></i></div>
            <a asp-controller="PayrollReports" asp-action="Index" class="small-box-footer">التقارير <i class="fas fa-arrow-circle-left"></i></a>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-6 col-12">
        <div class="small-box bg-secondary">
            <div class="inner"><h3>@ViewBag.PendingSalaryChanges</h3><p>طلبات تغيير راتب بانتظار الاعتماد</p></div>
            <div class="icon"><i class="fas fa-hourglass-half"></i></div>
            <a asp-controller="PayProfileChanges" asp-action="Index" asp-route-state="@PayProfileChangeState.PendingApproval" class="small-box-footer">عرض الطلبات <i class="fas fa-arrow-circle-left"></i></a>
        </div>
    </div>
    <div class="col-lg-6 col-12">
        <div class="small-box @((int)ViewBag.BlockedSalaryChanges > 0 ? "bg-danger" : "bg-light")">
            <div class="inner"><h3>@ViewBag.BlockedSalaryChanges</h3><p>تغييرات مجدولة تعذّر تطبيقها</p></div>
            <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
            <a asp-controller="PayProfileChanges" asp-action="Index" asp-route-blockedOnly="true" class="small-box-footer">عرض المتعذّرة <i class="fas fa-arrow-circle-left"></i></a>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-chart-bar me-2"></i>صافي الرواتب الشهري</h3></div>
    <div class="card-body"><canvas id="payrollChart" height="80"></canvas></div>
</div>
@section Scripts {
<script>
    new Chart(document.getElementById('payrollChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(ViewBag.ChartLabels),
            datasets: [{
                label: 'صافي الرواتب',
                data: @Html.Raw(ViewBag.ChartData),
                backgroundColor: 'rgba(60,141,188,0.6)',
                borderColor: 'rgba(60,141,188,1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: { y: { beginAtZero: true } },
            plugins: { legend: { display: false } }
        }
    });
</script>
}
