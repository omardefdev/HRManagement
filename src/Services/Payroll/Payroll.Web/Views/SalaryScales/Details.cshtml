@model Payroll.Web.ViewModels.SalaryScaleDetailsViewModel
@{
    ViewData["Title"] = "جدول الرواتب";
    var s = Model.Scale;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-table"></i> جدول الرواتب: @s.NameAr</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">عودة</a>
    </div>
    <div class="card-body">
        @if (Model.OpenRequest is not null)
        {
            <div class="alert alert-warning" role="alert">
                على هذا الجدول طلب @Html.HrEnumDisplay(Model.OpenRequest.Operation) بانتظار الاعتماد، والقيم أدناه هي المعتمدة حتى يُقرَّر فيه.
                <a asp-controller="PayrollReferenceChanges" asp-action="Details" asp-route-id="@Model.OpenRequest.Id" class="alert-link">عرض الطلب</a>
            </div>
        }
        <dl class="row">
            <dt class="col-sm-3">الكود</dt><dd class="col-sm-9">@s.Code</dd>
            <dt class="col-sm-3">الاسم بالعربية</dt><dd class="col-sm-9">@s.NameAr</dd>
            <dt class="col-sm-3">ساري من</dt><dd class="col-sm-9">@Html.HrDate(s.EffectiveFrom)</dd>
            <dt class="col-sm-3">ساري إلى</dt><dd class="col-sm-9">@Html.HrDate(s.EffectiveTo)</dd>
            <dt class="col-sm-3">فعّال</dt><dd class="col-sm-9">@(s.IsActive ? "نعم" : "لا")</dd>
        </dl>
        @if (Model.CanChange && Model.OpenRequest is null)
        {
            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> طلب تعديل</a>
            <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i> طلب حذف</a>
        }
        <h5 class="mt-4">درجات الجدول</h5>
        <table class="table table-sm">
            <thead><tr><th>الكود</th><th>الاسم</th><th>الأساسي</th><th>الحد الأدنى</th><th>الحد الأعلى</th><th></th></tr></thead>
            <tbody>
                @foreach (var g in s.PayGrades.OrderBy(g => g.GradeCode))
                {
                    <tr>
                        <td>@g.GradeCode</td><td>@g.GradeNameAr</td>
                        <td>@g.BaseSalary.ToString("N2")</td><td>@g.MinSalary.ToString("N2")</td><td>@g.MaxSalary.ToString("N2")</td>
                        <td><a asp-controller="PayGrades" asp-action="Details" asp-route-id="@g.Id" class="btn btn-info btn-xs">التفاصيل</a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (s.PayGrades.Count == 0)
        {
            @await Html.PartialAsync("_HrEmptyState", "لا درجات في هذا الجدول")
        }
    </div>
</div>
