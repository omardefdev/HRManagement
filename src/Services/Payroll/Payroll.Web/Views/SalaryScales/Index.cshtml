@model IList<Payroll.Domain.Entities.SalaryScale>
@{
    ViewData["Title"] = "جداول الرواتب";
    var q = ViewBag.Q as string;
    bool? isActive = ViewBag.IsActive;
    DateTime? effectiveFrom = ViewBag.EffectiveFrom;
    DateTime? effectiveTo = ViewBag.EffectiveTo;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-table"></i> جداول الرواتب</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> جديد</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="q" value="@q" class="form-control form-control-sm" placeholder="بحث بالرمز أو الاسم..." />
            </div>
            <div class="col-auto">
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">الكل</option>
                    <option value="true" selected="@(isActive == true ? "selected" : null)">فعّال</option>
                    <option value="false" selected="@(isActive == false ? "selected" : null)">غير فعّال</option>
                </select>
            </div>
            <div class="col-auto">
                <input type="date" name="effectiveFrom" value="@effectiveFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" title="ساري من" />
            </div>
            <div class="col-auto">
                <input type="date" name="effectiveTo" value="@effectiveTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" title="ساري إلى" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح الفلاتر"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الكود</th><th>الاسم</th><th>ساري من</th><th>ساري إلى</th><th>فعّال</th><th>الدرجات</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Code</td><td>@s.NameAr</td>
                        <td>@s.EffectiveFrom.ToString("yyyy/MM/dd")</td>
                        <td>@(s.EffectiveTo?.ToString("yyyy/MM/dd") ?? "—")</td>
                        <td>@(s.IsActive ? "✓" : "✗")</td>
                        <td><a asp-controller="PayGrades" asp-action="Index" asp-route-scaleId="@s.Id" class="badge bg-info">@s.PayGrades.Count</a></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                  data-hr-confirm="حذف؟"
                                  data-hr-confirm-title="تأكيد الحذف"
                                  data-hr-confirm-variant="danger"
                                  data-hr-confirm-label="حذف">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger btn-xs" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash"></i></button></form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">لا توجد جداول</td></tr> }
            </tbody>
        </table>
    </div>
</div>
