@model IList<Payroll.Domain.Entities.SalaryScale>
@{
    var canChange = ViewBag.CanChange == true;
    var openRequests = ViewBag.OpenRequests as Dictionary<Guid, Guid> ?? new Dictionary<Guid, Guid>();
    ViewData["Title"] = "جداول الرواتب";
    var q = ViewBag.Q as string;
    bool? isActive = ViewBag.IsActive;
    DateTime? effectiveFrom = ViewBag.EffectiveFrom;
    DateTime? effectiveTo = ViewBag.EffectiveTo;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-table"></i> جداول الرواتب</h3>
        <span>
            <a asp-controller="PayrollReferenceChanges" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-clipboard-check"></i> طلبات البيانات المرجعية</a>
            @if (canChange)
            {
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> طلب إضافة</a>
            }
        </span>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="q" value="@q" class="form-control form-control-sm" placeholder="بحث بالرمز أو الاسم..." />
            </div>
            <div class="col-auto">
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">الكل</option>
                    <option value="true" selected="@(isActive == true ? "selected" : null)">فعّال</option>
                    <option value="false" selected="@(isActive == false ? "selected" : null)">غير فعّال</option>
                </select>
            </div>
            <div class="col-auto">
                <input type="date" name="effectiveFrom" value="@Html.HrDateInputValue(effectiveFrom)" class="form-control form-control-sm" title="ساري من" />
            </div>
            <div class="col-auto">
                <input type="date" name="effectiveTo" value="@Html.HrDateInputValue(effectiveTo)" class="form-control form-control-sm" title="ساري إلى" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح الفلاتر"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الكود</th><th>الاسم</th><th>ساري من</th><th>ساري إلى</th><th>فعّال</th><th>الدرجات</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Code</td><td>@s.NameAr</td>
                        <td>@Html.HrDate(s.EffectiveFrom)</td>
                        <td>@Html.HrDate(s.EffectiveTo)</td>
                        <td>@(s.IsActive ? "✓" : "✗")</td>
                        <td><a asp-controller="PayGrades" asp-action="Index" asp-route-scaleId="@s.Id" class="badge bg-info">@s.PayGrades.Count</a></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-info btn-xs">التفاصيل</a>
                            @if (openRequests.TryGetValue(s.Id, out var openRequest))
                            {
                                <a asp-controller="PayrollReferenceChanges" asp-action="Details" asp-route-id="@openRequest" class="badge bg-warning text-dark">طلب بانتظار الاعتماد</a>
                            }
                            else if (canChange)
                            {
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-warning btn-xs" aria-label="طلب تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-outline-danger btn-xs" aria-label="طلب حذف"><i aria-hidden="true" class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">لا توجد جداول</td></tr> }
            </tbody>
        </table>
    </div>
</div>
