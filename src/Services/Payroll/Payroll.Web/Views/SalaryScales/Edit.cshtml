@model Payroll.Web.ViewModels.SalaryScaleChangeViewModel
@{ ViewData["Title"] = "طلب تعديل جدول رواتب"; }
<div class="card">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-edit"></i> طلب تعديل جدول رواتب</h3></div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-4 mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div>
                <div class="col-md-8 mb-3"><label asp-for="NameAr" class="form-label"></label><input asp-for="NameAr" class="form-control" /></div>
                <div class="col-md-4 mb-3"><label asp-for="EffectiveFrom" class="form-label"></label><input asp-for="EffectiveFrom" class="form-control" type="date" value="@Html.HrDateInputValue(Model.EffectiveFrom)" /></div>
                <div class="col-md-4 mb-3"><label asp-for="EffectiveTo" class="form-label"></label><input asp-for="EffectiveTo" class="form-control" type="date" value="@Html.HrDateInputValue(Model.EffectiveTo)" /></div>
                <div class="col-md-4 mb-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
            </div>
            <partial name="_ReferenceChangeFields" model="Model" />
            <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> تقديم الطلب</button>
            <a asp-action="Index" class="btn btn-secondary">عودة</a>
        </form>
    </div>
</div>
