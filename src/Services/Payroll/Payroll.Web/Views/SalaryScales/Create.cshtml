@model Payroll.Domain.Entities.SalaryScale
@{ ViewData["Title"] = "جدول رواتب جديد"; }
<div class="card">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-plus"></i> جدول رواتب جديد</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-6 mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div>
                <div class="col-md-6 mb-3"><label asp-for="NameAr" class="form-label"></label><input asp-for="NameAr" class="form-control" /></div>
                <div class="col-md-4 mb-3"><label asp-for="EffectiveFrom" class="form-label"></label><input asp-for="EffectiveFrom" class="form-control" type="date" /></div>
                <div class="col-md-4 mb-3"><label asp-for="EffectiveTo" class="form-label"></label><input asp-for="EffectiveTo" class="form-control" type="date" /></div>
                <div class="col-md-4 mb-3"><div class="form-check mt-4"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </form>
    </div>
</div>
