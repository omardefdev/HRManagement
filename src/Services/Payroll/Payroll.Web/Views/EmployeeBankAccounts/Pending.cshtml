@model Payroll.Web.ViewModels.PendingBankAccountsViewModel
@{
    ViewData["Title"] = "حسابات مصرفية بانتظار التحقق";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0"><i class="fas fa-hourglass-half"></i> حسابات مصرفية بانتظار التحقق</h3>
    </div>

    <div class="card-body">
        <p class="text-muted mb-0">
            لا يُصرف إلى حساب قبل أن يتحقق منه معتمد رواتب غير الذي سجّله، مقابل تأكيد المصرف. يُعرض الرقم كاملاً في صفحة التحقق وحدها.
        </p>
    </div>

    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>الموظف</th>
                    <th>رقم الحساب</th>
                    <th>النوع</th>
                    <th>المصرف</th>
                    <th>سجّله</th>
                    <th>تاريخ التسجيل</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model.Accounts)
                {
                    <tr>
                        <td><a asp-action="Index" asp-route-employeeId="@account.EmployeeId">@Html.HrEmployeeName(account.EmployeeId)</a></td>
                        <td dir="ltr" class="text-end">@account.MaskedNumber</td>
                        <td>@Html.HrEnumDisplay(account.AccountKind)</td>
                        <td>@(string.IsNullOrEmpty(account.BankNameAr) ? "—" : account.BankNameAr)</td>
                        <td>
                            @if (account.CreatedBy is null)
                            {
                                <span class="text-muted">مرحَّل من بيانات قديمة</span>
                            }
                            else
                            {
                                @await Html.PartialAsync("_UserDisplayName", (object?)account.CreatedBy)
                            }
                        </td>
                        <td>@Html.HrDateTime(account.CreatedAt)</td>
                        <td>
                            @if (Model.CanApprove)
                            {
                                <a asp-action="Verify" asp-route-id="@account.Id" class="btn btn-success btn-xs"><i class="fas fa-check-double"></i> التحقق أو الرفض</a>
                                @if (account.CreatedBy == Model.CurrentUserId)
                                {
                                    <span class="badge bg-secondary">سجّلته أنت</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Accounts.Count == 0)
        {
            @await Html.PartialAsync("_HrEmptyState", "لا توجد حسابات بانتظار التحقق")
        }
    </div>
</div>
