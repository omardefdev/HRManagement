@model IReadOnlyList<Payroll.Domain.Entities.PayrollRun>
@{ ViewData["Title"] = "تشغيلات الرواتب"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-money-check-alt"></i> تشغيلات الرواتب</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> تشغيل جديد</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الفترة</th><th>تاريخ التشغيل</th><th>الحالة</th><th>صافي الإجمالي</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.PeriodStart.ToString("yyyy/MM/dd") — @r.PeriodEnd.ToString("yyyy/MM/dd")</td>
                        <td>@r.RunDate.ToString("yyyy/MM/dd")</td>
                        <td>@r.Status</td>
                        <td>@r.TotalNetPay.ToString("N2")</td>
                        <td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-info btn-sm">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">لا توجد تشغيلات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
