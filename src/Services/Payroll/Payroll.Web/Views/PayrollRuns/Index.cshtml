@model IReadOnlyList<Payroll.Domain.Entities.PayrollRun>
@using Payroll.Domain.Enums
@{
    ViewData["Title"] = "تشغيلات الرواتب";
    var selectedStatus = ViewBag.PayrollStatus as PayrollRunStatus?;
    DateTime? periodFrom = ViewBag.PeriodFrom;
    DateTime? periodTo = ViewBag.PeriodTo;
    var page = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var pageCount = (int)Math.Ceiling(totalCount / (double)pageSize);
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-money-check-alt"></i> تشغيلات الرواتب</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm" title="إنشاء تشغيل رواتب جديد"><i class="fas fa-plus"></i> تشغيل جديد</a>
    </div>
    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label">الحالة</label><select name="status" class="form-select">
                <option value="">كل الحالات</option>
                @foreach (var item in Enum.GetValues<PayrollRunStatus>())
                {
                    <option value="@item" selected="@(selectedStatus == item ? "selected" : null)">@Html.HrEnumDisplay(item)</option>
                }
            </select></div>
            <div class="col-md-3"><label class="form-label">الفترة من</label><input type="date" name="periodFrom" value="@periodFrom?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">الفترة إلى</label><input type="date" name="periodTo" value="@periodTo?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-md-3"><button type="submit" class="btn btn-primary" title="تطبيق الفلاتر"><i class="fas fa-search"></i> بحث</button> <a asp-action="Index" class="btn btn-outline-secondary" title="مسح الفلاتر"><i class="fas fa-times"></i></a></div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead><tr><th>الفترة</th><th>تاريخ التشغيل</th><th>نوع التشغيل</th><th>الحالة</th><th>صافي الإجمالي</th><th></th></tr></thead>
            <tbody>
                @foreach (var run in Model)
                {
                    <tr>
                        <td>@run.PeriodStart.ToString("yyyy/MM/dd") — @run.PeriodEnd.ToString("yyyy/MM/dd")</td>
                        <td>@run.RunDate.ToString("yyyy/MM/dd")</td>
                        <td>@Html.HrEnumDisplay(run.RunType)</td>
                        <td>@Html.HrEnumDisplay(run.Status)</td>
                        <td>@run.TotalNetPay.ToString("N2")</td>
                        <td><a asp-action="Details" asp-route-id="@run.Id" class="btn btn-info btn-sm" title="عرض تفاصيل التشغيل"><i class="fas fa-eye"></i> تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا توجد تشغيلات مطابقة للفلاتر</td></tr> }
            </tbody>
        </table>
    </div>
    @if (pageCount > 1)
    {
        <nav class="p-3" aria-label="صفحات تشغيلات الرواتب"><ul class="pagination mb-0">
            @for (var current = 1; current <= pageCount; current++)
            {
                <li class="page-item @(current == page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@current" asp-route-pageSize="@pageSize" asp-route-status="@selectedStatus" asp-route-periodFrom="@periodFrom?.ToString("yyyy-MM-dd")" asp-route-periodTo="@periodTo?.ToString("yyyy-MM-dd")">@current</a></li>
            }
        </ul></nav>
    }
</div>
