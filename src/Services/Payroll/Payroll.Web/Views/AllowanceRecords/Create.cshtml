@model Payroll.Domain.Entities.AllowanceRecord
@{ ViewData["Title"] = "بدل جديد"; }
<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-control form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="AllowanceTypeId" class="form-label"></label><select asp-for="AllowanceTypeId" asp-items="ViewBag.Types" class="form-control"></select><span asp-validation-for="AllowanceTypeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" type="number" step="0.01" /><span asp-validation-for="Amount" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="EffectiveFrom" class="form-label"></label><input asp-for="EffectiveFrom" class="form-control" type="datetime-local" /><span asp-validation-for="EffectiveFrom" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="EffectiveTo" class="form-label"></label><input asp-for="EffectiveTo" class="form-control" type="datetime-local" /><span asp-validation-for="EffectiveTo" class="text-danger"></span></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div>
    </form>
</div>
