@model IReadOnlyList<Payroll.Domain.Entities.AllowanceRecord>

@{

    ViewData["Title"] = "استحقاق البدلات";

    var employeeNames = ViewBag.EmployeeNames as IReadOnlyDictionary<Guid, string>

                        ?? new Dictionary<Guid, string>();

    var filterEmployeeId = ViewBag.EmployeeId as Guid?;

    var allowanceTypeId = ViewBag.AllowanceTypeId as Guid?;

    DateTime? effectiveFrom = ViewBag.EffectiveFrom;

    DateTime? effectiveTo = ViewBag.EffectiveTo;

    var canApprove = ViewData[Payroll.Web.ViewModels.ManualInputPage.CanApproveKey] as bool? ?? false;
    var userId = ViewData[Payroll.Web.ViewModels.ManualInputPage.UserIdKey] as Guid?;
    var decisionError = ViewData[Payroll.Web.ViewModels.ManualInputPage.ErrorKey] as string;
}

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h3 class="card-title mb-0">البدلات</h3>

        <a asp-action="Create" class="btn btn-primary btn-sm">تسجيل بدل</a>

    </div>

    <div class="card-body">

        <form method="get" class="row g-2 mb-3">

            <div class="col-md-3">

                <label class="form-label">الموظف</label>

                <select name="employeeId" class="form-select form-select-sm" data-hr-picker="employee" data-placeholder="كل الموظفين">

                    <option value="">كل الموظفين</option>

                    @if (filterEmployeeId is Guid empId)

                    {

                        <option value="@empId" selected="selected">@(employeeNames.GetValueOrDefault(empId, empId.ToString()))</option>

                    }

                </select>

            </div>

            <div class="col-md-3">

                <label class="form-label">نوع البدل</label>

                <select name="allowanceTypeId" class="form-select form-select-sm" asp-items="ViewBag.AllowanceTypes">

                    <option value="">كل الأنواع</option>

                </select>

            </div>

            <div class="col-md-2">

                <label class="form-label">ساري من</label>

                <input type="date" name="effectiveFrom" value="@Html.HrDateInputValue(effectiveFrom)" class="form-control form-control-sm" />

            </div>

            <div class="col-md-2">

                <label class="form-label">ساري إلى</label>

                <input type="date" name="effectiveTo" value="@Html.HrDateInputValue(effectiveTo)" class="form-control form-control-sm" />

            </div>

            <div class="col-md-2 d-flex align-items-end gap-1">

                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-filter"></i> تصفية</button>

                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح الفلاتر"><i class="fas fa-times"></i></a>

            </div>

        </form>

    </div>

    <div class="card-body p-0 border-top-0 pt-0">

        @if (!string.IsNullOrEmpty(decisionError))
        {
            <div class="alert alert-danger m-3" role="alert" data-testid="manual-input-refusal">@decisionError</div>
        }
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>النوع</th><th>المبلغ</th><th>من</th><th>السبب</th><th>حالة الاعتماد</th><th>القرار</th></tr></thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(x.EmployeeId, employeeNames.GetValueOrDefault(x.EmployeeId)))</td>
                    <td>@(x.AllowanceType?.NameAr ?? "—")</td>
                    <td>@x.Amount</td>
                    <td>@Html.HrDate(x.EffectiveFrom)</td>
                    <td>@(x.Reason ?? "—")</td>
                    @await Html.PartialAsync("_ManualInputDecision", Payroll.Web.ViewModels.ManualInputDecisionCell.For("AllowanceRecords", x, canApprove, userId))
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="7"><partial name="_HrEmptyState" model="@("لا توجد بدلات مسجلة.")" /></td></tr> }
            </tbody>
        </table>

    </div>

</div>

