@model Payroll.Domain.Entities.ArrearsLedgerEntry
@using Payroll.Domain.Enums
@{
    ViewData["Title"] = "تفاصيل قيد المتأخرات";
    var entitled = (decimal)(ViewBag.Entitled ?? Model.OriginalAmount);
    var paid = (decimal)(ViewBag.Paid ?? Model.PaidAmount);
    var arrears = (decimal)(ViewBag.Arrears ?? Model.ArrearsAmount);
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-balance-scale"></i> تفاصيل قيد المتأخرات</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

        <table class="table table-bordered">
            <tr><th>الموظف</th><td>@await Html.PartialAsync("_EmployeeDisplayName", new EmployeeDisplayNameModel(Model.EmployeeId, ViewBag.EmployeeName as string))</td></tr>
            <tr><th>تشغيل الرواتب</th><td><a asp-controller="PayrollRuns" asp-action="Details" asp-route-id="@Model.PayrollRunId">عرض مسير الرواتب</a></td></tr>
            <tr class="table-light"><th>المستحق</th><td><strong>@entitled.ToString("N2")</strong></td></tr>
            <tr><th>المدفوع</th><td>@paid.ToString("N2")</td></tr>
            <tr class="table-warning"><th>المتأخرات</th><td><strong>@arrears.ToString("N2")</strong></td></tr>
            <tr><th>عصر العملة</th><td>@Model.CurrencyEra</td></tr>
            <tr><th>السبب</th><td>@(Model.Reason ?? "—")</td></tr>
            <tr><th>الحالة</th>
                <td>
                    <span class="badge @(Model.Status == ArrearsLedgerStatus.FullyPaid ? "bg-success" : Model.Status == ArrearsLedgerStatus.PartiallyPaid ? "bg-warning" : "bg-secondary")">
                        @Html.HrEnumDisplay(Model.Status)
                    </span>
                </td>
            </tr>
            <tr><th>دفعة التسوية</th><td>@if (Model.SettledByBatchId is Guid batchId) { <a asp-controller="PaymentBatches" asp-action="Details" asp-route-id="@batchId">عرض دفعة الصرف</a> } else { <span>—</span> }</td></tr>
            <tr><th>تاريخ الإنشاء</th><td>@Html.HrDateTime(Model.CreatedAt)</td></tr>
        </table>

        @if (Model.Status != ArrearsLedgerStatus.Voided)
        {
            <h5 class="mt-3">طلب تعديل القيد</h5>
            <p class="text-muted small">التعديل اليدوي فعلان من شخصين: يطلبه معالج الرواتب بالمبلغين وسبب، ويقرّره معتمد آخر من «طلبات بانتظار قرارك».</p>
            <form asp-action="Update" asp-route-id="@Model.Id" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label" for="originalAmount">المستحق</label>
                    <input id="originalAmount" name="originalAmount" type="number" step="0.01" min="0" value="@entitled.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="paidAmount">المدفوع</label>
                    <input id="paidAmount" name="paidAmount" type="number" step="0.01" min="0" value="@paid.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="reason">السبب</label>
                    <input id="reason" name="reason" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary btn-sm">طلب التعديل</button>
                </div>
            </form>
        }
    </div>
</div>
