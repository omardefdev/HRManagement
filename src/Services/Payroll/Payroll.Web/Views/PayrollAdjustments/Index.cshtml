@model IReadOnlyList<Payroll.Domain.Entities.PayrollAdjustment>
@{ ViewData["Title"] = "تسويات الرواتب"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">التسويات</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">تسوية جديدة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>المبلغ</th><th>السبب</th></tr></thead>
            <tbody>
            @foreach (var x in Model) { <tr><td>@x.EmployeeId</td><td>@x.Amount</td><td>@(x.AdjustmentReason ?? "—")</td></tr> }
            @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-3">لا توجد تسويات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
