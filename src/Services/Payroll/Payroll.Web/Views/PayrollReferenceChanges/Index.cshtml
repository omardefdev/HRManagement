@model Payroll.Web.ViewModels.PayrollReferenceChangeListViewModel
@{ ViewData["Title"] = "طلبات البيانات المرجعية"; }
<div class="card">
    <div class="card-header"><h3 class="card-title mb-0"><i class="fas fa-clipboard-check"></i> طلبات البيانات المرجعية</h3></div>
    <div class="card-body">
        <p class="text-muted mb-3">جداول الرواتب والدرجات لا تتغيّر مباشرة: يطلب صاحب صلاحية البيانات المرجعية التغيير بمرجع قانوني، ويعتمده معتمد رواتب آخر.</p>
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label" for="state">الحالة</label>
                <select id="state" name="state" class="form-select form-select-sm">
                    <option value="">كل الحالات</option>
                    @foreach (var option in Html.HrEnumSelectList<PayrollReferenceChangeState>())
                    {
                        <option value="@option.Value" selected="@(Model.State?.ToString() == option.Value ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="entityType">نوع السجل</label>
                <select id="entityType" name="entityType" class="form-select form-select-sm">
                    <option value="">الكل</option>
                    @foreach (var option in Html.HrEnumSelectList<PayrollReferenceEntityType>())
                    {
                        <option value="@option.Value" selected="@(Model.EntityType?.ToString() == option.Value ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-1">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-filter"></i> تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح الفلاتر" aria-label="مسح الفلاتر"><i aria-hidden="true" class="fas fa-times"></i></a>
                @if (Model.CanApprove)
                {
                    <a asp-action="Index" asp-route-state="@PayrollReferenceChangeState.PendingApproval" class="btn btn-outline-warning btn-sm"><i class="fas fa-hourglass-half"></i> بانتظار الاعتماد</a>
                }
            </div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>نوع السجل</th><th>السجل</th><th>العملية</th><th>الحالة</th><th>المرجع القانوني</th><th>الطالب</th><th>تاريخ الطلب</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td>@Html.HrEnumDisplay(r.EntityType)</td>
                        <td>@(string.IsNullOrEmpty(r.EntityLabel) ? "—" : r.EntityLabel)</td>
                        <td>@Html.HrEnumDisplay(r.Operation)</td>
                        <td>@Html.HrEnumDisplay(r.State)</td>
                        <td>@r.LegalReference</td>
                        <td>@await Html.PartialAsync("_UserDisplayName", (object)r.RequestedBy)</td>
                        <td>@Html.HrDateTime(r.RequestedAt)</td>
                        <td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-info btn-xs">التفاصيل</a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Items.Count == 0)
        {
            @await Html.PartialAsync("_HrEmptyState", "لا توجد طلبات بيانات مرجعية")
        }
    </div>
</div>
