@model Payroll.Domain.Entities.PayrollConfiguration
@{
    ViewData["Title"] = "تعديل الإطار القانوني";
}
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="card">
        <div class="card-header"><h3 class="card-title">@Model.NameAr</h3></div>
        <div class="card-body">
            <div class="mb-3"><label asp-for="NameAr" class="form-label"></label><input asp-for="NameAr" class="form-control" /></div>
            <div class="mb-3"><label asp-for="NonWorkingDays" class="form-label"></label><input asp-for="NonWorkingDays" class="form-control" /></div>
            <div class="mb-3"><label asp-for="EosGratuityRateFirstPeriod" class="form-label"></label><input asp-for="EosGratuityRateFirstPeriod" class="form-control" /></div>
            <div class="mb-3"><label asp-for="EosGratuityFirstYearsThreshold" class="form-label"></label><input asp-for="EosGratuityFirstYearsThreshold" class="form-control" /></div>
            <div class="mb-3"><label asp-for="EosGratuityRateAfterThreshold" class="form-label"></label><input asp-for="EosGratuityRateAfterThreshold" class="form-control" /></div>
            <div class="mb-3"><label asp-for="TaxableBaseMode" class="form-label"></label><input asp-for="TaxableBaseMode" class="form-control" /></div>
            <div class="mb-3"><label asp-for="TaxExemptionAmount" class="form-label"></label><input asp-for="TaxExemptionAmount" class="form-control" /></div>
            <div class="mb-3"><label asp-for="LeavePayoutDailyDivisor" class="form-label"></label><input asp-for="LeavePayoutDailyDivisor" class="form-control" /></div>
            <div class="mb-3"><label asp-for="DailyRateDivisor" class="form-label"></label><input asp-for="DailyRateDivisor" class="form-control" /></div>
            <div class="mb-3"><label asp-for="CurrencyCode" class="form-label"></label><input asp-for="CurrencyCode" class="form-control" maxlength="3" /></div>
            <div class="mb-3"><label asp-for="DecimalPlaces" class="form-label"></label><input asp-for="DecimalPlaces" class="form-control" /></div>
            <div class="mb-3">
                <label asp-for="RoundingMode" class="form-label"></label>
                <select asp-for="RoundingMode" class="form-select" asp-items="Html.GetEnumSelectList<Payroll.Domain.Enums.PayrollRoundingMode>()"></select>
            </div>
            <div class="mb-3"><label asp-for="MaxRetroCorrectionMonths" class="form-label"></label><input asp-for="MaxRetroCorrectionMonths" class="form-control" /></div>
            <div class="form-check"><input asp-for="UseDbHolidaysOnly" class="form-check-input" /><label asp-for="UseDbHolidaysOnly" class="form-check-label"></label></div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">إلغاء</a>
        </div>
    </div>
</form>
