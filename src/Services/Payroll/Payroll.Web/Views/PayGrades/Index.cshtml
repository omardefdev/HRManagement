@model IList<Payroll.Domain.Entities.PayGrade>
@{
    var canChange = ViewBag.CanChange == true;
    var openRequests = ViewBag.OpenRequests as Dictionary<Guid, Guid> ?? new Dictionary<Guid, Guid>();
    ViewData["Title"] = "الدرجات الوظيفية";
    var scaleId = ViewBag.ScaleId as Guid?;
    var q = ViewBag.Q as string;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-layer-group"></i> الدرجات الوظيفية</h3>
        <span>
            <a asp-controller="PayrollReferenceChanges" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-clipboard-check"></i> طلبات البيانات المرجعية</a>
            @if (canChange)
            {
                <a asp-action="Create" asp-route-scaleId="@scaleId" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> طلب إضافة</a>
            }
        </span>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <select name="scaleId" class="form-select form-select-sm" asp-items="ViewBag.Scales">
                    <option value="">كل الجداول</option>
                </select>
            </div>
            <div class="col-auto">
                <input type="text" name="q" value="@q" class="form-control form-control-sm" placeholder="بحث بالرمز أو الاسم..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح الفلاتر"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
    <div class="card-body p-0 border-top-0 pt-0">
        <div class="table-responsive">
<table class="table table-striped mb-0">
            <thead><tr><th>الجدول</th><th>الكود</th><th>الاسم</th><th>الأساسي</th><th>الحد الأدنى</th><th>الحد الأقصى</th><th></th></tr></thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td>@g.SalaryScale?.NameAr</td><td>@g.GradeCode</td><td>@g.GradeNameAr</td>
                        <td>@g.BaseSalary.ToString("N2")</td><td>@g.MinSalary.ToString("N2")</td><td>@g.MaxSalary.ToString("N2")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-info btn-xs">التفاصيل</a>
                            @if (openRequests.TryGetValue(g.Id, out var openRequest))
                            {
                                <a asp-controller="PayrollReferenceChanges" asp-action="Details" asp-route-id="@openRequest" class="badge bg-warning text-dark">طلب بانتظار الاعتماد</a>
                            }
                            else if (canChange)
                            {
                                <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-warning btn-xs" aria-label="طلب تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@g.Id" class="btn btn-outline-danger btn-xs" aria-label="طلب حذف"><i aria-hidden="true" class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">لا توجد درجات</td></tr> }
            </tbody>
        </table>
</div>
    </div>
</div>
