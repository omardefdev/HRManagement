@model HR.Movements.Domain.Entities.PromotionRequest
@using HR.Movements.Domain.Enums
@{ ViewData["Title"] = "تفاصيل طلب الترفيع"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">طلب ترفيع</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        <table class="table table-borderless table-sm w-auto">
            <tr><th>الموظف</th><td><span data-hr-employee-id="@Model.EmployeeId">جاري التحميل...</span></td></tr>
            <tr><th>نظام الخدمة</th><td>@Model.SourceLegalRegimeId</td></tr>
            <tr><th>من</th><td>@Model.FromGrade / @Model.FromStep</td></tr>
            <tr><th>إلى</th><td>@Model.ToGrade / @Model.ToStep</td></tr>
            <tr><th>مرجع القرار</th><td>@Model.TransitionDecisionRef</td></tr>
            <tr><th>تاريخ النفاذ</th><td>@Model.EffectiveDate</td></tr>
            <tr><th>الحالة</th><td>@Html.HrEnumDisplay(Model.Status)</td></tr>
        </table>
        <div class="mt-3 d-flex flex-wrap gap-2">
            @if (Model.Status == PromotionRequestStatus.Pending)
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm">اعتماد</button></form>
            }
            @if (Model.Status == PromotionRequestStatus.Approved)
            {
                <form asp-action="Execute" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-primary btn-sm">تنفيذ</button></form>
            }
        </div>
    </div>
</div>
