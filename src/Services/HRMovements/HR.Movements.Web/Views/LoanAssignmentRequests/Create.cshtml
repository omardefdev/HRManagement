@model HR.Movements.Domain.Entities.LoanAssignmentRequest
@{ ViewData["Title"] = "طلب إعارة"; }
<div class="card" dir="rtl">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-control form-select" data-hr-picker="employee"><option value="">— اختر —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="LendingOrgUnitId" class="form-label"></label><select asp-for="LendingOrgUnitId" class="form-control form-select" data-hr-picker="org-unit"><option value="">— اختر —</option></select><span asp-validation-for="LendingOrgUnitId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="BorrowingOrgUnitId" class="form-label"></label><select asp-for="BorrowingOrgUnitId" class="form-control form-select" data-hr-picker="org-unit"><option value="">— اختر —</option></select><span asp-validation-for="BorrowingOrgUnitId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" type="date" /><span asp-validation-for="StartDate" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control" type="date" /><span asp-validation-for="EndDate" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Terms" class="form-label"></label><textarea asp-for="Terms" class="form-control" rows="2"></textarea><span asp-validation-for="Terms" class="text-danger"></span></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div>
    </form>
</div>
