@model HR.Movements.Domain.Entities.LoanAssignmentRequest
@using HR.Movements.Domain.Enums
@{ ViewData["Title"] = "تفاصيل طلب الإعارة"; }
<div class="card" dir="rtl">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">طلب إعارة</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        <table class="table table-borderless table-sm w-auto">
            <tr><th>الموظف</th><td>@Model.EmployeeId</td></tr>
            <tr><th>مُعير</th><td>@Model.LendingOrgUnitId</td></tr>
            <tr><th>مستفيد</th><td>@Model.BorrowingOrgUnitId</td></tr>
            <tr><th>من</th><td>@Model.StartDate</td></tr>
            <tr><th>إلى</th><td>@Model.EndDate</td></tr>
            <tr><th>الحالة</th><td>@Model.Status</td></tr>
        </table>
        <div class="mt-3 d-flex flex-wrap gap-2">
            @if (Model.Status == LoanAssignmentStatus.Pending)
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm">اعتماد</button></form>
            }
            @if (Model.Status == LoanAssignmentStatus.Approved)
            {
                <form asp-action="Execute" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-primary btn-sm">تنفيذ</button></form>
            }
            @if (Model.Status != LoanAssignmentStatus.Closed)
            {
                <form asp-action="Close" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-secondary btn-sm">إغلاق</button></form>
            }
        </div>
    </div>
</div>
