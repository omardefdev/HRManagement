@model HR.Movements.Domain.Entities.MovementNotice
@{ ViewData["Title"] = "تفاصيل نشرة التنقلات"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">@Model.Title</h3>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <table class="table table-borderless table-sm w-auto">
            <tr><th>تاريخ الإصدار</th><td>@Model.IssueDate</td></tr>
            <tr><th>الفترة</th><td>@(Model.Period ?? "—")</td></tr>
            <tr><th>صادر عن</th><td>@(Model.IssuedBy?.ToString() ?? "—")</td></tr>
        </table>

        @if (!string.IsNullOrEmpty(Model.Items))
        {
            <h5 class="mt-3">بنود النشرة</h5>
            try
            {
                var items = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(Model.Items);
                if (items.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    <table class="table table-sm table-striped">
                        <thead><tr><th>الموظف</th><th>من</th><th>إلى</th><th>التاريخ</th></tr></thead>
                        <tbody>
                        @foreach (var item in items.EnumerateArray())
                        {
                            <tr>
                                <td>@(item.TryGetProperty("EmployeeId", out var e) ? e.ToString() : "—")</td>
                                <td>@(item.TryGetProperty("From", out var f) ? f.ToString() : "—")</td>
                                <td>@(item.TryGetProperty("To", out var t) ? t.ToString() : "—")</td>
                                <td>@(item.TryGetProperty("Date", out var d) ? d.ToString() : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            }
            catch
            {
                <pre class="bg-light p-2">@Model.Items</pre>
            }
        }
    </div>
</div>
