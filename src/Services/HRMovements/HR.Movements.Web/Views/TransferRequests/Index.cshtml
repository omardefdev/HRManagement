@model IReadOnlyList<HR.Movements.Domain.Entities.TransferRequest>
@{ ViewData["Title"] = "طلبات النقل"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">طلبات النقل</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">طلب جديد</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>من</th><th>إلى</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td><span data-hr-employee-id="@x.EmployeeId">@x.EmployeeId</span></td>
                        <td><span data-hr-org-unit-id="@x.FromOrgUnitId">@x.FromOrgUnitId</span></td>
                        <td><span data-hr-org-unit-id="@x.ToOrgUnitId">@x.ToOrgUnitId</span></td>
                        <td>@x.Status</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5">@await Html.PartialAsync("_HrEmptyState", "لا توجد طلبات نقل")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
