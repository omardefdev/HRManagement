@model HR.Movements.Domain.Entities.TransferRequest
@{ ViewData["Title"] = "تعديل طلب النقل"; }
<div class="card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-control form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="FromOrgUnitId" class="form-label"></label><select asp-for="FromOrgUnitId" class="form-control form-select" data-hr-picker="org-unit" data-placeholder="ابحث عن وحدة تنظيمية..."><option value="">— اختر وحدة —</option></select><span asp-validation-for="FromOrgUnitId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="ToOrgUnitId" class="form-label"></label><select asp-for="ToOrgUnitId" class="form-control form-select" data-hr-picker="org-unit" data-placeholder="ابحث عن وحدة تنظيمية..."><option value="">— اختر وحدة —</option></select><span asp-validation-for="ToOrgUnitId" class="text-danger"></span></div>
            <div class="mb-3">
                <label class="form-label">مقدّم الطلب</label>
                <input class="form-control" value="@Model.RequestedBy" disabled />
                <div class="form-text">يُسجَّل مقدّم الطلب من هوية الجلسة ولا يُعدَّل.</div>
            </div>
            <div class="mb-3"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" class="form-control" rows="2"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div>
            <div class="mb-3">
                <label asp-for="SourceLegalRegimeId" class="form-label">نظام الخدمة الحالي</label>
                <input asp-for="SourceLegalRegimeId" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="TargetLegalRegimeId" class="form-label">نظام الخدمة الهدف (اختياري — للنقل بين أنظمة)</label>
                <input asp-for="TargetLegalRegimeId" class="form-control" placeholder="law50 / law53 / special_*" />
            </div>
            <div class="mb-3">
                <label asp-for="TransitionDecisionRef" class="form-label">مرجع القرار/المرسوم</label>
                <input asp-for="TransitionDecisionRef" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ConditionCode" class="form-label">رمز شرط الانتقال</label>
                <input asp-for="ConditionCode" class="form-control" placeholder="agency_reclassification" />
            </div>
            <div class="mb-3">
                <label asp-for="ConflictNotes" class="form-label">ملاحظات المادة 159 (اختياري)</label>
                <textarea asp-for="ConflictNotes" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">حفظ التعديلات</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">إلغاء</a></div>
    </form>
</div>
