@model HR.Movements.Domain.Entities.TransferRequest
@using HRManagement.SharedKernel.Enums
@{ ViewData["Title"] = "تفاصيل طلب النقل"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">طلب نقل</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        @if (TempData["Warning"] != null) { <div class="alert alert-warning">@TempData["Warning"]</div> }

        <table class="table table-borderless table-sm w-auto">
            <tr><th>الموظف</th><td>@Model.EmployeeId</td></tr>
            <tr><th>من</th><td>@Model.FromOrgUnitId</td></tr>
            <tr><th>إلى</th><td>@Model.ToOrgUnitId</td></tr>
            <tr><th>التاريخ</th><td>@Model.RequestDate</td></tr>
            <tr><th>الحالة</th><td><span class="badge bg-info">@Model.Status</span></td></tr>
            @if (!string.IsNullOrEmpty(Model.Reason)) { <tr><th>السبب</th><td>@Model.Reason</td></tr> }
        </table>

        @if (Model.Approvals.Any())
        {
            <h5 class="mt-3">سجل الموافقات</h5>
            <div class="timeline timeline-inverse">
            @foreach (var a in Model.Approvals)
            {
                <div class="d-flex align-items-start mb-2">
                    <i class="fas fa-check-circle text-success me-2 mt-1"></i>
                    <div>
                        <span class="fw-bold">@a.ApprovedAt.ToString("yyyy/MM/dd HH:mm")</span> — المعتمد: @a.ApprovedBy
                        @if (!string.IsNullOrEmpty(a.Notes)) { <span class="text-muted"> — @a.Notes</span> }
                    </div>
                </div>
            }
            </div>
        }

        @if (Model.FinancialImpacts.Any())
        {
            <h5 class="mt-3">الأثر المالي</h5>
            <table class="table table-sm table-bordered w-auto">
                <thead><tr><th>فرق الراتب</th><th>فرق البدلات</th><th>ملاحظات</th><th>تاريخ</th></tr></thead>
                <tbody>
                @foreach (var f in Model.FinancialImpacts)
                {
                    <tr><td>@f.SalaryChange</td><td>@f.AllowanceChange</td><td>@f.Notes</td><td>@f.CalculatedAt.ToString("yyyy/MM/dd")</td></tr>
                }
                </tbody>
            </table>
        }

        <div class="mt-3 d-flex flex-wrap gap-2">
            @if (Model.Status == ApprovalStatus.Pending)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
            }
        </div>

        @if (Model.Status == ApprovalStatus.Pending)
        {
            <div class="card card-body bg-light mt-3">
                <p class="mb-2 fw-bold">اعتماد أو رفض الطلب</p>
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline-flex flex-wrap gap-2 align-items-end mb-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">اعتماد</button>
                </form>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="flex-grow-1" style="min-width:12rem">
                        <label class="form-label small">سبب الرفض</label>
                        <input type="text" name="notes" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-outline-danger btn-sm">رفض</button>
                </form>
            </div>
        }

        @if (Model.Status == ApprovalStatus.Approved)
        {
            <div class="card card-body bg-light mt-3">
                <p class="mb-2 fw-bold">تنفيذ النقل</p>
                <form asp-action="Execute" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="form-label small">فرق الراتب (اختياري)</label>
                        <input type="number" step="0.01" name="salaryChange" class="form-control form-control-sm" placeholder="0.00" />
                    </div>
                    <div>
                        <label class="form-label small">فرق البدلات (اختياري)</label>
                        <input type="number" step="0.01" name="allowanceChange" class="form-control form-control-sm" placeholder="0.00" />
                    </div>
                    <div class="flex-grow-1" style="min-width:10rem">
                        <label class="form-label small">ملاحظات مالية</label>
                        <input type="text" name="financialNotes" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-success btn-sm">تنفيذ النقل ونشر الحدث</button>
                </form>
            </div>
        }

        @if (Model.Status == ApprovalStatus.Executed)
        {
            <p class="text-success mt-3"><i class="fas fa-check-double"></i> تم تنفيذ النقل في @Model.ExecutionRecords.FirstOrDefault()?.ExecutedAt.ToString("yyyy/MM/dd HH:mm")</p>
        }
    </div>
</div>
