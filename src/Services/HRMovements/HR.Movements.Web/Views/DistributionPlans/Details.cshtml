@model HR.Movements.Domain.Entities.DistributionPlan
@using HR.Movements.Domain.Enums
@{ ViewData["Title"] = "تفاصيل خطة التوزيع"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">خطة توزيع</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <table class="table table-borderless table-sm w-auto">
            <tr><th>الوحدة التنظيمية</th><td>@Model.OrgUnitId</td></tr>
            <tr><th>تاريخ النفاذ</th><td>@Model.EffectiveDate</td></tr>
            <tr><th>الحالة</th><td><span class="badge bg-info">@Model.Status</span></td></tr>
            <tr><th>أنشئ بواسطة</th><td>@(Model.CreatedBy?.ToString() ?? "—")</td></tr>
        </table>

        @if (!string.IsNullOrEmpty(Model.PlannedPositions))
        {
            <h5 class="mt-3">الأماكن المخطط لها</h5>
            <pre class="bg-light p-2">@Model.PlannedPositions</pre>
        }

        <div class="mt-3 d-flex flex-wrap gap-2">
            @if (Model.Status == DistributionPlanStatus.Draft)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm">اعتماد</button></form>
            }
        </div>
    </div>
</div>
