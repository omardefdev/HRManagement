@model Vendor
@{ ViewData["Title"] = "تفاصيل المورد"; }
<div class="card mb-3">
    <div class="card-header"><h3 class="mb-0">@Model.Name</h3></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">معلومات الاتصال</dt><dd class="col-sm-9">@(Model.ContactInfo ?? "—")</dd>
            <dt class="col-sm-3">الدولة</dt><dd class="col-sm-9">@(Model.Country ?? "—")</dd>
        </dl>
    </div>
</div>
<div class="btn-group mb-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
          data-hr-confirm="هل أنت متأكد من الحذف؟"
          data-hr-confirm-title="تأكيد الحذف"
          data-hr-confirm-variant="danger"
          data-hr-confirm-label="حذف">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">حذف</button></form>
</div>
<p><a asp-action="Index">العودة</a></p>
