@model IReadOnlyList<Admin.Logistics.Domain.Entities.Vendor>
@{ ViewData["Title"] = "الموردون"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">الموردون</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>الاسم</th><th>الاتصال</th><th>الدولة</th><th></th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.Name</td><td>@x.ContactInfo</td><td>@x.Country</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
