@model IReadOnlyList<Admin.Logistics.Domain.Entities.Asset>
@{ ViewData["Title"] = "الأصول والعهد"; }
<div class="card">
    <div class="card-header"><h3 class="card-title mb-0">الأصول</h3></div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead><tr><th>رقم العهدة</th><th>الاسم</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@x.Id">@x.TagNumber</a></td>
                        <td>@x.Name</td>
                        <td>@x.Status</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-secondary">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">لا أصول</td></tr> }
            </tbody>
        </table>
    </div>
</div>
