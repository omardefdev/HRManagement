@model IReadOnlyList<ReceiptRecord>
@{ ViewData["Title"] = "سجلات الاستلام"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">سجلات الاستلام</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> إضافة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>طلب التجهيز</th><th>تاريخ الاستلام</th><th>المواد</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@(x.SupplyOrder?.Items ?? "—")</td>
                        <td>@x.ReceivedAt?.ToString("yyyy/MM/dd")</td>
                        <td>@(x.ItemsReceived ?? "—")</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">لا سجلات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
