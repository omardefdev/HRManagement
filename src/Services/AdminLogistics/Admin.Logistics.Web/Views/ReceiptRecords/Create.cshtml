@model ReceiptRecord
@{ ViewData["Title"] = "إضافة سجل استلام"; var orders = (SelectList)ViewBag.Orders; }
<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3"><label asp-for="SupplyOrderId" class="form-label"></label><select asp-for="SupplyOrderId" asp-items="orders" class="form-control"><option value="">-- اختر --</option></select></div>
            <div class="mb-3"><label asp-for="ReceivedBy" class="form-label"></label><input asp-for="ReceivedBy" class="form-control" /></div>
            <div class="mb-3"><label asp-for="ReceivedAt" class="form-label"></label><input asp-for="ReceivedAt" class="form-control" type="datetime-local" /></div>
            <div class="mb-3"><label asp-for="ItemsReceived" class="form-label"></label><textarea asp-for="ItemsReceived" class="form-control" rows="3"></textarea></div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
