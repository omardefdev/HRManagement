@model IReadOnlyList<Admin.Logistics.Domain.Entities.AssetAssignment>
@{ ViewData["Title"] = "عهدة الأصول"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">العهدة</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>الأصل</th><th>الموظف</th><th>التسليم</th><th>الإعادة</th><th></th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.Asset?.TagNumber</td><td>@x.EmployeeId</td><td>@x.AssignedAt</td><td>@x.ReturnedAt</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
