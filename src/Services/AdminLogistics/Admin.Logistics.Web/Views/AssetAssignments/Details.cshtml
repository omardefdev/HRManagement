@model AssetAssignment
@using Admin.Logistics.Web.Services
@{
    ViewData["Title"] = "تفاصيل العهدة";
    var employeeName = ViewBag.EmployeeName as string ?? "غير متاح";
}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">عهدة أصل</h3>
        @if (Model.Status == AssetAssignmentStatus.Active)
        {
            <a asp-controller="Assets" asp-action="HandoverReceiptPdf" asp-route-assignmentId="@Model.Id" class="btn btn-sm btn-outline-primary">تحميل محضر</a>
        }
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">الأصل</dt><dd class="col-sm-9"><a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId">@Model.Asset?.TagNumber — @Model.Asset?.Name</a></dd>
            <dt class="col-sm-3">الموظف</dt>
            <dd class="col-sm-9">
                @if (employeeName != Model.EmployeeId.ToString() && HrLookupDisplayHelper.IsResolvedEmployeeName(employeeName))
                {
                    <span>@employeeName</span>
                }
                else
                {
                <span data-hr-employee-id="@Model.EmployeeId">@employeeName</span>
                }
            </dd>
            <dt class="col-sm-3">الحالة</dt><dd class="col-sm-9">@Html.HrEnumDisplay(Model.Status)</dd>
            <dt class="col-sm-3">تاريخ التسليم</dt><dd class="col-sm-9">@Model.AssignedAt.ToString("yyyy/MM/dd")</dd>
            <dt class="col-sm-3">تاريخ الإعادة المتوقع</dt><dd class="col-sm-9">@(Model.DueBackDate?.ToString("yyyy/MM/dd") ?? "—")</dd>
            <dt class="col-sm-3">الحالة عند التسليم</dt><dd class="col-sm-9">@AssetAssignmentDisplay.FormatHandoverCondition(Model)</dd>
            @if (!string.IsNullOrWhiteSpace(Model.ReturnNotes))
            {
                <dt class="col-sm-3">ملاحظات الإعادة</dt><dd class="col-sm-9">@AssetAssignmentDisplay.FormatReturnNotesHtml(Model.ReturnNotes)</dd>
            }
            <dt class="col-sm-3">تاريخ الإعادة</dt><dd class="col-sm-9">@(Model.ReturnedAt?.ToString("yyyy/MM/dd") ?? "لم تتم")</dd>
            <dt class="col-sm-3">الدليل</dt>
            <dd class="col-sm-9">@await Html.PartialAsync("_AssignmentEvidenceDisplay", new AssignmentEvidenceViewModel { Assignment = Model, Asset = Model.Asset })</dd>
        </dl>
    </div>
    <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            @if (Model.ReturnedAt is null && Model.Status != AssetAssignmentStatus.Rejected)
            {
                <p class="text-muted small mb-0">للاسترداد أو أي إجراء تشغيلي، استخدم صفحة الأصل.</p>
            }
        </div>
        <div class="btn-group">
            <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="btn btn-primary">فتح صفحة الأصل</a>
            <a asp-action="Index" class="btn btn-outline-secondary">العودة للقائمة</a>
        </div>
    </div>
</div>
