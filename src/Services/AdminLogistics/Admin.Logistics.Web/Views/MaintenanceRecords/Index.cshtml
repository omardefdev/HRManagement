@model IReadOnlyList<MaintenanceRecord>
@{ ViewData["Title"] = "سجلات الصيانة"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">سجلات الصيانة</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> إضافة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الأصل</th><th>النوع</th><th>التاريخ</th><th>التكلفة</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Asset?.TagNumber</td>
                        <td>@x.MaintenanceType</td>
                        <td>@x.PerformedAt?.ToString("yyyy/MM/dd")</td>
                        <td>@x.Cost</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">لا سجلات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
