@model HR.Health.Domain.Entities.HealthStatusEntry
@{ ViewData["Title"] = "تسجيل حالة صحية"; }
<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-control form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="EntryDate" class="form-label"></label><input asp-for="EntryDate" class="form-control" type="datetime-local" /><span asp-validation-for="EntryDate" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="StatusCode" class="form-label"></label><input asp-for="StatusCode" class="form-control" /><span asp-validation-for="StatusCode" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div>
    </form>
</div>
