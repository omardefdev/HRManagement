@model HR.Health.Domain.Entities.HealthStatusEntry
@{ ViewData["Title"] = "تفاصيل الحالة الصحية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">حالة صحية</h3>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">تعديل</a>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">الموظف</dt><dd class="col-sm-9">@Model.EmployeeId</dd>
            <dt class="col-sm-3">التاريخ</dt><dd class="col-sm-9">@Model.EntryDate.ToString("yyyy/MM/dd HH:mm")</dd>
            <dt class="col-sm-3">كود الحالة</dt><dd class="col-sm-9">@(Model.StatusCode ?? "—")</dd>
            <dt class="col-sm-3">ملاحظات</dt><dd class="col-sm-9">@(Model.Notes ?? "—")</dd>
        </dl>
    </div>
</div>
<p><a asp-action="Index">العودة للقائمة</a></p>
