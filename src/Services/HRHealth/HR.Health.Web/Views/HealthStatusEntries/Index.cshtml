@model IReadOnlyList<HR.Health.Domain.Entities.HealthStatusEntry>
@{ ViewData["Title"] = "تسجيلات الحالة الصحية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">تسجيلات الحالة الصحية</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">تسجيل جديد</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>التاريخ</th><th>الكود</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in Model) { <tr><td>@x.EmployeeId</td><td>@x.EntryDate.ToString("yyyy/MM/dd HH:mm")</td><td>@(x.StatusCode ?? "—")</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-info">تفاصيل</a></td></tr> }
            @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">لا توجد تسجيلات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
