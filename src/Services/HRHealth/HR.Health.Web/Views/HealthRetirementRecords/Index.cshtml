@model IReadOnlyList<HR.Health.Domain.Entities.HealthRetirementRecord>
@{ ViewData["Title"] = "التقاعد لأسباب صحية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">ملفات التقاعد الصحي</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">سجل جديد</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>تاريخ النفاذ</th><th>السبب</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in Model) { <tr><td><span data-hr-employee-id="@x.EmployeeId">جاري التحميل...</span></td><td>@x.EffectiveDate</td><td>@(x.Reason ?? "—")</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-info">تفاصيل</a></td></tr> }
            @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">لا توجد سجلات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
