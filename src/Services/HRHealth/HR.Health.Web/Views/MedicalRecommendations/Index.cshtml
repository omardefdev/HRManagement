@model IReadOnlyList<HR.Health.Domain.Entities.MedicalRecommendation>
@{ ViewData["Title"] = "التوصيات الطبية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">التوصيات الطبية</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">إضافة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>النوع</th><th>التاريخ</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.EmployeeId</td>
                        <td>@x.RecommendationType</td>
                        <td>@(x.IssuedAt?.ToString("yyyy/MM/dd") ?? "—")</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-info">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">لا بيانات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
