@model IReadOnlyList<HR.Health.Domain.Entities.InsuranceCard>
@{ ViewData["Title"] = "بطاقات التأمين الصحي"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">بطاقات التأمين</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">إضافة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>العضوية</th><th>الشركة</th><th>الانتهاء</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in Model) { <tr><td><span data-hr-employee-id="@x.EmployeeId">جاري التحميل...</span></td><td>@x.MemberNumber</td><td>@(x.Provider ?? "—")</td><td>@x.ExpiryDate</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-info">تفاصيل</a></td></tr> }
            @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">لا توجد بطاقات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
