@model HR.Health.Domain.Entities.MedicalRecord
@{ ViewData["Title"] = "تعديل الملف الطبي"; }
<div class="card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-control form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="MedicalHistory" class="form-label"></label><textarea asp-for="MedicalHistory" class="form-control" rows="2"></textarea><span asp-validation-for="MedicalHistory" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="CurrentConditions" class="form-label"></label><textarea asp-for="CurrentConditions" class="form-control" rows="2"></textarea><span asp-validation-for="CurrentConditions" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Allergies" class="form-label"></label><input asp-for="Allergies" class="form-control" /><span asp-validation-for="Allergies" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Disabilities" class="form-label"></label><input asp-for="Disabilities" class="form-control" /><span asp-validation-for="Disabilities" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="LastExamDate" class="form-label"></label><input asp-for="LastExamDate" class="form-control" type="date" /><span asp-validation-for="LastExamDate" class="text-danger"></span></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">إلغاء</a></div>
    </form>
</div>
