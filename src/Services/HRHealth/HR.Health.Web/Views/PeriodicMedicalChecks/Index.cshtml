@model IReadOnlyList<HR.Health.Domain.Entities.PeriodicMedicalCheck>
@{ ViewData["Title"] = "الفحوص الدورية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">الفحوص الطبية الدورية</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">تسجيل فحص</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الموظف</th><th>تاريخ الفحص</th><th>الفحص التالي</th><th>ملخص</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.EmployeeId</td>
                        <td>@x.CheckDate</td>
                        <td>@x.NextDue</td>
                        <td class="small">@x.Summary</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-info">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">لا سجلات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
