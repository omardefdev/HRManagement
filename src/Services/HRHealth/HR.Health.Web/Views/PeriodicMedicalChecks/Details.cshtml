@model HR.Health.Domain.Entities.PeriodicMedicalCheck
@{ ViewData["Title"] = "تفاصيل الفحص الدوري"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">فحص دوري</h3>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">تعديل</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('هل أنت متأكد؟')">حذف</button>
            </form>
        </div>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">الموظف</dt><dd class="col-sm-9">@Model.EmployeeId</dd>
            <dt class="col-sm-3">تاريخ الفحص</dt><dd class="col-sm-9">@Model.CheckDate</dd>
            <dt class="col-sm-3">الملخص</dt><dd class="col-sm-9">@(Model.Summary ?? "—")</dd>
            <dt class="col-sm-3">القياسات</dt><dd class="col-sm-9">@(Model.Vitals ?? "—")</dd>
            <dt class="col-sm-3">الفحص التالي</dt><dd class="col-sm-9">@(Model.NextDue?.ToString() ?? "—")</dd>
        </dl>
    </div>
</div>
<p><a asp-action="Index">العودة للقائمة</a></p>
