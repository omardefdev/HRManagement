@model HR.Health.Domain.Entities.PeriodicMedicalCheck
@{ ViewData["Title"] = "فحص دوري"; }
<div class="card">
    <div class="card-header"><h3 class="mb-0">فحص طبي دوري</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-control form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="CheckDate" class="form-label"></label><input asp-for="CheckDate" class="form-control" type="date" /><span asp-validation-for="CheckDate" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="NextDue" class="form-label"></label><input asp-for="NextDue" class="form-control" type="date" /><span asp-validation-for="NextDue" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" class="form-control"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Vitals" class="form-label"></label><textarea asp-for="Vitals" class="form-control"></textarea><span asp-validation-for="Vitals" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-link">إلغاء</a>
        </form>
    </div>
</div>
