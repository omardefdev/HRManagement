@model IReadOnlyList<Records.Archive.Domain.Entities.PhysicalFileRecord>
@{ ViewData["Title"] = "الملفات الورقية"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">ملفات ورقية</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>عنصر</th><th>صندوق</th><th>صفحات</th><th></th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@(x.ArchiveItem?.Title ?? "—")</td><td>@(x.BoxNumber ?? "—")</td><td>@(x.PageCount?.ToString() ?? "—")</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted">لا توجد</td></tr>}
</tbody></table></div></div>
