@model PhysicalFileRecord
@{ ViewData["Title"] = "تفاصيل الملف الورقي"; }
<div class="card mb-3">
    <div class="card-header"><h3 class="mb-0">ملف ورقي</h3></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">عنصر الأرشيف</dt><dd class="col-sm-9">@Model.ArchiveItem?.Title</dd>
            <dt class="col-sm-3">رقم الصندوق</dt><dd class="col-sm-9">@(Model.BoxNumber ?? "—")</dd>
            <dt class="col-sm-3">عدد الصفحات</dt><dd class="col-sm-9">@Model.PageCount</dd>
            <dt class="col-sm-3">الحالة</dt><dd class="col-sm-9">@(Model.Condition ?? "—")</dd>
        </dl>
    </div>
</div>
<div class="btn-group mb-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
</div>
<p><a asp-action="Index">العودة</a></p>
