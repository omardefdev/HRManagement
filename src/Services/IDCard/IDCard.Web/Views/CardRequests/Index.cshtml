@model IReadOnlyList<CardRequest>
@{ ViewData["Title"] = "طلبات البطاقات"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">طلبات البطاقات</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm" aria-label="إضافة"><i aria-hidden="true" class="fas fa-plus"></i></a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الموظف</th><th>التاريخ</th><th>الغرض</th><th>الحالة</th><th>تفاصيل</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td><span data-hr-employee-id="@x.EmployeeId">جاري التحميل...</span></td>
                        <td>@x.RequestDate.ToString("yyyy/MM/dd")</td>
                        <td>@Html.HrEnumDisplay(x.Purpose)</td>
                        <td>@Html.HrEnumDisplay(x.Status)</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td>
                        <td>
                            @if (IDCard.Domain.Services.CardIssuanceWorkflow.CanEdit(x.Status))
                            {
                                <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            }
                            @if (x.WorkflowInstanceId is Guid instanceId)
                            {
                                <a href="/ui/hr-core/WorkflowApprovals/Details/@instanceId" class="btn btn-outline-info btn-xs" aria-label="عرض الاعتماد"><i aria-hidden="true" class="fas fa-stamp"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا طلبات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
