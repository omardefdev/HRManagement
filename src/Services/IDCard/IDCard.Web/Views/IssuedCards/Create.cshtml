@model IssuedCardFormModel
@{ ViewData["Title"] = "إصدار بطاقة"; var designs = (SelectList)ViewBag.Designs; }
<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="CardDesignId" class="form-label"></label><select asp-for="CardDesignId" asp-items="designs" class="form-control"></select><span asp-validation-for="CardDesignId" class="text-danger"></span></div>
            <p class="text-muted small mb-3">الرقم التسلسلي يُولَّد عند الإصدار (COD-001).</p>
            <div class="mb-3"><label asp-for="IssuedAt" class="form-label"></label><input asp-for="IssuedAt" class="form-control" type="datetime-local" /></div>
            <div class="mb-3"><label asp-for="ExpiresAt" class="form-label"></label><input asp-for="ExpiresAt" class="form-control" type="date" /></div>
            <div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<CardStatus>()"></select></div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">إصدار ونشر الحدث</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
