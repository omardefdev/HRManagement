@model CardDesign
@{ ViewData["Title"] = "تصميم جديد"; }
<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
            <div class="mb-3"><label asp-for="Template" class="form-label"></label><input asp-for="Template" class="form-control" /></div>
            <div class="mb-3"><label asp-for="ValidityDays" class="form-label"></label><input asp-for="ValidityDays" class="form-control" type="number" /></div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
