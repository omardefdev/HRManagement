@model IReadOnlyList<IDCard.Domain.Entities.CardPermissionSet>
@{ ViewData["Title"] = "مجموعات صلاحيات البطاقات"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">المجموعات</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>الاسم</th><th>الصلاحيات</th><th>تفاصيل</th></tr></thead><tbody>
@foreach (var x in Model){ var p = x.Permissions; <tr><td>@x.Name</td><td>@(p != null && p.Length > 60 ? p[..60]+"…" : p)</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="3" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
