@model AccessPermission
@{ ViewData["Title"] = "تفاصيل صلاحية الدخول"; }
<div class="card mb-3">
    <div class="card-header"><h3 class="mb-0">@Model.Resource</h3></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">البطاقة</dt><dd class="col-sm-9">@Model.IssuedCard?.SerialNumber</dd>
            <dt class="col-sm-3">مستوى الوصول</dt><dd class="col-sm-9">@(Model.AccessLevel ?? "—")</dd>
            <dt class="col-sm-3">ساري من</dt><dd class="col-sm-9">@Model.ValidFrom</dd>
            <dt class="col-sm-3">ساري إلى</dt><dd class="col-sm-9">@Model.ValidTo</dd>
        </dl>
    </div>
</div>
<div class="btn-group mb-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger" onclick="return confirm('هل أنت متأكد؟')">حذف</button></form>
</div>
<p><a asp-action="Index">العودة</a></p>
