@model IReadOnlyList<IDCard.Domain.Entities.AccessPermission>
@{ ViewData["Title"] = "صلاحيات الدخول"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">صلاحيات الدخول</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>البطاقة</th><th>المورد</th><th>المستوى</th><th>من</th><th>إلى</th><th>تفاصيل</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.IssuedCardId</td><td>@x.Resource</td><td>@x.AccessLevel</td><td>@x.ValidFrom</td><td>@x.ValidTo</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
