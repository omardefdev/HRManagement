@model CandidatePortalLoginViewModel
@{
    ViewData["Title"] = "الدخول إلى طلباتي";
    Layout = "_PublicLayout";
    var refError = ViewData.ModelState[nameof(CandidatePortalLoginViewModel.ReferenceNumber)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var nidError = ViewData.ModelState[nameof(CandidatePortalLoginViewModel.NationalId)]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<h1 class="careers-page-title"><i class="fas fa-user-lock ms-2" aria-hidden="true"></i> الدخول إلى طلباتي</h1>
<div class="careers-card">
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 shadow-sm" role="alert" tabindex="-1" data-hr-error-summary aria-labelledby="portal-login-errors-title">
                <p class="fw-bold mb-1" id="portal-login-errors-title">يرجى تصحيح ما يلي:</p>
                <ul class="mb-0">
                    @if (refError is not null) { <li><a href="#portal-ref">@refError</a></li> }
                    @if (nidError is not null) { <li><a href="#portal-nid">@nidError</a></li> }
                </ul>
            </div>
        }
        <p class="text-muted" id="portal-login-help">أدخل الرقم المرجعي لطلبك ورقمك الوطني، وسنرسل رمز تحقق إلى وسيلة التواصل المسجلة في الطلب.</p>
        <form asp-action="Login" method="post" class="careers-form" aria-describedby="portal-login-help" novalidate>
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="portal-ref">الرقم المرجعي</label>
                    <input id="portal-ref" name="ReferenceNumber" class="form-control@(refError is null ? "" : " is-invalid")" maxlength="40"
                           value="@Model.ReferenceNumber" autocomplete="off" required aria-required="true"
                           aria-invalid="@(refError is null ? "false" : "true")" aria-describedby="@(refError is null ? null : "portal-ref-error")" />
                    @if (refError is not null) { <div class="invalid-feedback d-block" id="portal-ref-error">@refError</div> }
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="portal-nid">الرقم الوطني</label>
                    <input id="portal-nid" name="NationalId" class="form-control@(nidError is null ? "" : " is-invalid")" maxlength="20"
                           inputmode="numeric" autocomplete="off" required aria-required="true"
                           aria-invalid="@(nidError is null ? "false" : "true")" aria-describedby="@(nidError is null ? null : "portal-nid-error")" />
                    @if (nidError is not null) { <div class="invalid-feedback d-block" id="portal-nid-error">@nidError</div> }
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn careers-btn-primary w-100"><i class="fas fa-paper-plane ms-1" aria-hidden="true"></i> إرسال الرمز</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script src="~/js/careers-portal.js" asp-append-version="true"></script>
