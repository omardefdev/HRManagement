@model IReadOnlyList<HR.Core.Domain.Entities.EstablishmentChangeLog>
<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>التاريخ</th>
            <th>نوع التغيير</th>
            <th>المرجع القانوني</th>
            <th>مرجع القرار</th>
            <th>المنفّذ</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@Html.HrDateTime(log.OccurredAt)</td>
                <td>@Html.HrEnumDisplay(log.ChangeType)</td>
                <td>@Html.HrLegalName(log.LegalSourceId)</td>
                <td>@(log.DecisionReference ?? "—")</td>
                <td>@Html.HrUserName(log.ActorUserId)</td>
            </tr>
        }
    @if (!(Model).Any())
        {
            <tr><td colspan="5"><partial name="_HrEmptyState" model="@("لا توجد سجلات لعرضها.")" /></td></tr>
        }
    </tbody>
</table>
