@{
    Layout = "_HrSharedLayout";
    ViewData["CurrentModuleSlug"] = "hr-core";
}

@section SidebarItems {
    @if (HR.Core.Web.Services.ExamMarkerAccess.IsExamMarkerOnly(User))
    {
        @* HCM-031 (PLAN-31): the exam marker only reaches the anonymous marking screens (no module navigation). *@
        <li class="nav-header">تصحيح الامتحانات</li>
        <li class="nav-item"><a asp-controller="ExamMarking" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-pen-to-square"></i><p>جلسات التصحيح</p></a></li>
    }
    else if (HR.Core.Web.Services.RecruitmentAppealAccess.IsComplianceOnly(User))
    {
        @* HCM-028 (F5): the compliance reviewer only reaches the appeal pages and the work inbox. *@
        <li class="nav-header">نواة الموارد البشرية (HR.Core)</li>
        <li class="nav-item"><a asp-controller="WorkInbox" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-inbox"></i><p>صندوق العمل</p></a></li>
        <li class="nav-item"><a asp-controller="RecruitmentAppeals" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-gavel"></i><p>استئنافات التوظيف</p></a></li>
        @await Html.PartialAsync("_HrModuleNav")
    }
    else
    {
    <li class="nav-header">نواة الموارد البشرية (HR.Core)</li>

    <li class="nav-item">
        <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
            <i class="nav-icon fas fa-tachometer-alt"></i>
            <p>لوحة القيادة</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-controller="Employees" asp-action="Index" class="nav-link">
            <i class="nav-icon fas fa-users"></i>
            <p>الموظفون</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-controller="OrgUnits" asp-action="Index" class="nav-link">
            <i class="nav-icon fas fa-sitemap"></i>
            <p>الهيكل التنظيمي</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-controller="Evaluations" asp-action="Index" class="nav-link">
            <i class="nav-icon fas fa-star"></i>
            <p>تقييمات الأداء</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-controller="WorkInbox" asp-action="Index" class="nav-link">
            <i class="nav-icon fas fa-inbox"></i>
            <p>صندوق العمل</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-controller="StatusHistory" asp-action="Index" class="nav-link">
            <i class="nav-icon fas fa-history"></i>
            <p>سجل حالة التوظيف</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-controller="Reports" asp-action="Index" class="nav-link">
            <i class="nav-icon fas fa-file-export"></i>
            <p>التقارير والتصدير</p>
        </a>
    </li>

    <li class="nav-header">التخطيط والحضور والديوان</li>
    <li class="nav-item"><a asp-controller="HrStatisticReports" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-chart-pie"></i><p>التقارير الإحصائية</p></a></li>
    <li class="nav-item"><a asp-controller="DailyAttendanceRecords" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-calendar-check"></i><p>الحضور اليومي</p></a></li>
    <li class="nav-item"><a asp-controller="FieldInspectionVisits" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-clipboard-check"></i><p>التفتيش الميداني</p></a></li>
    <li class="nav-item"><a asp-controller="DiwanCorrespondences" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-envelope-open-text"></i><p>سجل الديوان</p></a></li>
    <li class="nav-item"><a asp-controller="RecruitmentApplications" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-user-plus"></i><p>التوظيف والاستقطاب</p></a></li>
    <li class="nav-item"><a asp-controller="RecruitmentRequisitions" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-file-signature"></i><p>طلبات الشاغر</p></a></li>
    <li class="nav-item"><a asp-controller="Competitions" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-users-rectangle"></i><p>مسابقات التوظيف</p></a></li>
    <li class="nav-item"><a asp-controller="RecruitmentReports" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-chart-line"></i><p>تقارير التوظيف</p></a></li>
    @if (HR.Core.Web.Services.ExamMarkerAccess.IsMarker(User))
    {
        <li class="nav-item"><a asp-controller="ExamMarking" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-pen-to-square"></i><p>تصحيح الامتحانات</p></a></li>
    }
    @if (User.IsInRole(HRManagement.ServiceDefaults.HrManagementRoles.Admin) || User.IsInRole(HRManagement.ServiceDefaults.HrManagementRoles.HrCore) || User.IsInRole(HRManagement.ServiceDefaults.HrManagementRoles.Compliance))
    {
        <li class="nav-item"><a asp-controller="RecruitmentAppeals" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-gavel"></i><p>استئنافات التوظيف</p></a></li>
    }

    <li class="nav-header">الملاك والمناصب (EST-001)</li>
    <li class="nav-item"><a asp-controller="JobCatalog" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-book"></i><p>دليل الوظائف</p></a></li>
    <li class="nav-item"><a asp-controller="FundedPositions" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-chair"></i><p>المناصب الممولة</p></a></li>
    <li class="nav-item"><a asp-controller="EstablishmentChanges" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-clipboard-check"></i><p>طلبات تغيير الملاك</p></a></li>
    <li class="nav-item"><a asp-controller="WorkforcePlans" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-project-diagram"></i><p>خطط القوى العاملة</p></a></li>
    <li class="nav-item"><a asp-controller="WorkforcePlans" asp-action="GapReport" class="nav-link"><i class="nav-icon fas fa-chart-bar"></i><p>تقرير فجوة الملاك</p></a></li>
    <li class="nav-item"><a asp-controller="EstablishmentFinance" asp-action="Reconciliation" class="nav-link"><i class="nav-icon fas fa-balance-scale"></i><p>مصالحة الموازنة</p></a></li>

    <li class="nav-header">المناوبات والورديات</li>
    <li class="nav-item"><a asp-controller="Shifts" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-clock"></i><p>تعريف الورديات</p></a></li>
    <li class="nav-item"><a asp-controller="Rosters" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-calendar-week"></i><p>جداول المناوبات</p></a></li>

    <li class="nav-header">التعاقب والمسارات الوظيفية</li>
    <li class="nav-item"><a asp-controller="CareerPaths" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-route"></i><p>المسارات الوظيفية</p></a></li>
    <li class="nav-item"><a asp-controller="KeyPositions" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-chess-king"></i><p>المناصب الحرجة</p></a></li>
    <li class="nav-item"><a asp-controller="SuccessionPlans" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-users-cog"></i><p>خطط التعاقب</p></a></li>

    <li class="nav-header">سوق المواهب الداخلي</li>
    <li class="nav-item"><a asp-controller="TalentMarketplace" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-bullhorn"></i><p>الشواغر الداخلية</p></a></li>

    <li class="nav-header">بوابة المواطن للتوظيف</li>
    <li class="nav-item"><a asp-controller="PublicJobPostings" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-globe"></i><p>الإعلانات وطلبات المواطنين</p></a></li>
    @if (User.IsInRole(HRManagement.ServiceDefaults.HrManagementRoles.Admin))
    {
        <li class="nav-item"><a asp-controller="CandidateLifecycle" asp-action="Index" class="nav-link"><i class="nav-icon fas fa-user-shield"></i><p>الاحتفاظ ببيانات المرشحين</p></a></li>
    }

    <li class="nav-header">الحوكمة</li>
    <li class="nav-item">
        <a asp-controller="PolicyTemplates" asp-action="Index" class="nav-link">
            <i class="nav-icon fas fa-balance-scale"></i>
            <p>محرك السياسات</p>
        </a>
    </li>
    <li class="nav-item">
        <a asp-controller="ReferenceCatalog" asp-action="Index" asp-route-kind="Grade" class="nav-link">
            <i class="nav-icon fas fa-database"></i>
            <p>المرجع الوطني (MDM)</p>
        </a>
    </li>

    @await Html.PartialAsync("_HrModuleNav")
    }
}

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

@RenderBody()
