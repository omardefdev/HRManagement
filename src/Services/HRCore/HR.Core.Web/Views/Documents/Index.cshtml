@model HR.Core.Web.ViewModels.DocumentsIndexViewModel

@{

    ViewData["Title"] = "المستندات";

    var employee = Model.Employee;

    string DocTypeAr(HRManagement.SharedKernel.Enums.DocumentType t) => t switch

    {

        HRManagement.SharedKernel.Enums.DocumentType.Certificate => "شهادة",

        HRManagement.SharedKernel.Enums.DocumentType.Photo => "صورة",

        HRManagement.SharedKernel.Enums.DocumentType.Fingerprint => "بصمة",

        HRManagement.SharedKernel.Enums.DocumentType.NationalId => "هوية وطنية",

        HRManagement.SharedKernel.Enums.DocumentType.Passport => "جواز سفر",

        _ => "أخرى"

    };

}



<div class="card">

    <div class="card-header">

        <h3 class="card-title"><i class="fas fa-file-alt"></i> مستندات الموظف: @employee.FullName</h3>

        <div class="card-tools">

            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createDocumentModal">

                <i class="fas fa-plus"></i> إضافة مستند

            </button>

        </div>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">
<table class="table table-striped table-hover mb-0">

            <thead>

                <tr>

                    <th>عنوان المستند</th>

                    <th>النوع</th>

                    <th>جهة الإصدار</th>

                    <th>تاريخ الإصدار</th>

                    <th>تاريخ الانتهاء</th>

                    <th>موثق</th>

                    <th>إجراءات</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var d in Model.Documents)

                {

                    <tr>

                        <td>@d.DocTitle</td>

                        <td>@DocTypeAr(d.DocType)</td>

                        <td>@(d.IssuedBy ?? "—")</td>

                        <td>@(d.IssueDate?.ToString("yyyy/MM/dd") ?? "—")</td>

                        <td>@(d.ExpiryDate?.ToString("yyyy/MM/dd") ?? "—")</td>

                        <td>@(d.Verified ? Html.Raw("<i class=\"fas fa-check text-success\"></i>") : Html.Raw("<i class=\"fas fa-times text-danger\"></i>"))</td>

                        <td>

                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>

                            <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = d.Id })" aria-label="حذف">

                                <i aria-hidden="true" class="fas fa-trash"></i>

                            </button>

                        </td>

                    </tr>

                }

                @if (!Model.Documents.Any())

                {

                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد مستندات</td></tr>

                }

            </tbody>

        </table>
</div>

    </div>

    <div class="card-footer">

        <a asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id" class="btn btn-secondary">

            <i class="fas fa-arrow-right"></i> العودة لملف الموظف

        </a>

    </div>

</div>



@await Html.PartialAsync("_CreateModal", Model.CreateModel)



@section Scripts {

    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            if (@Json.Serialize(Model.ShowCreateModal)) {

                bootstrap.Modal.getOrCreateInstance(

                    document.getElementById('createDocumentModal')).show();

            }



            var docModal = document.getElementById('createDocumentModal');

            if (docModal) {

                docModal.addEventListener('shown.bs.modal', function () {

                    var picker = docModal.querySelector('[data-hr-picker="employee"]');

                    if (picker && window.hrSharedUi) {

                        window.hrSharedUi.initEmployeePicker(picker);

                    }

                });

            }

        });

    </script>

}


