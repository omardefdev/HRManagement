@model HR.Core.Domain.Entities.PublicJobPosting
@{
    ViewData["Title"] = Model.Title;
    Layout = "_PublicLayout";
    var isLegacy = ViewBag.IsLegacyPosting as bool? == true;
    var intakeClosed = ViewBag.IntakeClosed as bool? == true;
    var applyModel = ViewBag.ApplyModel as HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel
        ?? new HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel { PublicJobPostingId = Model.Id };
    var qualifications = ViewBag.Qualifications as IReadOnlyList<HR.Core.Infrastructure.Services.Recruitment.QualificationOption> ?? [];
    var criteria = ViewBag.Criteria as HR.Core.Domain.Services.EligibilityCriteria;
    string QualificationName(string code) =>
        qualifications.FirstOrDefault(q => string.Equals(q.Code, code, StringComparison.OrdinalIgnoreCase))?.NameAr ?? code;
    // HCM-030 (D5): the requisition's closing date is authoritative; the posting copy is the fallback.
    var closingDate = Model.Requisition?.ApplicationClosingDate ?? Model.ClosingDate;
    var maxBirthDate = DateOnly.FromDateTime(DateTime.UtcNow).AddYears(-HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel.MinApplicantAge);
    // HCM-030 (E4/E5): required document types and attachment limits.
    var requiredDocuments = ViewBag.RequiredDocumentTypes as IReadOnlyList<string> ?? [];
    var documentLimits = ViewBag.DocumentLimits as HR.Core.Infrastructure.Services.Recruitment.RecruitmentCandidateDocumentsOptions
        ?? new HR.Core.Infrastructure.Services.Recruitment.RecruitmentCandidateDocumentsOptions();
    var perFileMb = Math.Min(documentLimits.MaxBytes, HRManagement.FileStorage.FileUploadConstraints.CandidateDocument.MaxBytes) / (1024 * 1024);
    var totalMb = documentLimits.MaxTotalBytes / (1024 * 1024);
    // Required types first, then the optional ones (one input each; certificates and «أخرى» accept several files).
    var documentInputs = HR.Core.Domain.Services.CandidateDocumentTypes.All
        .OrderBy(t => requiredDocuments.Contains(t.Code) ? 0 : 1)
        .ToList();
    // PLAN-30 K4: one error summary (focused by careers-portal.js) linking each error to its field; a field in error carries
    // aria-invalid and aria-describedby to its own message.
    var applyErrors = ViewData.ModelState
        .SelectMany(e => e.Value!.Errors.Select(x => (Key: e.Key, x.ErrorMessage)))
        .Where(e => !string.IsNullOrEmpty(e.ErrorMessage))
        .ToList();
    string? Err(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
    string Invalid(string key) => Err(key) is null ? "false" : "true";
    string InvalidClass(string key) => Err(key) is null ? "" : " is-invalid";
    var documentFieldIds = documentInputs.ToDictionary(
        t => HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel.FieldFor(t.Code), t => "apply-doc-" + t.Code.ToLowerInvariant());
    string? ApplyTarget(string key) => key switch
    {
        "FullName" => "apply-fullname",
        "NationalId" => "apply-nationalid",
        "Phone" => "apply-phone",
        "Email" => "apply-email",
        "EducationLevelCode" => "apply-education",
        "Specialization" => "apply-specialization",
        "GraduationYear" => "apply-graduation",
        "YearsOfExperience" => "apply-experience",
        "BirthDate" => "apply-birthdate",
        "PreferredChannel" => "apply-channel-email",
        "NotificationConsent" => "apply-notification-consent",
        "CoverNote" => "apply-cover",
        "PrivacyConsent" => "privacy-consent",
        _ => documentFieldIds.TryGetValue(key, out var inputId) ? inputId : null
    };
}
@if (isLegacy)
{
    <div class="alert alert-warning mb-3">إعلان قديم غير مرتبط بطلب شاغر — يُفضّل التقديم على الإعلانات المرتبطة بطلبات منشورة.</div>
}
<div class="careers-card mb-4">
    <div class="card-body">
        <h1 class="card-title careers-posting-title">@Model.Title</h1>
        <p class="card-subtitle mb-3">
            <i class="fas fa-building ms-1" aria-hidden="true"></i> @(Model.Entity ?? "—")
            @if (!string.IsNullOrWhiteSpace(Model.Location)) { <span>• <i class="fas fa-map-marker-alt ms-1" aria-hidden="true"></i> @Model.Location</span> }
        </p>
        @if (Model.Requisition is not null)
        {
            <p class="text-muted mb-2">
                <i class="fas fa-file-alt ms-1" aria-hidden="true"></i> طلب الشاغر: <strong>@Model.Requisition.RequisitionNumber</strong>
            </p>
        }
        @if (intakeClosed)
        {
            <p><span class="badge bg-secondary">التقديم مغلق</span></p>
        }
        @if (closingDate is DateOnly closing)
        {
            <p class="careers-accent"><i class="fas fa-clock ms-1" aria-hidden="true"></i> آخر موعد للتقديم: <bdi dir="ltr">@closing.ToString("dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture)</bdi></p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <h2 class="h6 mt-3 careers-section-title"><i class="fas fa-file-alt ms-1" aria-hidden="true"></i> الوصف</h2>
            <p class="text-muted">@Model.Description</p>
        }
        @if (criteria is { IsEmpty: false })
        {
            @* HCM-030 (D2): checked at intake as notes for the screening team — an application is never refused for them. *@
            <h2 class="h6 mt-3 careers-section-title"><i class="fas fa-clipboard-list ms-1" aria-hidden="true"></i> شروط التقديم</h2>
            <ul class="text-muted mb-2">
                @if (criteria.MinQualificationCode is { } minCode)
                {
                    <li>المؤهل العلمي: @QualificationName(minCode) أو أعلى</li>
                }
                @if (criteria.MinYearsOfExperience is decimal minYears)
                {
                    <li>الخبرة: @minYears.ToString("0.#") سنة على الأقل</li>
                }
                @if (criteria.MinAge is int minAge && criteria.MaxAge is int maxAge)
                {
                    <li>العمر عند التقديم: من @minAge إلى @maxAge سنة</li>
                }
                else if (criteria.MinAge is int onlyMin)
                {
                    <li>العمر عند التقديم: @onlyMin سنة على الأقل</li>
                }
                else if (criteria.MaxAge is int onlyMax)
                {
                    <li>العمر عند التقديم: @onlyMax سنة على الأكثر</li>
                }
            </ul>
        }
        @if (requiredDocuments.Count > 0)
        {
            @* HCM-030 (E4): a missing document is a note for the screening team, not a refusal. *@
            <h2 class="h6 mt-3 careers-section-title"><i class="fas fa-paperclip ms-1" aria-hidden="true"></i> المستندات المطلوبة</h2>
            <ul class="text-muted mb-2">
                @foreach (var type in requiredDocuments)
                {
                    <li>@HR.Core.Domain.Services.CandidateDocumentTypes.LabelAr(type)</li>
                }
            </ul>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Requirements))
        {
            <h2 class="h6 mt-3 careers-section-title"><i class="fas fa-list-check ms-1" aria-hidden="true"></i> الشروط والمؤهلات</h2>
            <p class="text-muted">@Model.Requirements</p>
        }
    </div>
</div>

@if (intakeClosed)
{
    <div class="alert alert-secondary">
        <i class="fas fa-lock ms-1" aria-hidden="true"></i> انتهت فترة التقديم على هذه الوظيفة. يمكنك متابعة طلب سابق من صفحة «تتبع الطلب».
        <a asp-action="Track" class="alert-link">تتبع الطلب</a>
    </div>
}
else
{
<div class="careers-card">
    <div class="card-body">
        <h2 class="h5 careers-section-title mb-4" id="apply-title"><i class="fas fa-paper-plane ms-2" aria-hidden="true"></i> تقديم طلب توظيف</h2>
        @if (applyErrors.Count > 0)
        {
            <div class="alert alert-danger border-0 shadow-sm" role="alert" tabindex="-1" data-hr-error-summary aria-labelledby="apply-errors-title">
                <p class="fw-bold mb-1" id="apply-errors-title">يرجى تصحيح ما يلي:</p>
                <ul class="mb-0">
                    @foreach (var (key, message) in applyErrors)
                    {
                        var target = ApplyTarget(key);
                        if (target is null)
                        {
                            <li>@message</li>
                        }
                        else
                        {
                            <li><a href="#@target">@message</a></li>
                        }
                    }
                </ul>
            </div>
        }
        <form asp-action="Apply" method="post" enctype="multipart/form-data" class="careers-form" aria-labelledby="apply-title">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PublicJobPostingId" value="@Model.Id" />
            <div class="visually-hidden" aria-hidden="true">
                <label for="website-hp">لا تملأ هذا الحقل</label>
                <input id="website-hp" name="Website" tabindex="-1" autocomplete="off" />
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="apply-fullname">الاسم الكامل</label>
                    <input id="apply-fullname" name="FullName" class="form-control@(InvalidClass("FullName"))" maxlength="300" autocomplete="name"
                           value="@applyModel.FullName" required aria-required="true" aria-invalid="@Invalid("FullName")"
                           aria-describedby="@(Err("FullName") is null ? null : "apply-fullname-error")" />
                    @if (Err("FullName") is { } fullNameError) { <div class="invalid-feedback d-block" id="apply-fullname-error">@fullNameError</div> }
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-nationalid">الرقم الوطني</label>
                    <input id="apply-nationalid" name="NationalId" class="form-control@(InvalidClass("NationalId"))" maxlength="20" inputmode="numeric"
                           autocomplete="off" value="@applyModel.NationalId" required aria-required="true" aria-invalid="@Invalid("NationalId")"
                           aria-describedby="@(Err("NationalId") is null ? null : "apply-nationalid-error")" />
                    @if (Err("NationalId") is { } nationalIdError) { <div class="invalid-feedback d-block" id="apply-nationalid-error">@nationalIdError</div> }
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-phone">رقم الهاتف</label>
                    <input id="apply-phone" name="Phone" type="tel" class="form-control@(InvalidClass("Phone"))" inputmode="tel" autocomplete="tel" maxlength="20"
                           value="@applyModel.Phone" aria-invalid="@Invalid("Phone")"
                           aria-describedby="apply-phone-help@(Err("Phone") is null ? "" : " apply-phone-error")" />
                    <small id="apply-phone-help" class="text-muted d-block">مثال: <bdi dir="ltr">0999123456</bdi> أو <bdi dir="ltr">+963999123456</bdi> — يلزم إدخال الهاتف أو البريد الإلكتروني</small>
                    @if (Err("Phone") is { } phoneError) { <div class="invalid-feedback d-block" id="apply-phone-error">@phoneError</div> }
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-email">البريد الإلكتروني</label>
                    <input id="apply-email" name="Email" type="email" class="form-control@(InvalidClass("Email"))" autocomplete="email" maxlength="150"
                           value="@applyModel.Email" aria-invalid="@Invalid("Email")"
                           aria-describedby="@(Err("Email") is null ? null : "apply-email-error")" />
                    @if (Err("Email") is { } emailError) { <div class="invalid-feedback d-block" id="apply-email-error">@emailError</div> }
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-education">المؤهل العلمي</label>
                    <select id="apply-education" name="EducationLevelCode" class="form-select@(InvalidClass("EducationLevelCode"))"
                            aria-invalid="@Invalid("EducationLevelCode")"
                            aria-describedby="@(Err("EducationLevelCode") is null ? null : "apply-education-error")">
                        <option value="">— اختر —</option>
                        @foreach (var q in qualifications)
                        {
                            <option value="@q.Code" selected="@(string.Equals(applyModel.EducationLevelCode, q.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@q.NameAr</option>
                        }
                    </select>
                    @if (Err("EducationLevelCode") is { } educationError) { <div class="invalid-feedback d-block" id="apply-education-error">@educationError</div> }
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-specialization">التخصص</label>
                    <input id="apply-specialization" name="Specialization" class="form-control@(InvalidClass("Specialization"))" maxlength="200"
                           value="@applyModel.Specialization" aria-invalid="@Invalid("Specialization")"
                           aria-describedby="@(Err("Specialization") is null ? null : "apply-specialization-error")" />
                    @if (Err("Specialization") is { } specializationError) { <div class="invalid-feedback d-block" id="apply-specialization-error">@specializationError</div> }
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="apply-graduation">سنة التخرج</label>
                    <input id="apply-graduation" name="GraduationYear" type="number" class="form-control@(InvalidClass("GraduationYear"))" inputmode="numeric"
                           min="@HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel.MinGraduationYear" max="@DateTime.UtcNow.Year" value="@applyModel.GraduationYear"
                           aria-invalid="@Invalid("GraduationYear")"
                           aria-describedby="@(Err("GraduationYear") is null ? null : "apply-graduation-error")" />
                    @if (Err("GraduationYear") is { } graduationError) { <div class="invalid-feedback d-block" id="apply-graduation-error">@graduationError</div> }
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="apply-experience">سنوات الخبرة</label>
                    <input id="apply-experience" name="YearsOfExperience" type="number" class="form-control@(InvalidClass("YearsOfExperience"))" min="0" max="60" step="0.5"
                           value="@applyModel.YearsOfExperience?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           aria-invalid="@Invalid("YearsOfExperience")"
                           aria-describedby="@(Err("YearsOfExperience") is null ? null : "apply-experience-error")" />
                    @if (Err("YearsOfExperience") is { } experienceError) { <div class="invalid-feedback d-block" id="apply-experience-error">@experienceError</div> }
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="apply-birthdate">تاريخ الميلاد</label>
                    <input id="apply-birthdate" name="BirthDate" type="date" class="form-control@(InvalidClass("BirthDate"))"
                           max="@maxBirthDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                           value="@applyModel.BirthDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                           aria-invalid="@Invalid("BirthDate")"
                           aria-describedby="apply-birthdate-help@(Err("BirthDate") is null ? "" : " apply-birthdate-error")" />
                    <small id="apply-birthdate-help" class="text-muted">يُستخدم للتحقق من شروط العمر فقط ولا يظهر إلا لفريق التوظيف.</small>
                    @if (Err("BirthDate") is { } birthDateError) { <div class="invalid-feedback d-block" id="apply-birthdate-error">@birthDateError</div> }
                </div>
                @if (!isLegacy)
                {
                    @* HCM-030 (E5): attachments, relayed to File.Storage (scanned) by HR.Core. *@
                    <fieldset class="col-12" aria-describedby="apply-documents-help">
                        <legend class="form-label fs-6 fw-bold">المستندات</legend>
                        <small id="apply-documents-help" class="text-muted d-block mb-2">
                            PDF أو JPG أو PNG، حتى @perFileMb ميغابايت للملف و@totalMb ميغابايت للمجموع، و@documentLimits.MaxFiles ملفات على الأكثر.
                            المستند المطلوب غير المرفق لا يمنع التقديم، لكنه يظهر ملاحظةً لفريق التوظيف.
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <strong>عند إعادة عرض النموذج يجب اختيار الملفات من جديد.</strong>
                            }
                        </small>
                        <div class="row g-3">
                            @foreach (var (code, label) in documentInputs)
                            {
                                var field = HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel.FieldFor(code);
                                var inputId = "apply-doc-" + code.ToLowerInvariant();
                                var isRequired = requiredDocuments.Contains(code);
                                var multiple = code is HR.Core.Domain.Services.CandidateDocumentTypes.Certificate
                                    or HR.Core.Domain.Services.CandidateDocumentTypes.Other;
                                var docError = Err(field);
                                <div class="col-md-6">
                                    <label class="form-label" for="@inputId">@label@(isRequired ? " (مطلوب)" : " (اختياري)")</label>
                                    <input id="@inputId" name="@field" type="file" class="form-control@(InvalidClass(field))" accept=".pdf,.jpg,.jpeg,.png"
                                           multiple="@(multiple ? "multiple" : null)" aria-invalid="@Invalid(field)"
                                           aria-describedby="apply-documents-help@(docError is null ? "" : $" {inputId}-error")" />
                                    @if (docError is not null) { <div class="invalid-feedback d-block" id="@inputId-error">@docError</div> }
                                </div>
                            }
                        </div>
                    </fieldset>
                }
                @if (!isLegacy)
                {
                    @* COM-030 (F2): status notifications only with consent, on the chosen channel. *@
                    var channel = applyModel.PreferredChannel;
                    <fieldset class="col-12" aria-describedby="apply-channel-help@(Err("PreferredChannel") is null ? "" : " apply-channel-error")">
                        <legend class="form-label fs-6 fw-bold">إشعارات حالة الطلب</legend>
                        <small id="apply-channel-help" class="text-muted d-block mb-2">
                            نرسل إليك إشعاراً عند كل مرحلة من طلبك (الاستلام، المقابلة، العرض، القرار) دون أي بيانات شخصية.
                        </small>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="PreferredChannel" id="apply-channel-email" value="Email" aria-invalid="@Invalid("PreferredChannel")"
                                   @(channel == HRManagement.SharedKernel.Notifications.NotificationChannel.Email ? "checked" : "") />
                            <label class="form-check-label" for="apply-channel-email">البريد الإلكتروني</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="PreferredChannel" id="apply-channel-sms" value="Sms" aria-invalid="@Invalid("PreferredChannel")"
                                   @(channel == HRManagement.SharedKernel.Notifications.NotificationChannel.Sms ? "checked" : "") />
                            <label class="form-check-label" for="apply-channel-sms">رسالة نصية</label>
                        </div>
                        @if (Err("PreferredChannel") is { } channelError) { <div class="invalid-feedback d-block" id="apply-channel-error">@channelError</div> }
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="apply-notification-consent" name="NotificationConsent" value="true"
                                   @(applyModel.NotificationConsent ? "checked" : "") />
                            <label class="form-check-label" for="apply-notification-consent">
                                @HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel.NotificationConsentText
                            </label>
                        </div>
                    </fieldset>
                }
                <div class="col-12">
                    <label class="form-label" for="apply-cover">نبذة / مسوّغات</label>
                    <textarea id="apply-cover" name="CoverNote" class="form-control@(InvalidClass("CoverNote"))" rows="3" aria-invalid="@Invalid("CoverNote")"
                              aria-describedby="@(Err("CoverNote") is null ? null : "apply-cover-error")">@applyModel.CoverNote</textarea>
                    @if (Err("CoverNote") is { } coverError) { <div class="invalid-feedback d-block" id="apply-cover-error">@coverError</div> }
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input@(InvalidClass("PrivacyConsent"))" type="checkbox" id="privacy-consent" name="PrivacyConsent" value="true"
                               required aria-required="true" aria-invalid="@Invalid("PrivacyConsent")"
                               aria-describedby="@(Err("PrivacyConsent") is null ? null : "privacy-consent-error")" @(applyModel.PrivacyConsent ? "checked" : "") />
                        <label class="form-check-label" for="privacy-consent">
                            أوافق على معالجة بياناتي لغرض التوظيف —
                            <a asp-action="Privacy" target="_blank">إشعار الخصوصية<span class="visually-hidden"> (يفتح في نافذة جديدة)</span></a>
                        </label>
                        @if (Err("PrivacyConsent") is { } privacyError) { <div class="invalid-feedback d-block" id="privacy-consent-error">@privacyError</div> }
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn careers-btn-primary"><i class="fas fa-paper-plane ms-1" aria-hidden="true"></i> إرسال الطلب</button>
                <a asp-action="Index" class="btn careers-btn-outline me-2">رجوع</a>
            </div>
        </form>
    </div>
</div>
<script src="~/js/careers-portal.js" asp-append-version="true"></script>
}
