@model HR.Core.Domain.Entities.PublicJobPosting
@{
    ViewData["Title"] = Model.Title;
    Layout = "_PublicLayout";
    var isLegacy = ViewBag.IsLegacyPosting as bool? == true;
    var intakeClosed = ViewBag.IntakeClosed as bool? == true;
    var applyModel = ViewBag.ApplyModel as HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel
        ?? new HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel { PublicJobPostingId = Model.Id };
    var qualifications = ViewBag.Qualifications as IReadOnlyList<HR.Core.Infrastructure.Services.Recruitment.QualificationOption> ?? [];
    var criteria = ViewBag.Criteria as HR.Core.Domain.Services.EligibilityCriteria;
    string QualificationName(string code) =>
        qualifications.FirstOrDefault(q => string.Equals(q.Code, code, StringComparison.OrdinalIgnoreCase))?.NameAr ?? code;
    // HCM-030 (D5): the requisition's closing date is authoritative; the posting copy is the fallback.
    var closingDate = Model.Requisition?.ApplicationClosingDate ?? Model.ClosingDate;
    var maxBirthDate = DateOnly.FromDateTime(DateTime.UtcNow).AddYears(-HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel.MinApplicantAge);
    // HCM-030 (E4/E5): required document types and attachment limits.
    var requiredDocuments = ViewBag.RequiredDocumentTypes as IReadOnlyList<string> ?? [];
    var documentLimits = ViewBag.DocumentLimits as HR.Core.Infrastructure.Services.Recruitment.RecruitmentCandidateDocumentsOptions
        ?? new HR.Core.Infrastructure.Services.Recruitment.RecruitmentCandidateDocumentsOptions();
    var perFileMb = Math.Min(documentLimits.MaxBytes, HRManagement.FileStorage.FileUploadConstraints.CandidateDocument.MaxBytes) / (1024 * 1024);
    var totalMb = documentLimits.MaxTotalBytes / (1024 * 1024);
    // Required types first, then the optional ones (one input each; certificates and «أخرى» accept several files).
    var documentInputs = HR.Core.Domain.Services.CandidateDocumentTypes.All
        .OrderBy(t => requiredDocuments.Contains(t.Code) ? 0 : 1)
        .ToList();
}
@if (isLegacy)
{
    <div class="alert alert-warning mb-3">إعلان قديم غير مرتبط بطلب شاغر — يُفضّل التقديم على الإعلانات المرتبطة بطلبات منشورة.</div>
}
<div class="careers-card mb-4">
    <div class="card-body">
        <h3 class="card-title" style="font-size:1.4rem;">@Model.Title</h3>
        <p class="card-subtitle mb-3">
            <i class="fas fa-building ms-1"></i> @(Model.Entity ?? "—")
            @if (!string.IsNullOrWhiteSpace(Model.Location)) { <span>• <i class="fas fa-map-marker-alt ms-1"></i> @Model.Location</span> }
        </p>
        @if (Model.Requisition is not null)
        {
            <p class="text-muted mb-2">
                <i class="fas fa-file-alt ms-1"></i> طلب الشاغر: <strong>@Model.Requisition.RequisitionNumber</strong>
            </p>
        }
        @if (intakeClosed)
        {
            <p><span class="badge bg-secondary">التقديم مغلق</span></p>
        }
        @if (closingDate is DateOnly closing)
        {
            <p style="color:#6b1f2a;"><i class="fas fa-clock ms-1"></i> آخر موعد للتقديم: @closing.ToString("dd-MM-yyyy")</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <h6 class="mt-3" style="color:#6b1f2a; font-weight:700;"><i class="fas fa-file-alt ms-1"></i> الوصف</h6>
            <p class="text-muted">@Model.Description</p>
        }
        @if (criteria is { IsEmpty: false })
        {
            @* HCM-030 (D2): checked at intake as notes for the screening team — an application is never refused for them. *@
            <h6 class="mt-3 careers-section-title"><i class="fas fa-clipboard-list ms-1"></i> شروط التقديم</h6>
            <ul class="text-muted mb-2">
                @if (criteria.MinQualificationCode is { } minCode)
                {
                    <li>المؤهل العلمي: @QualificationName(minCode) أو أعلى</li>
                }
                @if (criteria.MinYearsOfExperience is decimal minYears)
                {
                    <li>الخبرة: @minYears.ToString("0.#") سنة على الأقل</li>
                }
                @if (criteria.MinAge is int minAge && criteria.MaxAge is int maxAge)
                {
                    <li>العمر عند التقديم: من @minAge إلى @maxAge سنة</li>
                }
                else if (criteria.MinAge is int onlyMin)
                {
                    <li>العمر عند التقديم: @onlyMin سنة على الأقل</li>
                }
                else if (criteria.MaxAge is int onlyMax)
                {
                    <li>العمر عند التقديم: @onlyMax سنة على الأكثر</li>
                }
            </ul>
        }
        @if (requiredDocuments.Count > 0)
        {
            @* HCM-030 (E4): a missing document is a note for the screening team, not a refusal. *@
            <h6 class="mt-3 careers-section-title"><i class="fas fa-paperclip ms-1"></i> المستندات المطلوبة</h6>
            <ul class="text-muted mb-2">
                @foreach (var type in requiredDocuments)
                {
                    <li>@HR.Core.Domain.Services.CandidateDocumentTypes.LabelAr(type)</li>
                }
            </ul>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Requirements))
        {
            <h6 class="mt-3" style="color:#6b1f2a; font-weight:700;"><i class="fas fa-list-check ms-1"></i> الشروط والمؤهلات</h6>
            <p class="text-muted">@Model.Requirements</p>
        }
    </div>
</div>

@if (intakeClosed)
{
    <div class="alert alert-secondary">
        <i class="fas fa-lock ms-1"></i> انتهت فترة التقديم على هذه الوظيفة. يمكنك متابعة طلب سابق من صفحة «تتبع الطلب».
        <a asp-action="Track" class="alert-link">تتبع الطلب</a>
    </div>
}
else
{
<div class="careers-card">
    <div class="card-body">
        <h5 style="color:#6b1f2a; font-weight:700; margin-bottom:1.25rem;"><i class="fas fa-paper-plane ms-2"></i> تقديم طلب توظيف</h5>
        <form asp-action="Apply" method="post" enctype="multipart/form-data" class="careers-form" aria-label="نموذج تقديم طلب توظيف">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PublicJobPostingId" value="@Model.Id" />
            <div class="visually-hidden" aria-hidden="true">
                <label for="website-hp">لا تملأ هذا الحقل</label>
                <input id="website-hp" name="Website" tabindex="-1" autocomplete="off" />
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="apply-fullname">الاسم الكامل</label>
                    <input id="apply-fullname" name="FullName" class="form-control" value="@applyModel.FullName" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-nationalid">الرقم الوطني</label>
                    <input id="apply-nationalid" name="NationalId" class="form-control" value="@applyModel.NationalId" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-phone">رقم الهاتف</label>
                    <input id="apply-phone" name="Phone" class="form-control" value="@applyModel.Phone" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-email">البريد الإلكتروني</label>
                    <input id="apply-email" name="Email" type="email" class="form-control" value="@applyModel.Email" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-education">المؤهل العلمي</label>
                    <select id="apply-education" name="EducationLevelCode" class="form-select">
                        <option value="">— اختر —</option>
                        @foreach (var q in qualifications)
                        {
                            <option value="@q.Code" selected="@(string.Equals(applyModel.EducationLevelCode, q.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@q.NameAr</option>
                        }
                    </select>
                    @Html.ValidationMessage("EducationLevelCode", null, new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apply-specialization">التخصص</label>
                    <input id="apply-specialization" name="Specialization" class="form-control" maxlength="200" value="@applyModel.Specialization" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="apply-graduation">سنة التخرج</label>
                    <input id="apply-graduation" name="GraduationYear" type="number" class="form-control" inputmode="numeric"
                           min="@HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel.MinGraduationYear" max="@DateTime.UtcNow.Year" value="@applyModel.GraduationYear" />
                    @Html.ValidationMessage("GraduationYear", null, new { @class = "text-danger small" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="apply-experience">سنوات الخبرة</label>
                    <input id="apply-experience" name="YearsOfExperience" type="number" class="form-control" min="0" max="60" step="0.5"
                           value="@applyModel.YearsOfExperience?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    @Html.ValidationMessage("YearsOfExperience", null, new { @class = "text-danger small" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="apply-birthdate">تاريخ الميلاد</label>
                    <input id="apply-birthdate" name="BirthDate" type="date" class="form-control" max="@maxBirthDate.ToString("yyyy-MM-dd")"
                           value="@applyModel.BirthDate?.ToString("yyyy-MM-dd")" aria-describedby="apply-birthdate-help" />
                    <small id="apply-birthdate-help" class="text-muted">يُستخدم للتحقق من شروط العمر فقط ولا يظهر إلا لفريق التوظيف.</small>
                    @Html.ValidationMessage("BirthDate", null, new { @class = "text-danger small d-block" })
                </div>
                @if (!isLegacy)
                {
                    @* HCM-030 (E5): attachments, relayed to File.Storage (scanned) by HR.Core. *@
                    <fieldset class="col-12" aria-describedby="apply-documents-help">
                        <legend class="form-label fs-6 fw-bold">المستندات</legend>
                        <small id="apply-documents-help" class="text-muted d-block mb-2">
                            PDF أو JPG أو PNG، حتى @perFileMb ميغابايت للملف و@totalMb ميغابايت للمجموع، و@documentLimits.MaxFiles ملفات على الأكثر.
                            المستند المطلوب غير المرفق لا يمنع التقديم، لكنه يظهر ملاحظةً لفريق التوظيف.
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <strong>عند إعادة عرض النموذج يجب اختيار الملفات من جديد.</strong>
                            }
                        </small>
                        <div class="row g-3">
                            @foreach (var (code, label) in documentInputs)
                            {
                                var field = HR.Core.Web.ViewModels.CitizenApplicationApplyViewModel.FieldFor(code);
                                var inputId = "apply-doc-" + code.ToLowerInvariant();
                                var isRequired = requiredDocuments.Contains(code);
                                var multiple = code is HR.Core.Domain.Services.CandidateDocumentTypes.Certificate
                                    or HR.Core.Domain.Services.CandidateDocumentTypes.Other;
                                <div class="col-md-6">
                                    <label class="form-label" for="@inputId">@label@(isRequired ? " (مطلوب)" : " (اختياري)")</label>
                                    <input id="@inputId" name="@field" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                                           multiple="@(multiple ? "multiple" : null)" aria-describedby="apply-documents-help @inputId-error" />
                                    @Html.ValidationMessage(field, null, new { @class = "text-danger small d-block", id = inputId + "-error" })
                                </div>
                            }
                        </div>
                    </fieldset>
                }
                @* PLAN-30 S2: the notification channel consent. *@
                <div class="col-12">
                    <label class="form-label" for="apply-cover">نبذة / مسوّغات</label>
                    <textarea id="apply-cover" name="CoverNote" class="form-control" rows="3">@applyModel.CoverNote</textarea>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="privacy-consent" name="PrivacyConsent" value="true" required @(applyModel.PrivacyConsent ? "checked" : "") />
                        <label class="form-check-label" for="privacy-consent">
                            أوافق على معالجة بياناتي لغرض التوظيف —
                            <a asp-action="Privacy" target="_blank">إشعار الخصوصية</a>
                        </label>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn careers-btn-primary"><i class="fas fa-paper-plane ms-1"></i> إرسال الطلب</button>
                <a asp-action="Index" class="btn careers-btn-outline me-2">رجوع</a>
            </div>
        </form>
    </div>
</div>
}
