@model IReadOnlyList<HR.Core.Domain.Entities.PublicJobPosting>
@{
    ViewData["Title"] = "الوظائف المتاحة";
    Layout = "_PublicLayout";
}
<h1 class="careers-page-title"><i class="fas fa-briefcase ms-2" aria-hidden="true"></i> الوظائف الحكومية المتاحة</h1>
@if (!Model.Any())
{
    <div class="careers-card p-5 text-center">
        <i class="fas fa-inbox fa-3x mb-3 careers-muted-icon" aria-hidden="true"></i>
        <p class="text-muted fs-5">لا توجد إعلانات وظيفية منشورة حالياً.</p>
    </div>
}
<div class="row g-3">
    @foreach (var p in Model)
    {
        <div class="col-md-6">
            <div class="careers-card h-100">
                <div class="card-body">
                    <h2 class="card-title h5">@p.Title</h2>
                    <p class="card-subtitle mb-2">
                        <i class="fas fa-building ms-1" aria-hidden="true"></i> @(p.Entity ?? "—")
                        @if (!string.IsNullOrWhiteSpace(p.Location)) { <span>• <i class="fas fa-map-marker-alt ms-1" aria-hidden="true"></i> @p.Location</span> }
                    </p>
                    @if (p.ClosingDate != null)
                    {
                        <p class="small mb-2 careers-accent">
                            <i class="fas fa-clock ms-1" aria-hidden="true"></i> يُغلق التقديم في <bdi dir="ltr">@p.ClosingDate.Value.ToString("dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture)</bdi>
                        </p>
                    }
                    <p class="text-muted mb-3">@(p.Description?.Length > 140 ? p.Description[..140] + "…" : p.Description)</p>
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn careers-btn-primary btn-sm">
                        <i class="fas fa-arrow-left ms-1" aria-hidden="true"></i> التفاصيل والتقديم<span class="visually-hidden">: @p.Title</span>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
