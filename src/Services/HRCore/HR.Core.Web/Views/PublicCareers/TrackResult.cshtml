@using HR.Core.Domain.Enums
@using HR.Core.Domain.Services
@model HR.Core.Domain.Entities.CitizenApplication
@{
    ViewData["Title"] = "حالة الطلب";
    Layout = "_PublicLayout";
    // HCM-030 (PLAN-30 I): read-only lookup without a one-time code — the public status label only. The timeline,
    // interviews, offer terms and the candidate actions are on /careers/my (after the code).
    var publicView = ViewBag.PublicView as CandidatePublicView;
    string LegacyBadge(CitizenApplicationStatus s) => s switch
    {
        CitizenApplicationStatus.Accepted => "bg-success",
        CitizenApplicationStatus.Rejected => "bg-danger",
        CitizenApplicationStatus.Shortlisted => "bg-info text-dark",
        CitizenApplicationStatus.UnderReview => "bg-warning text-dark",
        _ => "bg-secondary"
    };
    string StatusLabel(CitizenApplicationStatus s) => s switch
    {
        CitizenApplicationStatus.Accepted => "مقبول",
        CitizenApplicationStatus.Rejected => "مرفوض",
        CitizenApplicationStatus.Shortlisted => "في القائمة المختصرة",
        CitizenApplicationStatus.UnderReview => "قيد المراجعة",
        CitizenApplicationStatus.Received => "مستلَم",
        _ => s.ToString()
    };
    string PublicBadge(string code) => code switch
    {
        CandidatePublicStatusProjection.Codes.Accepted => "bg-success",
        CandidatePublicStatusProjection.Codes.NotAccepted => "bg-danger",
        CandidatePublicStatusProjection.Codes.OfferPending => "bg-primary",
        CandidatePublicStatusProjection.Codes.InterviewInvited => "bg-info text-dark",
        CandidatePublicStatusProjection.Codes.OfferClosed or CandidatePublicStatusProjection.Codes.Withdrawn => "bg-secondary",
        CandidatePublicStatusProjection.Codes.ReserveListed => "bg-dark",
        _ => "bg-warning text-dark"
    };
}
<h1 class="careers-page-title"><i class="fas fa-clipboard-check ms-2" aria-hidden="true"></i> حالة الطلب</h1>
<section class="careers-card" aria-label="حالة الطلب">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">الرقم المرجعي</dt>
            <dd class="col-sm-9"><bdi dir="ltr">@Model.ReferenceNumber</bdi></dd>
            <dt class="col-sm-3">الحالة</dt>
            <dd class="col-sm-9 mb-0" role="status">
                @if (publicView is not null)
                {
                    <span class="badge rounded-pill px-3 py-2 @PublicBadge(publicView.Code)">@publicView.LabelAr</span>
                }
                else
                {
                    <span class="badge rounded-pill px-3 py-2 @LegacyBadge(Model.Status)">@StatusLabel(Model.Status)</span>
                }
            </dd>
        </dl>
        <div class="alert alert-info mb-0 mt-3">
            <i class="fas fa-info-circle ms-1" aria-hidden="true"></i>
            لعرض مسار الطلب ومواعيد المقابلات والعرض والرد عليه أو الاستئناف أو الانسحاب، ادخل إلى
            <a asp-controller="CandidatePortal" asp-action="Login">طلبي</a> برمز تحقق يُرسل إلى وسيلة التواصل المسجلة في الطلب.
        </div>
    </div>
</section>
<div class="mt-3">
    <a asp-action="Track" class="btn careers-btn-outline"><i class="fas fa-search ms-1" aria-hidden="true"></i> تتبّع طلب آخر</a>
</div>
