@{
    ViewData["Title"] = "تتبّع الطلب";
    Layout = "_PublicLayout";
    // PLAN-30 K4: the neutral not-found message is the error summary (focused by careers-portal.js) and describes both fields.
    var notFound = ViewBag.NotFound == true;
}
<h1 class="careers-page-title"><i class="fas fa-search ms-2" aria-hidden="true"></i> تتبّع حالة طلب التوظيف</h1>
<div class="careers-card">
    <div class="card-body">
        @if (notFound)
        {
            <div class="alert alert-warning border-0 shadow-sm mb-3" id="track-not-found" role="alert" tabindex="-1" data-hr-error-summary>
                <i class="fas fa-exclamation-circle ms-1" aria-hidden="true"></i> لم يُعثر على طلب مطابق للرقم المرجعي والرقم الوطني.
            </div>
        }
        <form asp-action="Track" method="post" class="careers-form" aria-label="نموذج تتبع طلب التوظيف">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="track-ref">الرقم المرجعي</label>
                    <input id="track-ref" name="referenceNumber" class="form-control" placeholder="مثلاً: REF-20260612-ABC123" maxlength="40"
                           autocomplete="off" required aria-required="true" aria-describedby="@(notFound ? "track-not-found" : null)" />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="track-nid">الرقم الوطني</label>
                    <input id="track-nid" name="nationalId" class="form-control" maxlength="20" inputmode="numeric" autocomplete="off"
                           required aria-required="true" aria-describedby="@(notFound ? "track-not-found" : null)" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn careers-btn-primary w-100"><i class="fas fa-search ms-1" aria-hidden="true"></i> تتبّع</button>
                </div>
            </div>
        </form>
    </div>
</div>
<script src="~/js/careers-portal.js" asp-append-version="true"></script>
