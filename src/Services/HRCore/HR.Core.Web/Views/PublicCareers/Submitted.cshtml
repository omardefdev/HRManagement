@{
    ViewData["Title"] = "تم استلام الطلب";
    Layout = "_PublicLayout";
}
<div class="careers-card text-center">
    <div class="card-body p-5">
        <i class="fas fa-check-circle fa-3x mb-3 careers-success" aria-hidden="true"></i>
        <h1 class="h3 careers-success fw-bold mb-3">تم استلام طلبك بنجاح</h1>
        <p class="text-muted fs-5">احتفظ بالرقم المرجعي التالي لتتبّع حالة طلبك:</p>
        <p class="h2 my-3"><span class="careers-badge"><bdi dir="ltr">@ViewBag.Reference</bdi></span></p>
        <div class="mt-4">
            <a asp-action="Track" class="btn careers-btn-primary"><i class="fas fa-search ms-1" aria-hidden="true"></i> تتبّع الطلب</a>
            <a asp-action="Index" class="btn careers-btn-outline me-2">العودة للوظائف</a>
        </div>
    </div>
</div>
