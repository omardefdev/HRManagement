@model HR.Core.Web.ViewModels.ReferenceCatalogFormViewModel
@{ ViewData["Title"] = $"إضافة {Model.KindLabel}"; }
<div class="card">
    <div class="card-header"><h3 class="mb-0">إضافة @Model.KindLabel</h3></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Kind" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control" placeholder="مثل GR-16 أو JC-HR" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NameAr" class="form-label"></label>
                    <input asp-for="NameAr" class="form-control" />
                    <span asp-validation-for="NameAr" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NameEn" class="form-label"></label>
                    <input asp-for="NameEn" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ValidFrom" class="form-label"></label>
                    <input asp-for="ValidFrom" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ValidTo" class="form-label"></label>
                    <input asp-for="ValidTo" class="form-control" type="date" />
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-link">إلغاء</a>
        </div>
    </form>
</div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
