@model HR.Core.Web.ViewModels.InternalVacancyEditViewModel
@{ ViewData["Title"] = "تعديل شاغر داخلي"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">تعديل شاغر داخلي</h3>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
              data-hr-confirm="تأكيد الحذف؟"
              data-hr-confirm-title="تأكيد الحذف"
              data-hr-confirm-variant="danger"
              data-hr-confirm-label="حذف">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">حذف</button>
        </form>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="OrgUnitId" class="form-label"></label><select asp-for="OrgUnitId" asp-items="ViewBag.OrgUnits" class="form-control"><option value="">— بدون —</option></select><span asp-validation-for="OrgUnitId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="RequiredQualifications" class="form-label"></label><textarea asp-for="RequiredQualifications" class="form-control"></textarea><span asp-validation-for="RequiredQualifications" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="ClosingDate" class="form-label"></label><input asp-for="ClosingDate" class="form-control" type="date" /><span asp-validation-for="ClosingDate" class="text-danger"></span></div>
            <div class="form-check mb-2"><input asp-for="IsOpen" class="form-check-input" /><label class="form-check-label" asp-for="IsOpen">مفتوح للترشّح</label></div>
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-link">إلغاء</a>
        </form>
    </div>
</div>
