@model HR.Core.Web.ViewModels.ExamMarkingSessionViewModel
@using System.Globalization
@using HR.Core.Domain.Enums
@{ ViewData["Title"] = $"تصحيح — {Model.SessionTitle}"; }

@if (TempData["Success"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger" role="alert">@err</div> }

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">@Model.SessionTitle — @Html.HrEnumDisplay(Model.Role)</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">رجوع</a>
    </div>
    <div class="card-body">
        @if (Model.Locked)
        {
            <div class="alert alert-info">أُغلق التصحيح لهذه الجلسة؛ العلامات مقفلة.</div>
        }
        @if (Model.Role == ExamMarkerRole.Reconciler)
        {
            <p class="text-muted small">تظهر هنا فقط الدفاتر التي تجاوز فيها الفرق بين المصححَين الأول والثاني عتبة المسابقة.</p>
        }
        else
        {
            <p class="text-muted small">التصحيح مُغفَل ومستقل: لا تظهر علامة أي مصحح آخر.</p>
        }
        @if (Model.Papers.Count == 0)
        {
            <p class="text-muted mb-0">لا توجد دفاتر.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th scope="col">الرقم الامتحاني</th><th scope="col">علامتك</th><th scope="col"><span class="visually-hidden">إجراء</span></th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Papers)
                        {
                            <tr>
                                <td><bdi dir="ltr">@p.ExamNumber</bdi></td>
                                <td>@(p.OwnMark?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td>
                                    @if (!Model.Locked)
                                    {
                                        <a asp-action="Paper" asp-route-id="@p.ExamCandidateId" asp-route-sessionId="@Model.SessionId" class="btn btn-outline-primary btn-sm">@(p.OwnMark is null ? "رصد العلامة" : "تعديل العلامة")</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
