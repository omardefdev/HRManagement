@model IEnumerable<HR.Core.Domain.Entities.Policy.PolicyEnforcementLedger>
@using HRManagement.SharedKernel.Policy
@{ ViewData["Title"] = "سجل تطبيق السياسات"; }
<div class="card">
    <div class="card-header"><h3 class="mb-0">سجل تطبيق السياسات</h3></div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <partial name="_HrEmptyState" model="@("لا قرارات مسجّلة في سجل التطبيق بعد.")" />
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>الوقت</th><th>المجال</th><th>الإجراء</th><th>الوضع</th><th>المسار</th><th>بصمة الحقائق</th></tr></thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td>@Html.HrDateTime(x.OccurredAt)</td>
                            <td>@PolicyVocabularyAr.DomainName(x.Domain) <span class="hr-internal-code">@x.Domain</span></td>
                            <td>@PolicyVocabularyAr.Action(x.Action)</td>
                            <td>@Html.HrEnumDisplay(x.Mode)</td>
                            <td>@(x.WorkflowInstanceId?.ToString() ?? "—")</td>
                            <td><code class="small" dir="ltr" title="بصمة تقنية للحقائق التي قُرّر عليها">@x.FactsHash</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
<p><a asp-action="Index">العودة</a></p>
