@using HR.Core.Domain.Entities.Policy
@using HRManagement.SharedKernel.Policy
@model PolicyTemplate
@{
    ViewData["Title"] = Model.Name;
    // PLAN-49: nothing is drafted in a domain the catalog puts out of scope; the page shows its history and says why.
    var governed = PolicyDomainCatalog.IsGoverned(Model.Domain);
    var canAuthor = ViewBag.CanAuthor is true && governed;
    var inherited = ViewBag.Inherited is true;
    var effectiveId = ViewBag.EffectiveVersionId as Guid?;
    var hasDraft = Model.Versions.Any(v => v.Status == PolicyVersionStatus.Draft);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">
            @Model.Name
            @if (inherited)
            {
                <span class="badge bg-secondary ms-1" data-testid="badge-inherited">وطني (موروث — للقراءة)</span>
            }
            else if (Model.Scope == PolicyTemplateScope.TenantOverride)
            {
                <span class="badge bg-info text-dark ms-1" data-testid="badge-override">تجاوز الجهة</span>
            }
        </h3>
        @if (canAuthor && !hasDraft)
        {
            <form asp-action="CreateTemplateDraft" method="post" class="mb-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="templateId" value="@Model.Id" />
                <button type="submit" class="btn btn-sm btn-warning">إنشاء مسودة (نسخة من النافذ)</button>
            </form>
        }
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">المجال</dt><dd class="col-sm-9">@PolicyVocabularyAr.DomainName(Model.Domain) <span class="hr-internal-code">@Model.Domain</span></dd>
            <dt class="col-sm-3">نوع السجل</dt><dd class="col-sm-9">@Html.HrEntityTypeDisplay(Model.SubjectType)</dd>
            <dt class="col-sm-3">النطاق</dt><dd class="col-sm-9">@Html.HrEnumDisplay(Model.Scope)</dd>
        </dl>
        @if (!governed)
        {
            <p class="alert alert-secondary small mt-2 mb-0" data-testid="out-of-scope-note">
                @PolicyDomainCatalog.OutOfScopeMessageAr: @Html.HrTextWithCodes(PolicyDomainCatalog.Find(Model.Domain)?.OutOfScopeReasonAr)
                @if (Model.RetiredAt is { } retiredAt)
                {
                    <span data-testid="retired-note">سُحب القالب بإصدار أخير بلا قواعد في @Html.HrDate(retiredAt). الإصدارات السابقة باقية كما هي للسجل.</span>
                }
            </p>
        }
        @if (inherited)
        {
            <p class="text-muted small mt-2 mb-0" data-testid="inherited-note">
                سياسة وطنية تسري على الجهة كما هي. تضيف الجهة قيوداً أشد فقط بمسودة «تجاوز الجهة» للمجال نفسه (D-POL-4).
            </p>
        }
    </div>
</div>
@foreach (var v in Model.Versions.OrderByDescending(x => x.VersionNumber))
{
    var publication = v.Publications.OrderByDescending(p => p.PublishedAt).FirstOrDefault();
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between">
            <span>
                إصدار @v.VersionNumber — @Html.HrEnumDisplay(v.Status)
                @if (v.Id == effectiveId)
                {
                    <span class="badge bg-success ms-1">النافذ الآن</span>
                }
                @if (v.EffectiveFrom is DateTime from)
                {
                    <small class="text-muted ms-2">ينفذ من @Html.HrDateTime(from) إلى @Html.HrDateTime(v.EffectiveTo, "…")</small>
                }
            </span>
            <span>
                @if (v.Status == PolicyVersionStatus.Draft && !inherited)
                {
                    <a asp-action="EditRules" asp-route-versionId="@v.Id" class="btn btn-sm btn-warning me-1">@(canAuthor ? "تحرير" : "مراجعة ونشر")</a>
                }
                <a asp-action="Simulate" asp-route-versionId="@v.Id" class="btn btn-sm btn-primary">محاكاة</a>
            </span>
        </div>
        @if (publication is not null)
        {
            <div class="card-body border-bottom small">
                النوع: <strong>@Html.HrEnumDisplay(publication.Kind)</strong>
                · المحرّر: @(publication.MakerUserId is null ? Html.HrUserName(publication.Kind == PolicyPublicationKind.SystemSeed ? "system" : publication.MakerRole) : Html.HrUserName(publication.MakerUserId))
                · الناشر: @(publication.CheckerUserId is null ? Html.HrUserName(publication.Kind == PolicyPublicationKind.SystemSeed ? "system" : publication.CheckerRole) : Html.HrUserName(publication.CheckerUserId))
                · الدليل: @Html.HrTextWithCodes(publication.EvidenceRef)
                · النشر: @Html.HrDateTime(publication.PublishedAt)
                @if (publication.RolledBackFromVersionId is Guid rolledBack)
                {
                    var target = Model.Versions.FirstOrDefault(x => x.Id == rolledBack);
                    <span>· تراجع عن الإصدار @(target?.VersionNumber.ToString(inv) ?? rolledBack.ToString())</span>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(v.ChangeReason))
        {
            <div class="card-body border-bottom small">السبب: @Html.HrTextWithCodes(v.ChangeReason)</div>
        }
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>القاعدة</th><th>الأولوية</th><th>الشرط</th><th>الأثر</th></tr></thead>
                <tbody>
                    @foreach (var r in v.Rules.OrderBy(x => x.Priority).ThenBy(x => x.RuleKey))
                    {
                        <tr>
                            <td>@(r.Name ?? r.RuleKey) <small class="text-muted">@r.RuleKey</small></td>
                            <td>@r.Priority</td>
                            <td><code class="small" dir="ltr">@r.WhenJson</code></td>
                            <td><code class="small" dir="ltr">@r.ThenJson</code></td>
                        </tr>
                    }
                @if (!(v.Rules.OrderBy(x => x.Priority).ThenBy(x => x.RuleKey)).Any())
                    {
                        <tr><td colspan="4"><partial name="_HrEmptyState" model="@("لا قواعد في هذا الإصدار.")" /></td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (canAuthor && !hasDraft && v.Status == PolicyVersionStatus.Published && v.Id != effectiveId)
        {
            <div class="card-footer">
                <form asp-action="CreateRollbackDraft" method="post" class="row g-2 align-items-end mb-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="templateId" value="@Model.Id" />
                    <input type="hidden" name="targetVersionId" value="@v.Id" />
                    <div class="col-md-8"><input name="reason" class="form-control form-control-sm" placeholder="سبب التراجع (إلزامي)" required maxlength="1000" /></div>
                    <div class="col-md-4"><button type="submit" class="btn btn-sm btn-outline-warning">إنشاء مسودة تراجع إلى هذا الإصدار</button></div>
                </form>
            </div>
        }
    </div>
}
<p><a asp-action="Index">العودة</a></p>
