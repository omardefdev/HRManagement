@model HR.Core.Domain.Entities.Policy.PolicyTemplateVersion
@{ ViewData["Title"] = "تحرير قواعد — " + Model.PolicyTemplate.Domain; }
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between">
        <span>مسودة إصدار @Model.VersionNumber — @Model.PolicyTemplate.Name</span>
        <a asp-action="Simulate" asp-route-versionId="@Model.Id" class="btn btn-sm btn-outline-primary">محاكاة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead><tr><th>Rule</th><th>Priority</th><th>When</th><th>Then</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Rules.OrderBy(x => x.Priority))
                {
                    <tr>
                        <td>@(r.Name ?? r.RuleKey)</td>
                        <td>@r.Priority</td>
                        <td><code class="small">@r.WhenJson</code></td>
                        <td><code class="small">@r.ThenJson</code></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">إضافة قاعدة</div>
    <div class="card-body">
        <form asp-action="AddRule" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="versionId" value="@Model.Id" />
            <div class="row g-2">
                <div class="col-md-2"><input name="ruleKey" class="form-control form-control-sm" placeholder="RuleKey" required /></div>
                <div class="col-md-2"><input name="name" class="form-control form-control-sm" placeholder="الاسم" /></div>
                <div class="col-md-1"><input name="priority" type="number" class="form-control form-control-sm" value="100" /></div>
                <div class="col-md-3"><textarea name="whenJson" class="form-control form-control-sm" rows="2" placeholder='{"all":[...]}' required></textarea></div>
                <div class="col-md-3"><textarea name="thenJson" class="form-control form-control-sm" rows="2" placeholder='[{"effect":"Allow"}]' required></textarea></div>
                <div class="col-md-1"><button type="submit" class="btn btn-sm btn-primary">إضافة</button></div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">نشر (four-eyes)</div>
    <div class="card-body">
        <form asp-action="PublishFromUi" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="versionId" value="@Model.Id" />
            <div class="col-md-4">
                <label class="form-label">EvidenceRef</label>
                <input name="evidenceRef" class="form-control form-control-sm" placeholder="POL-EV-001" />
            </div>
            <div class="col-md-3 form-check">
                <input type="checkbox" name="forceSameActorForLab" value="true" class="form-check-input" id="forceLab" />
                <label class="form-check-label" for="forceLab">Lab: نفس المحرّر</label>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-success btn-sm">نشر</button></div>
        </form>
    </div>
</div>
<p class="mt-3"><a asp-action="Details" asp-route-id="@Model.PolicyTemplateId">العودة</a></p>
