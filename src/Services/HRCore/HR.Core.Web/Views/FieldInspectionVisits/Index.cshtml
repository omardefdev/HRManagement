@model IReadOnlyList<HR.Core.Domain.Entities.FieldInspectionVisit>
@{ ViewData["Title"] = "التفتيش الميداني"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">الزيارات</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>العنوان</th><th>الموقع</th><th>التاريخ</th><th>الحالة</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.Title</td><td>@x.Location</td><td>@x.VisitDate</td><td>@x.Status</td></tr>}
@if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
