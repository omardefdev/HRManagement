@model HR.Core.Web.ViewModels.FinanceImportViewModel
@{ ViewData["Title"] = "استيراد موازنة (Stub)"; }
<div class="card">
    <div class="card-header"><h3 class="mb-0">استيراد موازنة مالية — ملف CSV</h3></div>
    <div class="card-body">
        <p class="text-muted">Stub file import — لا يوجد تكامل ERP حي. الصيغة: CostCenter,GradeCode,ApprovedCount,ApprovedFTE,BudgetAmount,ExternalReference</p>
        <form asp-action="Import" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="FiscalYear" class="form-label"></label>
                <input asp-for="FiscalYear" class="form-control" type="number" />
            </div>
            <div class="mb-3">
                <label asp-for="File" class="form-label">ملف CSV</label>
                <input asp-for="File" class="form-control" type="file" accept=".csv,text/csv" />
            </div>
            <button type="submit" class="btn btn-primary">استيراد</button>
            <a asp-action="Reconciliation" class="btn btn-outline-secondary">مصالحة</a>
        </form>
    </div>
</div>
