@model HR.Core.Web.ViewModels.WorkforcePlansIndexViewModel
@{ ViewData["Title"] = "خطط القوى العاملة"; }
<div class="card">
    <div class="card-header d-flex justify-content-between"><h3 class="mb-0">التخطيط</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">السنة المالية</label>
                <input type="number" name="fiscalYear" value="@Model.FiscalYear" class="form-control" min="2000" max="2100" />
            </div>
            <div class="col-md-3">
                <label class="form-label">الوحدة التنظيمية</label>
                <select name="orgUnitId" asp-items="ViewBag.OrgUnits" class="form-select"><option value="">— الكل —</option></select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select">
                    <option value="">— الكل —</option>
                    @foreach (var o in new[] { ("draft", "مسودة"), ("final", "نهائي"), ("approved", "معتمد") })
                    {
                        if (Model.Status == o.Item1) { <option value="@o.Item1" selected>@o.Item2</option> }
                        else { <option value="@o.Item1">@o.Item2</option> }
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table mb-0"><thead><tr><th>العنوان</th><th>السنة</th><th>الوحدة</th><th>الحالة</th></tr></thead><tbody>
        @foreach (var x in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@x.Id">@x.Title</a></td><td>@x.FiscalYear</td><td>@x.OrgUnit?.NameAr</td><td>@x.Status</td></tr>}
        @if(!Model.Items.Any()){<tr><td colspan="4" class="text-center text-muted">لا توجد</td></tr>}</tbody></table>
    </div>
</div>
