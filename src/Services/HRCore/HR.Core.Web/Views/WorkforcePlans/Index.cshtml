@model IReadOnlyList<HR.Core.Domain.Entities.WorkforcePlan>
@{ ViewData["Title"] = "خطط القوى العاملة"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">التخطيط</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>العنوان</th><th>السنة</th><th>الوحدة</th><th>الحالة</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.Title</td><td>@x.FiscalYear</td><td>@x.OrgUnit?.NameAr</td><td>@x.Status</td></tr>}
@if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
