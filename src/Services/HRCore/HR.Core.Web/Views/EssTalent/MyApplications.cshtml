@using HR.Core.Domain.Enums
@model IReadOnlyList<HR.Core.Domain.Entities.InternalApplication>
@{
    ViewData["Title"] = "ترشّحاتي الداخلية";
    // HCM-030 (B3): linked applications show their public status; legacy rows keep the channel status.
    var publicStatuses = ViewBag.PublicStatuses as IReadOnlyDictionary<Guid, HR.Core.Domain.Services.CandidatePublicView>
        ?? new Dictionary<Guid, HR.Core.Domain.Services.CandidatePublicView>();
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">ترشّحاتي للشواغر الداخلية</h3>
        <a asp-action="Index" class="btn btn-link">استعراض الشواغر</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الشاغر</th><th>طلب الشاغر</th><th>الدرجة</th><th>تاريخ الترشّح</th><th>الحالة</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var req = a.InternalVacancy?.Requisition;
                    <tr>
                        <td>@(a.InternalVacancy?.Title ?? "—")</td>
                        <td>@(req?.RequisitionNumber ?? "—")</td>
                        <td>@(req?.FundedPosition?.GradeCode ?? "—")</td>
                        <td>@a.AppliedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (a.PromotedRecruitmentApplicationId is Guid linkedId && publicStatuses.TryGetValue(linkedId, out var publicView))
                            {
                                <span>@publicView.LabelAr</span>
                                @if (!string.IsNullOrWhiteSpace(publicView.DetailAr))
                                {
                                    <span class="d-block text-muted small">@publicView.DetailAr</span>
                                }
                            }
                            else
                            {
                                @Html.DisplayFor(_ => a.Status)
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">لم تترشّح بعد</td></tr> }
            </tbody>
        </table>
    </div>
</div>
