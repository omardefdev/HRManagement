@using HR.Core.Domain.Enums
@model IReadOnlyList<HR.Core.Domain.Entities.InternalApplication>
@{ ViewData["Title"] = "ترشّحاتي الداخلية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">ترشّحاتي للشواغر الداخلية</h3>
        <a asp-action="Index" class="btn btn-link">استعراض الشواغر</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الشاغر</th><th>طلب الشاغر</th><th>الدرجة</th><th>تاريخ الترشّح</th><th>الحالة</th><th>مسار الاختيار</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var req = a.InternalVacancy?.Requisition;
                    <tr>
                        <td>@(a.InternalVacancy?.Title ?? "—")</td>
                        <td>@(req?.RequisitionNumber ?? "—")</td>
                        <td>@(req?.FundedPosition?.GradeCode ?? "—")</td>
                        <td>@a.AppliedAt.ToString("yyyy-MM-dd")</td>
                        <td>@Html.DisplayFor(_ => a.Status)</td>
                        <td>
                            @if (a.PromotedRecruitmentApplicationId is Guid promotedId)
                            {
                                <span class="badge bg-success">@a.PromotedRecruitmentApplication?.Status.ToString()</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لم تترشّح بعد</td></tr> }
            </tbody>
        </table>
    </div>
</div>
