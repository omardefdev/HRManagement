@model IReadOnlyList<HR.Core.Domain.Entities.CareerPath>
@{ ViewData["Title"] = "المسارات الوظيفية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">المسارات الوظيفية</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">مسار جديد</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>العنوان</th><th>عدد المراحل</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Title</td>
                        <td>@x.Steps.Count</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-outline-info btn-xs">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">لا مسارات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
