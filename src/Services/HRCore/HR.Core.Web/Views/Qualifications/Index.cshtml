@model HR.Core.Web.ViewModels.QualificationsIndexViewModel

@{

    ViewData["Title"] = "المؤهلات";

    var employee = Model.Employee;

}



<div class="card">

    <div class="card-header">

        <h3 class="card-title"><i class="fas fa-graduation-cap"></i> مؤهلات الموظف: @employee.FullName</h3>

        <div class="card-tools">

            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createQualificationModal">

                <i class="fas fa-plus"></i> إضافة مؤهل

            </button>

        </div>

    </div>

    <div class="card-body p-0">

        <table class="table table-striped table-hover">

            <thead>

                <tr><th>اسم المؤهل</th><th>كود التأهيل</th><th>الجهة المانحة</th><th>تاريخ الإتمام</th><th>إجراءات</th></tr>

            </thead>

            <tbody>

                @foreach (var q in Model.Qualifications)

                {

                    <tr>

                        <td>@q.Title</td>

                        <td>@(q.QualificationCode ?? "—")</td>

                        <td>@(q.Provider ?? "—")</td>

                        <td>@(q.CompletionDate?.ToString("yyyy/MM/dd") ?? "—")</td>

                        <td>

                            <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>

                            <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = q.Id })" aria-label="حذف">

                                <i aria-hidden="true" class="fas fa-trash"></i>

                            </button>

                        </td>

                    </tr>

                }

                @if (!Model.Qualifications.Any())

                {

                    <tr><td colspan="5" class="text-center text-muted py-4">لا توجد مؤهلات مسجلة</td></tr>

                }

            </tbody>

        </table>

    </div>

    <div class="card-footer">

        <a asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id" class="btn btn-secondary">

            <i class="fas fa-arrow-right"></i> العودة لملف الموظف

        </a>

    </div>

</div>



@await Html.PartialAsync("_CreateModal", Model.CreateModel)



@section Scripts {

    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            if (@Json.Serialize(Model.ShowCreateModal)) {

                bootstrap.Modal.getOrCreateInstance(

                    document.getElementById('createQualificationModal')).show();

            }

        });

    </script>

}


