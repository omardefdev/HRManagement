@model HR.Core.Web.ViewModels.ExamSessionDetailsViewModel
@using System.Globalization
@using HR.Core.Domain.Enums
@{
    var s = Model.Session;
    ViewData["Title"] = $"جلسة الامتحان — {s.Title}";
    var attendanceOpen = Model.CanWrite && s.Status is ExamSessionStatus.Seated or ExamSessionStatus.Held;
}

@if (TempData["Success"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger" role="alert">@err</div> }

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">@s.Title — @Html.HrEnumDisplay(s.Type)</h3>
        <a asp-action="Details" asp-route-id="@Model.Competition.Id" class="btn btn-outline-secondary btn-sm">@Model.Competition.Number</a>
    </div>
    <div class="card-body">
        <p class="small mb-2">@s.ScheduledAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC · @s.Venue · السعة @s.Capacity · @Html.HrEnumDisplay(s.Status)</p>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.CanWrite && s.Status == ExamSessionStatus.Seated)
            {
                <form asp-action="MarkSessionHeld" asp-route-id="@s.Id" method="post"
                      data-hr-confirm="سيُعتمد انعقاد الجلسة ويُفتح التصحيح للمصححين." data-hr-confirm-title="اعتماد انعقاد الجلسة">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">اعتماد انعقاد الجلسة</button>
                </form>
            }
            @if (Model.CanWrite && s.Status == ExamSessionStatus.Held)
            {
                <form asp-action="CloseMarking" asp-route-id="@s.Id" method="post"
                      data-hr-confirm="سيُغلق التصحيح وتُقفل العلامات وتُثبَّت علامة كل دفتر." data-hr-confirm-title="إغلاق التصحيح" data-hr-confirm-variant="warning">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-warning btn-sm">إغلاق التصحيح</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">المتقدمون الموزعون (@Model.Candidates.Count)</div>
    <div class="card-body">
        <form asp-action="SetAttendance" asp-route-id="@s.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th scope="col">المقعد</th><th scope="col">الرقم الامتحاني</th><th scope="col">الاسم</th><th scope="col">الحضور</th><th scope="col">العلامة</th><th scope="col">البطاقة</th></tr></thead>
                    <tbody>
                        @foreach (var row in Model.Candidates)
                        {
                            <tr>
                                <td>@row.SeatNumber</td>
                                <td><bdi dir="ltr">@row.ExamNumber</bdi></td>
                                <td>@row.ApplicantFullName</td>
                                <td>
                                    @if (attendanceOpen)
                                    {
                                        <fieldset>
                                            <legend class="visually-hidden">حضور @row.ExamNumber</legend>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox" name="present" value="@row.Id" id="p-@row.Id" @(row.Attendance == ExamAttendance.Present ? "checked" : "") />
                                                <label class="form-check-label small" for="p-@row.Id">حاضر</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox" name="absent" value="@row.Id" id="a-@row.Id" @(row.Attendance == ExamAttendance.Absent ? "checked" : "") />
                                                <label class="form-check-label small" for="a-@row.Id">غائب</label>
                                            </div>
                                        </fieldset>
                                    }
                                    else
                                    {
                                        @Html.HrEnumDisplay(row.Attendance)
                                    }
                                </td>
                                <td>@(row.FinalMark?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td>
                                    @if (row.CardIssued)
                                    {
                                        <a asp-action="AdmissionCard" asp-route-id="@row.Id">تنزيل</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (attendanceOpen && Model.Candidates.Count > 0)
            {
                <button type="submit" class="btn btn-primary btn-sm">حفظ الحضور</button>
            }
        </form>
    </div>
</div>
