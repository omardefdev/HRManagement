@model HR.Core.Web.ViewModels.CompetitionLineFormViewModel
@{ ViewData["Title"] = Model.LineId is null ? "سطر مسابقة جديد" : "تعديل سطر المسابقة"; }

<div class="card">
    <div class="card-header"><h3 class="mb-0">@ViewData["Title"]</h3></div>
    <div class="card-body">
        <form asp-action="SaveLine" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="CompetitionId" />
            <input type="hidden" asp-for="LineId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="GradeCode" class="form-label"></label>
                    <input asp-for="GradeCode" class="form-control" aria-describedby="gradeHelp" />
                    <span asp-validation-for="GradeCode" class="text-danger"></span>
                    <div id="gradeHelp" class="form-text">تُربط بالسطر طلبات الشواغر المعتمدة التي تطابق درجة منصبها الممول هذه الدرجة.</div>
                </div>
                <div class="col-md-3">
                    <label asp-for="LinePassMark" class="form-label"></label>
                    <input asp-for="LinePassMark" class="form-control" type="number" step="0.01" min="0" max="100" aria-describedby="linePassHelp" />
                    <div id="linePassHelp" class="form-text">اختياري — يُترك فارغاً لاعتماد درجة نجاح المسابقة.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="JobCatalogEntryId" class="form-label"></label>
                    <select asp-for="JobCatalogEntryId" class="form-select" asp-items="ViewBag.JobCatalogEntries">
                        <option value="">— أي وظيفة بالدرجة نفسها —</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="OrgUnitId" class="form-label"></label>
                    <select asp-for="OrgUnitId" class="form-select" asp-items="ViewBag.OrgUnits">
                        <option value="">— غير محدد —</option>
                    </select>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">حفظ السطر</button>
                <a asp-action="Details" asp-route-id="@Model.CompetitionId" class="btn btn-outline-secondary">رجوع</a>
            </div>
        </form>
    </div>
</div>
