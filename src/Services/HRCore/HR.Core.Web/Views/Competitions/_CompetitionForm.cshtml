@model HR.Core.Web.ViewModels.CompetitionFormViewModel
@using HR.Core.Domain.Enums
@{
    var tieBreaks = Enum.GetValues<CompetitionTieBreak>();
}

@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
@if (Model.Id is Guid id)
{
    <input type="hidden" asp-for="Id" />
}

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="PublishingChannel" class="form-label"></label>
        <select asp-for="PublishingChannel" class="form-select" asp-items="Html.GetEnumSelectList<RecruitmentPublishingChannel>()"></select>
    </div>
    <div class="col-md-8">
        <label asp-for="LegalSourceId" class="form-label"></label>
        <select asp-for="LegalSourceId" class="form-select" asp-items="ViewBag.LegalSources" aria-describedby="legalSourceHelp">
            <option value="">— اختر المرجع من سجل التشريعات —</option>
        </select>
        <span asp-validation-for="LegalSourceId" class="text-danger"></span>
        <div id="legalSourceHelp" class="form-text">الأساس القانوني للمسابقة؛ تُؤخذ كل المعاملات القانونية أدناه من هذا المرجع المعتمد.</div>
    </div>
    <div class="col-md-2">
        <label asp-for="AnnouncementDate" class="form-label"></label>
        <input asp-for="AnnouncementDate" class="form-control" type="date" />
    </div>
    <div class="col-md-2">
        <label asp-for="ApplicationClosingDate" class="form-label"></label>
        <input asp-for="ApplicationClosingDate" class="form-control" type="date" />
        <span asp-validation-for="ApplicationClosingDate" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="ApplicationConditions" class="form-label"></label>
        <textarea asp-for="ApplicationConditions" class="form-control" rows="3"></textarea>
    </div>
</div>

<fieldset class="border rounded p-3 mt-3">
    <legend class="float-none w-auto px-2 fs-6">المعاملات القانونية (من المرجع المعتمد)</legend>
    @if (Model.PrefilledFromDefaults)
    {
        <div class="alert alert-warning py-2">قيم مُعبأة مسبقاً من إعدادات بيئة التطوير/القبول — تحقق منها مقابل المرجع المعتمد قبل الحفظ.</div>
    }
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="ObjectionWindowDays" class="form-label"></label>
            <input asp-for="ObjectionWindowDays" class="form-control" type="number" min="1" max="60" />
        </div>
        <div class="col-md-3">
            <label asp-for="ReserveValidityMonths" class="form-label"></label>
            <input asp-for="ReserveValidityMonths" class="form-control" type="number" min="0" max="36" />
        </div>
        <div class="col-md-3">
            <label asp-for="MaxLinesPerCandidate" class="form-label"></label>
            <input asp-for="MaxLinesPerCandidate" class="form-control" type="number" min="1" />
        </div>
        <div class="col-md-3">
            <label asp-for="PassMark" class="form-label"></label>
            <input asp-for="PassMark" class="form-control" type="number" step="0.01" min="0" max="100" />
        </div>
        <div class="col-md-3">
            <label asp-for="ReconcileThreshold" class="form-label"></label>
            <input asp-for="ReconcileThreshold" class="form-control" type="number" step="0.01" min="0" aria-describedby="thresholdHelp" />
            <div id="thresholdHelp" class="form-text">إذا تجاوز الفرق بين المصححَين الأول والثاني هذه العتبة يُحال الدفتر إلى مصحح ثالث.</div>
        </div>
        <div class="col-md-3">
            <label asp-for="ReconcileRule" class="form-label"></label>
            <select asp-for="ReconcileRule" class="form-select" asp-items="Html.GetEnumSelectList<CompetitionReconcileRule>()">
                <option value="">— اختر —</option>
            </select>
        </div>
        <div class="col-md-6">
            <span class="form-label d-block" id="tieBreakLabel">ترتيب كسر التعادل (بالأولوية)</span>
            <div class="row g-2" role="group" aria-labelledby="tieBreakLabel">
                @for (var i = 0; i < tieBreaks.Length; i++)
                {
                    var selected = i < Model.TieBreakOrder.Count ? Model.TieBreakOrder[i] : null;
                    <div class="col-6">
                        <label class="form-label small" for="tieBreak@(i)">المعيار @(i + 1)</label>
                        <select id="tieBreak@(i)" name="TieBreakOrder[@i]" class="form-select form-select-sm">
                            <option value="">— لا شيء —</option>
                            @foreach (var option in tieBreaks)
                            {
                                <option value="@option" selected="@(selected == option)">@Html.HrEnumDisplay(option)</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </div>
    </div>
</fieldset>
