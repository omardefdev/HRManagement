@model HR.Core.Web.ViewModels.CompetitionFormViewModel
@{ ViewData["Title"] = "مسابقة توظيف جديدة"; }

<div class="card">
    <div class="card-header"><h3 class="mb-0">مسابقة توظيف جديدة (مسودة)</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <partial name="_CompetitionForm" model="Model" />
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">حفظ كمسودة</button>
                <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
            </div>
        </form>
    </div>
</div>
