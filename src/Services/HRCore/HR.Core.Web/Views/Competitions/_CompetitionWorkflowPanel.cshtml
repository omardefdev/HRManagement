@model HR.Core.Web.ViewModels.WorkflowPanelViewModel
@{
    var competitionId = ViewData["CompetitionId"] as Guid? ?? Guid.Empty;
    var approveAction = ViewData["ApproveAction"] as string ?? "ApproveWorkflow";
    var rejectAction = ViewData["RejectAction"] as string ?? "RejectWorkflow";
    var prefix = ViewData["FieldPrefix"] as string ?? "competition";
}

@if (Model.HasWorkflowInstance)
{
    <h6 class="mt-3">مسار الاعتماد — @(Model.WorkflowName ?? Model.WorkflowCode ?? "—")</h6>
    <partial name="_WorkflowProgressPanel" model="Model.Steps" />

    @if (!string.IsNullOrWhiteSpace(Model.BlockReason))
    {
        <div class="alert alert-info mt-3 mb-0">@Model.BlockReason</div>
    }

    @if (Model.CanApprove || Model.CanReject)
    {
        <div class="card mt-3 border-warning">
            <div class="card-header bg-warning bg-opacity-10"><strong>إجراء الاعتماد — @Model.CurrentStepName</strong></div>
            <div class="card-body">
                @if (Model.CanApprove)
                {
                    <form asp-action="@approveAction" asp-route-id="@competitionId" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-md-8">
                            <label class="form-label" for="@(prefix)ApproveComments">ملاحظات (اختياري)</label>
                            <input type="text" class="form-control" id="@(prefix)ApproveComments" name="comments" maxlength="500" />
                        </div>
                        <div class="col-md-4"><button type="submit" class="btn btn-success btn-sm">اعتماد</button></div>
                    </form>
                }
                @if (Model.CanReject)
                {
                    <form asp-action="@rejectAction" asp-route-id="@competitionId" method="post" class="row g-2 align-items-end mt-2"
                          data-hr-confirm="سيُعاد العنصر إلى المسودة مع سبب الإرجاع."
                          data-hr-confirm-title="تأكيد الإرجاع"
                          data-hr-confirm-variant="warning">
                        @Html.AntiForgeryToken()
                        <div class="col-md-8">
                            <label class="form-label" for="@(prefix)RejectComments">سبب الإرجاع</label>
                            <input type="text" class="form-control" id="@(prefix)RejectComments" name="comments" maxlength="500" />
                        </div>
                        <div class="col-md-4"><button type="submit" class="btn btn-outline-danger btn-sm">إرجاع</button></div>
                    </form>
                }
            </div>
        </div>
    }
}
