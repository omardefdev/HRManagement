@model HR.Core.Web.ViewModels.CompetitionDetailsViewModel
@using HR.Core.Domain.Enums
@using System.Globalization
@{
    var c = Model.Competition;
    ViewData["Title"] = $"المسابقة {c.Number}";
    string D(DateOnly? d) => d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "—";
    string T(DateTime? d) => d?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? "—";
}

@if (TempData["Success"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger" role="alert">@err</div> }

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">@c.Number — @c.Title</h3>
        <span class="badge bg-primary">@Html.HrEnumDisplay(c.Status)</span>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(c.ReturnReason) && c.Status == RecruitmentCompetitionStatus.Draft)
        {
            <div class="alert alert-warning">أُعيدت المسابقة من مسار الاعتماد: @c.ReturnReason</div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-3">المرجع القانوني</dt><dd class="col-sm-9">@Model.LegalSourceLabel</dd>
            <dt class="col-sm-3">قناة النشر</dt><dd class="col-sm-9">@Html.HrEnumDisplay(c.PublishingChannel)</dd>
            <dt class="col-sm-3">تاريخ الإعلان</dt><dd class="col-sm-9">@D(c.AnnouncementDate)</dd>
            <dt class="col-sm-3">إغلاق التقديم</dt><dd class="col-sm-9">@D(c.ApplicationClosingDate)</dd>
            <dt class="col-sm-3">عدد الأسطر / الشواغر</dt><dd class="col-sm-9">@Model.Lines.Count / @Model.VacancyCount</dd>
            <dt class="col-sm-3">عدد المتقدمين</dt><dd class="col-sm-9">@Model.ApplicationCount</dd>
        </dl>
        <h6 class="mt-3">المعاملات القانونية (من المرجع المعتمد)</h6>
        <dl class="row mb-0 small">
            <dt class="col-sm-3">مدة الاعتراض</dt><dd class="col-sm-3">@c.ObjectionWindowDays يوماً</dd>
            <dt class="col-sm-3">صلاحية الاحتياط</dt><dd class="col-sm-3">@c.ReserveValidityMonths شهراً</dd>
            <dt class="col-sm-3">الحد الأقصى للأسطر لكل متقدم</dt><dd class="col-sm-3">@c.MaxLinesPerCandidate</dd>
            <dt class="col-sm-3">درجة النجاح</dt><dd class="col-sm-3">@c.PassMark.ToString("0.##", CultureInfo.InvariantCulture)</dd>
            <dt class="col-sm-3">عتبة التصحيح الثالث</dt><dd class="col-sm-3">@c.ReconcileThreshold.ToString("0.##", CultureInfo.InvariantCulture)</dd>
            <dt class="col-sm-3">قاعدة التسوية</dt><dd class="col-sm-3">@Html.HrEnumDisplay(c.ReconcileRule)</dd>
            <dt class="col-sm-3">ترتيب كسر التعادل</dt>
            <dd class="col-sm-9">@string.Join(" ← ", Model.TieBreakOrder.Select(t => Html.HrEnumDisplay(t).ToString()))</dd>
        </dl>
        @if (!string.IsNullOrWhiteSpace(c.ApplicationConditions))
        {
            <h6 class="mt-3">شروط التقديم</h6>
            <p class="mb-0">@c.ApplicationConditions</p>
        }

        @if (Model.CanWrite)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (Model.IsEditable)
                {
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
                    <a asp-action="AddLine" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">إضافة سطر</a>
                    <form asp-action="Submit" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="ستُقدَّم المسابقة للاعتماد وتُثبَّت معايير التقييم لكل سطر."
                          data-hr-confirm-title="تقديم المسابقة للاعتماد">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">تقديم للاعتماد</button>
                    </form>
                }
                @if (c.Status == RecruitmentCompetitionStatus.Approved)
                {
                    <form asp-action="Announce" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="سيُنشر إعلان واحد للمسابقة وتُنقل طلبات الشواغر المربوطة إلى «منشور» دون إعلانات منفردة."
                          data-hr-confirm-title="إعلان المسابقة">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">إعلان المسابقة</button>
                    </form>
                }
                @if (c.Status == RecruitmentCompetitionStatus.Announced)
                {
                    <form asp-action="CloseIntake" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="سيُغلق التقديم على المسابقة الآن قبل تاريخ الإغلاق."
                          data-hr-confirm-title="إغلاق التقديم" data-hr-confirm-variant="warning">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning btn-sm">إغلاق التقديم</button>
                    </form>
                }
            </div>
        }

        <partial name="_CompetitionWorkflowPanel" model="Model.Workflow" view-data='new ViewDataDictionary(ViewData) { ["CompetitionId"] = c.Id }' />
    </div>
</div>

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item" role="presentation"><button class="nav-link active" id="tab-lines-btn" data-bs-toggle="tab" data-bs-target="#tab-lines" type="button" role="tab" aria-controls="tab-lines" aria-selected="true">الأسطر</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-applicants-btn" data-bs-toggle="tab" data-bs-target="#tab-applicants" type="button" role="tab" aria-controls="tab-applicants" aria-selected="false">المتقدمون</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-exams-btn" data-bs-toggle="tab" data-bs-target="#tab-exams" type="button" role="tab" aria-controls="tab-exams" aria-selected="false">الامتحانات</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-scores-btn" data-bs-toggle="tab" data-bs-target="#tab-scores" type="button" role="tab" aria-controls="tab-scores" aria-selected="false">الدرجات</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-results-btn" data-bs-toggle="tab" data-bs-target="#tab-results" type="button" role="tab" aria-controls="tab-results" aria-selected="false">النتائج</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-objections-btn" data-bs-toggle="tab" data-bs-target="#tab-objections" type="button" role="tab" aria-controls="tab-objections" aria-selected="false">الاعتراضات</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-allocation-btn" data-bs-toggle="tab" data-bs-target="#tab-allocation" type="button" role="tab" aria-controls="tab-allocation" aria-selected="false">التخصيص والعروض</button></li>
</ul>
<div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
    <div class="tab-pane fade show active" id="tab-lines" role="tabpanel" aria-labelledby="tab-lines-btn">
        @if (Model.Lines.Count == 0)
        {
            <p class="text-muted mb-0">لا توجد أسطر بعد.</p>
        }
        @foreach (var row in Model.Lines)
        {
            var line = row.Line;
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <strong>السطر @line.LineNo — @line.Title</strong>
                    <span class="small text-muted">
                        الدرجة @line.GradeCode
                        @if (line.JobCatalogEntry is not null) { <text>· @line.JobCatalogEntry.TitleAr</text> }
                        @if (line.OrgUnit is not null) { <text>· @line.OrgUnit.NameAr</text> }
                        · الشواغر @row.Requisitions.Count
                        @if (line.LinePassMark is decimal lp) { <text>· درجة نجاح السطر @lp.ToString("0.##", CultureInfo.InvariantCulture)</text> }
                    </span>
                </div>
                <div class="card-body">
                    @if (row.Requisitions.Count == 0)
                    {
                        <p class="text-muted">لا توجد طلبات شاغر مربوطة.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead><tr><th scope="col">رقم الطلب</th><th scope="col">المسمى</th><th scope="col">الوحدة</th><th scope="col">الحالة</th><th scope="col"><span class="visually-hidden">إجراءات</span></th></tr></thead>
                                <tbody>
                                    @foreach (var req in row.Requisitions)
                                    {
                                        <tr>
                                            <td><a asp-controller="RecruitmentRequisitions" asp-action="Details" asp-route-id="@req.Id">@req.RequisitionNumber</a></td>
                                            <td>@req.JobTitle</td>
                                            <td>@(req.OrgUnitName ?? "—")</td>
                                            <td>@Html.HrEnumDisplay(req.Status)</td>
                                            <td>
                                                @if (Model.CanWrite && Model.IsEditable)
                                                {
                                                    <form asp-action="DetachRequisition" asp-route-id="@c.Id" method="post"
                                                          data-hr-confirm="سيُفصل طلب الشاغر @req.RequisitionNumber عن السطر." data-hr-confirm-title="فصل طلب الشاغر">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requisitionId" value="@req.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">فصل</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (Model.CanWrite && Model.IsEditable)
                    {
                        <div class="d-flex flex-wrap gap-2 align-items-end">
                            <form asp-action="AttachRequisition" asp-route-id="@c.Id" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lineId" value="@line.Id" />
                                <div>
                                    <label class="form-label small" for="attach-@line.Id">طلب شاغر معتمد بالدرجة نفسها</label>
                                    <select class="form-select form-select-sm" id="attach-@line.Id" name="requisitionId">
                                        <option value="">— اختر —</option>
                                        @foreach (var a in row.Attachable)
                                        {
                                            <option value="@a.Id">@a.RequisitionNumber — @a.JobTitle @(a.OrgUnitName is null ? "" : $"({a.OrgUnitName})")</option>
                                        }
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-outline-primary btn-sm">ربط</button>
                            </form>
                            <a asp-action="EditLine" asp-route-id="@line.Id" class="btn btn-outline-secondary btn-sm">تعديل السطر</a>
                            <form asp-action="RemoveLine" asp-route-id="@c.Id" method="post"
                                  data-hr-confirm="سيُحذف السطر @line.LineNo وتُفصل طلبات الشواغر المربوطة به." data-hr-confirm-title="حذف السطر" data-hr-confirm-variant="danger">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lineId" value="@line.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">حذف السطر</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <div class="tab-pane fade" id="tab-applicants" role="tabpanel" aria-labelledby="tab-applicants-btn">
        <p class="text-muted mb-0">تظهر طلبات التقديم بعد إعلان المسابقة.</p>
    </div>
    <div class="tab-pane fade" id="tab-exams" role="tabpanel" aria-labelledby="tab-exams-btn">
        <p class="text-muted mb-0">تُضاف جلسات الامتحان بعد إغلاق التقديم.</p>
    </div>
    <div class="tab-pane fade" id="tab-scores" role="tabpanel" aria-labelledby="tab-scores-btn">
        <p class="text-muted mb-0">تظهر حالة التصحيح بعد جلسات الامتحان.</p>
    </div>
    <div class="tab-pane fade" id="tab-results" role="tabpanel" aria-labelledby="tab-results-btn">
        <p class="text-muted mb-0">تظهر نسخ النتائج بعد انتهاء التصحيح.</p>
    </div>
    <div class="tab-pane fade" id="tab-objections" role="tabpanel" aria-labelledby="tab-objections-btn">
        <p class="text-muted mb-0">تظهر الاعتراضات بعد نشر النتائج.</p>
    </div>
    <div class="tab-pane fade" id="tab-allocation" role="tabpanel" aria-labelledby="tab-allocation-btn">
        <p class="text-muted mb-0">يتاح التخصيص والعروض بعد انتهاء مدة الاعتراض.</p>
    </div>
</div>

@if (Model.CanApprove && HR.Core.Domain.Services.CompetitionWorkflowRules.CanCancel(c.Status))
{
    <div class="card border-danger">
        <div class="card-header">إلغاء المسابقة</div>
        <div class="card-body">
            <form asp-action="Cancel" asp-route-id="@c.Id" method="post" class="row g-2 align-items-end"
                  data-hr-confirm="ستُلغى المسابقة ويُرفض كل طلب تقديم مفتوح عليها." data-hr-confirm-title="إلغاء المسابقة" data-hr-confirm-variant="danger">
                @Html.AntiForgeryToken()
                <div class="col-md-9">
                    <label for="cancelReason" class="form-label">سبب الإلغاء (10 أحرف على الأقل)</label>
                    <input id="cancelReason" name="reason" class="form-control" maxlength="500" required minlength="10" />
                </div>
                <div class="col-md-3"><button type="submit" class="btn btn-danger">إلغاء المسابقة</button></div>
            </form>
        </div>
    </div>
}
