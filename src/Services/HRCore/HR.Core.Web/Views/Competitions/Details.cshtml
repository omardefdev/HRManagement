@model HR.Core.Web.ViewModels.CompetitionDetailsViewModel
@using HR.Core.Domain.Enums
@using HR.Core.Domain.Entities
@using System.Globalization
@{
    var c = Model.Competition;
    ViewData["Title"] = $"المسابقة {c.Number}";
    string D(DateOnly? d) => d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "—";
    string T(DateTime? d) => d?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? "—";
}

@if (TempData["Success"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger" role="alert">@err</div> }

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">@c.Number — @c.Title</h3>
        <span class="badge bg-primary">@Html.HrEnumDisplay(c.Status)</span>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(c.ReturnReason) && c.Status == RecruitmentCompetitionStatus.Draft)
        {
            <div class="alert alert-warning">أُعيدت المسابقة من مسار الاعتماد: @c.ReturnReason</div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-3">المرجع القانوني</dt><dd class="col-sm-9">@Model.LegalSourceLabel</dd>
            <dt class="col-sm-3">قناة النشر</dt><dd class="col-sm-9">@Html.HrEnumDisplay(c.PublishingChannel)</dd>
            <dt class="col-sm-3">تاريخ الإعلان</dt><dd class="col-sm-9">@D(c.AnnouncementDate)</dd>
            <dt class="col-sm-3">إغلاق التقديم</dt><dd class="col-sm-9">@D(c.ApplicationClosingDate)</dd>
            <dt class="col-sm-3">عدد الأسطر / الشواغر</dt><dd class="col-sm-9">@Model.Lines.Count / @Model.VacancyCount</dd>
            <dt class="col-sm-3">عدد المتقدمين</dt><dd class="col-sm-9">@Model.ApplicationCount</dd>
        </dl>
        <h6 class="mt-3">المعاملات القانونية (من المرجع المعتمد)</h6>
        <dl class="row mb-0 small">
            <dt class="col-sm-3">مدة الاعتراض</dt><dd class="col-sm-3">@c.ObjectionWindowDays يوماً</dd>
            <dt class="col-sm-3">صلاحية الاحتياط</dt><dd class="col-sm-3">@c.ReserveValidityMonths شهراً</dd>
            <dt class="col-sm-3">الحد الأقصى للأسطر لكل متقدم</dt><dd class="col-sm-3">@c.MaxLinesPerCandidate</dd>
            <dt class="col-sm-3">درجة النجاح</dt><dd class="col-sm-3">@c.PassMark.ToString("0.##", CultureInfo.InvariantCulture)</dd>
            <dt class="col-sm-3">عتبة التصحيح الثالث</dt><dd class="col-sm-3">@c.ReconcileThreshold.ToString("0.##", CultureInfo.InvariantCulture)</dd>
            <dt class="col-sm-3">قاعدة التسوية</dt><dd class="col-sm-3">@Html.HrEnumDisplay(c.ReconcileRule)</dd>
            <dt class="col-sm-3">ترتيب كسر التعادل</dt>
            <dd class="col-sm-9">@string.Join(" ← ", Model.TieBreakOrder.Select(t => Html.HrEnumDisplay(t).ToString()))</dd>
        </dl>
        @if (!string.IsNullOrWhiteSpace(c.ApplicationConditions))
        {
            <h6 class="mt-3">شروط التقديم</h6>
            <p class="mb-0">@c.ApplicationConditions</p>
        }

        @if (Model.CanWrite)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (Model.IsEditable)
                {
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
                    <a asp-action="AddLine" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">إضافة سطر</a>
                    <form asp-action="Submit" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="ستُقدَّم المسابقة للاعتماد وتُثبَّت معايير التقييم لكل سطر."
                          data-hr-confirm-title="تقديم المسابقة للاعتماد">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">تقديم للاعتماد</button>
                    </form>
                }
                @if (c.Status == RecruitmentCompetitionStatus.Approved)
                {
                    <form asp-action="Announce" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="سيُنشر إعلان واحد للمسابقة وتُنقل طلبات الشواغر المربوطة إلى «منشور» دون إعلانات منفردة."
                          data-hr-confirm-title="إعلان المسابقة">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">إعلان المسابقة</button>
                    </form>
                }
                @if (c.Status == RecruitmentCompetitionStatus.Announced)
                {
                    <form asp-action="CloseIntake" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="سيُغلق التقديم على المسابقة الآن قبل تاريخ الإغلاق."
                          data-hr-confirm-title="إغلاق التقديم" data-hr-confirm-variant="warning">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning btn-sm">إغلاق التقديم</button>
                    </form>
                }
            </div>
        }

        <partial name="_CompetitionWorkflowPanel" model="Model.Workflow" view-data='new ViewDataDictionary(ViewData) { ["CompetitionId"] = c.Id }' />
    </div>
</div>

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item" role="presentation"><button class="nav-link active" id="tab-lines-btn" data-bs-toggle="tab" data-bs-target="#tab-lines" type="button" role="tab" aria-controls="tab-lines" aria-selected="true">الأسطر</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-applicants-btn" data-bs-toggle="tab" data-bs-target="#tab-applicants" type="button" role="tab" aria-controls="tab-applicants" aria-selected="false">المتقدمون</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-exams-btn" data-bs-toggle="tab" data-bs-target="#tab-exams" type="button" role="tab" aria-controls="tab-exams" aria-selected="false">الامتحانات</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-scores-btn" data-bs-toggle="tab" data-bs-target="#tab-scores" type="button" role="tab" aria-controls="tab-scores" aria-selected="false">الدرجات</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-results-btn" data-bs-toggle="tab" data-bs-target="#tab-results" type="button" role="tab" aria-controls="tab-results" aria-selected="false">النتائج</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-objections-btn" data-bs-toggle="tab" data-bs-target="#tab-objections" type="button" role="tab" aria-controls="tab-objections" aria-selected="false">الاعتراضات</button></li>
    <li class="nav-item" role="presentation"><button class="nav-link" id="tab-allocation-btn" data-bs-toggle="tab" data-bs-target="#tab-allocation" type="button" role="tab" aria-controls="tab-allocation" aria-selected="false">التخصيص والعروض</button></li>
</ul>
<div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
    <div class="tab-pane fade show active" id="tab-lines" role="tabpanel" aria-labelledby="tab-lines-btn">
        @if (Model.Lines.Count == 0)
        {
            <p class="text-muted mb-0">لا توجد أسطر بعد.</p>
        }
        @foreach (var row in Model.Lines)
        {
            var line = row.Line;
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <strong>السطر @line.LineNo — @line.Title</strong>
                    <span class="small text-muted">
                        الدرجة @line.GradeCode
                        @if (line.JobCatalogEntry is not null) { <text>· @line.JobCatalogEntry.TitleAr</text> }
                        @if (line.OrgUnit is not null) { <text>· @line.OrgUnit.NameAr</text> }
                        · الشواغر @row.Requisitions.Count
                        @if (line.LinePassMark is decimal lp) { <text>· درجة نجاح السطر @lp.ToString("0.##", CultureInfo.InvariantCulture)</text> }
                    </span>
                </div>
                <div class="card-body">
                    @if (row.Requisitions.Count == 0)
                    {
                        <p class="text-muted">لا توجد طلبات شاغر مربوطة.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead><tr><th scope="col">رقم الطلب</th><th scope="col">المسمى</th><th scope="col">الوحدة</th><th scope="col">الحالة</th><th scope="col"><span class="visually-hidden">إجراءات</span></th></tr></thead>
                                <tbody>
                                    @foreach (var req in row.Requisitions)
                                    {
                                        <tr>
                                            <td><a asp-controller="RecruitmentRequisitions" asp-action="Details" asp-route-id="@req.Id">@req.RequisitionNumber</a></td>
                                            <td>@req.JobTitle</td>
                                            <td>@(req.OrgUnitName ?? "—")</td>
                                            <td>@Html.HrEnumDisplay(req.Status)</td>
                                            <td>
                                                @if (Model.CanWrite && Model.IsEditable)
                                                {
                                                    <form asp-action="DetachRequisition" asp-route-id="@c.Id" method="post"
                                                          data-hr-confirm="سيُفصل طلب الشاغر @req.RequisitionNumber عن السطر." data-hr-confirm-title="فصل طلب الشاغر">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requisitionId" value="@req.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">فصل</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (Model.CanWrite && Model.IsEditable)
                    {
                        <div class="d-flex flex-wrap gap-2 align-items-end">
                            <form asp-action="AttachRequisition" asp-route-id="@c.Id" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lineId" value="@line.Id" />
                                <div>
                                    <label class="form-label small" for="attach-@line.Id">طلب شاغر معتمد بالدرجة نفسها</label>
                                    <select class="form-select form-select-sm" id="attach-@line.Id" name="requisitionId">
                                        <option value="">— اختر —</option>
                                        @foreach (var a in row.Attachable)
                                        {
                                            <option value="@a.Id">@a.RequisitionNumber — @a.JobTitle @(a.OrgUnitName is null ? "" : $"({a.OrgUnitName})")</option>
                                        }
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-outline-primary btn-sm">ربط</button>
                            </form>
                            <a asp-action="EditLine" asp-route-id="@line.Id" class="btn btn-outline-secondary btn-sm">تعديل السطر</a>
                            <form asp-action="RemoveLine" asp-route-id="@c.Id" method="post"
                                  data-hr-confirm="سيُحذف السطر @line.LineNo وتُفصل طلبات الشواغر المربوطة به." data-hr-confirm-title="حذف السطر" data-hr-confirm-variant="danger">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lineId" value="@line.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">حذف السطر</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <div class="tab-pane fade" id="tab-applicants" role="tabpanel" aria-labelledby="tab-applicants-btn">
        @{ var applicants = Model.Applicants; }
        @if (Model.BulkResults.Count > 0)
        {
            <div class="alert alert-warning">
                <p class="fw-bold mb-1">طلبات لم يُنفَّذ عليها الإجراء:</p>
                <ul class="mb-0">
                    @foreach (var failure in Model.BulkResults)
                    {
                        <li>@failure.ApplicantName — @failure.Error</li>
                    }
                </ul>
            </div>
        }
        <form method="get" asp-action="Details" asp-route-id="@c.Id" class="row g-2 mb-3 align-items-end">
            <div class="col-md-4">
                <label for="applicantStatus" class="form-label">حالة الطلب</label>
                <select id="applicantStatus" name="applicantStatus" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<RecruitmentApplicationStatus>()">
                    <option value="">— الكل —</option>
                </select>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary btn-sm">تصفية</button></div>
            <div class="col-md-6 text-muted small">العدد: @applicants.Total</div>
        </form>
        @if (applicants.Rows.Count == 0)
        {
            <p class="text-muted mb-0">لا توجد طلبات تقديم.</p>
        }
        else
        {
            <form asp-action="ScreenApplicants" asp-route-id="@c.Id" method="post"
                  data-hr-confirm="سيُنفَّذ الإجراء المختار على الطلبات المحددة." data-hr-confirm-title="إجراء جماعي على المتقدمين">
                @Html.AntiForgeryToken()
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th scope="col"><span class="visually-hidden">تحديد</span></th>
                                <th scope="col">المتقدم</th>
                                <th scope="col">القناة</th>
                                <th scope="col">الحالة</th>
                                <th scope="col">تاريخ التقديم</th>
                                <th scope="col">التفضيلات</th>
                                <th scope="col">ملاحظات الأهلية</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in applicants.Rows)
                            {
                                <tr>
                                    <td><input class="form-check-input" type="checkbox" name="applicationIds" value="@row.Id" id="app-@row.Id" aria-label="تحديد @row.ApplicantFullName" /></td>
                                    <td><a asp-controller="RecruitmentApplications" asp-action="Details" asp-route-id="@row.Id">@row.ApplicantFullName</a></td>
                                    <td>@Html.HrEnumDisplay(row.Channel)</td>
                                    <td>@Html.HrEnumDisplay(row.Status)</td>
                                    <td>@row.AppliedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                    <td class="small">@foreach (var p in row.Preferences) { <div>@p</div> }</td>
                                    <td class="small">@(row.FlagLabels.Count == 0 ? "—" : string.Join("، ", row.FlagLabels))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.CanWrite && c.Status is RecruitmentCompetitionStatus.Announced or RecruitmentCompetitionStatus.IntakeClosed)
                {
                    <div class="row g-2 align-items-end border-top pt-2">
                        <div class="col-md-3">
                            <label for="bulkTarget" class="form-label">الإجراء</label>
                            <select id="bulkTarget" name="target" class="form-select form-select-sm">
                                <option value="@RecruitmentApplicationStatus.UnderReview">قيد الفرز</option>
                                <option value="@RecruitmentApplicationStatus.Shortlisted">قبول للاختبار</option>
                                <option value="@RecruitmentApplicationStatus.Rejected">رفض</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="bulkOverride" class="form-label">سبب تجاوز ملاحظات الأهلية</label>
                            <input id="bulkOverride" name="eligibilityOverrideReason" class="form-control form-control-sm" maxlength="1000" />
                        </div>
                        <div class="col-md-3">
                            <label for="bulkRejectNote" class="form-label">ملاحظة الرفض</label>
                            <input id="bulkRejectNote" name="rejectionNote" class="form-control form-control-sm" maxlength="1000" />
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="bulkCoi" name="conflictOfInterestDeclared" value="true" />
                                <label class="form-check-label small" for="bulkCoi">أقر بعدم وجود تعارض مصالح مع المتقدمين المحددين</label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm mt-1">تنفيذ على المحدد</button>
                        </div>
                    </div>
                }
            </form>
            @if (applicants.Pages > 1)
            {
                <nav aria-label="صفحات المتقدمين" class="mt-2">
                    <ul class="pagination pagination-sm mb-0">
                        @for (var p = Math.Max(1, applicants.Page - 5); p <= Math.Min(applicants.Pages, applicants.Page + 5); p++)
                        {
                            <li class="page-item @(p == applicants.Page ? "active" : "")">
                                <a class="page-link" asp-action="Details" asp-route-id="@c.Id" asp-route-page="@p" asp-route-applicantStatus="@applicants.Status">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
    <div class="tab-pane fade" id="tab-exams" role="tabpanel" aria-labelledby="tab-exams-btn">
        @if (Model.CanWrite && c.Status is RecruitmentCompetitionStatus.IntakeClosed or RecruitmentCompetitionStatus.Examining)
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                <form asp-action="Seat" asp-route-id="@c.Id" method="post"
                      data-hr-confirm="سيُوزَّع المقبولون للاختبار على الجلسات حسب السعة بترتيب الرقم الامتحاني (يُعاد التوزيع إن وُجد)." data-hr-confirm-title="التوزيع على القاعات">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">التوزيع على القاعات</button>
                </form>
                @if (c.Status == RecruitmentCompetitionStatus.Examining)
                {
                    <form asp-action="IssueAdmissionCards" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="ستصدر بطاقات الامتحان لكل من وُزّع ولن يُسمح بإعادة التوزيع بعدها." data-hr-confirm-title="إصدار بطاقات الامتحان" data-hr-confirm-variant="warning">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary btn-sm">إصدار بطاقات الامتحان</button>
                    </form>
                }
            </div>
        }
        @if (Model.ExamSessions.Count == 0)
        {
            <p class="text-muted">لا توجد جلسات امتحان.</p>
        }
        @foreach (var row in Model.ExamSessions)
        {
            var s = row.Session;
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <a asp-action="ExamSession" asp-route-id="@s.Id"><strong>@s.Title</strong></a>
                    <span class="small text-muted">@Html.HrEnumDisplay(s.Type) · @s.ScheduledAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC · @s.Venue · السعة @s.Capacity · العلامة العظمى @s.MaxScore.ToString("0.##", CultureInfo.InvariantCulture) · @Html.HrEnumDisplay(s.Status)</span>
                </div>
                <div class="card-body">
                    <p class="small mb-2">الموزعون @row.Seated · حاضر @row.Present · غائب @row.Absent · البطاقات الصادرة @row.CardsIssued</p>
                    <h6>المصححون</h6>
                    @if (row.Markers.Count == 0) { <p class="text-muted small">لم يُكلَّف مصححون.</p> }
                    <ul class="small">
                        @foreach (var m in row.Markers)
                        {
                            <li>
                                @Html.HrEnumDisplay(m.Role): @m.EmployeeName @(m.Bound ? "" : "(لم يدخل بعد)")
                                @if (m.HoldsHrReadAccess)
                                {
                                    <span class="badge bg-warning text-dark">@HR.Core.Infrastructure.Services.Recruitment.Competitions.ExamSeatingService.HrReadAccessWarning</span>
                                }
                                @if (Model.CanWrite && s.Status != ExamSessionStatus.MarkingClosed)
                                {
                                    <form asp-action="RemoveMarker" asp-route-id="@c.Id" method="post" class="d-inline"
                                          data-hr-confirm="سيُلغى تكليف المصحح." data-hr-confirm-title="إلغاء تكليف">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="assignmentId" value="@m.AssignmentId" />
                                        <button type="submit" class="btn btn-link btn-sm p-0">إلغاء</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                    @if (Model.CanWrite && s.Status != ExamSessionStatus.MarkingClosed)
                    {
                        <form asp-action="AssignMarker" asp-route-id="@c.Id" method="post" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sessionId" value="@s.Id" />
                            <div class="col-md-5">
                                <label class="form-label small" for="marker-@s.Id">الموظف المصحح</label>
                                <select class="form-select form-select-sm" id="marker-@s.Id" name="employeeId" asp-items="Model.MarkerCandidates" data-hr-picker="select">
                                    <option value="">— اختر —</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small" for="role-@s.Id">الدور</label>
                                <select class="form-select form-select-sm" id="role-@s.Id" name="role" asp-items="Html.GetEnumSelectList<ExamMarkerRole>()"></select>
                            </div>
                            <div class="col-md-2"><button type="submit" class="btn btn-outline-primary btn-sm">تكليف</button></div>
                        </form>
                        <p class="form-text">يمكن تكليف موظف يملك صلاحية الاطلاع على بيانات الموارد البشرية، لكن ذلك يظهر تنبيهاً ويُسجَّل في التدقيق عند دخوله.</p>
                    }
                    @if (Model.CanWrite && s.Status == ExamSessionStatus.Planned && row.Seated == 0)
                    {
                        <form asp-action="RemoveExamSession" asp-route-id="@c.Id" method="post"
                              data-hr-confirm="ستُحذف جلسة الامتحان." data-hr-confirm-title="حذف الجلسة" data-hr-confirm-variant="danger">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sessionId" value="@s.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">حذف الجلسة</button>
                        </form>
                    }
                </div>
            </div>
        }
        @if (Model.CanWrite && c.Status is RecruitmentCompetitionStatus.Announced or RecruitmentCompetitionStatus.IntakeClosed or RecruitmentCompetitionStatus.Examining)
        {
            <div class="card">
                <div class="card-header">جلسة امتحان جديدة</div>
                <div class="card-body">
                    <form asp-action="AddExamSession" asp-route-id="@c.Id" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-md-2"><label class="form-label small" for="ns-type">النوع</label><select id="ns-type" name="type" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<ExamSessionType>()"></select></div>
                        <div class="col-md-3"><label class="form-label small" for="ns-title">العنوان</label><input id="ns-title" name="title" class="form-control form-control-sm" maxlength="200" required /></div>
                        <div class="col-md-3"><label class="form-label small" for="ns-at">الموعد</label><input id="ns-at" name="scheduledAt" type="datetime-local" class="form-control form-control-sm" required /></div>
                        <div class="col-md-2"><label class="form-label small" for="ns-duration">المدة (دقيقة)</label><input id="ns-duration" name="durationMinutes" type="number" min="1" max="600" class="form-control form-control-sm" required /></div>
                        <div class="col-md-2"><label class="form-label small" for="ns-capacity">السعة</label><input id="ns-capacity" name="capacity" type="number" min="1" class="form-control form-control-sm" required /></div>
                        <div class="col-md-5"><label class="form-label small" for="ns-venue">المكان</label><input id="ns-venue" name="venue" class="form-control form-control-sm" maxlength="300" required /></div>
                        <div class="col-md-2"><label class="form-label small" for="ns-max">العلامة العظمى</label><input id="ns-max" name="maxScore" type="number" step="0.01" min="0.01" class="form-control form-control-sm" required /></div>
                        <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm">إضافة الجلسة</button></div>
                    </form>
                </div>
            </div>
        }
    </div>
    <div class="tab-pane fade" id="tab-scores" role="tabpanel" aria-labelledby="tab-scores-btn">
        @if (Model.ExamSessions.Count == 0)
        {
            <p class="text-muted mb-0">تظهر حالة التصحيح بعد جلسات الامتحان.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th scope="col">الجلسة</th><th scope="col">الحاضرون</th><th scope="col">مكتمل التصحيح</th><th scope="col">بانتظار المصحح الثالث</th><th scope="col">الحالة</th></tr></thead>
                    <tbody>
                        @foreach (var row in Model.ExamSessions)
                        {
                            <tr>
                                <td><a asp-action="ExamSession" asp-route-id="@row.Session.Id">@row.Session.Title</a></td>
                                <td>@row.Present</td>
                                <td>@row.Complete</td>
                                <td>@row.AwaitingReconciler</td>
                                <td>@Html.HrEnumDisplay(row.Session.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="tab-pane fade" id="tab-results" role="tabpanel" aria-labelledby="tab-results-btn">
        @{ var latest = Model.LatestVersion; }
        @if (Model.CanWrite && c.Status is RecruitmentCompetitionStatus.Examining or RecruitmentCompetitionStatus.ResultsDraft or RecruitmentCompetitionStatus.ResultsPublished)
        {
            <form asp-action="ComputeResults" asp-route-id="@c.Id" method="post" class="row g-2 align-items-end mb-3"
                  data-hr-confirm="ستُحتسب مسودة النتائج من العلامات المغلقة وتقييمات المراحل الأخرى (تُستبدل المسودة الحالية إن وُجدت)." data-hr-confirm-title="احتساب النتائج">
                @Html.AntiForgeryToken()
                <div class="col-md-8">
                    <label for="computeReason" class="form-label small">سبب النسخة (يُطلب للنسخ اللاحقة)</label>
                    <input id="computeReason" name="reason" class="form-control form-control-sm" maxlength="1000" />
                </div>
                <div class="col-md-4"><button type="submit" class="btn btn-primary btn-sm">احتساب مسودة النتائج</button></div>
            </form>
        }
        @if (Model.ResultVersions.Count == 0)
        {
            <p class="text-muted">لم تُحتسب النتائج بعد.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th scope="col">النسخة</th><th scope="col">الحالة</th><th scope="col">الاحتساب</th><th scope="col">النشر</th><th scope="col">المتقدمون</th><th scope="col">الناجحون</th><th scope="col">تعادل</th><th scope="col">تغييرات</th><th scope="col">رمز التحقق</th><th scope="col">السبب</th></tr></thead>
                    <tbody>
                        @foreach (var v in Model.ResultVersions)
                        {
                            <tr>
                                <td>@v.Version.VersionNo</td>
                                <td>@Html.HrEnumDisplay(v.Version.Status)</td>
                                <td>@v.Version.ComputedAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                                <td>@(v.Version.PublishedAt?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td>@v.Candidates</td>
                                <td>@v.Passed</td>
                                <td>@v.Ties</td>
                                <td>@v.Changes</td>
                                <td><bdi dir="ltr">@(string.IsNullOrWhiteSpace(v.Version.Sha256) ? "—" : v.Version.Sha256.Trim()[..12].ToUpperInvariant())</bdi></td>
                                <td class="small">@(v.Version.Reason ?? "—")@(v.Version.ReturnReason is null ? "" : $" — أُعيدت: {v.Version.ReturnReason}")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (c.CurrentResultVersionId is not null)
            {
                <p class="small"><a asp-action="ResultsDocument" asp-route-id="@c.Id">تنزيل قائمة النتائج المنشورة (PDF)</a>
                    · <a href="/careers/competitions/@c.Id/results">الصفحة العامة</a></p>
            }
        }
        @if (latest is not null)
        {
            <h6 class="mt-3">النسخة @latest.VersionNo — @Html.HrEnumDisplay(latest.Status)</h6>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @if (Model.CanWrite && latest.Status == CompetitionResultVersionStatus.Draft)
                {
                    <form asp-action="SubmitResults" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="ستُقدَّم نسخة النتائج إلى مسار الاعتماد (لجنة المسابقة ثم مدير الموارد البشرية)." data-hr-confirm-title="تقديم النتائج للاعتماد">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="versionId" value="@latest.Id" />
                        <button type="submit" class="btn btn-primary btn-sm">تقديم للاعتماد</button>
                    </form>
                }
                @if (Model.CanWrite && latest.Status == CompetitionResultVersionStatus.Approved)
                {
                    <form asp-action="PublishResults" asp-route-id="@c.Id" method="post"
                          data-hr-confirm="ستُنشر النتائج (الرقم الامتحاني والنتيجة فقط) وتبدأ مدة الاعتراض عند أول نشر." data-hr-confirm-title="نشر النتائج" data-hr-confirm-variant="warning">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="versionId" value="@latest.Id" />
                        <button type="submit" class="btn btn-success btn-sm">نشر النتائج</button>
                    </form>
                }
            </div>
            @if (Model.ResultsWorkflow is { } resultsWorkflow)
            {
                <partial name="_CompetitionWorkflowPanel" model="resultsWorkflow"
                         view-data='new ViewDataDictionary(ViewData) { ["CompetitionId"] = c.Id, ["ApproveAction"] = "ApproveResultsWorkflow", ["RejectAction"] = "RejectResultsWorkflow", ["FieldPrefix"] = "results", ["VersionId"] = latest.Id }' />
            }
            @foreach (var tie in Model.Results.Where(r => r.TieUnresolved).GroupBy(r => r.Rank))
            {
                <div class="card border-warning mb-2">
                    <div class="card-header">@HR.Core.Domain.Services.CompetitionScoringRules.UnresolvedTieMessage — الرتبة @tie.Key</div>
                    <div class="card-body">
                        @if (Model.CanWrite && latest.Status == CompetitionResultVersionStatus.Draft)
                        {
                            <form asp-action="ResolveTie" asp-route-id="@c.Id" method="post" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="versionId" value="@latest.Id" />
                                @{ var position = 1; }
                                @foreach (var row in tie)
                                {
                                    <input type="hidden" name="applicationIds" value="@row.ApplicationId" />
                                    <div class="col-md-3">
                                        <label class="form-label small" for="tie-@row.ApplicationId">@row.ExamNumber — @row.ApplicantFullName</label>
                                        <input id="tie-@row.ApplicationId" name="positions" type="number" min="1" class="form-control form-control-sm" value="@(position++)" required />
                                    </div>
                                }
                                <div class="col-md-6">
                                    <label class="form-label small" for="tie-reason-@tie.Key">سبب القرار (يُسجَّل ويُعرض في الاعتماد)</label>
                                    <input id="tie-reason-@tie.Key" name="reason" class="form-control form-control-sm" minlength="10" maxlength="500" required />
                                </div>
                                <div class="col-md-2"><button type="submit" class="btn btn-warning btn-sm">تسجيل القرار</button></div>
                            </form>
                        }
                        else
                        {
                            <p class="mb-0 small">@string.Join("، ", tie.Select(r => r.ExamNumber))</p>
                        }
                    </div>
                </div>
            }
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <caption class="small">تُعرض أول 300 رتبة وكل حالات التعادل والغياب.</caption>
                    <thead><tr><th scope="col">الرتبة</th><th scope="col">الرقم الامتحاني</th><th scope="col">الاسم</th><th scope="col">نقاط الامتحان</th><th scope="col">الدرجة النهائية</th><th scope="col">النتيجة</th><th scope="col">ملاحظة</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Results)
                        {
                            <tr class="@(r.TieUnresolved ? "table-warning" : "")">
                                <td>@(r.Rank?.ToString() ?? "—")</td>
                                <td><bdi dir="ltr">@r.ExamNumber</bdi></td>
                                <td>@r.ApplicantFullName</td>
                                <td>@(r.ExamScore?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td>@(r.FinalScore?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td>@Html.HrEnumDisplay(r.Outcome)</td>
                                <td class="small">@(r.TieUnresolved ? HR.Core.Domain.Services.CompetitionScoringRules.UnresolvedTieMessage : r.TieDecisionReason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="tab-pane fade" id="tab-objections" role="tabpanel" aria-labelledby="tab-objections-btn">
        @if (Model.ObjectionDeadlineUtc is DateTime objectionDeadline)
        {
            <p class="small">آخر موعد للاعتراض: @objectionDeadline.ToString("yyyy/MM/dd HH:mm", CultureInfo.InvariantCulture) UTC (يُحسب من أول نشر ولا يُعاد فتحه بنسخ لاحقة).</p>
            @if (Model.CanWrite && DateTime.UtcNow <= objectionDeadline && c.Status == RecruitmentCompetitionStatus.ResultsPublished)
            {
                <form asp-action="FileObjection" asp-route-id="@c.Id" method="post" class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label for="objExam" class="form-label small">الرقم الامتحاني</label>
                        <input id="objExam" name="examNumber" class="form-control form-control-sm" maxlength="16" required />
                    </div>
                    <div class="col-md-6">
                        <label for="objReason" class="form-label small">سبب الاعتراض (نيابةً عن المتقدم)</label>
                        <input id="objReason" name="reason" class="form-control form-control-sm" maxlength="2000" required />
                    </div>
                    <div class="col-md-3"><button type="submit" class="btn btn-outline-primary btn-sm">تسجيل اعتراض</button></div>
                </form>
            }
        }
        else
        {
            <p class="text-muted">تظهر الاعتراضات بعد نشر النتائج.</p>
        }
        @if (Model.Objections.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th scope="col">المتقدم</th><th scope="col">الرقم الامتحاني</th><th scope="col">مقدم من</th><th scope="col">التاريخ</th><th scope="col">الحالة</th><th scope="col">النتيجة</th><th scope="col">المراجع</th></tr></thead>
                    <tbody>
                        @foreach (var o in Model.Objections)
                        {
                            <tr>
                                <td><a asp-controller="RecruitmentAppeals" asp-action="Details" asp-route-id="@o.AppealId">@o.ApplicantFullName</a></td>
                                <td><bdi dir="ltr">@(o.ExamNumber ?? "—")</bdi></td>
                                <td>@(o.FiledBy == HR.Core.Domain.Entities.RecruitmentAppealFiledBy.Candidate ? "المتقدم" : "الموارد البشرية")</td>
                                <td>@o.FiledAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                <td>@Html.HrEnumDisplay(o.Status)</td>
                                <td>@if (o.Outcome is { } oc) { @Html.HrEnumDisplay(oc) } else { <text>—</text> }@(o.CorrectedScore is decimal cs ? $" ({cs.ToString("0.##", CultureInfo.InvariantCulture)})" : "")</td>
                                <td>@(o.HasReviewer ? "معيّن" : "لم يُعيّن")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="tab-pane fade" id="tab-allocation" role="tabpanel" aria-labelledby="tab-allocation-btn">
        <p class="text-muted mb-0">يتاح التخصيص والعروض بعد انتهاء مدة الاعتراض.</p>
    </div>
</div>

@if (Model.CanApprove && HR.Core.Domain.Services.CompetitionWorkflowRules.CanCancel(c.Status))
{
    <div class="card border-danger">
        <div class="card-header">إلغاء المسابقة</div>
        <div class="card-body">
            <form asp-action="Cancel" asp-route-id="@c.Id" method="post" class="row g-2 align-items-end"
                  data-hr-confirm="ستُلغى المسابقة ويُرفض كل طلب تقديم مفتوح عليها." data-hr-confirm-title="إلغاء المسابقة" data-hr-confirm-variant="danger">
                @Html.AntiForgeryToken()
                <div class="col-md-9">
                    <label for="cancelReason" class="form-label">سبب الإلغاء (10 أحرف على الأقل)</label>
                    <input id="cancelReason" name="reason" class="form-control" maxlength="500" required minlength="10" />
                </div>
                <div class="col-md-3"><button type="submit" class="btn btn-danger">إلغاء المسابقة</button></div>
            </form>
        </div>
    </div>
}
