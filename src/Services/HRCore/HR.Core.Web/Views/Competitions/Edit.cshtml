@model HR.Core.Web.ViewModels.CompetitionFormViewModel
@{ ViewData["Title"] = "تعديل المسابقة"; }

<div class="card">
    <div class="card-header"><h3 class="mb-0">تعديل المسابقة</h3></div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <partial name="_CompetitionForm" model="Model" />
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">حفظ</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">رجوع</a>
            </div>
        </form>
    </div>
</div>
