@model HR.Core.Web.ViewModels.CompetitionIndexViewModel
@using HR.Core.Domain.Enums
@{ ViewData["Title"] = "مسابقات التوظيف"; }

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">مسابقات التوظيف</h3>
        @if (Model.CanWrite)
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus" aria-hidden="true"></i> مسابقة جديدة</a>
        }
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3 align-items-end">
            <div class="col-md-4">
                <label for="status" class="form-label">الحالة</label>
                <select id="status" name="status" class="form-select" asp-items="Html.GetEnumSelectList<RecruitmentCompetitionStatus>()">
                    <option value="">— الكل —</option>
                </select>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary">تصفية</button></div>
        </form>

        @if (Model.Rows.Count == 0)
        {
            <p class="text-muted mb-0">لا توجد مسابقات.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th scope="col">الرقم</th>
                            <th scope="col">العنوان</th>
                            <th scope="col">الحالة</th>
                            <th scope="col">إغلاق التقديم</th>
                            <th scope="col">الأسطر</th>
                            <th scope="col">الشواغر</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td><a asp-action="Details" asp-route-id="@row.Id">@row.Number</a></td>
                                <td>@row.Title</td>
                                <td><span class="badge bg-secondary">@Html.HrEnumDisplay(row.Status)</span></td>
                                <td>@row.ApplicationClosingDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td>@row.Lines</td>
                                <td>@row.Vacancies</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
