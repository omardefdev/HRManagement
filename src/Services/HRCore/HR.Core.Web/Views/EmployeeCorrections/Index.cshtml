@{
    ViewData["Title"] = "تصحيحات الموظفين";
    Layout = "_Layout";
}
@model IList<HR.Core.Domain.Entities.EmployeeCorrection>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">طلبات تصحيح بيانات الموظفين (DATA-002)</h3>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>المعرف</th>
                <th>الموظف</th>
                <th>السبب</th>
                <th>الحالة</th>
                <th>قانوني</th>
                <th>طلب</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@c.Id.ToString()[..8]</code></td>
                    <td><code>@c.EmployeeId.ToString()[..8]</code></td>
                    <td>@c.Reason</td>
                    <td>@c.Status</td>
                    <td>@(c.RequiresLegalApproval ? "نعم" : "لا")</td>
                    <td>@c.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (c.Status == HRManagement.SharedKernel.Enums.ApprovalStatus.Pending)
                        {
                            <form asp-action="Approve" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-success btn-xs">اعتماد</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">لا توجد طلبات</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
