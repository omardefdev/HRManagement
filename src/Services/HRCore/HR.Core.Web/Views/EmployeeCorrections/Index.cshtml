@model HR.Core.Web.ViewModels.EmployeeCorrectionsIndexViewModel
@using HRManagement.SharedKernel.Enums
@{
    ViewData["Title"] = "تصحيحات الموظفين";
    Layout = "_Layout";
    string FilterEmployeeLabel(Guid id) =>
        !string.IsNullOrWhiteSpace(Model.FilterEmployeeName) ? Model.FilterEmployeeName! : id.ToString();
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">طلبات تصحيح بيانات الموظفين (DATA-002)</h3>
    </div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">الموظف</label>
                <select name="employeeId" class="form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف...">
                    <option value="">— الكل —</option>
                    @if (Model.EmployeeId is Guid empId)
                    {
                        <option value="@empId" selected="selected">@FilterEmployeeLabel(empId)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select">
                    <option value="">— الكل —</option>
                    @foreach (ApprovalStatus s in Enum.GetValues<ApprovalStatus>())
                    {
                        if (Model.Status == s) { <option value="@((int)s)" selected="selected">@Html.HrEnumDisplay(s)</option> }
                        else { <option value="@((int)s)">@Html.HrEnumDisplay(s)</option> }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">يتطلب موافقة قانونية</label>
                <select name="requiresLegalApproval" class="form-select">
                    <option value="">— الكل —</option>
                    @if (Model.RequiresLegalApproval == true) { <option value="true" selected>نعم</option> } else { <option value="true">نعم</option> }
                    @if (Model.RequiresLegalApproval == false) { <option value="false" selected>لا</option> } else { <option value="false">لا</option> }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">من تاريخ</label>
                <input type="datetime-local" name="createdFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">إلى تاريخ</label>
                <input type="datetime-local" name="createdTo" value="@Model.CreatedTo?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
            <tr>
                <th>المعرف</th>
                <th>الموظف</th>
                <th>السبب</th>
                <th>الحالة</th>
                <th>قانوني</th>
                <th>طلب</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Items)
            {
                <tr>
                    <td><code>@c.Id.ToString()[..8]</code></td>
                    <td><span data-hr-employee-id="@c.EmployeeId">جاري التحميل...</span></td>
                    <td>@c.Reason</td>
                    <td>@Html.HrEnumDisplay(c.Status)</td>
                    <td>@(c.RequiresLegalApproval ? "نعم" : "لا")</td>
                    <td>@c.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (c.Status == ApprovalStatus.Pending)
                        {
                            <form asp-action="Approve" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-success btn-xs">اعتماد</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">لا توجد طلبات</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
