@model HR.Core.Web.ViewModels.WorkflowPanelViewModel
@{
    var offerId = ViewData["OfferId"] as Guid? ?? Guid.Empty;
    ViewData["WorkflowController"] = "OfferLetters";
    ViewData["WorkflowApproveAction"] = "ApproveWorkflow";
    ViewData["WorkflowRejectAction"] = "RejectWorkflow";
    ViewData["WorkflowEntityId"] = offerId;
    ViewData["WorkflowEntityIdFieldName"] = "OfferId";
    ViewData["WorkflowConfirmReject"] = "رفض خطاب العرض وإرجاعه إلى المسودة؟";
}

@if (!string.IsNullOrWhiteSpace(Model.MissingWorkflowWarning))
{
    <div class="alert alert-warning">@Model.MissingWorkflowWarning</div>
}

@if (Model.HasWorkflowInstance)
{
    <h6 class="mt-3">مسار اعتماد العرض</h6>
    <p class="text-muted small mb-2">
        @(Model.WorkflowName ?? Model.WorkflowCode ?? "—")
        @if (Model.WorkflowStatus is not null)
        {
            <span class="badge bg-light text-dark ms-1">@Model.WorkflowStatus</span>
        }
    </p>
    <partial name="_WorkflowProgressPanel" model="Model.Steps" />

    @if (!string.IsNullOrWhiteSpace(Model.BlockReason))
    {
        <div class="alert alert-info mt-3 mb-0">@Model.BlockReason</div>
    }

    @if (Model.CanApprove || Model.CanReject)
    {
        <partial name="_WorkflowActionPanel" model="Model" />
    }
}
