@model HR.Core.Web.ViewModels.OfferLettersIndexViewModel
@using HR.Core.Domain.Enums
@using HRManagement.ServiceDefaults

@{
    ViewData["Title"] = "خطابات العرض";
    var canWrite = User.IsInRole(HrManagementRoles.Admin) || User.IsInRole(HrManagementRoles.HrCore);
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">خطابات العرض</h3>
    </div>

    <div class="card-body border-bottom">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">بحث</label>
                <input name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="رقم العرض أو اسم المرشح" />
            </div>
            <div class="col-md-3">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-select">
                    <option value="">كل الحالات</option>
                    @foreach (OfferStatus s in Enum.GetValues<OfferStatus>())
                    {
                        <option value="@((int)s)" selected="@(Model.Status == s ? "selected" : null)">@Html.HrEnumDisplay(s)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> بحث</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>رقم العرض</th>
                    <th>المتقدم</th>
                    <th>الراتب</th>
                    <th>الحالة</th>
                    <th>تاريخ المباشرة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var offer in Model.Offers)
            {
                <tr>
                    <td>@offer.OfferNumber</td>
                    <td>@(offer.RecruitmentApplication?.ApplicantFullName ?? "—")</td>
                    <td>@offer.OfferedSalary.ToString("N2")</td>
                    <td>@Html.HrEnumDisplay(offer.Status)</td>
                    <td>@offer.ProposedStartDate.ToString("yyyy/MM/dd")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@offer.Id" class="btn btn-sm btn-outline-info">
                            <i class="fas fa-eye"></i> تفاصيل
                        </a>
                        @if (offer.RecruitmentApplicationId != Guid.Empty)
                        {
                            <a asp-controller="RecruitmentApplications" asp-action="Details"
                               asp-route-id="@offer.RecruitmentApplicationId" class="btn btn-sm btn-link">الطلب</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Offers.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">لا توجد خطابات عرض</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
