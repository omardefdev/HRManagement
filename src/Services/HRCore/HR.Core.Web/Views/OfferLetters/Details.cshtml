@model HR.Core.Web.ViewModels.OfferLetterDetailsViewModel
@using HR.Core.Domain.Enums
@using HRManagement.ServiceDefaults

@{
    ViewData["Title"] = "تفاصيل خطاب العرض";
    var offer = Model.Offer;
    var app = offer.RecruitmentApplication;
    var canWrite = User.IsInRole(HrManagementRoles.Admin) || User.IsInRole(HrManagementRoles.HrCore);
}

@if (Model.NextCandidate is not null && canWrite)
{
    <partial name="_NextCandidateBanner" model="Model.NextCandidate" />
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">@offer.OfferNumber — @Html.HrEnumDisplay(offer.Status)</h3>
        <div class="d-flex gap-1 flex-wrap">
            @if (app is not null)
            {
                <a asp-controller="RecruitmentApplications" asp-action="Details" asp-route-id="@app.Id" class="btn btn-outline-primary btn-sm">طلب التوظيف</a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">رجوع</a>
        </div>
    </div>
    <div class="card-body">
        @if (offer.IsExceptionOffer)
        {
            <div class="alert alert-warning">
                @if (offer.IsMeritOverride)
                {
                    <span class="badge bg-warning text-dark ms-1">عرض استثنائي — تجاوز الجدارة</span>
                }
                @if (offer.IsGradeDeviation)
                {
                    <span class="badge bg-warning text-dark ms-1">عرض استثنائي — اختلاف الدرجة</span>
                }
                @if (offer.SalaryUnverified)
                {
                    <span class="badge bg-danger ms-1">راتب غير متحقق منه</span>
                }
                @if (offer.IsMeritOverride)
                {
                    <div class="mt-2"><strong>مبرر تجاوز الجدارة:</strong> @offer.MeritOverrideReason</div>
                }
                @if (offer.IsGradeDeviation)
                {
                    <div class="mt-2"><strong>مبرر اختلاف الدرجة:</strong> @offer.GradeDeviationReason</div>
                }
                @if (offer.SalaryUnverified)
                {
                    <div class="mt-2"><strong>مبرر الراتب:</strong> @offer.SalaryJustification</div>
                    <div class="form-text">تعذّر التحقق من حدود الدرجة في الرواتب عند إنشاء العرض.</div>
                }
                <div class="form-text">يتطلب اعتماد ثلاث خطوات بمعتمدين مختلفين (RECRUITMENT-OFFER-OVERRIDE-APPROVAL).</div>
            </div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-3">المتقدم</dt><dd class="col-sm-9">@(app?.ApplicantFullName ?? "—")</dd>
            <dt class="col-sm-3">الراتب المعروض</dt><dd class="col-sm-9">@offer.OfferedSalary.ToString("N2")</dd>
            <dt class="col-sm-3">الدرجة</dt>
            <dd class="col-sm-9">
                @(offer.GradeCode ?? "—")
                @if (offer.FundedPosition?.GradeCode is string positionGrade)
                {
                    <span class="text-muted">(درجة المنصب: @positionGrade)</span>
                }
            </dd>
            <dt class="col-sm-3">حدود الدرجة</dt>
            <dd class="col-sm-9">
                @if (offer.GradeMinSalary is decimal gMin && offer.GradeMaxSalary is decimal gMax)
                {
                    @(HR.Core.Domain.Services.OfferTermsRules.FormatAmount(gMin) + "–" + HR.Core.Domain.Services.OfferTermsRules.FormatAmount(gMax))
                    <span class="text-muted">(تحقق في @(offer.SalaryCheckedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—"))</span>
                }
                else
                {
                    <span>—</span>
                }
            </dd>
            <dt class="col-sm-3">تاريخ المباشرة</dt><dd class="col-sm-9">@offer.ProposedStartDate.ToString("yyyy/MM/dd")</dd>
            <dt class="col-sm-3">تاريخ الإصدار</dt><dd class="col-sm-9">@(offer.IssuedDate?.ToString("yyyy/MM/dd") ?? "—")</dd>
            <dt class="col-sm-3">تاريخ الانتهاء</dt><dd class="col-sm-9">@(offer.ExpiryDate?.ToString("yyyy/MM/dd") ?? "—")</dd>
            <dt class="col-sm-3">مدة الصلاحية</dt><dd class="col-sm-9">@offer.ValidityDays يوماً (تُحسب من تاريخ الإصدار)</dd>
            <dt class="col-sm-3">تاريخ القبول</dt><dd class="col-sm-9">@(offer.AcceptedDate?.ToString("yyyy/MM/dd") ?? "—")</dd>
            @if (offer.Status == OfferStatus.Declined)
            {
                <dt class="col-sm-3">تاريخ الرفض</dt><dd class="col-sm-9">@(offer.DeclinedAt?.ToString("yyyy/MM/dd") ?? "—")</dd>
                <dt class="col-sm-3">رفض بواسطة</dt>
                <dd class="col-sm-9">@(offer.DeclinedBy == HR.Core.Domain.Entities.OfferDeclinedBy.Candidate ? "المرشح" : "HR نيابة عن المرشح")</dd>
                <dt class="col-sm-3">سبب الرفض</dt><dd class="col-sm-9">@(offer.DeclineReason ?? "—")</dd>
            }
            @if (offer.Status == OfferStatus.Revoked)
            {
                <dt class="col-sm-3">تاريخ الإلغاء</dt><dd class="col-sm-9">@(offer.RevokedAt?.ToString("yyyy/MM/dd") ?? "—")</dd>
                <dt class="col-sm-3">سبب الإلغاء</dt><dd class="col-sm-9">@(offer.RevokeReason ?? "—")</dd>
            }
            @if (offer.Status == OfferStatus.Expired)
            {
                <dt class="col-sm-3">انتهت الصلاحية في</dt><dd class="col-sm-9">@(offer.ExpiredAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</dd>
            }
            <dt class="col-sm-3">مرجع قانوني</dt>
            <dd class="col-sm-9">
                @(ViewBag.LegalSourceLabel ?? "—")
                @if (ViewBag.LegalSourceLabel is not null)
                {
                    <div class="form-text">يُورَّث من طلب الشاغر — غير قابل للتعديل في هذه المرحلة.</div>
                }
            </dd>
        </dl>

        @if (offer.Status == OfferStatus.PendingApproval)
        {
            ViewData["OfferId"] = offer.Id;
            <partial name="_OfferWorkflowPanel" model="Model.Workflow" />
        }
    </div>
    @if (canWrite && (Model.CanSubmit || Model.CanAccept))
    {
        <div class="card-footer d-flex flex-wrap gap-2">
            @if (Model.CanSubmit)
            {
                <form asp-action="SubmitOffer" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@offer.Id" />
                    <button type="submit" class="btn btn-warning btn-sm">تقديم للاعتماد</button>
                </form>
            }
            @if (Model.CanAccept)
            {
                <form asp-action="AcceptOffer" method="post" class="d-inline" onsubmit="return confirm('تأكيد قبول خطاب العرض؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@offer.Id" />
                    <button type="submit" class="btn btn-success btn-sm">قبول العرض</button>
                </form>
            }
        </div>
        @if (Model.CanDecline || Model.CanRevoke)
        {
            <div class="card-footer">
                <div class="row g-3">
                    @if (Model.CanDecline)
                    {
                        <div class="col-md-6">
                            <form asp-action="DeclineOffer" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@offer.Id" />
                                <h6>رفض العرض</h6>
                                <p class="form-text mb-1">يُسجَّل الرفض بواسطة: HR نيابة عن المرشح.</p>
                                <label class="form-label" for="DeclineReason">سبب الرفض</label>
                                <textarea name="Reason" id="DeclineReason" class="form-control mb-2" rows="2"
                                          minlength="@HR.Core.Domain.Services.OfferWorkflowRules.MinDeclineReasonLength" maxlength="1000" required></textarea>
                                <button type="submit" class="btn btn-outline-danger btn-sm">تسجيل رفض المرشح</button>
                            </form>
                        </div>
                    }
                    @if (Model.CanRevoke)
                    {
                        <div class="col-md-6">
                            <form asp-action="Revoke" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@offer.Id" />
                                <h6>إلغاء العرض</h6>
                                <label class="form-label" for="RevokeReason">سبب الإلغاء</label>
                                <textarea name="Reason" id="RevokeReason" class="form-control mb-2" rows="2"
                                          minlength="@HR.Core.Domain.Services.OfferWorkflowRules.MinRevokeReasonLength" maxlength="1000" required></textarea>
                                <div class="form-check mb-2">
                                    <input type="checkbox" name="RevertToRanked" value="true" id="RevertToRanked" class="form-check-input" />
                                    <label class="form-check-label" for="RevertToRanked">خطأ إداري — إعادة المرشح إلى المرتبين</label>
                                </div>
                                <button type="submit" class="btn btn-danger btn-sm">إلغاء العرض</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
