@using HR.Core.Domain.Enums
@model HR.Core.Domain.Entities.SuccessionPlan
@{
    ViewData["Title"] = "تفاصيل خطة التعاقب";
    string Badge(ReadinessLevel r) => r switch
    {
        ReadinessLevel.ReadyNow => "bg-success",
        ReadinessLevel.ReadyWithinYear => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">@(Model.KeyPosition?.Title ?? "خطة تعاقب") — @Model.Year</h3>
        <div>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  data-hr-confirm="حذف الخطة؟"
                  data-hr-confirm-title="تأكيد الحذف"
                  data-hr-confirm-variant="danger"
                  data-hr-confirm-label="حذف">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">حذف</button>
            </form>
            <a asp-action="Index" class="btn btn-link">رجوع</a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="card-body"><p class="mb-0">@Model.Notes</p></div>
    }
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">إضافة مرشّح</h5></div>
    <div class="card-body">
        <p class="text-muted small">تُحتسب الجاهزية تلقائياً من الدرجة وسنوات الخدمة والمؤهل. إن تُرك حقل الدرجة فارغاً يؤخذ آخر تقييم معتمد.</p>
        <form asp-action="AddCandidate" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="successionPlanId" value="@Model.Id" />
            <div class="col-md-4"><label class="form-label">الموظف</label><select name="employeeId" asp-items="ViewBag.Employees" class="form-control" required></select></div>
            <div class="col-md-2"><label class="form-label">آخر درجة تقييم</label><input name="latestEvaluationScore" type="number" step="0.1" class="form-control" placeholder="تلقائي" /></div>
            <div class="col-md-2"><label class="form-label">سنوات الخدمة</label><input name="yearsInService" type="number" min="0" value="0" class="form-control" /></div>
            <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input name="meetsQualification" value="true" type="checkbox" class="form-check-input" checked /><label class="form-check-label">يستوفي المؤهل</label></div></div>
            <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-primary w-100">إضافة</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="mb-0">المرشّحون</h5></div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الموظف</th><th>الدرجة</th><th>سنوات الخدمة</th><th>المؤهل</th><th>الجاهزية</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model.Candidates.OrderByDescending(c => c.Readiness))
                {
                    <tr>
                        <td><span data-hr-employee-id="@c.EmployeeId">@(c.Employee?.FullName ?? "جاري التحميل...")</span></td>
                        <td>@c.LatestEvaluationScore</td>
                        <td>@c.YearsInService</td>
                        <td>@(c.MeetsQualification ? "نعم" : "لا")</td>
                        <td><span class="badge @Badge(c.Readiness)">@Html.DisplayFor(_ => c.Readiness)</span></td>
                        <td>
                            <form asp-action="RemoveCandidate" method="post"
                                  data-hr-confirm="حذف المرشّح؟"
                                  data-hr-confirm-title="تأكيد الحذف"
                                  data-hr-confirm-variant="danger"
                                  data-hr-confirm-label="حذف">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <input type="hidden" name="successionPlanId" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-xs">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Candidates.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا مرشّحين</td></tr> }
            </tbody>
        </table>
    </div>
</div>
