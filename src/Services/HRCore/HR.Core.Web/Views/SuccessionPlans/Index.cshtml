@model HR.Core.Web.ViewModels.SuccessionPlansIndexViewModel
@{ ViewData["Title"] = "خطط التعاقب الوظيفي"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">خطط التعاقب الوظيفي</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">خطة جديدة</a>
    </div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">المنصب الحرج</label>
                <select name="keyPositionId" asp-items="ViewBag.KeyPositions" class="form-select"><option value="">— الكل —</option></select>
            </div>
            <div class="col-md-2">
                <label class="form-label">السنة</label>
                <input type="number" name="year" value="@Model.Year" class="form-control" min="2000" max="2100" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>المنصب الحرج</th><th>السنة</th><th>عدد المرشّحين</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model.Items)
                {
                    <tr>
                        <td>@(x.KeyPosition?.Title ?? "—")</td>
                        <td>@x.Year</td>
                        <td>@x.Candidates.Count</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-outline-info btn-xs">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Items.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">لا خطط</td></tr> }
            </tbody>
        </table>
    </div>
</div>
