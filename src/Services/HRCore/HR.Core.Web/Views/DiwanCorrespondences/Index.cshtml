@model IReadOnlyList<HR.Core.Domain.Entities.DiwanCorrespondence>
@{ ViewData["Title"] = "سجل الديوان"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">المكاتبات</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>المرجع</th><th>الموضوع</th><th>الاتجاه</th><th>التسجيل</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.ReferenceNumber</td><td>@x.Subject</td><td>@x.Direction</td><td>@x.RegisteredAt</td></tr>}
@if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
