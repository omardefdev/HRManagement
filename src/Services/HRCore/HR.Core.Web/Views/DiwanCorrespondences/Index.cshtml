@model HR.Core.Web.ViewModels.DiwanCorrespondencesIndexViewModel
@using HR.Core.Domain.Enums
@{ ViewData["Title"] = "سجل الديوان";
   string FilterEmployeeLabel(Guid id) =>
       !string.IsNullOrWhiteSpace(Model.FilterEmployeeName) ? Model.FilterEmployeeName! : id.ToString(); }
<div class="card">
    <div class="card-header d-flex justify-content-between"><h3 class="mb-0">المكاتبات</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">بحث</label>
                <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="المرجع أو الموضوع..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">الاتجاه</label>
                <select name="direction" class="form-select">
                    <option value="">— الكل —</option>
                    @foreach (CorrespondenceDirection d in Enum.GetValues<CorrespondenceDirection>())
                    {
                        if (Model.Direction == d) { <option value="@((int)d)" selected="selected">@Html.HrEnumDisplay(d)</option> }
                        else { <option value="@((int)d)">@Html.HrEnumDisplay(d)</option> }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">موظف مرتبط</label>
                <select name="relatedEmployeeId" class="form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف...">
                    <option value="">— الكل —</option>
                    @if (Model.RelatedEmployeeId is Guid empId)
                    {
                        <option value="@empId" selected="selected">@FilterEmployeeLabel(empId)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">مسجّل من</label>
                <input type="datetime-local" name="registeredFrom" value="@Model.RegisteredFrom?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">مسجّل إلى</label>
                <input type="datetime-local" name="registeredTo" value="@Model.RegisteredTo?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table mb-0"><thead><tr><th>المرجع</th><th>الموضوع</th><th>الاتجاه</th><th>التسجيل</th></tr></thead><tbody>
        @foreach (var x in Model.Items){<tr><td>@x.ReferenceNumber</td><td>@x.Subject</td><td>@Html.HrEnumDisplay(x.Direction)</td><td>@x.RegisteredAt</td></tr>}
        @if(!Model.Items.Any()){<tr><td colspan="4" class="text-center text-muted">لا توجد</td></tr>}</tbody></table>
    </div>
</div>
