@model HR.Core.Web.ViewModels.ApprovalListViewModel
@{
    ViewData["Title"] = "سجل طلبات الموافقة";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
        <div class="card-tools">
            <a asp-action="Pending" class="btn btn-warning btn-sm">
                <i class="fas fa-clock"></i> الطلبات المعلقة
            </a>
        </div>
    </div>
    <div class="card-body">
        <form method="get" class="row mb-3 g-2">
            <div class="col-md-3">
                <input type="text" name="filter.SearchTerm" value="@Model.Filter.SearchTerm"
                       class="form-control form-control-sm" placeholder="بحث بالوصف أو مقدّم الطلب..." />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-control form-control-sm">
                    <option value="">كل الحالات</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">معلق</option>
                    <option value="Approved" selected="@(Model.StatusFilter == "Approved")">موافق عليه</option>
                    <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">مرفوض</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">ملغى</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="entityType" class="form-control form-control-sm">
                    <option value="">كل الأنواع</option>
                    <option value="Employee" selected="@(Model.EntityTypeFilter == "Employee")">موظف</option>
                    <option value="Evaluation" selected="@(Model.EntityTypeFilter == "Evaluation")">تقييم</option>
                    <option value="EmploymentRecord" selected="@(Model.EntityTypeFilter == "EmploymentRecord")">سجل وظيفي</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>نوع الكيان</th>
                        <th>الوصف</th>
                        <th>مقدّم الطلب</th>
                        <th>تاريخ الطلب</th>
                        <th>الحالة</th>
                        <th>المراجع</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.Requests.Items)
                    {
                        <tr>
                            <td>@req.EntityType</td>
                            <td>@(req.Description ?? "—")</td>
                            <td>@(req.RequestedByName ?? "—")</td>
                            <td dir="ltr">@req.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @switch (req.Status)
                                {
                                    case HRManagement.SharedKernel.Enums.ApprovalStatus.Pending:
                                        <span class="badge text-bg-warning">معلق</span>
                                        break;
                                    case HRManagement.SharedKernel.Enums.ApprovalStatus.Approved:
                                        <span class="badge text-bg-success">موافق عليه</span>
                                        break;
                                    case HRManagement.SharedKernel.Enums.ApprovalStatus.Rejected:
                                        <span class="badge text-bg-danger">مرفوض</span>
                                        break;
                                    case HRManagement.SharedKernel.Enums.ApprovalStatus.Cancelled:
                                        <span class="badge text-bg-secondary">ملغى</span>
                                        break;
                                }
                            </td>
                            <td>@(req.ReviewedByName ?? "—")</td>
                            <td>
                                <a asp-action="Review" asp-route-id="@req.Id" class="btn btn-info btn-xs">
                                    <i class="fas fa-eye"></i> مراجعة
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_HrPagination", (object?)null, new ViewDataDictionary(ViewData) {
            ["CurrentPage"] = Model.Requests.PageIndex,
            ["TotalPages"] = Model.Requests.TotalPages,
            ["PaginationAction"] = "Index"
        })
    </div>
</div>
