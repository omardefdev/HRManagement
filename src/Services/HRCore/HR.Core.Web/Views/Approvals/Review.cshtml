@model HR.Core.Web.ViewModels.ApprovalReviewViewModel
@{
    ViewData["Title"] = "مراجعة طلب الموافقة";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-gavel"></i> @ViewData["Title"]</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">نوع الكيان</dt>
                    <dd class="col-sm-8">@Model.EntityType</dd>

                    <dt class="col-sm-4">الوصف</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "—")</dd>

                    <dt class="col-sm-4">مقدّم الطلب</dt>
                    <dd class="col-sm-8">@(Model.RequestedByName ?? "—")</dd>

                    <dt class="col-sm-4">تاريخ الطلب</dt>
                    <dd class="col-sm-8" dir="ltr">@Model.RequestedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-4">الحالة</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Status)
                        {
                            case HRManagement.SharedKernel.Enums.ApprovalStatus.Pending:
                                <span class="badge text-bg-warning">معلق</span>
                                break;
                            case HRManagement.SharedKernel.Enums.ApprovalStatus.Approved:
                                <span class="badge text-bg-success">موافق عليه</span>
                                break;
                            case HRManagement.SharedKernel.Enums.ApprovalStatus.Rejected:
                                <span class="badge text-bg-danger">مرفوض</span>
                                break;
                            case HRManagement.SharedKernel.Enums.ApprovalStatus.Cancelled:
                                <span class="badge text-bg-secondary">ملغى</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">المستوى الحالي</dt>
                    <dd class="col-sm-8">@Model.CurrentLevel</dd>
                </dl>

                <h5 class="mt-4">خطوات الموافقة</h5>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>المستوى</th>
                            <th>الدور المطلوب</th>
                            <th>الحالة</th>
                            <th>المراجع</th>
                            <th>التاريخ</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var step in Model.Steps)
                        {
                            <tr class="@(step.Status == HRManagement.SharedKernel.Enums.ApprovalStatus.Approved ? "table-success" :
                                          step.Status == HRManagement.SharedKernel.Enums.ApprovalStatus.Rejected ? "table-danger" : "")">
                                <td>@step.Level</td>
                                <td>@step.RoleRequired</td>
                                <td>
                                    @switch (step.Status)
                                    {
                                        case HRManagement.SharedKernel.Enums.ApprovalStatus.Pending:
                                            <span class="badge text-bg-warning">معلق</span>
                                            break;
                                        case HRManagement.SharedKernel.Enums.ApprovalStatus.Approved:
                                            <span class="badge text-bg-success">موافق</span>
                                            break;
                                        case HRManagement.SharedKernel.Enums.ApprovalStatus.Rejected:
                                            <span class="badge text-bg-danger">مرفوض</span>
                                            break;
                                    }
                                </td>
                                <td>@(step.ReviewedByName ?? "—")</td>
                                <td dir="ltr">@(step.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>@(step.Comments ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.Status == HRManagement.SharedKernel.Enums.ApprovalStatus.Pending)
                {
                    <hr />
                    <div class="mb-3">
                        <label for="reviewComments">ملاحظات المراجعة</label>
                        <textarea id="reviewComments" name="reviewComments" class="form-control" rows="3" 
                                  placeholder="أضف ملاحظاتك هنا (اختياري)..."></textarea>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <form asp-action="Approve" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="reviewComments" value="" id="approveComments" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success" onclick="document.getElementById('approveComments').value=document.getElementById('reviewComments').value">
                                <i class="fas fa-check"></i> موافقة
                            </button>
                        </form>
                        <form asp-action="Reject" method="post" class="d-inline ms-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="reviewComments" value="" id="rejectComments" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger" onclick="document.getElementById('rejectComments').value=document.getElementById('reviewComments').value">
                                <i class="fas fa-times"></i> رفض
                            </button>
                        </form>
                        <form asp-action="Cancel" method="post" class="d-inline ms-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-secondary">
                                <i class="fas fa-ban"></i> إلغاء
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-default"><i class="fas fa-arrow-right"></i> العودة</a>
</div>
