@model HR.Core.Domain.Entities.JobCatalogEntry
@using HR.Core.Domain.Entities
@using HR.Core.Infrastructure.Services.Establishment
@{
    ViewData["Title"] = Model.TitleAr;
    var canMutate = ViewBag.CanMutate == true;
    var changeLogs = ViewBag.ChangeLogs as IReadOnlyList<EstablishmentChangeLog> ?? [];
    var timeline = ViewBag.VersionTimeline as IReadOnlyList<JobCatalogVersionDto> ?? [];
    var asOfSnapshot = ViewBag.AsOfSnapshot as JobCatalogVersionDto;
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">@Model.TitleAr</h3>
        @if (canMutate)
        {
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">طلب تعديل</a>
                @if (Model.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('إنشاء طلب تعطيل لهذا الدليل؟');">طلب تعطيل</button>
                    </form>
                }
            </div>
        }
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-md-4">
                <label class="form-label">عرض كما في تاريخ</label>
                <input type="datetime-local" name="asOf" value="@(ViewBag.AsOfDate is DateTime d ? d.ToString("yyyy-MM-ddTHH:mm") : "")" class="form-control" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-primary">استعلام as-of</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">الحالة الحالية</a>
            </div>
        </form>

        @if (asOfSnapshot is not null)
        {
            <div class="alert alert-info">
                <strong>كما في @(((DateTime)ViewBag.AsOfDate!).ToString("yyyy-MM-dd HH:mm")):</strong>
                @asOfSnapshot.TitleAr (@asOfSnapshot.JobCode) — @(asOfSnapshot.IsActive ? "نشط" : "معطّل")
            </div>
        }

        <table class="table table-sm">
            <tr><th style="width:30%">رمز الوظيفة</th><td>@Model.JobCode</td></tr>
            <tr><th>المسمى بالعربي</th><td>@Model.TitleAr</td></tr>
            <tr><th>المسمى بالإنكليزي</th><td>@(Model.TitleEn ?? "—")</td></tr>
            <tr><th>رمز الدرجة</th><td>@Model.GradeCode</td></tr>
            <tr><th>المجموعة المهنية</th><td>@(Model.OccupationalGroup ?? "—")</td></tr>
            <tr><th>نشط</th><td>@(Model.IsActive ? "نعم" : "لا")</td></tr>
            <tr><th>المناصب المرتبطة</th><td>@ViewBag.LinkedPositionCount</td></tr>
        </table>
        @if (!string.IsNullOrWhiteSpace(Model.DescriptionAr))
        {
            <h5 class="mt-3">الوصف</h5>
            <p>@Model.DescriptionAr</p>
        }

        @if (timeline.Any())
        {
            <h5 class="mt-4">الخط الزمني</h5>
            <table class="table table-sm table-bordered">
                <thead><tr><th>صالح من</th><th>صالح حتى</th><th>العملية</th><th>مرجع قانوني</th></tr></thead>
                <tbody>
                    @foreach (var v in timeline)
                    {
                        <tr>
                            <td>@v.ValidFrom.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(v.ValidTo?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>@v.OperationType</td>
                            <td>@(v.LegalSourceId ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (changeLogs.Any())
        {
            <h5 class="mt-4">سجل التغييرات (حوكمة)</h5>
            <partial name="_EstablishmentChangeLogTable" model="changeLogs" />
        }
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">العودة</a>
    </div>
</div>
