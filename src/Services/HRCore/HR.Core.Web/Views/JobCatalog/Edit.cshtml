@model HR.Core.Web.ViewModels.JobCatalogEditViewModel
@{ ViewData["Title"] = "تعديل دليل وظيفة"; }
<div class="card">
    <div class="card-header"><h3 class="mb-0">تعديل دليل وظيفة</h3></div>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_JobCatalogFormFields" model="Model" />
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ مسودة</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">إلغاء</a>
        </div>
    </form>
</div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
