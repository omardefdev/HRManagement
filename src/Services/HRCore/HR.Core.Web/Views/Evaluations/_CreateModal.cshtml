@model HR.Core.Web.ViewModels.EvaluationCreateViewModel

<div class="modal fade" id="createEvaluationModal" tabindex="-1" aria-labelledby="createEvaluationModalLabel" aria-hidden="true">
    <div class="modal-dialog" dir="rtl">
        <div class="modal-content">
            <form asp-controller="Evaluations" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EmployeeId" />
                <input type="hidden" asp-for="ReturnTo" />
                <div class="modal-header">
                    <h5 class="modal-title" id="createEvaluationModalLabel">إضافة تقييم@(Model.EmployeeName != null ? $" — {Model.EmployeeName}" : "")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Year" class="form-label"></label>
                                <input asp-for="Year" class="form-control" type="number" />
                                <span asp-validation-for="Year" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Score" class="form-label"></label>
                                <input asp-for="Score" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="Score" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label"></label>
                        <textarea asp-for="Summary" class="form-control" rows="4"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>
