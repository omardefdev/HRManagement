@using HR.Core.Domain.Entities
@using HR.Core.Domain.Enums
@using HR.Core.Domain.Services
@using HRManagement.SharedKernel.Localization
@model SelectionCommitteeSession?
@{
    ViewData["Title"] = "لجنة الاختيار";
    var requisition = ViewBag.Requisition as RecruitmentRequisition;
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">لجنة الاختيار — @(requisition?.RequisitionNumber ?? "—")</h3>
        <a asp-controller="RecruitmentRequisitions" asp-action="Details" asp-route-id="@requisition?.Id" class="btn btn-outline-secondary btn-sm">رجوع</a>
    </div>
    <div class="card-body">
        <p class="text-muted">@requisition?.JobTitle</p>
        @if (Model is not null)
        {
            <dl class="row">
                <dt class="col-sm-3">تاريخ الجلسة</dt>
                <dd class="col-sm-9">@Model.CommitteeDate.ToLocalTime().ToString("yyyy/MM/dd")</dd>
                <dt class="col-sm-3">غرض الجلسة</dt>
                <dd class="col-sm-9">@EnumDisplayExtensions.GetDisplayName(Model.Purpose)</dd>
                <dt class="col-sm-3">التوصية</dt>
                <dd class="col-sm-9">@(Model.Recommendation ?? "—")</dd>
                <dt class="col-sm-3">النتائج</dt>
                <dd class="col-sm-9">@(Model.Findings ?? "—")</dd>
                <dt class="col-sm-3">الاعتماد</dt>
                <dd class="col-sm-9">
                    @if (Model.ApprovedAt is not null)
                    {
                        <span class="badge bg-success">معتمد @Model.ApprovedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")</span>
                    }
                    else if (Model.WorkflowInstanceId is not null || Model.LockedAt is not null)
                    {
                        <span class="badge bg-warning text-dark">قيد الاعتماد</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-dark">مسودة</span>
                    }
                </dd>
            </dl>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">تفاصيل / اعتماد</a>
            @if (Model.Members.Any())
            {
                <h5>الأعضاء</h5>
                <table class="table table-sm">
                    <thead><tr><th>الموظف</th><th>الدور</th><th>COI</th><th>انسحاب</th></tr></thead>
                    <tbody>
                    @foreach (var m in Model.Members)
                    {
                        <tr>
                            <td>@(m.Employee?.FullName ?? m.EmployeeId.ToString())</td>
                            <td>@(SelectionCommitteeRules.IsChairRole(m.Role) ? "رئيس اللجنة" : "عضو")</td>
                            <td>@(m.HasConflictOfInterest ? "نعم" : "لا")</td>
                            <td>@(m.Recused ? "نعم" : "لا")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">إنشاء جلسة</h5></div>
    <div class="card-body">
        <form asp-action="CreateSession" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requisitionId" value="@requisition?.Id" />
            <div class="col-md-3">
                <label class="form-label">تاريخ الجلسة</label>
                <input type="date" name="committeeDate" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="purpose">غرض الجلسة</label>
                <select id="purpose" name="purpose" class="form-select">
                    @foreach (var option in Enum.GetValues<CommitteePurpose>())
                    {
                        <option value="@option" selected="@(option == CommitteePurpose.Ranking)">@EnumDisplayExtensions.GetDisplayName(option)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">النتائج</label>
                <input type="text" name="findings" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">التوصية</label>
                <input type="text" name="recommendation" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">إنشاء</button>
            </div>
        </form>
    </div>
</div>
