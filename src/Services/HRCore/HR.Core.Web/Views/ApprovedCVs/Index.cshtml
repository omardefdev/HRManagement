@model IReadOnlyList<HR.Core.Domain.Entities.ApprovedCV>
@{
    ViewData["Title"] = "السيرة المعتمدة";
    var employee = (HR.Core.Domain.Entities.Employee)ViewBag.Employee;
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-file-contract"></i> السير المعتمدة — @employee.FullName</h3>
        <div class="card-tools">
            <a asp-action="Create" asp-route-employeeId="@employee.Id" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> إضافة
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>الملف</th>
                    <th>تاريخ الاعتماد</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@await Html.PartialAsync("_FileDisplayLink", (c.FileId, "عرض السيرة"))</td>
                        <td>@(c.ApprovedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = c.Id })" aria-label="حذف">
                                <i aria-hidden="true" class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">لا توجد سير معتمدة</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة لملف الموظف
        </a>
    </div>
</div>

