@model IReadOnlyList<HR.Core.Domain.Entities.DailyAttendanceRecord>
@{ ViewData["Title"] = "الحضور اليومي"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">الحضور</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>الموظف</th><th>اليوم</th><th>الحالة</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.Employee?.FullName</td><td>@x.AttendanceDate</td><td>@x.Status</td></tr>}
@if(!Model.Any()){<tr><td colspan="3" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
