@model HR.Core.Web.ViewModels.DailyAttendanceRecordCreateViewModel
@{ ViewData["Title"] = "تسجيل حضور"; }
<div class="card"><form asp-action="Create" method="post">@Html.AntiForgeryToken()
<div class="card-body">
<div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-control"><option value="">— الموظف —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="AttendanceDate" class="form-label"></label><input asp-for="AttendanceDate" class="form-control" type="date" /><span asp-validation-for="AttendanceDate" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label><select class="form-control" asp-for="Status" asp-items="Html.GetEnumSelectList<HR.Core.Domain.Enums.DailyAttendanceStatus>()" class="form-control"></select><span asp-validation-for="Status" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
</div>
<div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div></form></div>
