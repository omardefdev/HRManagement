@model HR.Core.Web.ViewModels.RecruitmentRequisitionDetailsViewModel

@using HR.Core.Domain.Enums

@{ ViewData["Title"] = "تفاصيل طلب الشاغر"; var requisition = Model.Requisition; }

@inject Microsoft.Extensions.Options.IOptions<HR.Core.Infrastructure.Services.Recruitment.RecruitmentOptions> RecruitmentOptions
@{
    var todayUtc = DateOnly.FromDateTime(DateTime.UtcNow);
    var minClosingDate = todayUtc.AddDays(RecruitmentOptions.Value.MinPostingDays).ToString("yyyy-MM-dd");
    var intakeClosed = requisition.Status == RequisitionStatus.Published
        && (requisition.IntakeClosedAt is not null || requisition.ApplicationClosingDate < todayUtc);
}



@functions {

    string StatusBadgeClass(RequisitionStatus status) => status switch

    {

        RequisitionStatus.Draft => "bg-secondary",

        RequisitionStatus.PendingApproval => "bg-warning text-dark",

        RequisitionStatus.Approved => "bg-info text-dark",

        RequisitionStatus.Published => "bg-success",

        RequisitionStatus.Closed => "bg-dark",

        RequisitionStatus.Cancelled => "bg-danger",

        _ => "bg-secondary"

    };



    string ChannelLabel(RecruitmentPublishingChannel channel) => channel switch

    {

        RecruitmentPublishingChannel.InternalOnly => "داخلي",

        RecruitmentPublishingChannel.Both => "عام + داخلي",

        _ => "عام"

    };

}



@if (Model.NextCandidate is not null && Model.CanWrite)
{
    <partial name="_NextCandidateBanner" model="Model.NextCandidate" />
}

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h3 class="mb-0">@requisition.RequisitionNumber — @requisition.JobTitle</h3>

        <div class="d-flex gap-1 flex-wrap">

            @if (Model.CanWrite && requisition.Status == RequisitionStatus.Draft)

            {

                <form asp-action="Submit" asp-route-id="@requisition.Id" method="post" class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-warning btn-sm">تقديم للاعتماد</button>

                </form>

                <a asp-action="Edit" asp-route-id="@requisition.Id" class="btn btn-primary btn-sm">تعديل</a>

                <form asp-action="Delete" asp-route-id="@requisition.Id" method="post" class="d-inline" onsubmit="return confirm('حذف مسودة طلب الشاغر؟');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger btn-sm">حذف</button>

                </form>

                <form asp-action="Cancel" asp-route-id="@requisition.Id" method="post" class="d-inline" onsubmit="return confirm('إلغاء طلب الشاغر؟');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-danger btn-sm">إلغاء</button>

                </form>

            }

            @if (Model.CanWrite && requisition.Status == RequisitionStatus.PendingApproval)

            {

                <form asp-action="Cancel" asp-route-id="@requisition.Id" method="post" class="d-inline" onsubmit="return confirm('إلغاء طلب الشاغر؟');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-danger btn-sm">إلغاء</button>

                </form>

            }

            @if (Model.CanWrite && requisition.Status == RequisitionStatus.Approved)

            {

                @if (requisition.PublishingChannel is RecruitmentPublishingChannel.PublicOnly or RecruitmentPublishingChannel.Both)

                {

                    <form asp-action="Publish" asp-route-id="@requisition.Id" method="post" class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="date" name="applicationClosingDate" class="form-control form-control-sm d-inline-block w-auto"
                               value="@(requisition.ApplicationClosingDate?.ToString("yyyy-MM-dd"))" min="@minClosingDate" required
                               aria-label="تاريخ إغلاق التقديم" title="تاريخ إغلاق التقديم" />

                        <button type="submit" class="btn btn-success btn-sm">نشر الإعلان العام</button>

                    </form>

                }

                @if (requisition.PublishingChannel is RecruitmentPublishingChannel.InternalOnly or RecruitmentPublishingChannel.Both)

                {

                    <form asp-action="PublishInternal" asp-route-id="@requisition.Id" method="post" class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="date" name="applicationClosingDate" class="form-control form-control-sm d-inline-block w-auto"
                               value="@(requisition.ApplicationClosingDate?.ToString("yyyy-MM-dd"))" min="@minClosingDate" required
                               aria-label="تاريخ إغلاق التقديم" title="تاريخ إغلاق التقديم" />

                        <button type="submit" class="btn btn-outline-success btn-sm">نشر الشاغر الداخلي</button>

                    </form>

                }

            }

            @if (Model.CanWrite && requisition.Status == RequisitionStatus.Published

                 && requisition.PublishingChannel is RecruitmentPublishingChannel.InternalOnly or RecruitmentPublishingChannel.Both

                 && requisition.InternalVacancyId is null)

            {

                <form asp-action="PublishInternal" asp-route-id="@requisition.Id" method="post" class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-success btn-sm">نشر الشاغر الداخلي</button>

                </form>

            }

            @if (Model.CanWrite && requisition.Status == RequisitionStatus.Published)

            {

                <form asp-action="Close" asp-route-id="@requisition.Id" method="post" class="d-inline" onsubmit="return confirm('إغلاق طلب الشاغر وإخفاء الإعلان؟');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-dark btn-sm">إغلاق</button>

                </form>

                @if (requisition.PublicJobPostingId is Guid postingId)

                {

                    <a asp-controller="PublicJobPostings" asp-action="Details" asp-route-id="@postingId" class="btn btn-outline-info btn-sm">عرض الإعلان</a>

                }

                @if (requisition.InternalVacancyId is Guid internalId)

                {

                    <a asp-controller="TalentMarketplace" asp-action="Details" asp-route-id="@internalId" class="btn btn-outline-info btn-sm">عرض الشاغر الداخلي</a>

                }

            }

            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">رجوع</a>

        </div>

    </div>

    <div class="card-body">

        <div class="mb-3">

            <span class="badge @StatusBadgeClass(requisition.Status)">@requisition.Status</span>
            @if (intakeClosed)
            {
                <span class="badge bg-secondary">التقديم مغلق</span>
            }

        </div>

        <h6>المسار</h6>

        <ul class="list-inline mb-4">

            <li class="list-inline-item"><span class="badge @(requisition.RequestedDate != default ? "bg-secondary" : "bg-light text-dark")">مسودة</span></li>

            <li class="list-inline-item">→</li>

            <li class="list-inline-item"><span class="badge @(requisition.Status >= RequisitionStatus.PendingApproval ? "bg-warning text-dark" : "bg-light text-dark")">بانتظار الاعتماد</span></li>

            <li class="list-inline-item">→</li>

            <li class="list-inline-item"><span class="badge @(requisition.ApprovedDate.HasValue ? "bg-info text-dark" : "bg-light text-dark")">معتمد</span></li>

            <li class="list-inline-item">→</li>

            <li class="list-inline-item"><span class="badge @(requisition.PublishedAt.HasValue ? "bg-success" : "bg-light text-dark")">منشور</span></li>

        </ul>



        @{

            ViewData["RequisitionId"] = requisition.Id;

        }

        <partial name="_RequisitionWorkflowPanel" model="Model.Workflow" />

        @if (requisition.Status == RequisitionStatus.Approved && Model.CriteriaPanel.Active is null)
        {
            <div class="alert alert-warning mt-3 mb-0">
                <i class="fas fa-exclamation-triangle ms-1"></i>
                لا توجد معايير تقييم نشطة لهذا الطلب — يجب اعتماد معايير التقييم قبل النشر.
                <a href="#assessment-criteria" class="alert-link">تعريف المعايير</a>
            </div>
        }

        @if (!Model.CanWrite && requisition.Status == RequisitionStatus.Approved)
        {
            <div class="alert alert-info mt-3 mb-0">
                النشر والإلغاء من حساب موارد بشرية (مثل <strong>acc-central-a</strong>) — دور المعتمد يقتصر على المراجعة والاعتماد.
            </div>
        }

        <dl class="row mt-4">

            <dt class="col-sm-3">رقم الطلب</dt>

            <dd class="col-sm-9">@requisition.RequisitionNumber</dd>

            <dt class="col-sm-3">تاريخ الطلب</dt>

            <dd class="col-sm-9">@requisition.RequestedDate.ToString("yyyy-MM-dd HH:mm") UTC</dd>

            <dt class="col-sm-3">تاريخ الاعتماد</dt>

            <dd class="col-sm-9">@(requisition.ApprovedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>

            <dt class="col-sm-3">تاريخ النشر</dt>

            <dd class="col-sm-9">@(requisition.PublishedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>

            <dt class="col-sm-3">تاريخ الإغلاق</dt>

            <dd class="col-sm-9">@(requisition.ClosedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>

            <dt class="col-sm-3">عدد الشواغر</dt>

            <dd class="col-sm-9">@requisition.VacancyCount</dd>

            <dt class="col-sm-3">قناة النشر</dt>

            <dd class="col-sm-9"><span class="badge bg-light text-dark">@ChannelLabel(requisition.PublishingChannel)</span></dd>

            <dt class="col-sm-3">المسمى الوظيفي</dt>

            <dd class="col-sm-9">@requisition.JobTitle</dd>

            <dt class="col-sm-3">رمز المنصب</dt>

            <dd class="col-sm-9">@(requisition.FundedPosition?.PositionCode ?? "—")</dd>

            <dt class="col-sm-3">الدرجة</dt>

            <dd class="col-sm-9">@(requisition.FundedPosition?.GradeCode ?? "—")</dd>

            <dt class="col-sm-3">سنة الموازنة</dt>

            <dd class="col-sm-9">@(requisition.FundedPosition?.BudgetYear.ToString() ?? "—")</dd>

            <dt class="col-sm-3">الوحدة التنظيمية</dt>

            <dd class="col-sm-9">@(requisition.FundedPosition?.OrgUnit?.NameAr ?? "—")</dd>

            <dt class="col-sm-3">حالة المنصب</dt>

            <dd class="col-sm-9">@(requisition.FundedPosition?.Status.ToString() ?? "—")</dd>

            <dt class="col-sm-3">مبررات الطلب</dt>

            <dd class="col-sm-9">@(requisition.JustificationNotes ?? "—")</dd>

            <dt class="col-sm-3">مرجع قانوني</dt>

            <dd class="col-sm-9">@(ViewBag.LegalSourceLabel ?? "—")</dd>

            <dt class="col-sm-3">تاريخ إغلاق التقديم</dt>
            <dd class="col-sm-9">
                @(requisition.ApplicationClosingDate?.ToString("yyyy-MM-dd") ?? "—")
                @if (requisition.IntakeClosedAt is not null)
                {
                    <span class="badge bg-secondary ms-1">التقديم مغلق منذ @requisition.IntakeClosedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</span>
                }
            </dd>

            @if (requisition.Status == RequisitionStatus.Cancelled && requisition.CancelledAt is not null)
            {
                <dt class="col-sm-3">تاريخ الإلغاء</dt>
                <dd class="col-sm-9">@requisition.CancelledAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                <dt class="col-sm-3">سبب الإلغاء</dt>
                <dd class="col-sm-9">@(requisition.CancellationReason ?? "—")</dd>
            }

        </dl>

    </div>

</div>

<partial name="_AssessmentCriteriaPanel" model="Model.CriteriaPanel" />

@if (Model.CanWrite && requisition.Status is RequisitionStatus.Approved or RequisitionStatus.Published)
{
    <div class="card mt-3" id="closing-date">
        <div class="card-header"><h5 class="mb-0"><i class="fas fa-calendar-plus ms-1"></i> تمديد تاريخ إغلاق التقديم</h5></div>
        <div class="card-body">
            <p class="text-muted small">
                يُسمح بالتمديد فقط (تاريخ لاحق)، مع سبب مكتوب. إذا كان التقديم قد أُغلق آلياً والطلب ما زال منشوراً، يُعاد فتح الإعلان والشاغر الداخلي.
            </p>
            <form asp-action="ExtendClosingDate" asp-route-id="@requisition.Id" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label" for="extendNewDate">التاريخ الجديد</label>
                    <input type="date" id="extendNewDate" name="newDate" class="form-control" min="@todayUtc.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="extendReason">سبب التمديد (10 أحرف على الأقل)</label>
                    <input type="text" id="extendReason" name="reason" class="form-control" minlength="10" maxlength="500" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-primary w-100">تمديد</button>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.CanWrite && requisition.Status is RequisitionStatus.Approved or RequisitionStatus.Published)
{
    <div class="card mt-3 border-danger" id="cancel-requisition">
        <div class="card-header"><h5 class="mb-0 text-danger"><i class="fas fa-ban ms-1"></i> إلغاء طلب الشاغر</h5></div>
        <div class="card-body">
            @if (Model.CanApprove)
            {
                <p class="text-muted small">
                    يُلغى الإعلان والشاغر الداخلي، وتُسحب العروض غير المقبولة، وتُرفض الطلبات المفتوحة وتُلغى مقابلاتها المجدولة.
                    لا يمكن الإلغاء إذا وُجد مرشح معيّن أو عرض مقبول.
                </p>
                <form asp-action="Cancel" asp-route-id="@requisition.Id" method="post" class="row g-2 align-items-end"
                      data-hr-confirm="إلغاء طلب الشاغر وكل ما يترتب عليه؟" data-hr-confirm-title="تأكيد الإلغاء" data-hr-confirm-variant="danger">
                    @Html.AntiForgeryToken()
                    <div class="col-md-9">
                        <label class="form-label" for="cancelReason">سبب الإلغاء (10 أحرف على الأقل)</label>
                        <input type="text" id="cancelReason" name="reason" class="form-control" minlength="10" maxlength="500" required />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-danger w-100">إلغاء الطلب</button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">إلغاء طلب شاغر معتمد أو منشور يتطلب صلاحية الاعتماد.</p>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/recruitment-criteria.js" asp-append-version="true"></script>
}
