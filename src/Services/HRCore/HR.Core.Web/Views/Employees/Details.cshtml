@model HR.Core.Web.ViewModels.EmployeeDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الموظف";
    var emp = Model.Employee;
}

<div class="mb-3 d-flex flex-wrap gap-2">
    <a asp-controller="EmployeeProfiles" asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-id-badge"></i> الملف الشخصي الموسّع
    </a>
    <a asp-controller="EmploymentRecords" asp-action="Index" asp-route-employeeId="@emp.Id" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-briefcase"></i> السجل الوظيفي
    </a>
    <a asp-controller="ApprovedCVs" asp-action="Index" asp-route-employeeId="@emp.Id" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-file-contract"></i> السيرة المعتمدة
    </a>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card card-primary card-outline">
            <div class="card-body box-profile text-center">
                @if (emp.PhotoFileId.HasValue)
                {
                    <div class="profile-user-img img-fluid img-circle d-inline-block" style="width:100px;height:100px;overflow:hidden;">
                        @await Html.PartialAsync("_FileImagePreview", emp.PhotoFileId, new ViewDataDictionary(ViewData)
                        {
                            ["ImageClass"] = "img-fluid img-circle w-100 h-100",
                            ["MaxHeight"] = "100px"
                        })
                    </div>
                }
                else
                {
                    <div class="profile-user-img img-fluid img-circle d-flex align-items-center justify-content-center" style="width:100px;height:100px;margin:auto;background:var(--sy-primary);color:white;font-size:2rem;">
                        <i class="fas fa-user"></i>
                    </div>
                }
                <h3 class="profile-username mt-3">@emp.FullName</h3>
                <p class="text-muted">@(emp.PrimaryOrgUnit?.NameAr ?? "بدون وحدة")</p>
                <div class="mb-2">
                    @{
                        var empStatusBadge = emp.CurrentStatus switch
                        {
                            HRManagement.SharedKernel.Enums.EmploymentStatus.Active => "bg-success",
                            HRManagement.SharedKernel.Enums.EmploymentStatus.Suspended => "bg-warning",
                            HRManagement.SharedKernel.Enums.EmploymentStatus.Terminated => "bg-danger",
                            HRManagement.SharedKernel.Enums.EmploymentStatus.Retired => "bg-secondary",
                            HRManagement.SharedKernel.Enums.EmploymentStatus.OnLeave => "bg-info",
                            HRManagement.SharedKernel.Enums.EmploymentStatus.Seconded => "bg-primary",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @empStatusBadge">@Html.HrEnumDisplay(emp.CurrentStatus)</span>
                </div>
                <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-primary btn-sm">
                    <i class="fas fa-edit"></i> تعديل
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">البيانات الأساسية</h3></div>
            <div class="card-body p-0">
                <table class="table table-sm">
                    <tr><th>الرقم الوطني</th><td>@Model.DisplayNationalId</td></tr>
                    <tr><th>تاريخ الميلاد</th><td>@emp.BirthDate.ToString("yyyy/MM/dd")</td></tr>
                    <tr><th>الجنس</th><td>@(emp.Gender == HRManagement.SharedKernel.Enums.Gender.Male ? "ذكر" : emp.Gender == HRManagement.SharedKernel.Enums.Gender.Female ? "أنثى" : "آخر")</td></tr>
                    <tr><th>الحالة الاجتماعية</th><td>@Html.HrEnumDisplay(emp.MaritalStatus)</td></tr>
                    <tr><th>تاريخ التعيين</th><td>@(emp.HireDate?.ToString("yyyy/MM/dd") ?? "—")</td></tr>
                    @if (!string.IsNullOrWhiteSpace(Model.ServiceRegimeLabel))
                    {
                        <tr><th>نظام الخدمة</th><td>@Model.ServiceRegimeLabel</td></tr>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ServiceRegimeLegalSourceLabel))
                    {
                        <tr><th>المرجع التشريعي</th><td>@Model.ServiceRegimeLegalSourceLabel</td></tr>
                    }
                </table>
            </div>
        </div>

        @if (Model.RegimeTransitions.Any())
        {
            <div class="card mt-3">
                <div class="card-header"><h3 class="card-title">تاريخ انتقالات نظام الخدمة</h3></div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>من</th>
                                <th>إلى</th>
                                <th>ساري من</th>
                                <th>مرجع القرار</th>
                                <th>ملاحظات 159</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.RegimeTransitions)
                            {
                                <tr>
                                    <td>@(t.FromRegimeId ?? "—")</td>
                                    <td>@t.ToRegimeId</td>
                                    <td>@t.EffectiveFrom.ToString("yyyy/MM/dd")</td>
                                    <td>@t.TransitionDecisionRef</td>
                                    <td>@(string.IsNullOrWhiteSpace(t.ConflictNotes) ? "—" : t.ConflictNotes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-md-8">
        @if (Model.Profile != null)
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0"><i class="fas fa-id-badge"></i> الملف الشخصي</h3>
                    <a asp-controller="EmployeeProfiles" asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-tool btn-sm"><i class="fas fa-edit"></i></a>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm">
                        <tr><th>الجنسية</th><td>@(Model.Profile.Nationality ?? "—")</td></tr>
                        <tr><th>مكان الميلاد</th><td>@(Model.Profile.PlaceOfBirth ?? "—")</td></tr>
                        <tr><th>عنوان السكن</th><td>@(Model.Profile.ResidentialAddress ?? "—")</td></tr>
                        <tr><th>جهة اتصال طارئة</th><td>@(Model.Profile.EmergencyContact ?? "—")</td></tr>
                    </table>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-graduation-cap"></i> المؤهلات (@Model.Qualifications.Count)</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-xs" data-bs-toggle="modal" data-bs-target="#createQualificationModal">
                        <i class="fas fa-plus"></i> إضافة
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped">
                    <thead><tr><th>المؤهل</th><th>الجهة المانحة</th><th>تاريخ الإتمام</th></tr></thead>
                    <tbody>
                        @foreach (var q in Model.Qualifications)
                        {
                            <tr>
                                <td>@q.Title</td>
                                <td>@(q.Provider ?? "—")</td>
                                <td>@(q.CompletionDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                            </tr>
                        }
                        @if (!Model.Qualifications.Any()) { <tr><td colspan="3" class="text-center text-muted">لا توجد مؤهلات</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-phone"></i> معلومات الاتصال (@Model.Contacts.Count)</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-xs" data-bs-toggle="modal" data-bs-target="#createContactModal">
                        <i class="fas fa-plus"></i> إضافة
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped">
                    <thead><tr><th>النوع</th><th>القيمة</th><th>أساسي</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Contacts)
                        {
                            <tr>
                                <td>@(c.Type switch { HRManagement.SharedKernel.Enums.ContactType.Phone => "هاتف", HRManagement.SharedKernel.Enums.ContactType.Email => "بريد إلكتروني", _ => "عنوان" })</td>
                                <td>@c.Value</td>
                                <td>@(c.IsPrimary ? "✓" : "")</td>
                            </tr>
                        }
                        @if (!Model.Contacts.Any()) { <tr><td colspan="3" class="text-center text-muted">لا توجد معلومات اتصال</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-file-alt"></i> المستندات (@Model.Documents.Count)</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-xs" data-bs-toggle="modal" data-bs-target="#createDocumentModal">
                        <i class="fas fa-plus"></i> إضافة
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped">
                    <thead><tr><th>العنوان</th><th>النوع</th><th>موثق</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.Documents)
                        {
                            <tr>
                                <td>@d.DocTitle</td>
                                <td>@(d.DocType switch { HRManagement.SharedKernel.Enums.DocumentType.Certificate => "شهادة", HRManagement.SharedKernel.Enums.DocumentType.Photo => "صورة", HRManagement.SharedKernel.Enums.DocumentType.NationalId => "هوية وطنية", HRManagement.SharedKernel.Enums.DocumentType.Passport => "جواز سفر", HRManagement.SharedKernel.Enums.DocumentType.Fingerprint => "بصمة", _ => "أخرى" })</td>
                                <td>@(d.Verified ? "✓" : "✗")</td>
                            </tr>
                        }
                        @if (!Model.Documents.Any()) { <tr><td colspan="3" class="text-center text-muted">لا توجد مستندات</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-star"></i> التقييمات (@Model.Evaluations.Count)</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-xs" data-bs-toggle="modal" data-bs-target="#createEvaluationModal">
                        <i class="fas fa-plus"></i> إضافة
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped">
                    <thead><tr><th>السنة</th><th>الدرجة</th><th>الحالة</th></tr></thead>
                    <tbody>
                        @foreach (var ev in Model.Evaluations)
                        {
                            <tr>
                                <td>@ev.Year</td>
                                <td>@ev.Score</td>
                                <td>@(ev.Status == "draft" ? "مسودة" : "نهائي")</td>
                            </tr>
                        }
                        @if (!Model.Evaluations.Any()) { <tr><td colspan="3" class="text-center text-muted">لا توجد تقييمات</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-right"></i> العودة للقائمة
    </a>
</div>

@await Html.PartialAsync("~/Views/Qualifications/_CreateModal.cshtml", Model.QualificationCreate)
@await Html.PartialAsync("~/Views/Contacts/_CreateModal.cshtml", Model.ContactCreate)
@await Html.PartialAsync("~/Views/Documents/_CreateModal.cshtml", Model.DocumentCreate)
@await Html.PartialAsync("~/Views/Evaluations/_CreateModal.cshtml", Model.EvaluationCreate)

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var openModals = [
                { show: @Json.Serialize(Model.ShowQualificationCreateModal), id: 'createQualificationModal' },
                { show: @Json.Serialize(Model.ShowContactCreateModal), id: 'createContactModal' },
                { show: @Json.Serialize(Model.ShowDocumentCreateModal), id: 'createDocumentModal' },
                { show: @Json.Serialize(Model.ShowEvaluationCreateModal), id: 'createEvaluationModal' }
            ];
            openModals.forEach(function (m) {
                if (m.show) {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById(m.id)).show();
                }
            });

            var docModal = document.getElementById('createDocumentModal');
            if (docModal) {
                docModal.addEventListener('shown.bs.modal', function () {
                    var picker = docModal.querySelector('[data-hr-picker="employee"]');
                    if (picker && window.hrSharedUi) {
                        window.hrSharedUi.initEmployeePicker(picker);
                    }
                });
            }
        });
    </script>
}
