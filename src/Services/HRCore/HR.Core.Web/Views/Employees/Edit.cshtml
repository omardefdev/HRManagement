@model HR.Core.Web.ViewModels.EmployeeEditViewModel
@{
    ViewData["Title"] = "تعديل بيانات الموظف";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-user-edit"></i> تعديل بيانات الموظف</h3>
    </div>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                        <label asp-for="NationalId" class="form-label"></label>
                        <input asp-for="NationalId" class="form-control" />
                        <span asp-validation-for="NationalId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                        <label asp-for="MiddleName" class="form-label"></label>
                        <input asp-for="MiddleName" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                        <label asp-for="BirthDate" class="form-label"></label>
                        <input asp-for="BirthDate" class="form-control" type="date" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                        <label asp-for="HireDate" class="form-label"></label>
                        <input asp-for="HireDate" class="form-control" type="date" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="mb-3 mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-control">
                            <option value="Male">ذكر</option>
                            <option value="Female">أنثى</option>
                            <option value="Other">آخر</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3 mb-3">
                        <label asp-for="MaritalStatus" class="form-label"></label>
                        <select asp-for="MaritalStatus" class="form-control">
                            <option value="Single">أعزب</option>
                            <option value="Married">متزوج</option>
                            <option value="Divorced">مطلق</option>
                            <option value="Widowed">أرمل</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3 mb-3">
                        <label asp-for="CurrentStatus" class="form-label"></label>
                        <select asp-for="CurrentStatus" class="form-control">
                            <option value="Active">نشط</option>
                            <option value="Suspended">موقوف</option>
                            <option value="Terminated">منتهي</option>
                            <option value="Retired">متقاعد</option>
                            <option value="OnLeave">في إجازة</option>
                            <option value="Seconded">منتدب</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3 mb-3">
                        <label asp-for="PrimaryOrgUnitId" class="form-label"></label>
                        <select asp-for="PrimaryOrgUnitId" asp-items="Model.OrgUnits" class="form-control">
                            <option value="">-- اختر الوحدة --</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                        <label asp-for="Cadre" class="form-label"></label>
                        @if (ViewBag.CadreLocked != null)
                        {
                            <input type="hidden" asp-for="Cadre" />
                            <input class="form-control" readonly value="@(Model.Cadre == HRManagement.SharedKernel.Enums.EmployeeCadre.Supervisory ? "كادر إشرافي" : "موظف تنفيذي")" />
                        }
                        else
                        {
                            <select asp-for="Cadre" class="form-control" asp-items="Html.GetEnumSelectList<HRManagement.SharedKernel.Enums.EmployeeCadre>()"></select>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                    @{
                        ViewData["FileUploadName"] = "PhotoFileId";
                        ViewData["FileUploadId"] = "PhotoFileId";
                        ViewData["FileUploadAccept"] = "image/jpeg,image/png,image/webp";
                        ViewData["FileUploadMaxSize"] = "2097152";
                        ViewData["FileUploadLabel"] = "صورة الموظف";
                    }
                    @await Html.PartialAsync("_FileUploadWidget", Model.PhotoFileId)
                        <small class="form-text text-muted">اترك الحقل فارغاً للإبقاء على الصورة الحالية</small>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="CorrectionReason" class="form-label"></label>
                <textarea asp-for="CorrectionReason" class="form-control" rows="2"
                          placeholder="اكتب سبب التصحيح عند تغيير الرقم الوطني أو الاسم أو التاريخ"></textarea>
                <span asp-validation-for="CorrectionReason" class="text-danger"></span>
                <div class="form-text">التعديلات القانونية تنشئ طلباً مستقلاً، ويعتمدها مستخدم مخول مختلف دون إدخال أي معرف تقني.</div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> حفظ التغييرات
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                <i class="fas fa-times"></i> إلغاء
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
