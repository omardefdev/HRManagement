@model HR.Core.Web.ViewModels.EstablishmentChangesIndexViewModel
@using HR.Core.Domain.Entities
@{ ViewData["Title"] = "طلبات تغيير الملاك"; }

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0"><i class="fas fa-clipboard-check"></i> طلبات تغيير الملاك (EST-002)</h3>
    </div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">بحث</label>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="رقم الطلب..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="">— الكل —</option>
                    @foreach (EstablishmentChangeStatus s in Enum.GetValues<EstablishmentChangeStatus>())
                    {
                        if (Model.Status == s)
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">نوع التغيير</label>
                <select name="ChangeType" class="form-select">
                    <option value="">— الكل —</option>
                    @foreach (EstablishmentChangeType t in Enum.GetValues<EstablishmentChangeType>())
                    {
                        if (Model.ChangeType == t)
                        {
                            <option value="@t" selected>@t</option>
                        }
                        else
                        {
                            <option value="@t">@t</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">سنة الموازنة</label>
                <input type="number" name="BudgetYear" value="@Model.BudgetYear" class="form-control" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>رقم الطلب</th>
                    <th>نوع التغيير</th>
                    <th>الحالة</th>
                    <th>تاريخ الطلب</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.RequestNumber</td>
                        <td>@item.ChangeType</td>
                        <td>@item.Status</td>
                        <td>@item.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">تفاصيل</a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any())
        {
            <p class="p-3 text-muted mb-0">لا توجد طلبات.</p>
        }
    </div>
</div>
