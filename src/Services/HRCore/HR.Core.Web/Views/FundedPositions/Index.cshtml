@model HR.Core.Web.ViewModels.FundedPositionsIndexViewModel
@using HR.Core.Domain.Entities
@{ ViewData["Title"] = "المناصب الممولة"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0"><i class="fas fa-chair"></i> المناصب الممولة (EST-001)</h3>
        @if (ViewBag.CanMutate == true)
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> منصب جديد</a>
        }
    </div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">سنة الموازنة</label>
                <input type="number" name="BudgetYear" value="@Model.BudgetYear" class="form-control" min="2000" max="2100" />
            </div>
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <select name="Status" class="form-select">
                    <option value="">— الكل —</option>
                    @foreach (FundedPositionStatus s in Enum.GetValues<FundedPositionStatus>())
                    {
                        if (Model.Status == s) { <option value="@s" selected>@s</option> }
                        else { <option value="@s">@s</option> }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الفرع / المركزية</label>
                <select name="ScopeOrgUnitId" asp-items="ViewBag.BranchScopes" class="form-select">
                    <option value="">— الكل —</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الوحدة</label>
                <select name="OrgUnitId" asp-items="ViewBag.OrgUnits" class="form-select">
                    <option value="">— الكل —</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">بحث</label>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="رمز أو مسمى..." />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>رمز المنصب</th>
                    <th>المسمى</th>
                    <th>الدرجة</th>
                    <th>السنة</th>
                    <th>الوحدة</th>
                    <th>الحالة</th>
                    <th>المشغّل</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@p.Id"><strong>@p.PositionCode</strong></a></td>
                    <td>@(p.JobCatalogEntry?.TitleAr ?? "—")</td>
                    <td>@p.GradeCode</td>
                    <td>@p.BudgetYear</td>
                    <td>@(p.OrgUnit?.NameAr ?? "—")</td>
                    <td>@p.Status</td>
                    <td>@(p.OccupantEmployee?.FullName ?? "—")</td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">لا توجد مناصب</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
