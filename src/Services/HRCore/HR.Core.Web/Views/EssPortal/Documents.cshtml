@model IEnumerable<HR.Core.Domain.Entities.EmployeeDocument>
@{
    ViewData["Title"] = "مستنداتي";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">مستنداتي</h3></div>
    <div class="card-body table-responsive">
        <table class="table table-striped">
            <thead><tr><th>العنوان</th><th>النوع</th><th>التاريخ</th></tr></thead>
            <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.DocTitle</td>
                    <td>@d.DocType</td>
                    <td>@d.CreatedAt.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            </tbody>
        </table>
        <a asp-action="Index" class="btn btn-secondary">رجوع</a>
    </div>
</div>
