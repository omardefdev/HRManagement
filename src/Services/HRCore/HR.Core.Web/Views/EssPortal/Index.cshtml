@model HR.Core.Domain.Entities.Employee
@{
    ViewData["Title"] = "بوابة الموظف";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-user-circle ms-2"></i> مرحباً، @Model.FullName</h3>
        <span class="badge bg-success px-3 py-2">@Model.CurrentStatus</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="ess-info-item">
                    <i class="fas fa-sitemap"></i>
                    <div>
                        <small class="text-muted">الوحدة التنظيمية</small>
                        <div class="fw-bold">@(Model.PrimaryOrgUnit?.NameAr ?? "—")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ess-info-item">
                    <i class="fas fa-clock"></i>
                    <div>
                        <small class="text-muted">نمط الدوام</small>
                        <div class="fw-bold">@Model.WorkScheduleMode</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="ess-info-item">
                    <i class="fas fa-calendar-check"></i>
                    <div>
                        <small class="text-muted">سجلات الحضور</small>
                        <div class="fw-bold">@ViewBag.AttendanceCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="ess-info-item">
                    <i class="fas fa-folder-open"></i>
                    <div>
                        <small class="text-muted">المستندات</small>
                        <div class="fw-bold">@ViewBag.DocumentCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <a asp-action="Attendance" class="card ess-action-card h-100 text-decoration-none">
            <div class="card-body text-center py-4">
                <i class="fas fa-fingerprint fa-2x mb-2" style="color: var(--sy-teal);"></i>
                <h6 class="mb-0">الحضور والانصراف</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Leave" class="card ess-action-card h-100 text-decoration-none">
            <div class="card-body text-center py-4">
                <i class="fas fa-plane-departure fa-2x mb-2" style="color: var(--sy-primary);"></i>
                <h6 class="mb-0">طلب إجازة</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Advance" class="card ess-action-card h-100 text-decoration-none">
            <div class="card-body text-center py-4">
                <i class="fas fa-hand-holding-usd fa-2x mb-2" style="color: var(--sy-gold-dark);"></i>
                <h6 class="mb-0">طلب سلفة</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/ui/payroll/Ess/Payslips" class="card ess-action-card h-100 text-decoration-none">
            <div class="card-body text-center py-4">
                <i class="fas fa-file-invoice-dollar fa-2x mb-2" style="color: var(--sy-teal-dark);"></i>
                <h6 class="mb-0">كشوف الراتب</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Documents" class="card ess-action-card h-100 text-decoration-none">
            <div class="card-body text-center py-4">
                <i class="fas fa-file-alt fa-2x mb-2" style="color: var(--sy-gray);"></i>
                <h6 class="mb-0">المستندات</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="IdCard" class="card ess-action-card h-100 text-decoration-none">
            <div class="card-body text-center py-4">
                <i class="fas fa-id-card fa-2x mb-2" style="color: var(--sy-primary-dark);"></i>
                <h6 class="mb-0">طلب بطاقة</h6>
            </div>
        </a>
    </div>
</div>
