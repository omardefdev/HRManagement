@model HR.Core.Web.Controllers.EssAdvanceRequestModel
@{
    ViewData["Title"] = "طلب سلفة";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">تقديم طلب سلفة</h3></div>
    <div class="card-body">
        <form asp-action="Advance" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Amount" class="form-label">المبلغ</label>
                <input asp-for="Amount" type="number" step="0.01" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Reason" class="form-label">السبب</label>
                <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">إرسال الطلب</button>
            <a asp-action="Index" class="btn btn-secondary">رجوع</a>
        </form>
    </div>
</div>
