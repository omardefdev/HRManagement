@model HR.Core.Web.ViewModels.RecruitmentAppealsIndexViewModel
@using HR.Core.Domain.Enums

@{
    ViewData["Title"] = "استئنافات التوظيف";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0"><i class="fas fa-gavel ms-1"></i> استئنافات التوظيف</h3>
        <div class="btn-group btn-group-sm" role="group" aria-label="تصفية الحالة">
            <a asp-action="Index" class="btn @(Model.StatusFilter == "pending" ? "btn-primary" : "btn-outline-primary")">المعلقة</a>
            <a asp-action="Index" asp-route-status="all" class="btn @(Model.StatusFilter == "all" ? "btn-primary" : "btn-outline-primary")">الكل</a>
        </div>
    </div>
    <div class="card-body">
        @if (Model.AssignedOnly)
        {
            <p class="text-muted">تظهر هنا الاستئنافات المعيّنة لك بصفتك مراجعاً مستقلاً فقط.</p>
        }
        @if (Model.Items.Count == 0)
        {
            <p class="text-muted mb-0">لا توجد استئنافات.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>المرشح</th>
                            <th>طلب الشاغر</th>
                            <th>تاريخ التقديم</th>
                            <th>المراجع المستقل</th>
                            <th>الحالة</th>
                            <th>النتيجة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var appeal = item.Appeal;
                            <tr>
                                <td>@item.ApplicantFullName</td>
                                <td>@(item.RequisitionNumber ?? "—")</td>
                                <td>@appeal.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (item.ReviewerName is not null)
                                    {
                                        @item.ReviewerName
                                    }
                                    else if (appeal.IndependentReviewerId is not null)
                                    {
                                        <span class="text-muted">معرّف مستخدم (سجل قديم)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">غير معيّن</span>
                                    }
                                </td>
                                <td>
                                    @Html.HrEnumDisplay(appeal.Status)
                                    @if (appeal.Status == RecruitmentAppealStatus.Pending && appeal.IsAwaitingInfo)
                                    {
                                        <span class="badge bg-info text-dark ms-1">بانتظار معلومات</span>
                                    }
                                </td>
                                <td>
                                    @if (appeal.Outcome is { } outcome)
                                    {
                                        @Html.HrEnumDisplay(outcome)
                                    }
                                    else
                                    {
                                        <text>—</text>
                                    }
                                </td>
                                <td><a asp-action="Details" asp-route-id="@appeal.Id" class="btn btn-outline-secondary btn-sm">التفاصيل</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
