@model HR.Core.Web.ViewModels.RecruitmentApplicationDetailsViewModel
@using HR.Core.Domain.Enums
@using HR.Core.Domain.Services
@using HRManagement.ServiceDefaults

@{
    ViewData["Title"] = "تفاصيل طلب التوظيف";
    var app = Model.Application;
    var canWrite = User.IsInRole(HrManagementRoles.Admin) || User.IsInRole(HrManagementRoles.HrCore);
    var eligibilityFlags = RecruitmentEligibilityRules.Parse(app.EligibilityFlags);
    var qualificationNames = ViewBag.QualificationNames as IReadOnlyDictionary<string, string>
        ?? new Dictionary<string, string>();
}

@if (Model.AppealPending)
{
    <div class="alert alert-warning">
        <i class="fas fa-gavel ms-1"></i> يوجد استئناف قيد المراجعة — الترتيب وخطاب العرض موقوفان مؤقتاً.
        @if (Model.ActiveAppeal is not null)
        {
            <a asp-controller="RecruitmentAppeals" asp-action="Details" asp-route-id="@Model.ActiveAppeal.Id" class="alert-link ms-1">فتح الاستئناف</a>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.HireBlockedReason))
{
    <div class="alert alert-warning"><i class="fas fa-ban ms-1"></i> @Model.HireBlockedReason</div>
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="mb-0">
            @app.ApplicantFullName — @Html.HrEnumDisplay(app.Status)
            @if (app.Status == RecruitmentApplicationStatus.ReserveListed && app.ReserveUntil is DateOnly reserveUntil)
            {
                <span class="badge bg-secondary fs-6 align-middle">حتى @reserveUntil.ToString("yyyy/MM/dd")</span>
            }
        </h3>
        <div class="d-flex gap-1 flex-wrap">
            @if (canWrite && Model.CanHire)
            {
                <a asp-action="Hire" asp-route-id="@app.Id" class="btn btn-success btn-sm">
                    <i class="fas fa-user-check"></i> تعيين
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">رجوع</a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">المسمى</dt><dd class="col-sm-9">@app.AppliedPosition</dd>
            <dt class="col-sm-3">الرقم الوطني</dt><dd class="col-sm-9">@(app.NationalId ?? "—")</dd>
            <dt class="col-sm-3">طلب الشاغر</dt>
            <dd class="col-sm-9">
                @if (app.RequisitionId is Guid reqId)
                {
                    <a asp-controller="RecruitmentRequisitions" asp-action="Details" asp-route-id="@reqId">@(app.Requisition?.RequisitionNumber ?? "—")</a>
                    @if (canWrite)
                    {
                        <a asp-controller="SelectionCommittees" asp-action="Index" asp-route-requisitionId="@reqId" class="btn btn-outline-secondary btn-sm ms-2">لجنة الاختيار</a>
                    }
                }
                else
                {
                    <span class="badge bg-secondary">قديم</span>
                }
            </dd>
            <dt class="col-sm-3">تاريخ التقديم</dt><dd class="col-sm-9">@app.AppliedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
            <dt class="col-sm-3">قناة التقديم</dt><dd class="col-sm-9"><span class="badge bg-light text-dark border">@Html.HrEnumDisplay(app.IntakeChannel)</span></dd>
            <dt class="col-sm-3">درجة التقييم</dt><dd class="col-sm-9">@(app.AssessmentScore?.ToString("N1") ?? "—")</dd>
            <dt class="col-sm-3">الترتيب</dt><dd class="col-sm-9">@(app.Rank?.ToString() ?? "—")</dd>
            <dt class="col-sm-3">ملاحظات</dt><dd class="col-sm-9">@(app.Notes ?? "—")</dd>
        </dl>
    </div>
</div>

@* HCM-030 (D1/D4): application profile (HR only — BirthDate is personal data) and eligibility flags. *@
<div class="card mb-3" id="eligibility">
    <div class="card-header"><h5 class="mb-0">بيانات التقديم والأهلية</h5></div>
    <div class="card-body">
        <dl class="row mb-2">
            <dt class="col-sm-3">المؤهل العلمي</dt>
            <dd class="col-sm-9">@(app.EducationLevelCode is { } code ? qualificationNames.GetValueOrDefault(code, code) : "—")</dd>
            <dt class="col-sm-3">التخصص</dt><dd class="col-sm-9">@(app.Specialization ?? "—")</dd>
            <dt class="col-sm-3">سنة التخرج</dt><dd class="col-sm-9">@(app.GraduationYear?.ToString() ?? "—")</dd>
            <dt class="col-sm-3">سنوات الخبرة</dt><dd class="col-sm-9">@(app.YearsOfExperience?.ToString("0.#") ?? "—")</dd>
            <dt class="col-sm-3">تاريخ الميلاد</dt><dd class="col-sm-9">@(app.BirthDate?.ToString("yyyy/MM/dd") ?? "—")</dd>
            <dt class="col-sm-3">ملاحظات الأهلية</dt>
            <dd class="col-sm-9">
                @if (eligibilityFlags.Count > 0)
                {
                    @foreach (var flag in eligibilityFlags)
                    {
                        <span class="badge bg-warning text-dark ms-1">@RecruitmentEligibilityRules.LabelAr(flag)</span>
                    }
                }
                else if (app.EligibilityEvaluatedAt is null)
                {
                    <span class="text-muted">لم تُقيَّم (طلب قديم أو مُدخل يدوياً)</span>
                }
                else
                {
                    <span class="text-success">لا ملاحظات</span>
                }
            </dd>
            @if (!string.IsNullOrWhiteSpace(app.EligibilityOverrideReason))
            {
                <dt class="col-sm-3">سبب تجاوز الأهلية</dt><dd class="col-sm-9">@app.EligibilityOverrideReason</dd>
            }
        </dl>
    </div>
</div>

@if (app.RequisitionId.HasValue)
{
    <partial name="_InterviewsPanel" model="Model" />
    <partial name="_AssessmentScoringPanel" model="Model.ScoringPanel" />
}

@if (canWrite)
{
    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">إقرار تعارض المصالح (COI)</h5></div>
        <div class="card-body">
            @if (app.ConflictOfInterestDeclared)
            {
                <p class="text-success mb-0">
                    <i class="fas fa-check-circle"></i>
                    تم الإقرار @(app.ConflictOfInterestDeclaredAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "")
                </p>
            }
            else
            {
                <form asp-action="DeclareCoi" method="post" class="d-flex align-items-center gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@app.Id" />
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="coiConfirm" required />
                        <label class="form-check-label" for="coiConfirm">أُقر بعدم وجود تعارض مصالح يؤثر على قرار الاختيار</label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">تسجيل الإقرار</button>
                </form>
            }
        </div>
    </div>

    @if (app.RequisitionId.HasValue)
    {
        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">تعيين الترتيب</h5></div>
            <div class="card-body">
                @{
                    var gate = Model.CommitteeGate;
                    var committeeDecision = Model.CommitteeDecision;
                    var gated = gate?.Required == true;
                }
                @if (gated || committeeDecision is not null)
                {
                    <div class="mb-3">
                        @if (gated)
                        {
                            <span class="badge bg-warning text-dark">الترتيب مشروط باعتماد لجنة الاختيار</span>
                        }
                        @if (gate?.ApprovedSession is null)
                        {
                            <span class="text-muted small ms-1">لا توجد جلسة لجنة معتمدة (ترتيب/قرار نهائي) لهذا الطلب بعد.</span>
                        }
                        else if (committeeDecision is null)
                        {
                            <span class="text-muted small ms-1">لا توجد توصية للجنة بشأن هذا المرشح في الجلسة المعتمدة.</span>
                        }
                        else
                        {
                            <span class="ms-1">توصية اللجنة:
                                <strong>@HRManagement.SharedKernel.Localization.EnumDisplayExtensions.GetDisplayName(committeeDecision.Recommendation)</strong>
                                @if (committeeDecision.ProposedRank is int proposed)
                                {
                                    <span>— الترتيب المقترح <strong>@proposed</strong></span>
                                }
                            </span>
                            @if (!string.IsNullOrWhiteSpace(committeeDecision.Rationale))
                            {
                                <div class="text-muted small">@committeeDecision.Rationale</div>
                            }
                            <a asp-controller="SelectionCommittees" asp-action="Details" asp-route-id="@gate.ApprovedSession.Id" class="small">محضر الجلسة</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(app.RankOverrideReason))
                        {
                            <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">رتبة مخالفة للمقترح — السبب: @app.RankOverrideReason</div>
                        }
                    </div>
                }
                @if (!Model.CanRank)
                {
                    <p class="text-muted mb-0">الترتيب موقوف بسبب استئناف قيد المراجعة.</p>
                }
                else if (app.Status is not (HR.Core.Domain.Enums.RecruitmentApplicationStatus.Assessed or HR.Core.Domain.Enums.RecruitmentApplicationStatus.Ranked))
                {
                    <p class="text-muted mb-0">@HR.Core.Domain.Services.SelectionCommitteeRules.NotAssessedMessage</p>
                }
                else
                {
                    <form asp-action="AssignRank" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ApplicationId" value="@app.Id" />
                        <div class="col-md-3">
                            <label class="form-label">الترتيب</label>
                            <input type="number" name="Rank" class="form-control" min="1" value="@(app.Rank ?? committeeDecision?.ProposedRank ?? 1)" required />
                        </div>
                        @if (gated && committeeDecision is { ProposedRank: not null })
                        {
                            <div class="col-md-7">
                                <label class="form-label" for="rankOverrideReason">سبب مخالفة الترتيب المقترح (مطلوب إن اختلف الترتيب، @HR.Core.Domain.Services.SelectionCommitteeRules.MinRankOverrideReasonLength حرفاً على الأقل)</label>
                                <input type="text" id="rankOverrideReason" name="RankOverrideReason" class="form-control" maxlength="1000" />
                            </div>
                        }
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary">حفظ الترتيب</button>
                        </div>
                    </form>
                }
            </div>
        </div>

    }

    @if (Model.AllowedStatusTransitions.Any())
    {
        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">انتقالات الحالة</h5></div>
            <div class="card-body d-flex flex-wrap gap-2">
                @foreach (var target in Model.AllowedStatusTransitions.Where(t => t != RecruitmentApplicationStatus.Rejected))
                {
                    @if (target == RecruitmentApplicationStatus.Shortlisted && eligibilityFlags.Count > 0)
                    {
                        @* HCM-030 (D4): shortlisting a flagged application needs a reason (audited). *@
                        <form asp-action="SetStatus" method="post" class="w-100 border rounded p-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@app.Id" />
                            <input type="hidden" name="status" value="@target" />
                            <label class="form-label" for="eligibilityOverrideReason">سبب تجاوز ملاحظات الأهلية</label>
                            <textarea id="eligibilityOverrideReason" name="eligibilityOverrideReason" class="form-control form-control-sm mb-2"
                                      rows="2" minlength="@RecruitmentEligibilityRules.MinOverrideReasonLength" maxlength="1000" required></textarea>
                            <button type="submit" class="btn btn-outline-primary btn-sm">@Html.HrEnumDisplay(target)</button>
                        </form>
                        continue;
                    }
                    <form asp-action="SetStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@app.Id" />
                        <input type="hidden" name="status" value="@target" />
                        <button type="submit" class="btn btn-outline-primary btn-sm">@Html.HrEnumDisplay(target)</button>
                    </form>
                }
                @if (Model.AllowedStatusTransitions.Contains(RecruitmentApplicationStatus.Rejected))
                {
                    <form asp-action="SetStatus" method="post" class="d-flex gap-1 align-items-center" data-hr-confirm="رفض الطلب؟ يمكن للمرشح الاستئناف خلال المهلة." data-hr-confirm-title="رفض الطلب" data-hr-confirm-variant="danger">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@app.Id" />
                        <input type="hidden" name="status" value="@RecruitmentApplicationStatus.Rejected" />
                        <label class="visually-hidden" for="rejectionNote">ملاحظة الرفض</label>
                        <input type="text" id="rejectionNote" name="rejectionNote" class="form-control form-control-sm" maxlength="1000" placeholder="ملاحظة الرفض (اختياري)" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">@Html.HrEnumDisplay(RecruitmentApplicationStatus.Rejected)</button>
                    </form>
                }
            </div>
        </div>
    }

    @if (app.Status == RecruitmentApplicationStatus.Rejected)
    {
        <div class="card mb-3" id="appeal">
            <div class="card-header"><h5 class="mb-0">الرفض والاستئناف</h5></div>
            <div class="card-body">
                <dl class="row mb-3">
                    <dt class="col-sm-3">نوع الرفض</dt>
                    <dd class="col-sm-9">
                        @if (app.RejectionKind is { } kind)
                        {
                            @Html.HrEnumDisplay(kind)
                        }
                        else
                        {
                            <text>قرار الاختيار (سجل قديم)</text>
                        }
                    </dd>
                    <dt class="col-sm-3">تاريخ الرفض</dt>
                    <dd class="col-sm-9">@((app.RejectedAt ?? app.ReviewedAt)?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</dd>
                    @if (!string.IsNullOrWhiteSpace(app.RejectionNote))
                    {
                        <dt class="col-sm-3">ملاحظة الرفض</dt>
                        <dd class="col-sm-9">@app.RejectionNote</dd>
                    }
                </dl>
                @if (canWrite && Model.CanAppeal)
                {
                    <form asp-action="FileAppeal" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@app.Id" />
                        <div class="col-md-9">
                            <label class="form-label" for="appealReason">سبب الاستئناف (نيابة عن المرشح، @HR.Core.Domain.Services.RecruitmentAppealWorkflowRules.MinReasonLength حرفاً على الأقل)</label>
                            <textarea id="appealReason" name="reason" class="form-control" rows="2" minlength="@HR.Core.Domain.Services.RecruitmentAppealWorkflowRules.MinReasonLength" maxlength="2000" required></textarea>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-warning">تقديم الاستئناف</button>
                        </div>
                    </form>
                    <p class="text-muted small mt-2 mb-0">يُعيَّن المراجع المستقل بعد التقديم من صفحة الاستئناف.</p>
                }
                else if (!Model.CanAppeal && Model.ActiveAppeal is null && !string.IsNullOrWhiteSpace(Model.AppealFilingError))
                {
                    <p class="text-muted mb-0">@Model.AppealFilingError</p>
                }
            </div>
        </div>
    }

    @if (Model.ActiveAppeal is not null)
    {
        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">الاستئناف</h5></div>
            <div class="card-body d-flex flex-wrap gap-3 align-items-center">
                <span>الحالة: <strong>@Html.HrEnumDisplay(Model.ActiveAppeal.Status)</strong></span>
                @if (Model.ActiveAppeal.Outcome is { } outcome)
                {
                    <span>النتيجة: <strong>@Html.HrEnumDisplay(outcome)</strong></span>
                }
                <a asp-controller="RecruitmentAppeals" asp-action="Details" asp-route-id="@Model.ActiveAppeal.Id" class="btn btn-outline-secondary btn-sm">تفاصيل الاستئناف</a>
            </div>
        </div>
    }

    @if (app.RequisitionId.HasValue && app.ActiveOfferLetter is null
         && app.Status is RecruitmentApplicationStatus.Ranked or RecruitmentApplicationStatus.ReserveListed)
    {
        <div class="card mb-3" id="create-offer">
            <div class="card-header"><h5 class="mb-0">إنشاء خطاب عرض</h5></div>
            <div class="card-body">
                @if (!Model.CanOffer)
                {
                    <p class="text-muted mb-0">إنشاء العرض موقوف بسبب استئناف قيد المراجعة.</p>
                }
                else if (ViewBag.RequisitionLegalSourceLabel is null)
                {
                    <p class="text-warning mb-0">@HR.Core.Domain.Services.RecruitmentLegalSourceRules.RequisitionMissingLegalSourceForOfferMessage</p>
                }
                else
                {
                    <p class="mb-2 text-muted">
                        <strong>المرجع القانوني (من طلب الشاغر):</strong> @ViewBag.RequisitionLegalSourceLabel
                    </p>
                    @if (Model.GradeMinSalary is decimal gradeMin && Model.GradeMaxSalary is decimal gradeMax)
                    {
                        <div class="alert alert-info py-2">
                            حدود الدرجة @Model.PositionGradeCode في سلّم الرواتب الساري:
                            <strong>@HR.Core.Domain.Services.OfferTermsRules.FormatAmount(gradeMin)–@HR.Core.Domain.Services.OfferTermsRules.FormatAmount(gradeMax)</strong>
                        </div>
                    }
                    else if (Model.PayrollLookupUnavailable)
                    {
                        <div class="alert alert-warning py-2">
                            تعذّر التحقق من حدود الدرجة في الرواتب حالياً. يمكن إنشاء العرض بمبرر للراتب
                            (@HR.Core.Domain.Services.OfferTermsRules.MinSalaryJustificationLength حرفاً على الأقل)، ويصبح عرضاً استثنائياً بمسار اعتماد من ثلاث خطوات.
                        </div>
                    }
                    else if (Model.PositionGradeNotInScale)
                    {
                        <div class="alert alert-danger py-2">@HR.Core.Domain.Services.OfferTermsRules.GradeNotFoundMessage(Model.PositionGradeCode!)</div>
                    }
                    <form asp-action="CreateOffer" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ApplicationId" value="@app.Id" />
                    <div class="col-md-2">
                        <label class="form-label" for="OfferedSalary">الراتب المعروض</label>
                        <input type="number" name="OfferedSalary" id="OfferedSalary" class="form-control" step="0.01" required
                               min="@(Model.GradeMinSalary?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0.01")"
                               max="@(Model.GradeMaxSalary?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="GradeCode">الدرجة</label>
                        <input type="text" name="GradeCode" id="GradeCode" class="form-control" maxlength="50" value="@Model.PositionGradeCode" />
                        @if (Model.PositionGradeCode is not null)
                        {
                            <div class="form-text">من المنصب الممول</div>
                        }
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="ProposedStartDate">تاريخ المباشرة</label>
                        <input type="date" name="ProposedStartDate" id="ProposedStartDate" class="form-control"
                               min="@DateTime.UtcNow.Date.ToString("yyyy-MM-dd")"
                               value="@Model.DefaultProposedStartDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="ValidityDays">مدة صلاحية العرض (أيام)</label>
                        <input type="number" name="ValidityDays" id="ValidityDays" class="form-control"
                               min="@HR.Core.Domain.Services.OfferWorkflowRules.MinValidityDays"
                               max="@HR.Core.Domain.Services.OfferWorkflowRules.MaxValidityDays"
                               value="@Model.DefaultOfferValidityDays" required />
                    </div>
                    @if (Model.RequiresMeritOverride)
                    {
                        <div class="col-12">
                            <div class="alert alert-warning mb-2">
                                المرشح ليس التالي بالجدارة (الرتبة المتاحة: @(Model.BestAvailableRank?.ToString() ?? "—")).
                                يتطلب إصدار العرض تجاوز الجدارة بمبرر مكتوب (@HR.Core.Domain.Services.OfferEligibilityRules.MinMeritOverrideReasonLength حرفاً على الأقل) ومسار اعتماد استثنائي من ثلاث خطوات.
                            </div>
                            <div class="form-check mb-2">
                                <input type="checkbox" name="IsMeritOverride" value="true" id="IsMeritOverride" class="form-check-input" />
                                <label class="form-check-label" for="IsMeritOverride">تجاوز الجدارة</label>
                            </div>
                            <label class="form-label" for="MeritOverrideReason">مبرر تجاوز الجدارة</label>
                            <textarea name="MeritOverrideReason" id="MeritOverrideReason" class="form-control" rows="3"
                                      maxlength="1000" minlength="@HR.Core.Domain.Services.OfferEligibilityRules.MinMeritOverrideReasonLength"></textarea>
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label" for="GradeDeviationReason">مبرر اختلاف الدرجة (إن اختلفت عن درجة المنصب)</label>
                        <textarea name="GradeDeviationReason" id="GradeDeviationReason" class="form-control" rows="2" maxlength="500"></textarea>
                        <div class="form-text">اختلاف الدرجة يجعل العرض استثنائياً بمسار اعتماد من ثلاث خطوات.</div>
                    </div>
                    @if (Model.PayrollLookupUnavailable)
                    {
                        <div class="col-md-6">
                            <label class="form-label" for="SalaryJustification">مبرر الراتب (الرواتب غير متاحة)</label>
                            <textarea name="SalaryJustification" id="SalaryJustification" class="form-control" rows="2" maxlength="1000"
                                      minlength="@HR.Core.Domain.Services.OfferTermsRules.MinSalaryJustificationLength" required></textarea>
                        </div>
                    }
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success">إنشاء مسودة</button>
                    </div>
                </form>
                }
            </div>
        </div>
    }
}

@if (app.ActiveOfferLetter is not null)
{
    var offer = app.ActiveOfferLetter;
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">خطاب العرض</h5>
            <a asp-controller="OfferLetters" asp-action="Details" asp-route-id="@offer.Id" class="btn btn-outline-primary btn-sm">عرض التفاصيل</a>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">رقم العرض</dt><dd class="col-sm-9">@offer.OfferNumber</dd>
                <dt class="col-sm-3">الحالة</dt><dd class="col-sm-9">@Html.HrEnumDisplay(offer.Status)</dd>
                <dt class="col-sm-3">الراتب</dt><dd class="col-sm-9">@offer.OfferedSalary.ToString("N2")</dd>
                <dt class="col-sm-3">تاريخ المباشرة</dt><dd class="col-sm-9">@offer.ProposedStartDate.ToString("yyyy/MM/dd")</dd>
                <dt class="col-sm-3">مرجع قانوني</dt><dd class="col-sm-9">@(ViewBag.RequisitionLegalSourceLabel ?? offer.LegalSourceId ?? "—")</dd>
            </dl>
        </div>
    </div>
}

@if (app.OfferLetters.Any())
{
    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">سجل العروض</h5></div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>رقم العرض</th><th>الحالة</th><th>الإصدار</th><th>الانتهاء</th><th>السبب</th></tr></thead>
                <tbody>
                @foreach (var past in app.OfferLetters.OrderByDescending(o => o.CreatedAt))
                {
                    <tr>
                        <td>
                            <a asp-controller="OfferLetters" asp-action="Details" asp-route-id="@past.Id">@past.OfferNumber</a>
                            @if (past.IsExceptionOffer)
                            {
                                <span class="badge bg-warning text-dark ms-1">استثنائي</span>
                            }
                            @if (HR.Core.Infrastructure.Services.Recruitment.OfferLetterDocumentService.CanDownload(past.Status))
                            {
                                <a asp-controller="OfferLetters" asp-action="Document" asp-route-id="@past.Id" class="ms-1" title="خطاب العرض الرسمي (PDF)"><i class="fas fa-file-pdf"></i> PDF</a>
                            }
                        </td>
                        <td>@Html.HrEnumDisplay(past.Status)</td>
                        <td>@(past.IssuedDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                        <td>@(past.ExpiryDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                        <td>@(past.DeclineReason ?? past.RevokeReason ?? (past.Status == OfferStatus.Expired ? "انتهاء صلاحية العرض" : "—"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.RankBoard.Any())
{
    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">لوحة الترتيب</h5></div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>الترتيب</th><th>المتقدم</th><th>الدرجة</th><th>الحالة</th></tr></thead>
                <tbody>
                @foreach (var row in Model.RankBoard)
                {
                    var isNextByMerit = Model.BestAvailableRank is int best && row.Rank == best
                        && HR.Core.Domain.Services.OfferEligibilityRules.IsAvailableForMerit(row);
                    <tr class="@(row.Id == app.Id ? "table-primary" : "")">
                        <td>
                            @row.Rank
                            @if (isNextByMerit)
                            {
                                <span class="badge bg-success ms-1">التالي بالجدارة</span>
                            }
                        </td>
                        <td>
                            @if (row.Id == app.Id)
                            {
                                @row.ApplicantFullName
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@row.Id">@row.ApplicantFullName</a>
                            }
                        </td>
                        <td>@(row.AssessmentScore?.ToString("N1") ?? "—")</td>
                        <td>
                            @Html.HrEnumDisplay(row.Status)
                            @if (row.Status == RecruitmentApplicationStatus.ReserveListed && row.ReserveUntil is DateOnly rowReserveUntil)
                            {
                                <span class="text-muted small">حتى @rowReserveUntil.ToString("yyyy/MM/dd")</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
