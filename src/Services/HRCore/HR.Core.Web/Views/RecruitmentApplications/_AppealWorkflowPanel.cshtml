@model HR.Core.Web.ViewModels.WorkflowPanelViewModel
@{
    var applicationId = ViewData["ApplicationId"] as Guid? ?? Guid.Empty;
    var appealId = ViewData["AppealId"] as Guid? ?? Guid.Empty;
    ViewData["WorkflowController"] = "RecruitmentApplications";
    ViewData["WorkflowApproveAction"] = "ApproveAppealWorkflow";
    ViewData["WorkflowRejectAction"] = "RejectAppealWorkflow";
    ViewData["WorkflowEntityId"] = applicationId;
    ViewData["WorkflowEntityIdFieldName"] = "ApplicationId";
    ViewData["WorkflowExtraFieldName"] = "AppealId";
    ViewData["WorkflowExtraFieldValue"] = appealId;
    ViewData["WorkflowConfirmReject"] = "رفض الاستئناف عبر مسار المراجعة؟";
}

@if (Model.HasWorkflowInstance)
{
    <h6 class="mt-2">مسار مراجعة الاستئناف</h6>
    <p class="text-muted small mb-2">
        @(Model.WorkflowName ?? Model.WorkflowCode ?? "—")
        @if (Model.WorkflowStatus is not null)
        {
            <span class="badge bg-light text-dark ms-1">@Model.WorkflowStatus</span>
        }
    </p>
    <partial name="_WorkflowProgressPanel" model="Model.Steps" />

    @if (!string.IsNullOrWhiteSpace(Model.BlockReason))
    {
        <div class="alert alert-info mt-3 mb-0">@Model.BlockReason</div>
    }

    @if (Model.CanApprove || Model.CanReject)
    {
        <partial name="_WorkflowActionPanel" model="Model" />
    }
}
