@model HR.Core.Web.ViewModels.HrStatisticReportsIndexViewModel
@{ ViewData["Title"] = "التقارير الإحصائية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between"><h3 class="mb-0">الإحصاء</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">بحث</label>
                <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="العنوان أو الملخص..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">الوحدة التنظيمية</label>
                <select name="orgUnitId" asp-items="ViewBag.OrgUnits" class="form-select"><option value="">— الكل —</option></select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الفترة من</label>
                <input type="date" name="periodFrom" value="@Model.PeriodFrom?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">الفترة إلى</label>
                <input type="date" name="periodTo" value="@Model.PeriodTo?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table mb-0"><thead><tr><th>العنوان</th><th>الفترة</th><th>الوحدة</th></tr></thead><tbody>
        @foreach (var x in Model.Items){<tr><td>@x.Title</td><td>@x.PeriodStart — @x.PeriodEnd</td><td>@x.OrgUnit?.NameAr</td></tr>}
        @if(!Model.Items.Any()){<tr><td colspan="3" class="text-center text-muted">لا توجد</td></tr>}</tbody></table>
    </div>
</div>
