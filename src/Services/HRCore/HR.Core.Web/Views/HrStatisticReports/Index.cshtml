@model IReadOnlyList<HR.Core.Domain.Entities.HrStatisticReport>
@{ ViewData["Title"] = "التقارير الإحصائية"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">الإحصاء</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>العنوان</th><th>الفترة</th><th>الوحدة</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.Title</td><td>@x.PeriodStart — @x.PeriodEnd</td><td>@x.OrgUnit?.NameAr</td></tr>}
@if(!Model.Any()){<tr><td colspan="3" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
