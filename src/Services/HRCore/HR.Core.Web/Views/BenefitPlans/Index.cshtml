@model IReadOnlyList<HRManagement.SharedKernel.Benefits.BenefitPlan>
@{
    ViewData["Title"] = "خطط المزايا";
    var legalLabels = ViewBag.LegalSourceLabels as IDictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-hand-holding-medical"></i> خطط المزايا والتقاعد</h3>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>الرمز</th>
                    <th>الاسم</th>
                    <th>النوع</th>
                    <th>نظام الخدمة</th>
                    <th>المرجع التشريعي</th>
                    <th>ساري من</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var plan in Model)
                {
                    <tr>
                        <td>@plan.PlanCode</td>
                        <td>@plan.PlanName</td>
                        <td>@Html.HrEnumDisplay(plan.PlanType)</td>
                        <td>@(plan.LegalRegimeId ?? "—")</td>
                        <td>@(plan.LegalSourceId is null ? "—" : (legalLabels.TryGetValue(plan.LegalSourceId, out var label) ? label : plan.LegalSourceId))</td>
                        <td>@plan.EffectiveFrom.ToString("yyyy/MM/dd")</td>
                        <td>@(plan.IsActive ? "نشط" : "غير نشط")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد خطط مزايا</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
