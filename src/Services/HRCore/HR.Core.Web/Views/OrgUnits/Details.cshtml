@model HR.Core.Domain.Entities.OrgUnit
@{
    ViewData["Title"] = "تفاصيل الوحدة التنظيمية";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-building"></i> @Model.NameAr</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <table class="table table-sm">
                    <tr><th style="width:40%">رمز الوحدة</th><td>@Model.Code</td></tr>
                    <tr><th>الاسم بالعربي</th><td>@Model.NameAr</td></tr>
                    <tr><th>الاسم بالإنكليزي</th><td>@(Model.NameEn ?? "—")</td></tr>
                    <tr><th>الوحدة الأم</th><td>@(Model.Parent?.NameAr ?? "— (وحدة جذرية)")</td></tr>
                    <tr><th>رئيس الوحدة</th><td>@(Model.HeadEmployee?.FullName ?? "—")</td></tr>
                </table>
            </div>
        </div>

        @if (Model.Children.Any())
        {
            <h5 class="mt-4"><i class="fas fa-folder-open"></i> الوحدات الفرعية (@Model.Children.Count)</h5>
            <table class="table table-sm table-striped">
                <thead><tr><th>الرمز</th><th>الاسم</th><th>إجراءات</th></tr></thead>
                <tbody>
                    @foreach (var child in Model.Children)
                    {
                        <tr>
                            <td>@child.Code</td>
                            <td>@child.NameAr</td>
                            <td><a asp-action="Details" asp-route-id="@child.Id" class="btn btn-info btn-xs"><i class="fas fa-eye"></i> عرض</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit"></i> تعديل</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> العودة</a>
    </div>
</div>
