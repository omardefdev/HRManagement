@model HR.Core.Web.ViewModels.OrgUnitCreateViewModel
@{
    ViewData["Title"] = "إضافة وحدة تنظيمية";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-plus-circle"></i> إضافة وحدة تنظيمية</h3>
    </div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="alert alert-info">يُولَّد رمز الوحدة تلقائياً عند الحفظ وفق سياسة الترميز.</div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3 mb-3">
                        <label asp-for="NameAr" class="form-label"></label>
                        <input asp-for="NameAr" class="form-control" />
                        <span asp-validation-for="NameAr" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3 mb-3">
                        <label asp-for="NameEn" class="form-label"></label>
                        <input asp-for="NameEn" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3 mb-3">
                        <label asp-for="ParentId" class="form-label"></label>
                        <select asp-for="ParentId" asp-items="Model.ParentUnits" class="form-control">
                            <option value="">-- بدون وحدة أم --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3 mb-3">
                        <label asp-for="HeadEmployeeId" class="form-label"></label>
                        <select asp-for="HeadEmployeeId" asp-items="Model.Employees" class="form-control">
                            <option value="">-- بدون رئيس --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> حفظ</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times"></i> إلغاء</a>
        </div>
    </form>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
