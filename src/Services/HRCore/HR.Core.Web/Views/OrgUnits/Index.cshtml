@model HR.Core.Web.ViewModels.OrgUnitListViewModel
@{
    ViewData["Title"] = "الوحدات التنظيمية";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-sitemap"></i> الوحدات التنظيمية</h3>
        <div class="card-tools">
            <a asp-action="Tree" class="btn btn-info btn-sm me-1">
                <i class="fas fa-project-diagram"></i> عرض الشجرة
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> إضافة وحدة تنظيمية
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>رمز الوحدة</th>
                        <th>الاسم بالعربي</th>
                        <th>الوحدة الأم</th>
                        <th>رئيس الوحدة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var unit in Model.OrgUnits.Items)
                    {
                        <tr>
                            <td><strong>@unit.Code</strong></td>
                            <td><a asp-action="Details" asp-route-id="@unit.Id">@unit.NameAr</a></td>
                            <td>@(unit.Parent?.NameAr ?? "—")</td>
                            <td>@(unit.HeadEmployee?.FullName ?? "—")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@unit.Id" class="btn btn-info btn-xs" aria-label="تفاصيل"><i aria-hidden="true" class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-warning btn-xs" aria-label="تعديل"><i aria-hidden="true" class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="@Url.Action("Delete", new { id = unit.Id })" aria-label="حذف">
                                    <i aria-hidden="true" class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.OrgUnits.Items.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">لا توجد وحدات تنظيمية</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_HrPagination", HrPaginationModel.From(Model.OrgUnits))
    </div>
</div>

