@model List<HR.Core.Domain.Entities.EmploymentStatusHistory>
@{
    ViewData["Title"] = ViewBag.Employee != null
        ? $"سجل حالة التوظيف - {ViewBag.Employee.FullName}"
        : "سجل حالة التوظيف";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-history"></i> @ViewData["Title"]</h3>
        <div class="card-tools">
            <a asp-action="FullLog" class="btn btn-info btn-sm"><i class="fas fa-list-alt"></i> السجل الكامل</a>
        </div>
    </div>
    <div class="card-body">
        <form method="get" class="row mb-3 g-2">
            <div class="col-md-3">
                <label class="form-label">الموظف</label>
                <select name="employeeId" class="form-control form-control-sm" asp-items="@((SelectList)ViewBag.Employees)">
                    <option value="">الكل</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <input type="text" name="status" value="@ViewBag.StatusFilter" class="form-control form-control-sm" placeholder="الحالة الجديدة" />
            </div>
            <div class="col-md-2">
                <label class="form-label">من تاريخ</label>
                <input type="date" name="from" value="@ViewBag.FromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">إلى تاريخ</label>
                <input type="date" name="to" value="@ViewBag.ToDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover">
                <thead>
                    <tr>
                        <th>الموظف</th>
                        <th>الحالة القديمة</th>
                        <th>الحالة الجديدة</th>
                        <th>تاريخ التغيير</th>
                        <th>السبب</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td>@(h.Employee?.FullName ?? "—")</td>
                            <td>@(h.OldStatus ?? "—")</td>
                            <td><span class="badge text-bg-primary">@h.NewStatus</span></td>
                            <td dir="ltr">@h.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(h.Reason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var currentPage = (int)ViewBag.CurrentPage;
            var totalPages = (int)ViewBag.TotalPages;
        }
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i"
                               asp-route-employeeId="@ViewBag.EmployeeId"
                               asp-route-status="@ViewBag.StatusFilter"
                               asp-route-from="@ViewBag.FromDate"
                               asp-route-to="@ViewBag.ToDate">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
