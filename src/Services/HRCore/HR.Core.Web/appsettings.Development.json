{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "ConnectionStrings":  {
                              "HRCoreDb":  "Host=localhost;Port=5433;Database=hr_core_db;Username=hrmanagement;Password=USE_ENV_OR_USER_SECRETS"
                          },
    "HrGateway":  {
                      "InternalBaseUrl":  "http://localhost:5200"
                  },
    "Seed":  {
                 "IncludeSamplePosting":  true
             },
    "Recruitment": {
        "PublicPortalBaseUrl": "http://localhost:5000",
        "Competition": {
            "Defaults": {
                "ObjectionWindowDays": 7,
                "ReserveValidityMonths": 6,
                "MaxLinesPerCandidate": 2,
                "PassMark": 50,
                "ReconcileThreshold": 10,
                "ReconcileRule": "ReconcilerDecides",
                "TieBreakOrder": [ "ExamScore", "InterviewScore", "AppliedAt" ]
            }
        }
    },
    "Notifications": {
        "Candidate": {
            "Provider": "FileDrop",
            "FileDrop": {
                "Path": "artifacts/candidate-notifications"
            }
        }
    }
}
