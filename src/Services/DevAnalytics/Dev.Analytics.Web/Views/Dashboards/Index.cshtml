@model (IReadOnlyList<Dev.Analytics.Domain.Entities.Dashboard> Dashboards, IReadOnlyList<Dev.Analytics.Domain.Entities.KPI> Kpis, IReadOnlyList<Dev.Analytics.Domain.Entities.ETLJob> Jobs, Dev.Analytics.Domain.Services.RecruitmentCard Recruitment)
@{ ViewData["Title"] = "لوحات ومؤشرات"; }
<p><a asp-action="Create" class="btn btn-primary btn-sm">لوحة جديدة</a></p>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header">لوحات</div>
            <ul class="list-group list-group-flush">
                @foreach (var d in Model.Dashboards)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">@d.Name <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-info">تفاصيل</a></li>
                }
                @if (!Model.Dashboards.Any())
                {
                    <li class="list-group-item text-muted">لا لوحات بعد</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header">مؤشرات الأداء</div>
            <ul class="list-group list-group-flush small">
                @foreach (var k in Model.Kpis)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center"><span>@k.Code — @k.Name</span><a asp-controller="Kpis" asp-action="Details" asp-route-id="@k.Id" class="btn btn-sm btn-info">تفاصيل</a></li>
                }
                @if (!Model.Kpis.Any())
                {
                    <li class="list-group-item text-muted">لا مؤشرات</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header">مهام ETL الأخيرة</div>
            <ul class="list-group list-group-flush small">
                @foreach (var j in Model.Jobs)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center"><span>@j.Name <span class="text-muted">(@Html.HrEnumDisplay(j.Status))</span></span><a asp-controller="EtlJobs" asp-action="Details" asp-route-id="@j.Id" class="btn btn-sm btn-info">تفاصيل</a></li>
                }
                @if (!Model.Jobs.Any())
                {
                    <li class="list-group-item text-muted">لا وظائف</li>
                }
            </ul>
        </div>
    </div>
</div>

@* HCM-032 (PLAN-32): aggregates of HR.Core's closed requisitions; counts 1–4 are shown «<5». *@
<section class="card mb-3" aria-labelledby="recruitment-card-title" id="recruitment-card">
    <div class="card-header"><h2 class="h6 mb-0" id="recruitment-card-title">التوظيف</h2></div>
    <div class="card-body small">
        <p class="mb-2">
            طلبات شاغر أُغلقت في آخر 12 شهراً: @Model.Recruitment.RequisitionsClosed · ملغاة: @Model.Recruitment.RequisitionsCancelled ·
            مُلئت: @Model.Recruitment.Filled · وسيط زمن الملء (أيام): @Model.Recruitment.MedianTimeToFillDays
        </p>
        <div class="row">
            <div class="col-md-6">
                <table class="table table-sm">
                    <caption>المتقدمون حسب قناة التقديم (الأعداد من 1 إلى 4 محجوبة)</caption>
                    <thead><tr><th scope="col">القناة</th><th scope="col">المتقدمون</th></tr></thead>
                    <tbody>
                        @foreach (var row in Model.Recruitment.Channels)
                        {
                            <tr><th scope="row">@row.Label</th><td>@row.Value</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-sm">
                    <caption>نتائج العروض (الأعداد من 1 إلى 4 محجوبة)</caption>
                    <thead><tr><th scope="col">النتيجة</th><th scope="col">العدد</th></tr></thead>
                    <tbody>
                        @foreach (var row in Model.Recruitment.OfferOutcomes)
                        {
                            <tr><th scope="row">@row.Label</th><td>@row.Value</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<p><a asp-controller="Reports" asp-action="Index">التقارير</a></p>
