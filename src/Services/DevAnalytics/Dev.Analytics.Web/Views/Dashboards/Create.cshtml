@model Dev.Analytics.Domain.Entities.Dashboard
@{ ViewData["Title"] = "لوحة جديدة"; }
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Widgets" class="form-label"></label>
        <textarea asp-for="Widgets" class="form-control" rows="3" placeholder="JSON أو وصف نصي للأدوات"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">حفظ</button>
    <a asp-action="Index" class="btn btn-link">إلغاء</a>
</form>
