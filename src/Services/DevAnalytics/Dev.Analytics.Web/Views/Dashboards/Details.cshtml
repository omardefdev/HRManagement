@model Dashboard
@{ ViewData["Title"] = "تفاصيل اللوحة"; }
<div class="card">
    <div class="card-header"><h3 class="card-title">@ViewData["Title"]</h3></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Widgets)</dt>
            <dd class="col-sm-9"><pre>@Model.Widgets</pre></dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.OwnerId)</dt>
            <dd class="col-sm-9">@Model.OwnerId</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
        <a asp-action="Index" class="btn btn-default">رجوع</a>
    </div>
</div>
