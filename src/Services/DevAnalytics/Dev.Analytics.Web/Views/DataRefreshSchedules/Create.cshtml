@model Dev.Analytics.Domain.Entities.DataRefreshSchedule
@{ ViewData["Title"] = "جدول تحديث"; }
<div class="card"><form asp-action="Create" method="post">@Html.AntiForgeryToken()
<div class="card-body">
<div class="mb-3"><label asp-for="TargetReadModelId" class="form-label"></label><select asp-for="TargetReadModelId" asp-items="ViewBag.ReadModels" class="form-control"><option value="">— اختياري —</option></select><span asp-validation-for="TargetReadModelId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="CronExpression" class="form-label"></label><input asp-for="CronExpression" class="form-control" placeholder="Cron" /><span asp-validation-for="CronExpression" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="LastRunAt" class="form-label"></label><input asp-for="LastRunAt" class="form-control" type="datetime-local" /><span asp-validation-for="LastRunAt" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="NextRunAt" class="form-label"></label><input asp-for="NextRunAt" class="form-control" type="datetime-local" /><span asp-validation-for="NextRunAt" class="text-danger"></span></div>
</div>
<div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div></form></div>
