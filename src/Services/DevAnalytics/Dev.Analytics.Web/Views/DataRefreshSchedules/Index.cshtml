@model IReadOnlyList<Dev.Analytics.Domain.Entities.DataRefreshSchedule>
@{ ViewData["Title"] = "جداول تحديث البيانات"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">الجداول</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>نموذج القراءة</th><th>Cron</th><th>آخر تشغيل</th><th>التالي</th><th></th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.TargetReadModel?.Name</td><td>@x.CronExpression</td><td>@x.LastRunAt</td><td>@x.NextRunAt</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
