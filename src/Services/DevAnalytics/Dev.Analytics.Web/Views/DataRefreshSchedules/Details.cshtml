@model DataRefreshSchedule
@{ ViewData["Title"] = "تفاصيل جدول التحديث"; }
<div class="card">
    <div class="card-header"><h3 class="card-title">@ViewData["Title"]</h3></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">نموذج القراءة</dt>
            <dd class="col-sm-9">@Model.TargetReadModel?.Name</dd>

            <dt class="col-sm-3">جدولة</dt>
            <dd class="col-sm-9">@Model.CronExpression</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.LastRunAt)</dt>
            <dd class="col-sm-9">@Model.LastRunAt</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NextRunAt)</dt>
            <dd class="col-sm-9">@Model.NextRunAt</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Trigger" asp-route-id="@Model.Id" method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">تشغيل الآن</button>
        </form>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
        <a asp-action="Index" class="btn btn-default">رجوع</a>
    </div>
</div>
