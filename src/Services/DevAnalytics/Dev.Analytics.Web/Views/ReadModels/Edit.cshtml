@model ReadModel
@{ ViewData["Title"] = "تعديل نموذج القراءة"; }
<div class="card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-header"><h3 class="card-title">@ViewData["Title"]</h3></div>
        <div class="card-body">
            <div class="mb-3 mb-2">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3 mb-2">
                <label asp-for="Schema" class="form-label"></label>
                <textarea asp-for="Schema" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3 mb-2">
                <label asp-for="LastRefreshed" class="form-label"></label>
                <input asp-for="LastRefreshed" class="form-control" type="datetime-local" />
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
