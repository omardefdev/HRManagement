@model IReadOnlyList<Dev.Analytics.Domain.Entities.ReadModel>
@{ ViewData["Title"] = "نماذج القراءة"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">Read models</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>الاسم</th><th>آخر تحديث</th><th></th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.Name</td><td>@x.LastRefreshed</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="3" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
