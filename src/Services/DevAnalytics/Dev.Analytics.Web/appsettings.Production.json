{    "Kestrel":  {
                    "Limits":  {
                                   "MaxRequestBodySize":  10485760,
                                   "KeepAliveTimeout":  "00:02:00",
                                   "RequestHeadersTimeout":  "00:00:30"
                               }
                },
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Warning",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "Serilog":  {
                    "SeqUrl":  "http://seq:5341",
                    "FilePath":  "logs/dev-analytics-.log"
                },
    "Keycloak":  {
                     "ClientId":  "hr-gateway-client",
                     "RequireHttpsMetadata":  true
                 },
    "Database": { "RunMigrationsAtStartup": false },
    "HrAuth":  {
                   "BehindGateway":  true,
                   "CookieSecureAlways":  true,
                   "IdleTimeoutMinutes":  480,
                   "SlidingExpiration":  true
               },
    "GatewayCallerProof":  {
                              "Enforce":  true
                          },
    "Security":  {
                     "EnableHsts":  true,
                     "EnableSecurityHeaders":  true,
                     "CspMode":  "Enforce"
                 }
}

