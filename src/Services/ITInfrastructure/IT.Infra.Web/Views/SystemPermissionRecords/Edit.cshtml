@model SystemPermissionRecord
@{ ViewData["Title"] = "تعديل صلاحية نظام"; }

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>
    <form asp-action="Edit">
        <div class="card-body">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="System" class="form-label"></label>
                <input asp-for="System" class="form-control" />
                <span asp-validation-for="System" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Roles" class="form-label"></label>
                <textarea asp-for="Roles" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Roles" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GrantedAt" class="form-label"></label>
                <input asp-for="GrantedAt" class="form-control" type="datetime-local" />
                <span asp-validation-for="GrantedAt" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RevokedAt" class="form-label"></label>
                <input asp-for="RevokedAt" class="form-control" type="datetime-local" />
                <span asp-validation-for="RevokedAt" class="text-danger"></span>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default">إلغاء</a>
        </div>
    </form>
</div>
