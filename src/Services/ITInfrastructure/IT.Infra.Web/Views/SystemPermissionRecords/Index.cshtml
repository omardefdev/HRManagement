@model IReadOnlyList<IT.Infrastructure.Domain.Entities.SystemPermissionRecord>
@{ ViewData["Title"] = "صلاحيات الأنظمة"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">سجلات الصلاحيات</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>المستخدم</th><th>النظام</th><th>منح</th><th>سحب</th><th></th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.UserId</td><td>@x.System</td><td>@x.GrantedAt</td><td>@x.RevokedAt</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
