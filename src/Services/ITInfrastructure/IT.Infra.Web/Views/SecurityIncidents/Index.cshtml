@model IReadOnlyList<IT.Infrastructure.Domain.Entities.SecurityIncident>
@{ ViewData["Title"] = "حوادث أمنية"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">الحوادث</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">تسجيل حادثة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>العنوان</th><th>الشدة</th><th>تاريخ الإبلاغ</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Title</td>
                        <td>@Html.HrEnumDisplay(x.Severity)</td>
                        <td>@x.ReportedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>@Html.HrEnumDisplay(x.Status)</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">لا حوادث</td></tr> }
            </tbody>
        </table>
    </div>
</div>
