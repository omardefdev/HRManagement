@model IT.Infrastructure.Domain.Entities.EnvironmentConfiguration
@{ ViewData["Title"] = "وصفة بيئة"; }
<div class="card"><form asp-action="Create" method="post">@Html.AntiForgeryToken()
<div class="card-body">
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Config" class="form-label"></label><textarea asp-for="Config" class="form-control" rows="4"></textarea><span asp-validation-for="Config" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Version" class="form-label"></label><input asp-for="Version" class="form-control" /><span asp-validation-for="Version" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="AppliedAt" class="form-label"></label><input asp-for="AppliedAt" class="form-control" type="datetime-local" /><span asp-validation-for="AppliedAt" class="text-danger"></span></div>
</div>
<div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div></form></div>
