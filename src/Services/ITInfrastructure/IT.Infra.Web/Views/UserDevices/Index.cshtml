@model IReadOnlyList<IT.Infrastructure.Domain.Entities.UserDevice>
@{ ViewData["Title"] = "أجهزة المستخدمين"; }
<div class="card">
    <div class="card-header"><h3 class="card-title mb-0">أجهزة المستخدمين</h3></div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead><tr><th>رقم الأصل</th><th>النوع</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr><td>@x.AssetTag</td><td>@x.DeviceType</td><td>@x.Status</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-info">تفاصيل</a></td></tr>
                }
                @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">لا أجهزة</td></tr> }
            </tbody>
        </table>
    </div>
</div>
