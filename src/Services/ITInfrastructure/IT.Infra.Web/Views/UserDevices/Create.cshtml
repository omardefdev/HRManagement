@model UserDevice
@{ ViewData["Title"] = "إضافة جهاز مستخدم"; }

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>
    <form asp-action="Create">
        <div class="card-body">
            <div class="alert alert-info mb-3">
                يُولَّد رقم الأصل (Asset Tag) تلقائياً عند الحفظ وفق سياسة IT.
            </div>
            <div class="mb-3">
                <label asp-for="AssignedTo" class="form-label"></label>
                <input asp-for="AssignedTo" class="form-control" />
                <span asp-validation-for="AssignedTo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DeviceType" class="form-label"></label>
                <select asp-for="DeviceType" asp-items="Html.GetEnumSelectList<DeviceType>()" class="form-control"></select>
                <span asp-validation-for="DeviceType" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SerialNumber" class="form-label"></label>
                <input asp-for="SerialNumber" class="form-control" />
                <span asp-validation-for="SerialNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<DeviceStatus>()" class="form-control"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-default">إلغاء</a>
        </div>
    </form>
</div>
