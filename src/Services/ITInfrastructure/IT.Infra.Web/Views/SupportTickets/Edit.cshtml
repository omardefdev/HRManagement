@model ITSupportTicket
@{ ViewData["Title"] = "تعديل تذكرة دعم"; }

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>
    <form asp-action="Edit">
        <div class="card-body">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="IssueSummary" class="form-label"></label>
                <input asp-for="IssueSummary" class="form-control" />
                <span asp-validation-for="IssueSummary" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ReportedBy" class="form-label"></label>
                <input asp-for="ReportedBy" class="form-control" />
                <span asp-validation-for="ReportedBy" class="text-danger"></span>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-default">إلغاء</a>
        </div>
    </form>
</div>
