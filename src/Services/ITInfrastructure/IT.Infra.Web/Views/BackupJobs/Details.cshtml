@model BackupJob
@{ ViewData["Title"] = "تفاصيل مهمة النسخ الاحتياطي"; }

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Target)</dt>
            <dd class="col-sm-9">@Model.Target</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Schedule)</dt>
            <dd class="col-sm-9">@Model.Schedule</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.LastRunAt)</dt>
            <dd class="col-sm-9">@(Model.LastRunAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Status)</dt>
            <dd class="col-sm-9">@Html.HrEnumDisplay(Model.Status)</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">تعديل</a>
        <a asp-action="Index" class="btn btn-default">رجوع</a>
    </div>
</div>
