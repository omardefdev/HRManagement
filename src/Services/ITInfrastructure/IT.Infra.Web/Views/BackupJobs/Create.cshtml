@model IT.Infrastructure.Domain.Entities.BackupJob
@{ ViewData["Title"] = "مهمة نسخ"; }
<div class="card">
    <div class="card-header"><h3 class="mb-0">مهمة جديدة</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3"><label asp-for="Target" class="form-label"></label><input asp-for="Target" class="form-control" /><span asp-validation-for="Target" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Schedule" class="form-label"></label><input asp-for="Schedule" class="form-control" /><span asp-validation-for="Schedule" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-control form-select" asp-items="Html.GetEnumSelectList<IT.Infrastructure.Domain.Enums.BackupStatus>()"></select><span asp-validation-for="Status" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-link">إلغاء</a>
        </form>
    </div>
</div>
