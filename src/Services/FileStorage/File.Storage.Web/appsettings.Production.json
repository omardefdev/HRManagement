{
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 20971520,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "SeqUrl": "http://seq:5341"
  },
  "Database": { "RunMigrationsAtStartup": false },
  "HrAuth": {
    "BehindGateway": true,
    "CookieSecureAlways": true
  },
  "GatewayCallerProof": {
    "Enforce": true
  },
  "FileStorage": {
    "ClamAvRequired": true
  },
  "Security": {
    "EnableHsts": true,
    "EnableSecurityHeaders": true,
    "CspMode": "Enforce"
  }
}
