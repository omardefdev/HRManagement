{

  "Logging": {

    "LogLevel": {

      "Default": "Information",

      "Microsoft.AspNetCore": "Warning"

    }

  },

  "AllowedHosts": "*",

  "ConnectionStrings": {

    "FileStorageDb": "Host=localhost;Port=5433;Database=file_storage_db;Username=file_storage_app;Password=USE_ENV_OR_USER_SECRETS"

  },

  "FileStorage": {

    "Provider": "Minio",

    "Endpoint": "localhost:9000",

    "UseSsl": false,

    "AccessKey": "hrminio",

    "SecretKey": "USE_ENV_OR_USER_SECRETS",

    "PresignedUrlExpiryMinutes": 5,

    "GrantDefaultLifetimeHours": 24,

    "ClamAvHost": "",

    "ClamAvPort": 3310,

    "ClamAvRequired": false

  },

  "RabbitMQ": {

    "Host": "localhost",

    "Port": 5673,

    "VirtualHost": "/",

    "Username": "USE_ENV_OR_USER_SECRETS",

    "Password": "USE_ENV_OR_USER_SECRETS"

  },

  "Keycloak": {

    "Authority": "http://localhost:8088/realms/hrmanagement",

    "AdditionalValidAudiences": "api-file-storage;hr-gateway-client"

  },

  "HrAuth": {

    "BehindGateway": true

  },

  "ServiceIdentity": {

    "ApiAudience": "api-file-storage"

  }

}

