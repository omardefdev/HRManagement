@model IReadOnlyList<HR.Training.Domain.Entities.ELearningCourse>
@{
    ViewData["Title"] = "التعلّم الإلكتروني";
    var enrolled = (List<Guid>)ViewBag.EnrolledCourseIds;
}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">الدورات المتاحة</h3>
        <a asp-action="MyLearning" class="btn btn-outline-secondary btn-sm">تعلّمي</a>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-center text-muted py-4">لا دورات منشورة حالياً</p>
        }
        @foreach (var c in Model)
        {
            var isEnrolled = enrolled.Contains(c.Id);
            <div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@c.TitleAr <small class="text-muted">(@c.Code)</small></h5>
                    <div class="text-muted small">@(c.Category ?? "عام") • @c.EstimatedHours ساعة</div>
                    @if (!string.IsNullOrWhiteSpace(c.Description)) { <p class="mb-0 mt-1">@c.Description</p> }
                </div>
                <div style="min-width:140px;" class="text-start">
                    @if (isEnrolled)
                    {
                        <span class="badge bg-success">ملتحق</span>
                    }
                    else
                    {
                        <form asp-action="Enroll" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@c.Id" />
                            <button type="submit" class="btn btn-primary btn-sm w-100">التحاق</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
