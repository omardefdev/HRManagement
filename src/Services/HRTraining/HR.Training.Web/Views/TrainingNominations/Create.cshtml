@model HR.Training.Domain.Entities.TrainingNomination
@{ ViewData["Title"] = "ترشيح تدريب"; }
<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div class="mb-3"><label asp-for="EmployeeId" class="form-label"></label><select asp-for="EmployeeId" class="form-control form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select><span asp-validation-for="EmployeeId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="CourseId" class="form-label"></label><select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-control"></select><span asp-validation-for="CourseId" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="NominatedBy" class="form-label"></label><select asp-for="NominatedBy" class="form-control form-select" data-hr-picker="employee" data-placeholder="ابحث عن موظف..."><option value="">— اختر موظف —</option></select><span asp-validation-for="NominatedBy" class="text-danger"></span></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div>
    </form>
</div>
