@model HR.Training.Domain.Entities.TrainingNomination
@using HRManagement.SharedKernel.Enums
@{ ViewData["Title"] = "تفاصيل الترشيح"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">ترشيح للتدريب</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <table class="table table-borderless table-sm w-auto">
            <tr><th>الموظف</th><td><span data-hr-employee-id="@Model.EmployeeId">جاري التحميل...</span></td></tr>
            <tr><th>الدورة</th><td>@(Model.Course?.TitleAr ?? Model.CourseId.ToString())</td></tr>
            <tr><th>رشّح بواسطة</th><td>@(Model.NominatedBy.HasValue ? "مستخدم النظام" : "—")</td></tr>
            <tr><th>تاريخ الترشيح</th><td>@Model.NominatedAt.ToString("yyyy/MM/dd")</td></tr>
            <tr><th>الحالة</th><td><span class="badge bg-info">@Html.HrEnumDisplay(Model.Status)</span></td></tr>
        </table>

        @if (ViewBag.Enrollment != null)
        {
            var enrollment = (HR.Training.Domain.Entities.TrainingEnrollment)ViewBag.Enrollment;
            <p class="text-success mt-2"><i class="fas fa-check"></i> الموظف مسجل في الدورة — الحالة: @Html.HrEnumDisplay(enrollment.Status)</p>
        }

        @if (Model.Status == ApprovalStatus.Pending)
        {
            <div class="mt-3 d-flex gap-2">
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm">اعتماد وتسجيل</button></form>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger btn-sm">رفض</button></form>
            </div>
        }
    </div>
</div>
