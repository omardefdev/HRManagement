@model HR.Training.Domain.Entities.TrainingCourse
@{ ViewData["Title"] = "تفاصيل الدورة"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">@Model.TitleAr</h3>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('حذف الدورة؟')">حذف</button></form>
            <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <table class="table table-borderless table-sm w-auto">
            <tr><th>الكود</th><td>@Model.Code</td></tr>
            <tr><th>الاسم بالإنكليزي</th><td>@(Model.TitleEn ?? "—")</td></tr>
            <tr><th>المدة</th><td>@Model.DurationDays أيام</td></tr>
            <tr><th>المزود</th><td>@(Model.Provider?.Name ?? "—")</td></tr>
            @if (!string.IsNullOrEmpty(Model.Description)) { <tr><th>الوصف</th><td>@Model.Description</td></tr> }
        </table>
        @if (Model.Enrollments.Any())
        {
            <h5 class="mt-3">التسجيلات (@Model.Enrollments.Count)</h5>
            <table class="table table-sm table-striped">
                <thead><tr><th>الموظف</th><th>الحالة</th><th>التاريخ</th></tr></thead>
                <tbody>@foreach (var e in Model.Enrollments) { <tr><td>@e.EmployeeId</td><td>@e.Status</td><td>@e.EnrolledAt.ToString("yyyy/MM/dd")</td></tr> }</tbody>
            </table>
        }
        @if (Model.Nominations.Any())
        {
            <h5 class="mt-3">الترشيحات (@Model.Nominations.Count)</h5>
            <table class="table table-sm table-striped">
                <thead><tr><th>الموظف</th><th>الحالة</th></tr></thead>
                <tbody>@foreach (var n in Model.Nominations) { <tr><td>@n.EmployeeId</td><td>@n.Status</td></tr> }</tbody>
            </table>
        }
    </div>
</div>
