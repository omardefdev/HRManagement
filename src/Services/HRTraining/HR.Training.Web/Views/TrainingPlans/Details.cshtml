@model HR.Training.Domain.Entities.TrainingPlan
@{ ViewData["Title"] = "تفاصيل خطة التدريب"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">خطة تدريب @Model.Year</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <table class="table table-borderless table-sm w-auto">
            <tr><th>السنة</th><td>@Model.Year</td></tr>
            <tr>
                <th>الوحدة التنظيمية</th>
                <td>
                    @if (Model.OrgUnitId.HasValue)
                    {
                        <span data-hr-org-unit-id="@Model.OrgUnitId">جاري التحميل...</span>
                    }
                    else
                    {
                        <span>عام</span>
                    }
                </td>
            </tr>
            <tr><th>معتمدة؟</th><td>@(Model.ApprovedAt != null ? $"نعم — {Model.ApprovedAt:yyyy/MM/dd}" : "لا")</td></tr>
        </table>

        @if (!string.IsNullOrEmpty(Model.PlannedCourses))
        {
            <h5 class="mt-3">الدورات المخطط لها</h5>
            <pre class="bg-light p-2">@Model.PlannedCourses</pre>
        }

        @if (Model.ApprovedAt == null)
        {
            <div class="mt-3 d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm">اعتماد</button></form>
            </div>
        }
    </div>
</div>
