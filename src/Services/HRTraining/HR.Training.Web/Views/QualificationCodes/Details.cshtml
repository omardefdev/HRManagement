@model HR.Training.Domain.Entities.QualificationCode
@{ ViewData["Title"] = "تفاصيل رمز التأهيل"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">@Model.TitleAr</h3>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('حذف؟')">حذف</button></form>
            <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <table class="table table-borderless table-sm w-auto">
            <tr><th>الكود</th><td>@Model.Code</td></tr>
            <tr><th>الاسم بالإنكليزي</th><td>@(Model.TitleEn ?? "—")</td></tr>
        </table>
        @if (!string.IsNullOrEmpty(Model.RequiredCourses))
        {
            <h5 class="mt-3">الدورات المطلوبة</h5>
            <pre class="bg-light p-2">@Model.RequiredCourses</pre>
        }
        <div class="mt-3">
            <h5>تحليل فجوة المهارات</h5>
            <form asp-action="GapAnalysis" method="get" class="d-flex flex-wrap gap-2 align-items-end">
                <input type="hidden" name="qualificationCodeId" value="@Model.Id" />
                <div><label class="form-label small">معرف الموظف </label><input name="employeeId" class="form-control form-control-sm"  required /></div>
                <button type="submit" class="btn btn-outline-info btn-sm">تحليل</button>
            </form>
        </div>
    </div>
</div>
