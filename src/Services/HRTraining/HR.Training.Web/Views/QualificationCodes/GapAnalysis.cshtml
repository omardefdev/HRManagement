@model HR.Training.Domain.Services.GapAnalysisResult
@{
    var qc = (HR.Training.Domain.Entities.QualificationCode)ViewBag.QualificationCode;
    var employeeId = ViewBag.EmployeeId;
    var courseNames = (Dictionary<Guid, string>)ViewBag.CourseNames;
    ViewData["Title"] = "تحليل فجوة المهارات";
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">تحليل فجوة المهارات</h3>
        <a asp-action="Details" asp-route-id="@qc.Id" class="btn btn-secondary btn-sm">العودة</a>
    </div>
    <div class="card-body">
        <table class="table table-borderless table-sm w-auto">
            <tr><th>رمز التأهيل</th><td>@qc.TitleAr (@qc.Code)</td></tr>
            <tr><th>الموظف</th><td><span data-hr-employee-id="@employeeId">جاري التحميل...</span></td></tr>
            <tr><th>نسبة الإكتمال</th><td>
                <div class="progress" style="min-width:200px">
                    <div class="progress-bar" style="width: @Model.CompletionPercentage%">@Model.CompletionPercentage%</div>
                </div>
            </td></tr>
        </table>

        <h5 class="mt-3">الدورات المطلوبة (@Model.RequiredCourseIds.Count)</h5>
        <table class="table table-sm table-striped">
            <thead><tr><th>الدورة</th><th>الحالة</th></tr></thead>
            <tbody>
            @foreach (var cid in Model.RequiredCourseIds)
            {
                var name = courseNames.GetValueOrDefault(cid, cid.ToString());
                var done = Model.CompletedCourseIds.Contains(cid);
                <tr>
                    <td>@name</td>
                    <td>
                        @if (done) { <span class="badge bg-success">مكتمل</span> }
                        else { <span class="badge bg-warning">ناقص</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
