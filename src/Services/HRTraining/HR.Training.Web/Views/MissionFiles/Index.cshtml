@model IReadOnlyList<HR.Training.Domain.Entities.MissionFile>
@{ ViewData["Title"] = "ملفات البعثات"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">البعثات</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">بعثة جديدة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>موظف</th><th>الوجهة</th><th>من</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in Model) { <tr><td><span data-hr-employee-id="@x.EmployeeId">جاري التحميل...</span></td><td>@x.Destination</td><td>@x.StartDate</td><td>@Html.HrEnumDisplay(x.Status)</td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-outline-info btn-xs">تفاصيل</a></td></tr> }
            @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">لا توجد بعثات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
