@model HR.Training.Domain.Entities.MissionFile
@using HR.Training.Domain.Enums
@{ ViewData["Title"] = "تفاصيل البعثة"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">ملف بعثة</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">القائمة</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <table class="table table-borderless table-sm w-auto">
            <tr><th>الموظف</th><td>@Model.EmployeeId</td></tr>
            <tr><th>الوجهة</th><td>@Model.Destination</td></tr>
            <tr><th>من</th><td>@Model.StartDate</td></tr>
            <tr><th>إلى</th><td>@(Model.EndDate?.ToString() ?? "—")</td></tr>
            <tr><th>الغرض</th><td>@(Model.Purpose ?? "—")</td></tr>
            <tr><th>الجهة الراعية</th><td>@(Model.Sponsor ?? "—")</td></tr>
            <tr><th>الحالة</th><td><span class="badge bg-info">@Model.Status</span></td></tr>
        </table>

        <div class="mt-3 d-flex flex-wrap gap-2">
            @if (Model.Status == MissionStatus.Proposed)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">تعديل</a>
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm">اعتماد</button></form>
            }
            @if (Model.Status == MissionStatus.Approved)
            {
                <form asp-action="MarkOngoing" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-primary btn-sm">بدء البعثة</button></form>
            }
            @if (Model.Status == MissionStatus.Ongoing)
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-success btn-sm">إكمال البعثة</button></form>
            }
        </div>
    </div>
</div>
