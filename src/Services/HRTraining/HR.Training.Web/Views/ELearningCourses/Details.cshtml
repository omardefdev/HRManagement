@model HR.Training.Domain.Entities.ELearningCourse
@{ ViewData["Title"] = "تفاصيل الدورة الإلكترونية"; }
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">@Model.TitleAr <small class="text-muted">(@Model.Code)</small></h3>
        <div>
            <form asp-action="TogglePublish" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-@(Model.IsPublished ? "warning" : "success") btn-sm">@(Model.IsPublished ? "إلغاء النشر" : "نشر")</button>
            </form>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">تعديل</a>
            <a asp-action="Index" class="btn btn-link">رجوع</a>
        </div>
    </div>
    <div class="card-body">
        <p>@(Model.Description ?? "—")</p>
        <span class="badge bg-secondary">@Model.EstimatedHours ساعة</span>
        <span class="badge @(Model.IsPublished ? "bg-success" : "bg-secondary")">@(Model.IsPublished ? "منشورة" : "مسودة")</span>
        <span class="badge bg-info">@Model.Enrollments.Count ملتحق</span>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">إضافة وحدة</h5></div>
    <div class="card-body">
        <form asp-action="AddModule" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="courseId" value="@Model.Id" />
            <div class="col-md-2"><input name="order" type="number" class="form-control" value="@(Model.Modules.Count + 1)" placeholder="الترتيب" /></div>
            <div class="col-md-8"><input name="title" class="form-control" placeholder="عنوان الوحدة" required /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">إضافة وحدة</button></div>
        </form>
    </div>
</div>

@foreach (var m in Model.Modules.OrderBy(m => m.Order))
{
    <div class="card mb-2">
        <div class="card-header"><strong>@m.Order. @m.Title</strong></div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <tbody>
                    @foreach (var l in m.Lessons.OrderBy(l => l.Order))
                    {
                        <tr>
                            <td style="width:60px;">@l.Order</td>
                            <td>@l.Title</td>
                            <td>
                                @if (l.ContentFileId.HasValue)
                                {
                                    @await Html.PartialAsync("_FileDisplayLink", (l.ContentFileId, "ملف المحتوى"))
                                }
                                @if (!string.IsNullOrWhiteSpace(l.ExternalResourceUrl))
                                {
                                    @if (l.ContentFileId.HasValue) { <span class="mx-1">|</span> }
                                    <a href="@l.ExternalResourceUrl" target="_blank" rel="noopener">مورد خارجي</a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!m.Lessons.Any()) { <tr><td colspan="3" class="text-muted text-center py-2">لا دروس</td></tr> }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <form asp-action="AddLesson" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" value="@Model.Id" />
                <input type="hidden" name="moduleId" value="@m.Id" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-1"><input name="order" type="number" class="form-control form-control-sm" value="@(m.Lessons.Count + 1)" /></div>
                    <div class="col-md-3"><input name="title" class="form-control form-control-sm" placeholder="عنوان الدرس" required /></div>
                    <div class="col-md-3">
                        @{
                            ViewData["FileUploadName"] = "contentFileId";
                            ViewData["FileUploadId"] = $"contentFileId_{m.Id}";
                            ViewData["FileUploadAccept"] = "application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,video/mp4";
                            ViewData["FileUploadMaxSize"] = "26214400";
                            ViewData["FileUploadLabel"] = "ملف المحتوى";
                        }
                        @await Html.PartialAsync("_FileUploadWidget", (Guid?)null)
                    </div>
                    <div class="col-md-2"><input name="externalResourceUrl" class="form-control form-control-sm" placeholder="رابط خارجي (اختياري)" /></div>
                    <div class="col-md-2"><input name="content" class="form-control form-control-sm" placeholder="محتوى مختصر" /></div>
                    <div class="col-md-1"><button type="submit" class="btn btn-outline-primary btn-sm w-100">إضافة</button></div>
                </div>
            </form>
        </div>
    </div>
}
@if (!Model.Modules.Any()) { <p class="text-center text-muted">لا وحدات بعد — أضِف وحدة لبدء بناء المحتوى.</p> }
