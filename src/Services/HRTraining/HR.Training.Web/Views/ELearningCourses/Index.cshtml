@model IReadOnlyList<HR.Training.Domain.Entities.ELearningCourse>
@{ ViewData["Title"] = "دورات التعلّم الإلكتروني"; }
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">التعلّم الإلكتروني</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">دورة جديدة</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead><tr><th>الكود</th><th>الاسم</th><th>التصنيف</th><th>الساعات</th><th>الحالة</th><th>الملتحقون</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Code</td>
                        <td>@x.TitleAr</td>
                        <td>@(x.Category ?? "—")</td>
                        <td>@x.EstimatedHours</td>
                        <td>@(x.IsPublished ? "منشورة" : "مسودة")</td>
                        <td>@x.Enrollments.Count</td>
                        <td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-outline-info btn-xs">تفاصيل</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">لا دورات</td></tr> }
            </tbody>
        </table>
    </div>
</div>
