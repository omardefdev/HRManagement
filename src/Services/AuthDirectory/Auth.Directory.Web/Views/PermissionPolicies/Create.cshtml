@model Auth.Directory.Domain.Entities.PermissionPolicy
@{ ViewData["Title"] = "سياسة صلاحيات"; }
<div class="card"><form asp-action="Create" method="post">@Html.AntiForgeryToken()
<div class="card-body">
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Rules" class="form-label"></label><textarea asp-for="Rules" class="form-control" rows="5"></textarea><span asp-validation-for="Rules" class="text-danger"></span></div>
</div>
<div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div></form></div>
