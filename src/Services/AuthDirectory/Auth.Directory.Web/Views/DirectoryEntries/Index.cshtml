@model IReadOnlyList<Auth.Directory.Domain.Entities.DirectoryEntry>
@{ ViewData["Title"] = "مدخلات الدليل"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="mb-0">الدليل</h3><a asp-action="Create" class="btn btn-primary btn-sm">جديد</a></div>
<div class="card-body p-0"><table class="table mb-0"><thead><tr><th>الاسم</th><th>البريد</th><th>الحالة</th><th>مزامنة</th></tr></thead><tbody>
@foreach (var x in Model){<tr><td>@x.DisplayName</td><td>@x.PrimaryEmail</td><td>@EnumDisplayExtensions.GetStoredEnumDisplayName("EmploymentStatus", x.Status)</td><td>@x.LastSyncedAt</td></tr>}
@if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted">لا توجد</td></tr>}</tbody></table></div></div>
