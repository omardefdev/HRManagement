{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "ConnectionStrings":  {
                              "AuthDirectoryDb":  "Host=localhost;Port=5433;Database=auth_directory_db;Username=hrmanagement;Password=USE_ENV_OR_USER_SECRETS"
                          },
    "RabbitMQ":  {
                     "Host":  "localhost",
                     "Port":  5672,
                     "VirtualHost":  "/",
                     "Username":  "USE_ENV_OR_USER_SECRETS",
                     "Password":  "USE_ENV_OR_USER_SECRETS"
                 },
    "Keycloak":  {
                     "Authority":  "http://localhost:8080/realms/hrmanagement",
                     "RequireHttpsMetadata":  false,
                     "AdditionalValidAudiences":  "api-auth-directory;hr-gateway-client",
                     "DirectorySync":  {
                                           "Enabled":  false,
                                           "AdminClientId":  "directory-sync",
                                           "AdminClientSecret":  "",
                                           "DefaultRealmRoles":  [
                                                                     "hr-core"
                                                                 ]
                                       }
                 },
    "MassTransit":  {
                        "RetryCount":  3,
                        "RetryIntervalSeconds":  5
                    },
    "HrAuth":  {
                   "BehindGateway":  true
               },
    "ServiceIdentity":  {
                            "ApiAudience":  "api-auth-directory"
                        }
}

