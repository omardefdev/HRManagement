@model ComplianceRecommendation
@using HRManagement.SharedKernel.Enums
@{ ViewData["Title"] = "توصية رقابية جديدة"; }

<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-header"><h3 class="mb-0">توصية رقابية جديدة</h3></div>
        <div class="card-body">
            <div class="mb-3 mb-3">
                <label asp-for="FindingId" class="form-label">الملاحظة الرقابية</label>
                <select asp-for="FindingId" class="form-control">
                    <option value="">— اختر —</option>
                    @if (ViewBag.Findings != null)
                    {
                        @foreach (SelectListItem item in (SelectList)ViewBag.Findings)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="FindingId" class="text-danger"></span>
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="RecommendedAction" class="form-label"></label>
                <textarea asp-for="RecommendedAction" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control" type="date" />
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="ResponsibleUnitId" class="form-label"></label>
                <select asp-for="ResponsibleUnitId" class="form-select" data-hr-picker="org-unit" data-placeholder="ابحث عن وحدة تنظيمية..."><option value="">— اختر وحدة —</option></select>
            </div>
            <div class="mb-3 mb-3">
                <label class="form-label">الحالة</label>
                <input class="form-control" value="قيد الانتظار" disabled />
                <div class="form-text">تُعتمد التوصية عبر إجراء الموافقة.</div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
