@model Compliance.Domain.Entities.LegalCase
@{ ViewData["Title"] = "قضية"; }
<div class="card"><form asp-action="Create" method="post">@Html.AntiForgeryToken()
<div class="card-body"><div class="mb-3"><label asp-for="CaseNumber" class="form-label"></label><input asp-for="CaseNumber" class="form-control" /><span asp-validation-for="CaseNumber" class="text-danger"></span></div><div class="mb-3"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger"></span></div><div class="mb-3"><label asp-for="Parties" class="form-label"></label><textarea asp-for="Parties" class="form-control"></textarea><span asp-validation-for="Parties" class="text-danger"></span></div><div class="mb-3"><label class="form-label">الحالة</label><input class="form-control" value="مفتوحة" disabled /><div class="form-text">تُحدَّث حالة القضية من شاشة التفاصيل.</div></div><div class="mb-3"><label asp-for="CourtDetails" class="form-label"></label><textarea asp-for="CourtDetails" class="form-control"></textarea><span asp-validation-for="CourtDetails" class="text-danger"></span></div>
<div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div></form></div>
