@model LegalCase
@{ ViewData["Title"] = "تعديل القضية"; }

<div class="card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="card-header"><h3 class="mb-0">تعديل القضية</h3></div>
        <div class="card-body">
            <div class="mb-3 mb-3">
                <label asp-for="CaseNumber" class="form-label"></label>
                <input asp-for="CaseNumber" class="form-control" />
                <span asp-validation-for="CaseNumber" class="text-danger"></span>
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="Parties" class="form-label"></label>
                <textarea asp-for="Parties" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3 mb-3">
                <label class="form-label">الحالة</label>
                <input class="form-control" value="@Model.Status" disabled />
                <div class="form-text">تُحدَّث حالة القضية من شاشة التفاصيل عبر إجراء تحديث الحالة.</div>
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="CourtDetails" class="form-label"></label>
                <textarea asp-for="CourtDetails" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="AssignedTo" class="form-label"></label>
                <input asp-for="AssignedTo" class="form-control" />
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
