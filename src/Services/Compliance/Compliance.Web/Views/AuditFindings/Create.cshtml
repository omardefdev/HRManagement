@model Compliance.Domain.Entities.AuditFinding
@{ ViewData["Title"] = "ملاحظة رقابية"; }
<div class="card"><form asp-action="Create" method="post">@Html.AntiForgeryToken()
<div class="card-body"><div class="mb-3"><label asp-for="AuditId" class="form-label"></label><input asp-for="AuditId" class="form-control" /><span asp-validation-for="AuditId" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div class="mb-3"><label asp-for="Severity" class="form-label"></label><select class="form-control" asp-for="Severity" asp-items="Html.GetEnumSelectList<Compliance.Domain.Enums.FindingSeverity>()" class="form-control"></select><span asp-validation-for="Severity" class="text-danger"></span></div><div class="mb-3"><label asp-for="Recommendation" class="form-label"></label><textarea asp-for="Recommendation" class="form-control"></textarea><span asp-validation-for="Recommendation" class="text-danger"></span></div><div class="mb-3"><label asp-for="Status" class="form-label"></label><select class="form-control" asp-for="Status" asp-items="Html.GetEnumSelectList<Compliance.Domain.Enums.FindingStatus>()" class="form-control"></select><span asp-validation-for="Status" class="text-danger"></span></div>
<div class="card-footer"><button type="submit" class="btn btn-primary">حفظ</button> <a asp-action="Index" class="btn btn-secondary">إلغاء</a></div></form></div>
