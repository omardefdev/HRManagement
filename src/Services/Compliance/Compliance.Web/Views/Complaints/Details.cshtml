@model Compliance.Domain.Entities.Complaint
@using Compliance.Domain.Enums
@{ ViewData["Title"] = "تفاصيل الشكوى"; }
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">@Model.Subject</h3>
        <span class="badge bg-info">@Html.HrEnumDisplay(Model.Status)</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            @* ComplaintProtectionRules.CanSeeReporter decides this; the view used to print
               FiledBy unconditionally, exposing the identity of an anonymous reporter. *@
            <dt class="col-sm-3">مقدم الشكوى</dt>
            <dd class="col-sm-9">
                @if (ViewBag.CanSeeReporter is true)
                {
                    @Model.FiledBy
                }
                else
                {
                    <span class="text-muted">محجوب لحماية هوية المبلّغ</span>
                }
            </dd>
            <dt class="col-sm-3">ضد</dt><dd class="col-sm-9">@Model.Against</dd>
            <dt class="col-sm-3">الوصف</dt><dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">تاريخ التقديم</dt><dd class="col-sm-9">@Model.FiledAt.ToString("yyyy/MM/dd")</dd>
            <dt class="col-sm-3">مسند إلى</dt><dd class="col-sm-9">@(Model.AssignedTo?.ToString() ?? "—")</dd>
            <dt class="col-sm-3">القرار</dt><dd class="col-sm-9">@Model.Resolution</dd>
        </dl>
    </div>
</div>

@if (Model.Status == ComplaintStatus.Open)
{
    <div class="card mb-3">
        <div class="card-header">تعيين مسؤول التحقيق (اختياري)</div>
        <div class="card-body">
            <form asp-action="Assign" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-md-8">
                    <label class="form-label">معرّف المستخدم </label>
                    <input type="text" name="assignedTo" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-primary w-100">حفظ التعيين</button>
                </div>
            </form>
        </div>
    </div>
    <form asp-action="StartInvestigation" method="post" class="mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-primary">بدء التحقيق</button>
    </form>
}

@if (Model.Status == ComplaintStatus.Investigating)
{
    <div class="card mb-3">
        <div class="card-header">إنهاء التحقيق بقرار</div>
        <div class="card-body">
            <form asp-action="Resolve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label">نص القرار</label>
                    <textarea name="resolution" class="form-control" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn btn-success">حفظ القرار</button>
            </form>
        </div>
    </div>
}

@if (Model.Status == ComplaintStatus.Resolved)
{
    <form asp-action="Close" method="post" class="d-inline me-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-secondary">إغلاق الشكوى</button>
    </form>
    <div class="card mt-3">
        <div class="card-header">استئناف</div>
        <div class="card-body">
            <form asp-action="Appeal" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label">ملاحظة</label>
                    <textarea name="note" class="form-control" rows="2"></textarea>
                </div>
                <button type="submit" class="btn btn-warning">إعادة فتح للتحقيق</button>
            </form>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header">متابعات</div>
    <div class="card-body">
        <ul class="list-group list-group-flush mb-3">
            @foreach (var f in Model.FollowUps.OrderByDescending(x => x.CreatedAt))
            {
                <li class="list-group-item">
                    <small class="text-muted">@f.PerformedAt?.ToString("yyyy/MM/dd HH:mm")</small>
                    <div>@f.ActionTaken</div>
                </li>
            }
            @if (!Model.FollowUps.Any())
            {
                <li class="list-group-item text-muted">لا سجلات</li>
            }
        </ul>
        @if (Model.Status != ComplaintStatus.Closed)
        {
            <form asp-action="AddFollowUp" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label">إضافة ملاحظة متابعة</label>
                    <input type="text" name="note" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-sm btn-outline-secondary">إضافة</button>
            </form>
        }
    </div>
</div>

<p><a asp-action="Index">العودة للقائمة</a></p>
