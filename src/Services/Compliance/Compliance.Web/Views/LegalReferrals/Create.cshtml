@model LegalReferral
@{ ViewData["Title"] = "إحالة قانونية جديدة"; }

<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-header"><h3 class="mb-0">إحالة قانونية جديدة</h3></div>
        <div class="card-body">
            <div class="mb-3 mb-3">
                <label asp-for="OriginatingUnit" class="form-label"></label>
                <select asp-for="OriginatingUnit" class="form-select" data-hr-picker="org-unit" data-placeholder="ابحث عن وحدة تنظيمية..."><option value="">— اختر وحدة —</option></select>
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="ReferredTo" class="form-label"></label>
                <input asp-for="ReferredTo" class="form-control" />
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="ReferralDate" class="form-label"></label>
                <input asp-for="ReferralDate" class="form-control" type="date" />
            </div>
            <div class="mb-3 mb-3">
                <label asp-for="Documents" class="form-label"></label>
                <textarea asp-for="Documents" class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
