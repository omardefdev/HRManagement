{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "Gateway":  {
                    "HealthProbe":  {
                                        "TimeoutSeconds":  4,
                                        "CacheSeconds":  4
                                    }
                },
    "HrAuth":  {
                   "CookieSameSite":  "Lax",
                   "CookieSecureAlways":  false
               },
    "Keycloak":  {
                     "RequireHttpsMetadata":  false
                 },
    "ConnectionStrings":  {
                              "GatewayAuditDb":  "Host=localhost;Port=5433;Database=gateway_audit_db;Username=hrmanagement;Password=USE_ENV_OR_USER_SECRETS"
                          },
    "AuditDurability":  {
                            "ChannelCapacity":  256,
                            "OverflowPath":  "data/audit-overflow-dev",
                            "MaxRetries":  3,
                            "RetryDelaysMs":  [100, 200, 300],
                            "OverflowSweepSeconds":  2
                        },
    "AuditRetention":  {
                           "Enabled":  false,
                           "RetentionDays":  365
                       }
}
