<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بوابة إدارة الموارد البشرية</title>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/syrian-theme.css" asp-append-version="true" />
</head>
<body dir="rtl">
    <a class="hr-skip-link" href="#main-content">تخطي إلى المحتوى</a>
    <nav class="navbar navbar-expand-lg gateway-navbar" aria-label="التنقل الرئيسي">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <i class="fas fa-building" aria-hidden="true"></i>
                <span>بوابة إدارة الموارد البشرية</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gatewayNav"
                    aria-controls="gatewayNav" aria-expanded="false" aria-label="إظهار القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="gatewayNav">
                <div class="navbar-nav ms-auto gap-1 align-items-center">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home ms-1" aria-hidden="true"></i> الرئيسية
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Operations" ? "active" : "")" asp-controller="Home" asp-action="Operations">
                        <i class="fas fa-cogs ms-1" aria-hidden="true"></i> العمليات
                    </a>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Audit" ? "active" : "")" asp-controller="Home" asp-action="Audit">
                        <i class="fas fa-clipboard-list ms-1" aria-hidden="true"></i> سجل التدقيق
                    </a>
                    <a class="nav-link @((ViewContext.RouteData.Values["action"]?.ToString() == "Journeys" || ViewContext.RouteData.Values["action"]?.ToString() == "JourneyDetails") ? "active" : "")" asp-controller="Home" asp-action="Journeys">
                        <i class="fas fa-route ms-1" aria-hidden="true"></i> المسارات التشغيلية
                    </a>
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                            <i class="fas fa-th ms-1" aria-hidden="true"></i> الوحدات
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @await Html.PartialAsync("_HrGatewayModuleNav")
                        </ul>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="nav-link gateway-user-badge"><i class="fas fa-user-circle ms-1" aria-hidden="true"></i> @User.Identity.Name</span>
                        <a class="nav-link" href="/Account/Logout"><i class="fas fa-sign-out-alt ms-1" aria-hidden="true"></i> خروج</a>
                    }
                    else
                    {
                        <a class="nav-link" href="/Account/Login"><i class="fas fa-sign-in-alt ms-1" aria-hidden="true"></i> تسجيل الدخول</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main class="container py-4 gateway-shell" id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="gateway-footer">
        <div class="container d-flex justify-content-between align-items-center">
            <strong>شعبة التنظيم والموارد البشرية</strong>
            <span>&copy; @DateTime.Now.Year &mdash; نظام إدارة الموارد البشرية</span>
        </div>
    </footer>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
</body>
</html>
