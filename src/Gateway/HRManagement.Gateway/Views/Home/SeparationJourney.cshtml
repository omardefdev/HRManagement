@{
    ViewData["Title"] = "مسار الفصل — دليل تشغيلي";
    var steps = new (string Title, string Description, string Slug)[]
    {
        ("النقل (قبل الفصل)", "طلبات النقل والتنفيذ", "hr-movements"),
        ("العقود", "إكمال الفصل وإشعار الأنظمة", "hr-contracts"),
        ("الرواتب", "تسوية مستحقات نهائية", "payroll"),
        ("الأرشيف", "أرشفة الوثائق", "records-archive"),
        ("العهد واللوجستيات", "استرداد الأصول", "admin-logistics"),
        ("البطاقة", "إبطال البطاقة (تلقائي عبر الحدث عند التكامل)", "idcard"),
        ("الدليل", "تعطيل أو تحديث الحساب", "auth-directory"),
    };
}
<h1 class="mb-3">@ViewData["Title"]</h1>
<p class="text-muted">روابط تفتح الواجهات خلف البوابة. نفّذ الخطوات حسب سياسة المؤسسة.</p>
<ol class="list-group list-group-numbered">
    @foreach (var s in steps)
    {
        <li class="list-group-item d-flex justify-content-between align-items-start">
            <div class="ms-2 me-auto">
                <div class="fw-bold">@s.Title</div>
                <small>@s.Description</small>
            </div>
            <a class="btn btn-sm btn-outline-primary" asp-action="OpenModule" asp-route-slug="@s.Slug">فتح</a>
        </li>
    }
</ol>
<p class="mt-3"><a asp-action="Index">العودة للوحة البوابة</a></p>
