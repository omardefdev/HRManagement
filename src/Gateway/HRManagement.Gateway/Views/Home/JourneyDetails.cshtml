@model HRManagement.Gateway.Models.GatewayJourneyDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Journey.Title} — دليل تشغيلي";
    string? currentPhase = null;
}

<div class="gateway-page-header">
    <h1 class="gateway-page-title">@Model.Journey.Title</h1>
    <p class="gateway-page-subtitle">@Model.Journey.Description</p>
    <p class="small gateway-muted mb-0">التصنيف: @Model.Journey.Category</p>
</div>

<ol class="list-group list-group-numbered gateway-step-list">
    @foreach (var step in Model.Steps)
    {
        var phaseKey = step.Step.PhaseKey;
        if (!string.IsNullOrWhiteSpace(phaseKey) && !string.Equals(phaseKey, currentPhase, StringComparison.OrdinalIgnoreCase))
        {
            currentPhase = phaseKey;
            if (!string.IsNullOrWhiteSpace(step.Step.PhaseTitleAr))
            {
                <li class="list-group-item gateway-journey-phase-header">
                    <h2 class="h5 mb-0">@step.Step.PhaseTitleAr</h2>
                </li>
            }
        }

        <li class="list-group-item d-flex justify-content-between align-items-start">
            <div class="ms-2 me-auto">
                <div class="fw-bold">@step.Step.Title</div>
                <small>@step.Step.Description</small>
                @if (!string.IsNullOrWhiteSpace(step.Step.Note))
                {
                    <div class="small gateway-muted mt-1">@step.Step.Note</div>
                }
                @if (!step.Step.IsRequired)
                {
                    <div class="small mt-1"><span class="gateway-badge gateway-badge-info">خطوة اختيارية</span></div>
                }
            </div>

            @if (step.CanOpenPublic && !string.IsNullOrWhiteSpace(step.PublicHref))
            {
                <a class="btn btn-sm gateway-btn-primary" href="@step.PublicHref">فتح</a>
            }
            else if (step.HasModule && step.Module is not null)
            {
                @if (step.IsAuthorized)
                {
                    <a class="btn btn-sm gateway-btn-primary"
                       asp-action="OpenModule"
                       asp-route-slug="@step.Module.Slug"
                       asp-route-uiPath="@step.Step.UiPath">فتح</a>
                }
                else
                {
                    <button class="btn btn-sm gateway-btn-secondary" disabled>تتطلب صلاحية</button>
                }
            }
            else
            {
                <span class="gateway-badge gateway-badge-info">إرشادي</span>
            }
        </li>
    }
</ol>

<p class="mt-3">
    <a class="btn btn-sm gateway-btn-ghost" asp-action="Journeys">العودة إلى المسارات</a>
</p>
