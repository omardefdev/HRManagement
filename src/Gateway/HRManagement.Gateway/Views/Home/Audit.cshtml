@model HRManagement.Gateway.Models.GatewayAuditSearchResponse
@{
    ViewData["Title"] = "سجل التدقيق";
    var req = ViewData["Request"] as HRManagement.Gateway.Models.GatewayAuditSearchRequest
              ?? new HRManagement.Gateway.Models.GatewayAuditSearchRequest();
}
<div class="gateway-page-header">
    <h1 class="gateway-page-title">سجل التدقيق التشغيلي</h1>
    <p class="gateway-page-subtitle">يعرض السجل العمليات ضمن نطاق زمني محدد. استخدم معرّف الترابط لربط الطلبات المتتابعة في رحلة واحدة.</p>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <select class="form-select" name="statusCode">
            <option value="">الكل</option>
            <option value="401" selected="@(req.StatusCode == 401 ? "selected" : null)">401</option>
            <option value="403" selected="@(req.StatusCode == 403 ? "selected" : null)">403</option>
            <option value="502" selected="@(req.StatusCode == 502 ? "selected" : null)">502</option>
        </select>
    </div>
    <div class="col-md-4">
        <input class="form-control" type="text" name="correlationId" value="@req.CorrelationId" placeholder="مُدخل معرّف الترابط" />
    </div>
    <div class="col-md-2">
        <select class="form-select" name="timeRange">
            <option value="1h" selected="@(req.TimeRange == "1h" ? "selected" : null)">آخر ساعة</option>
            <option value="24h" selected="@(string.IsNullOrEmpty(req.TimeRange) || req.TimeRange == "24h" ? "selected" : null)">آخر 24 ساعة</option>
            <option value="7d" selected="@(req.TimeRange == "7d" ? "selected" : null)">آخر 7 أيام</option>
        </select>
    </div>
    <div class="col-md-2">
        <input class="form-control" type="number" min="1" max="200" name="pageSize" value="@req.PageSize" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn gateway-btn-primary w-100" type="submit">بحث</button>
        <a class="btn gateway-btn-secondary w-100" asp-action="Audit">إعادة</a>
    </div>
    <input type="hidden" name="page" value="1" />
</form>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="gateway-card-kpi gateway-kpi">
            <div class="gateway-kpi-label"><i class="fas fa-list-ol ms-1"></i> إجمالي النتائج</div>
            <div class="gateway-kpi-value">@Model.TotalCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="gateway-card-kpi gateway-kpi">
            <div class="gateway-kpi-label"><i class="fas fa-user-lock ms-1"></i> خطأ 401</div>
            <div class="gateway-kpi-value gateway-kpi-value-warn">@Model.Count401</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="gateway-card-kpi gateway-kpi">
            <div class="gateway-kpi-label"><i class="fas fa-ban ms-1"></i> خطأ 403</div>
            <div class="gateway-kpi-value gateway-kpi-value-danger">@Model.Count403</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="gateway-card-kpi gateway-kpi">
            <div class="gateway-kpi-label"><i class="fas fa-server ms-1"></i> خطأ 502</div>
            <div class="gateway-kpi-value gateway-kpi-value-danger">@Model.Count502</div>
        </div>
    </div>
</div>

<div class="gateway-table table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
        <tr>
            <th>الوقت</th>
            <th>القرار</th>
            <th>الكود</th>
            <th>الطريقة</th>
            <th>المسار</th>
            <th>المستخدم</th>
            <th>معرّف الترابط</th>
            <th>الزمن (مللي ثانية)</th>
            <th>إجراءات</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Items)
        {
            <tr>
                <td>@row.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@HRManagement.Gateway.Models.GatewayAuditDisplay.Decision(row.Decision)</td>
                <td>@row.StatusCode</td>
                <td>@row.Method</td>
                <td><code>@row.Path</code></td>
                <td>@(string.IsNullOrWhiteSpace(row.UserName) ? "-" : row.UserName)</td>
                <td><code id="corr-@row.CorrelationId.GetHashCode()">@row.CorrelationId</code></td>
                <td>@row.ElapsedMs</td>
                <td class="d-flex gap-1">
                    <button type="button" class="btn btn-sm gateway-btn-secondary copy-corr" data-corr="@row.CorrelationId">نسخ</button>
                    <a class="btn btn-sm gateway-btn-primary" asp-action="Operations" asp-route-correlationId="@row.CorrelationId">تتبع</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@{
    var totalPages = Math.Max(1, (int)Math.Ceiling((double)Model.TotalCount / Math.Max(1, Model.PageSize)));
    var prevPage = Math.Max(1, Model.Page - 1);
    var nextPage = Math.Min(totalPages, Model.Page + 1);
}
<div class="d-flex justify-content-between">
    <a class="btn btn-sm gateway-btn-secondary @(Model.Page <= 1 ? "disabled" : "")"
       asp-action="Audit"
       asp-route-statusCode="@req.StatusCode"
       asp-route-correlationId="@req.CorrelationId"
       asp-route-timeRange="@req.TimeRange"
       asp-route-pageSize="@Model.PageSize"
       asp-route-page="@prevPage">السابق</a>
    <span class="text-muted">صفحة @Model.Page من @totalPages</span>
    <a class="btn btn-sm gateway-btn-secondary @(Model.Page >= totalPages ? "disabled" : "")"
       asp-action="Audit"
       asp-route-statusCode="@req.StatusCode"
       asp-route-correlationId="@req.CorrelationId"
       asp-route-timeRange="@req.TimeRange"
       asp-route-pageSize="@Model.PageSize"
       asp-route-page="@nextPage">التالي</a>
</div>

<script>
    document.querySelectorAll('.copy-corr').forEach(btn => {
        btn.addEventListener('click', async () => {
            const corr = btn.getAttribute('data-corr');
            try {
                await navigator.clipboard.writeText(corr);
                const oldText = btn.textContent;
                btn.textContent = 'تم النسخ';
                setTimeout(() => btn.textContent = oldText, 1200);
            } catch {
                btn.textContent = 'فشل';
                setTimeout(() => btn.textContent = 'نسخ', 1200);
            }
        });
    });
</script>
