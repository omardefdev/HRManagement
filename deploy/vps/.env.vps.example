# PLAN-36 — ملف البيئة للخادم الواحد (عرض واختبار ببيانات اصطناعية فقط).
# مكانه على الخادم: /opt/hrm/shared/.env بصلاحية 600 ومالكه المستخدم hrm. لا يُنسخ من جهاز المالك ولا يدخل git.
# يُولَّد على الخادم نفسه: كل سر بـ openssl rand دون طباعته (docs/OPS_VPS_SINGLE_HOST.md، «توليد .env»).
# scripts/vps/deploy.ps1 وdeploy/vps/remote-deploy.sh يرفضان النشر إن غاب أي مفتاح من هذا الملف (بالأسماء فقط).
# المفاتيح التي تقبل قيمة فارغة: ACME_EMAIL وADMIN_ALLOWED_CIDRS.

# ---------- الأسماء العامة وTLS ----------
# اسم التطبيق العام (سجل DNS من نوع A إلى عنوان الخادم)، أو بلا نطاق: hr.161-97-185-71.sslip.io
APP_DOMAIN=
# اسم Keycloak العام، أو بلا نطاق: sso.161-97-185-71.sslip.io
SSO_DOMAIN=
# بريد إشعارات انتهاء الشهادات من Let's Encrypt. فارغ = تسجيل بلا بريد. لا يُملأ إلا ببريد أعطاه المالك لهذا الغرض.
ACME_EMAIL=
# دليل ACME: staging حتى يخضرّ أول اختبار ذاتي، ثم production وإعادة إنشاء الحافة وحدها.
# staging:    https://acme-staging-v02.api.letsencrypt.org/directory
# production: https://acme-v02.api.letsencrypt.org/directory
HRM_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# عناوين يُسمح لها بـ /health و/metrics ولوحة Keycloak الإدارية (CIDR مفصولة بمسافة). فارغ = لا أحد؛ البديل نفق SSH.
ADMIN_ALLOWED_CIDRS=

# ---------- الصور ----------
# السجل بأحرف صغيرة: ghcr.io/<owner>/hrmanagement (أو 127.0.0.1:5050/hrmanagement للسجل الاحتياطي على الخادم)
HRM_IMAGE_REPO=
# وسم الإصدار (أول 12 حرفاً من SHA). deploy.ps1 يمرّر الوسم صراحةً؛ latest مرفوض.
IMAGE_TAG=

# ---------- وضع التشغيل ----------
# demo = وضع العرض (D-36-1): حساب PostgreSQL وRabbitMQ الإداري، ترحيلات عند الإقلاع، بذور Demo، لافتة «بيئة عرض».
HRM_DEPLOYMENT_MODE=demo
# التطبيقات خلف ملف التعريف full-stack.
COMPOSE_PROFILES=full-stack
# اسم الجهة في رأس الواجهة.
HRM_ORGANIZATION_NAME=شعبة التنظيم والموارد البشرية
# مزوّد الملفات: Local على volume مسمّى. Minio يحتاج --profile minio وMINIO_IMAGE ومفاتيح MinIO (غير مفعّل هنا).
HRM_FILE_PROVIDER=Local
# OpenTelemetry معطل على الخادم الواحد؛ Seq وحده (D-OPS-6).
HRM_OTEL_ENABLED=false
# الترخيص معطل (D-OPS-9).
HRM_REQUIRE_LICENSE=false

# ---------- البنية التحتية (أسماء المستخدمين ليست أسراراً) ----------
POSTGRES_USER=hrm_admin
RABBITMQ_DEFAULT_USER=hrm_admin
KEYCLOAK_ADMIN=hrm_kc_admin

# ---------- الأسرار: تُولَّد على الخادم ولا تُطبع ----------
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_PASS=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HR_GATEWAY_CLIENT_SECRET=
KEYCLOAK_DIRECTORY_SYNC_SECRET=
# مفتاح HMAC لرموز بوابة التوظيف (32 حرفاً على الأقل).
HR_CORE_OTP_HMAC_KEY=
# سر إثبات البوابة المشترك بين البوابة والوحدات الـ14 (32 حرفاً على الأقل).
GATEWAY_CALLER_PROOF_SECRET=
# كلمة مرور كل المستخدمين التجريبيين (16 حرفاً على الأقل). يقرؤها المالك وحده على الخادم.
DEMO_USERS_PASSWORD=
# أسرار عملاء الخدمات في Keycloak (S2S). ربطها الكامل بين الخدمات ← PLAN-37.
SVC_HR_CORE_CLIENT_SECRET=
SVC_HR_CONTRACTS_CLIENT_SECRET=
SVC_HR_HEALTH_CLIENT_SECRET=
SVC_HR_MOVEMENTS_CLIENT_SECRET=
SVC_HR_TRAINING_CLIENT_SECRET=
SVC_PAYROLL_CLIENT_SECRET=
SVC_IDCARD_CLIENT_SECRET=
SVC_RECORDS_ARCHIVE_CLIENT_SECRET=
SVC_ADMIN_LOGISTICS_CLIENT_SECRET=
SVC_IT_INFRA_CLIENT_SECRET=
SVC_DEV_ANALYTICS_CLIENT_SECRET=
SVC_COMPLIANCE_CLIENT_SECRET=
