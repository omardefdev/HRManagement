# PLAN-36 acceptance on the owner's machine: LAB-ONLY values for the local single-host chain
# (scripts/vps/deploy.ps1 -Local -EnvFile deploy/vps/.env.vps-local). Every secret ends in -lab-only; none is used
# anywhere else, and .gitleaks.toml allows exactly that pattern in exactly this file. Never use them on a server.
APP_DOMAIN=hr.hrm.test
SSO_DOMAIN=sso.hrm.test
ACME_EMAIL=
HRM_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ADMIN_ALLOWED_CIDRS=
HRM_IMAGE_REPO=localhost:5001/hrmanagement
IMAGE_TAG=
HRM_DEPLOYMENT_MODE=demo
COMPOSE_PROFILES=full-stack
HRM_ORGANIZATION_NAME=شعبة التنظيم والموارد البشرية
HRM_FILE_PROVIDER=Local
HRM_OTEL_ENABLED=false
HRM_REQUIRE_LICENSE=false
POSTGRES_USER=hrm_admin
RABBITMQ_DEFAULT_USER=hrm_admin
KEYCLOAK_ADMIN=hrm_kc_admin
POSTGRES_PASSWORD=postgres-password-0123456789-lab-only
RABBITMQ_DEFAULT_PASS=rabbitmq-default-pass-0123456789-lab-only
KEYCLOAK_ADMIN_PASSWORD=keycloak-admin-password-0123456789-lab-only
KEYCLOAK_HR_GATEWAY_CLIENT_SECRET=keycloak-hr-gateway-client-secret-0123456789-lab-only
KEYCLOAK_DIRECTORY_SYNC_SECRET=keycloak-directory-sync-secret-0123456789-lab-only
HR_CORE_OTP_HMAC_KEY=hr-core-otp-hmac-key-0123456789-lab-only
GATEWAY_CALLER_PROOF_SECRET=gateway-caller-proof-secret-0123456789-lab-only
DEMO_USERS_PASSWORD=demo-users-password-0123456789-lab-only
SVC_HR_CORE_CLIENT_SECRET=svc-hr-core-client-secret-0123456789-lab-only
SVC_HR_CONTRACTS_CLIENT_SECRET=svc-hr-contracts-client-secret-0123456789-lab-only
SVC_HR_HEALTH_CLIENT_SECRET=svc-hr-health-client-secret-0123456789-lab-only
SVC_HR_MOVEMENTS_CLIENT_SECRET=svc-hr-movements-client-secret-0123456789-lab-only
SVC_HR_TRAINING_CLIENT_SECRET=svc-hr-training-client-secret-0123456789-lab-only
SVC_PAYROLL_CLIENT_SECRET=svc-payroll-client-secret-0123456789-lab-only
SVC_IDCARD_CLIENT_SECRET=svc-idcard-client-secret-0123456789-lab-only
SVC_RECORDS_ARCHIVE_CLIENT_SECRET=svc-records-archive-client-secret-0123456789-lab-only
SVC_ADMIN_LOGISTICS_CLIENT_SECRET=svc-admin-logistics-client-secret-0123456789-lab-only
SVC_IT_INFRA_CLIENT_SECRET=svc-it-infra-client-secret-0123456789-lab-only
SVC_DEV_ANALYTICS_CLIENT_SECRET=svc-dev-analytics-client-secret-0123456789-lab-only
SVC_COMPLIANCE_CLIENT_SECRET=svc-compliance-client-secret-0123456789-lab-only
