  "allowListExceptions": [
    {
      "policy": "ServicePolicies.HrCoreLookupS2S",
      "clients": ["hr-gateway-client", "svc-admin-logistics", "svc-compliance"],
      "reason": "Allowed before PLAN-37 without a call to the lifecycle or service-regime endpoints (their lookups use /api/lookup under HrManagementPolicies.HrCoreLookup). Not widened here; removing them is PLAN-42 (least privilege)."
    },
    {
      "policy": "ServicePolicies.DirectorySync",
      "clients": ["svc-hr-core", "svc-auth-directory"],
      "reason": "Allowed before PLAN-37 without a directory-sync call. Not widened here; removing them is PLAN-42."
    }
  ],
