    },
    "hr-core.policies.enforce": {
      "target": "hr-core-web", "method": "POST", "path": "/api/internal/policies/enforce",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/PoliciesController.cs",
      "serverPolicies": ["HrManagementPolicies.HrCoreReadOnly", "HrManagementPolicies.HrCoreBranchOperation"], "scope": "hr-core.workflow"
    },
    "hr-core.lookup.by-ids": {
      "target": "hr-core-web", "method": "POST", "path": "/api/lookup/employees/by-ids",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/LookupApiController.cs",
      "serverPolicies": ["HrManagementPolicies.HrCoreLookup"], "scope": "hr-core.lookup"
    },
    "hr-core.service-regime.active-regimes": {
      "target": "hr-core-web", "method": "POST", "path": "/api/internal/service-regime/active-regimes",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/ServiceRegimeInternalController.cs",
      "serverPolicies": ["ServicePolicies.HrCoreLookupS2S"], "scope": "hr-core.lookup"
    },
    "hr-core.service-regime.payroll-blockers": {
      "target": "hr-core-web", "method": "POST", "path": "/api/internal/service-regime/payroll-blockers",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/ServiceRegimeInternalController.cs",
      "serverPolicies": ["ServicePolicies.HrCoreLookupS2S"], "scope": "hr-core.lookup"
    },
    "hr-core.employees.lifecycle-flags": {
      "target": "hr-core-web", "method": "GET", "path": "/api/internal/employees/{employeeId}/lifecycle-flags",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/EmployeeLifecycleInternalController.cs",
      "serverPolicies": ["ServicePolicies.HrCoreLookupS2S"], "scope": "hr-core.lookup"
    },
    "hr-core.workflow-instances.start": {
      "target": "hr-core-web", "method": "POST", "path": "/api/workflow-instances",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/WorkflowInstancesController.cs",
      "serverPolicies": ["HrManagementPolicies.HrCoreReadOnly", "HrManagementPolicies.HrCoreWrite"], "scope": "hr-core.workflow"
    },
    "hr-core.dsar.subject": {
      "target": "hr-core-web", "method": "GET", "path": "/api/internal/dsar-subjects/{employeeId}",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/DsarInternalController.cs",
      "serverPolicies": ["ServicePolicies.DsarSubjectRead"], "scope": "dsar.subject.read"
    },
    "hr-core.dsar.candidate-anonymize": {
      "target": "hr-core-web", "method": "POST", "path": "/api/internal/dsar-subjects/candidates/{applicationId}/anonymize",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/DsarInternalController.cs",
      "serverPolicies": ["ServicePolicies.DsarSubjectRead"], "scope": "dsar.subject.read"
    },
    "payroll.dsar.subject": {
      "target": "payroll-web", "method": "GET", "path": "/api/internal/dsar-subjects/{employeeId}",
      "controller": "src/Services/Payroll/Payroll.Web/Controllers/DsarInternalController.cs",
      "serverPolicies": ["ServicePolicies.DsarSubjectRead"], "scope": "dsar.subject.read"
    },
    "payroll.pay-grades": {
      "target": "payroll-web", "method": "GET", "path": "/api/internal/pay-grades/{gradeCode}",
      "controller": "src/Services/Payroll/Payroll.Web/Controllers/PayGradeLookupInternalController.cs",
      "serverPolicies": ["ServicePolicies.PayrollGradeLookup"], "scope": "payroll.grades.read"
    },
    "file-storage.references": {
      "target": "file-storage-web", "via": "hr-gateway", "method": "POST", "path": "/api/files/{fileId}/references",
      "controller": "src/Services/FileStorage/File.Storage.Web/Controllers/FilesApiController.cs",
      "serverPolicies": ["HrManagementPolicies.ModuleFileStorage", "ServicePolicies.FileStorageReferences"], "scope": "file-storage.references"
    },
    "file-storage.service-upload": {
      "target": "file-storage-web", "method": "POST", "path": "/api/files/service-upload",
      "controller": "src/Services/FileStorage/File.Storage.Web/Controllers/FilesServiceUploadController.cs",
      "serverPolicies": ["ServicePolicies.FileStorageServiceUpload"], "scope": "file-storage.service-upload"
    },
    "file-storage.dsar.files": {
      "target": "file-storage-web", "method": "GET", "path": "/api/internal/dsar-subjects/{employeeId}/files",
      "controller": "src/Services/FileStorage/File.Storage.Web/Controllers/DsarInternalController.cs",
      "serverPolicies": ["ServicePolicies.DsarSubjectRead"], "scope": "dsar.subject.read"
    },
    "auth-directory.sync-employee": {
      "target": "auth-directory-web", "method": "POST", "path": "/api/internal/directory/sync-employee",
      "controller": "src/Services/AuthDirectory/Auth.Directory.Web/Controllers/DirectoryInternalSyncController.cs",
      "serverPolicies": ["ServicePolicies.DirectorySync"], "scope": "directory.sync"
    }
  },
