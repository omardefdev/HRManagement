{
  "schemaVersion": 1,
  "about": "PLAN-37: the single source of truth for service-to-service wiring. ProductionWiringMatrixTests checks it against the code, the server policies, the compose chains, k8s and the Keycloak scripts. A plan that adds an S2S client, call or scope, changes a server policy for a called endpoint, or removes a registration updates this file in the same commit. Rendered to docs/SERVICE_WIRING_MATRIX.md by scripts/int037-render-wiring-doc.ps1.",
  "scopes": {
    "hr-core.lookup": { "description": "HR.Core employee lookup (S2S)", "audiences": ["api-hr-core"] },
    "hr-core.workflow": { "description": "HR.Core workflow + code generation (S2S)", "audiences": ["api-hr-core"] },
    "file-storage.references": { "description": "File.Storage reference registration (S2S)", "audiences": ["api-file-storage"] },
    "dsar.subject.read": { "description": "Compliance DSAR subject collection (S2S)", "audiences": ["api-hr-core", "api-payroll", "api-file-storage"] },
    "payroll.grades.read": { "description": "HR.Core offer salary bounds from Payroll pay grades (S2S, HCM-027)", "audiences": ["api-payroll"] },
    "file-storage.service-upload": { "description": "HR.Core relays candidate document uploads to File.Storage (S2S, PLAN-30)", "audiences": ["api-file-storage"] },
    "directory.sync": { "description": "Auth.Directory synchronization (S2S)", "audiences": ["api-auth-directory"] },
    "evidence.ingest": { "description": "Gateway evidence ingestion (S2S)", "audiences": ["hr-gateway-client"], "note": "CI evidence publishing; no service client requests it" }
  },
  "endpoints": {
    "hr-core.codes.generate": {
      "target": "hr-core-web", "method": "POST", "path": "/api/internal/codes/generate",
      "controller": "src/Services/HRCore/HR.Core.Web/Controllers/CodeGenerationController.cs",
