          "length": {
            "max": 255
          },
          "person-name-prohibited-characters": {}
        },
        "required": {
          "roles": [
            "user"
          ]
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      }
    ],
    "attributes": [
      {
        "name": "tenant_id",
        "displayName": "Tenant ID",
        "validations": {
          "length": {
            "max": 36
          }
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin"
          ]
        },
        "multivalued": false
      },
      {
        "name": "scope_org_unit_id",
        "displayName": "Organization scope ID",
        "validations": {
          "length": {
            "max": 36
          }
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin"
          ]
        },
        "multivalued": false
      },
      {
        "name": "acceptance_fixture",
        "displayName": "Acceptance fixture",
        "validations": {
          "length": {
            "max": 64
          }
        },
        "permissions": {
          "view": [
            "admin"
          ],
          "edit": [
            "admin"
          ]
        },
        "multivalued": false
      },
      {
        "name": "employee_id",
        "displayName": "Employee ID",
        "validations": {
          "length": {
            "max": 36
          }
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin"
          ]
