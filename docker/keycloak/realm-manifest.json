{
  "schemaVersion": "realm-manifest-v1",
  "about": [
    "PLAN-39 (D-39-1): the realm hrmanagement as code, without secrets. Service clients (svc-*), their scopes, the",
    "scope audiences and the secret variable of each client are NOT here: they come from deploy/wiring/service-wiring.json",
    "(PLAN-37). scripts/keycloak/render-realm.ps1 merges the two per profile (Production, Demo, Acceptance) into",
    "artifacts/keycloak/<profile>/realm-hrmanagement.json; deploy/keycloak/reconcile.sh keeps an existing realm in step",
    "on every deploy (clients, scopes, secrets, redirect URIs, the security fields below; never users or role mappings).",
    "Profiles differ only in users, redirect URIs and the listed acceptanceExceptions (Ops039RenderRealmTests)."
  ],
  "realm": {
    "realm": "hrmanagement",
    "enabled": true,
    "displayName": "HR Management",
    "registrationAllowed": false,
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "resetPasswordAllowed": true,
    "editUsernameAllowed": false
  },
  "security": {
    "about": "D-39-6, the same in every profile (also Demo, P-5). reconcile.sh applies these named fields to an existing realm.",
    "sslRequired": "external",
    "bruteForceProtected": true,
    "permanentLockout": false,
    "failureFactor": 5,
    "waitIncrementSeconds": 900,
    "maxFailureWaitSeconds": 900,
    "minimumQuickLoginWaitSeconds": 60,
    "quickLoginCheckMilliSeconds": 1000,
    "maxDeltaTimeSeconds": 43200,
    "passwordPolicy": "length(12) and notUsername and passwordHistory(3)"
  },
  "roles": [
    {
      "name": "hr-admin",
      "description": "Full access to all HR modules"
    },
