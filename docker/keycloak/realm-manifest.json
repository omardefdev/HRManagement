    "groups": [
      {
        "name": "user-metadata",
        "displayHeader": "User metadata",
        "displayDescription": "Attributes, which refer to user metadata"
      }
    ]
  },
  "profiles": {
    "Production": {
      "about": "D-39-5: one bootstrap administrator, password change at first login. Redirect URIs on APP_DOMAIN.",
      "appUrls": "https://{APP_DOMAIN}",
      "users": "bootstrapAdmin"
    },
    "Demo": {
      "about": "The demo server: the demo users, password placeholder DEMO_USERS_PASSWORD resolved by Keycloak at import. Redirect URIs on APP_DOMAIN.",
      "appUrls": "https://{APP_DOMAIN}",
      "users": "demoUsers"
    },
    "Acceptance": {
      "about": "The acceptance stacks: every persona of testdata/acceptance/personas.json (lab passwords, .acceptance/credentials.json).",
      "appUrls": [
        "http://localhost:5000",
        "http://localhost:5200",
        "http://localhost:6200"
      ],
      "webOrigins": [
        "+"
      ],
      "users": "personas",
      "acceptanceExceptions": {
        "about": "The acceptance harness signs personas in with the password grant (AcceptanceHarness); the stacks run with lab secrets (the gateway secret of the local .env, the shared lab service secret of docker-compose.acceptance.yml, generated persona passwords).",
        "gatewayDirectAccessGrantsEnabled": true,
        "labSecrets": true
      }
    }
  },
