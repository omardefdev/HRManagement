    },
    {
      "name": "admin-logistics",
      "description": "Admin.Logistics"
    },
    {
      "name": "it-infra",
      "description": "IT.Infra"
    },
    {
      "name": "dev-analytics",
      "description": "Dev.Analytics"
    },
    {
