      "description": "Auth.Directory"
    },
    {
      "name": "file-storage",
      "description": "File.Storage"
    },
    {
      "name": "platform-admin",
      "description": "Platform operator"
    },
    {
      "name": "branch-manager",
      "description": "Branch scope manager"
    },
    {
      "name": "hr-employee",
