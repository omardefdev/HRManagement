@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam ArrowColor #24465A
skinparam ActorBorderColor #0F6B73
skinparam ActorBackgroundColor #E6F3F3
skinparam UsecaseBorderColor #0F6B73
skinparam UsecaseBackgroundColor #F4FAFA
skinparam RectangleBorderColor #24465A
skinparam RectangleBackgroundColor #F8FBFC
skinparam ComponentBorderColor #24465A
skinparam ComponentBackgroundColor #F4F7F8
skinparam ClassBorderColor #24465A
skinparam ClassBackgroundColor #F8FBFC
skinparam SequenceLifeLineBorderColor #78909C
skinparam SequenceParticipantBorderColor #24465A
skinparam SequenceParticipantBackgroundColor #F4F7F8

title ERD مفاهيمي مختصر للنواة الحالية HR.Core
left to right direction

entity "Tenant\nالجهة" as Tenant {
  * Id : uuid <<PK>>
  Code : text <<UQ>>
}
entity "TenantAssignmentRule\nقاعدة الإسناد" as AssignmentRule {
  * Id : uuid <<PK>>
  TenantId : uuid <<FK>>
}
entity "TenantQuarantineEntry\nسجل الحجر" as Quarantine {
  * Id : uuid <<PK>>
  CandidateTenantId : uuid
}
entity "OrgUnit\nالوحدة التنظيمية" as OrgUnit {
  * Id : uuid <<PK>>
  TenantId : uuid <<FK>>
  ParentId : uuid <<FK>>
}
entity "OrgUnitVersion\nنسخة الهيكل المؤرخة" as OrgVersion {
  * Id : uuid <<PK>>
  OrgUnitId : uuid <<FK>>
  ValidFrom : timestamp
}
entity "Employee\nالموظف" as Employee {
  * Id : uuid <<PK>>
  TenantId : uuid <<FK>>
  PrimaryOrgUnitId : uuid <<FK>>
  NationalIdEncrypted : bytes
  NationalIdHash : text
}
entity "JobCatalogEntry\nدليل الوظائف" as Job {
  * Id : uuid <<PK>>
  TenantId : uuid <<FK>>
}
entity "FundedPosition\nوظيفة ممولة" as Position {
  * Id : uuid <<PK>>
  JobCatalogEntryId : uuid <<FK>>
  OrgUnitId : uuid <<FK>>
}
entity "WorkforcePlan\nخطة القوى العاملة" as Workforce {
  * Id : uuid <<PK>>
  TenantId : uuid <<FK>>
}
entity "PolicyTemplateVersion\nإصدار السياسة" as Policy {
  * Id : uuid <<PK>>
  TenantId : uuid <<FK>>
  Status : enum
}
entity "WorkflowDefinition\nتعريف سير العمل" as Workflow {
  * Id : uuid <<PK>>
  TenantId : uuid <<FK>>
}
entity "CodePolicyVersion\nسياسة الرمز" as CodePolicy {
  * Id : uuid <<PK>>
  TenantId : uuid <<FK>>
}

Tenant ||--o{ OrgUnit
Tenant ||--o{ Employee
Tenant ||--o{ AssignmentRule
AssignmentRule ..> Quarantine
OrgUnit ||--o{ OrgVersion
OrgUnit ||--o{ Employee : PrimaryOrgUnit
OrgUnit ||--o{ Position
Job ||--o{ Position
Workforce ..> Position
Policy ..> Workflow
CodePolicy ..> OrgUnit

note bottom of Employee
هذا عرض مفاهيمي للكيانات المحورية لا قائمة جداول نهائية.
يعتمد ملحق ERD المستخرج من Migration Snapshot مرجعاً بنيوياً كاملاً.
end note
@enduml
