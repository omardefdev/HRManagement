        <mxCell id="erd-04-box-377" parent="1" vertex="1" value="ComplaintFollowUps Ups Follow شكوى PerformedBy → hr_core_db.Employee منفّذ المتابعة" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#C9784A;fontColor=#A34F1A;fontSize=11;fontFamily=Segoe UI;align=right;verticalAlign=top;spacing=6;arcSize=8;dashed=1;">
