        <mxCell id="erd-02-txt-243" parent="1" vertex="1" value="ملاحظات: حقول تشير إلى قاعدة أخرى (بلا FK)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#C9784A;fontFamily=Segoe UI;fontStyle=1;">
          <mxGeometry x="2420" y="94" width="320" height="22" as="geometry" />
        </mxCell>
        <mxCell id="erd-02-box-244" parent="1" vertex="1" value="AssetAssignments تعيينات أصل EmployeeId → hr_core_db.Employee معرّف موظف في النواة HandoverFileId → file_storage_db.Files معرّف ملف تسليم ReturnFileId → file_storage_db.Files معرّف ملف إعادة WorkflowInstanceId → hr_core_db.WorkflowInstance معرّف سير عمل" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#C9784A;fontColor=#A34F1A;fontSize=11;fontFamily=Segoe UI;align=right;verticalAlign=top;spacing=6;arcSize=8;dashed=1;">
          <mxGeometry x="2420" y="120" width="320" height="112" as="geometry" />
        </mxCell>
        <mxCell id="erd-02-box-245" parent="1" vertex="1" value="AssetLossReports Reports فقد أصل LossFileId → file_storage_db.Files معرّف ملف فقد WorkflowInstanceId → hr_core_db.WorkflowInstance معرّف سير عمل" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#C9784A;fontColor=#A34F1A;fontSize=11;fontFamily=Segoe UI;align=right;verticalAlign=top;spacing=6;arcSize=8;dashed=1;">
          <mxGeometry x="2420" y="242" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="erd-02-box-246" parent="1" vertex="1" value="ReceiptRecords سجلات استلام ReceivedBy → hr_core_db.Employee مستلم" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#C9784A;fontColor=#A34F1A;fontSize=11;fontFamily=Segoe UI;align=right;verticalAlign=top;spacing=6;arcSize=8;dashed=1;">
          <mxGeometry x="2420" y="328" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="erd-02-box-247" parent="1" vertex="1" value="SupplyOrders أوامر توريد OrgUnitId → hr_core_db.OrgUnit معرّف وحدة تنظيمية RequestedBy → hr_core_db.Employee طالب الطلب" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#C9784A;fontColor=#A34F1A;fontSize=11;fontFamily=Segoe UI;align=right;verticalAlign=top;spacing=6;arcSize=8;dashed=1;">
          <mxGeometry x="2420" y="396" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="erd-02-txt-248" parent="1" vertex="1" value="FK = HasOne داخل هذه القاعدة. الخط البرتقالي المتقطع = مرجع منطقي داخلي. REF + الملاحظة الجانبية = حقل يشير إلى قاعدة أخرى. السطر العربي الصغير = ترجمة الاسم." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7280;fontFamily=Segoe UI;">
          <mxGeometry x="60" y="1550" width="2640" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
