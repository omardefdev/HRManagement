        </mxCell>
        <mxCell id="erd-04-box-380" parent="1" vertex="1" value="DisciplinaryActions إجراءات تأديبي EmployeeId → hr_core_db.Employee معرّف موظف في النواة EvidenceFileId → file_storage_db.Files معرّف ملف دليل IssuedBy → hr_core_db.Employee صادر من موظف" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#C9784A;fontColor=#A34F1A;fontSize=11;fontFamily=Segoe UI;align=right;verticalAlign=top;spacing=6;arcSize=8;dashed=1;">
