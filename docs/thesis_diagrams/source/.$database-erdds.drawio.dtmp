        </mxCell>
        <mxCell id="erd-04-box-378" parent="1" vertex="1" value="Complaints شكاوى AssignedTo → hr_core_db.Employee مسند إلى موظف EvidenceFileId → file_storage_db.Files معرّف ملف دليل ReporterProtectedId → hr_core_db.Employee معرّف هوية المبلّغ المحمية" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#C9784A;fontColor=#A34F1A;fontSize=11;fontFamily=Segoe UI;align=right;verticalAlign=top;spacing=6;arcSize=8;dashed=1;">
