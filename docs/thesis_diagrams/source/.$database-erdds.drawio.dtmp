        <mxCell id="erd-15-box-255" parent="1" vertex="1" value="ArchiveItems عناصر أرشيف Creator → hr_core_db.Employee منشئ عنصر الأرشيف DisposeApprovedBy → auth_directory_db.AuthUser معتمد إتلاف DisposeRequestedBy → auth_directory_db.AuthUser طالب إتلاف" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#C9784A;fontColor=#A34F1A;fontSize=11;fontFamily=Segoe UI;align=right;verticalAlign=top;spacing=6;arcSize=8;dashed=1;">
