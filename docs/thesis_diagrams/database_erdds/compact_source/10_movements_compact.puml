@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة hr_movements_db\nHR.Movements"

entity "DistributionPlans\nDistributionPlan" as T01 {
  * Id
    OrgUnitId
    TenantId
    TransferRequestId
}
entity "LoanAssignmentRequests\nLoanAssignmentRequest" as T02 {
  * Id
    BorrowingOrgUnitId
    EmployeeId
    LendingOrgUnitId
    TenantId
}
entity "MovementExecutionRecords\nMovementExecutionRecord" as T03 {
  * Id
    EmployeeId
    LoanAssignmentRequestId
    SecondmentRequestId
    TenantId
    TransferRequestId
}
entity "MovementNotices\nMovementNotice" as T04 {
  * Id
    TenantId
}
entity "SecondmentRequests\nSecondmentRequest" as T05 {
  * Id
    EmployeeId
    TenantId
}
entity "TransferApprovals\nTransferApproval" as T06 {
  * Id
    TenantId
    TransferRequestId
}
entity "TransferFinancialImpacts\nTransferFinancialImpact" as T07 {
  * Id
    EmployeeId
    TenantId
    TransferRequestId
}
entity "TransferRequests\nTransferRequest" as T08 {
  * Id
    EmployeeId
    FromOrgUnitId
    TenantId
    ToOrgUnitId
}
entity "AuditLogs\nEntityAuditLog" as T09 {
  * Id
    EntityId
    TenantId
    UserId
}
entity "OrgUnitSnapshots\nOrgUnitSnapshot" as T10 {
  * Id
    ParentId
}

T01 }o--|| T08 : TransferRequestId
T03 }o--|| T02 : LoanAssignmentRequestId
T03 }o--|| T05 : SecondmentRequestId
T03 }o--|| T08 : TransferRequestId
T06 }o--|| T08 : TransferRequestId
T07 }o--|| T08 : TransferRequestId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
