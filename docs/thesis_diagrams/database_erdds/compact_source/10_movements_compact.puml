@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة movements_db\nHR.Movements"

entity "DistributionPlans\nDistributionPlan" as T01 {
  * Id
    OrgUnitId
    TenantId
    TransferRequestId
}
entity "LoanAssignmentRequests\nLoanAssignmentRequest" as T02 {
  * Id
    BorrowingOrgUnitId
    EmployeeId
    LendingOrgUnitId
    TenantId
}
entity "MovementChecklists\nMovementChecklist" as T03 {
  * Id
    CorrelationId
    TenantId
}
entity "MovementExecutionRecords\nMovementExecutionRecord" as T04 {
  * Id
    EmployeeId
    LoanAssignmentRequestId
    SecondmentRequestId
    TenantId
    TransferRequestId
}
entity "MovementNotices\nMovementNotice" as T05 {
  * Id
    TenantId
}
entity "SecondmentRequests\nSecondmentRequest" as T06 {
  * Id
    EmployeeId
    TenantId
}
entity "TransferApprovals\nTransferApproval" as T07 {
  * Id
    TenantId
    TransferRequestId
}
entity "TransferFinancialImpacts\nTransferFinancialImpact" as T08 {
  * Id
    EmployeeId
    TenantId
    TransferRequestId
}
entity "TransferRequests\nTransferRequest" as T09 {
  * Id
    EmployeeId
    FromOrgUnitId
    TenantId
    ToOrgUnitId
}
entity "SecondmentSagaStates\nSecondmentSagaState" as T10 {
  * CorrelationId
    BusinessCorrelationId
    EmployeeId
    SecondmentRequestId
    TenantId
    TimeoutTokenId
}
entity "TransferSagaStates\nTransferSagaState" as T11 {
  * CorrelationId
    BusinessCorrelationId
    EmployeeId
    FromOrgUnitId
    TenantId
    TimeoutTokenId
    ToOrgUnitId
    TransferRequestId
}
entity "IdempotencyRecords\nIdempotencyRecord" as T12 {
  * Id
    TenantId
}
entity "AuditLogs\nEntityAuditLog" as T13 {
  * Id
    EntityId
    TenantId
    UserId
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T14 {
  * Id
    MessageId
    TenantId
}
entity "OrgUnitSnapshots\nOrgUnitSnapshot" as T15 {
  * Id
    ParentId
    TenantId
}
entity "ProcessInterventions\nProcessIntervention" as T16 {
  * Id
    CorrelationId
    TenantId
}
entity "InboxState\nInboxState" as T17 {
  * Id
    ConsumerId
    LockId
    MessageId
}
entity "OutboxMessage\nOutboxMessage" as T18 {
  * SequenceNumber
    ConversationId
    CorrelationId
    InboxConsumerId
    InboxMessageId
    InitiatorId
    MessageId
    OutboxId
    RequestId
}
entity "OutboxState\nOutboxState" as T19 {
  * OutboxId
    LockId
}

T01 }o--|| T09 : TransferRequestId
T04 }o--|| T02 : LoanAssignmentRequestId
T04 }o--|| T06 : SecondmentRequestId
T04 }o--|| T09 : TransferRequestId
T07 }o--|| T09 : TransferRequestId
T08 }o--|| T09 : TransferRequestId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
