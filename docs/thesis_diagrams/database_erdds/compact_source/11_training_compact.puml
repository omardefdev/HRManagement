@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة hr_training_db\nHR.Training"

entity "CourseModules\nCourseModule" as T01 {
  * Id
    ELearningCourseId
    TenantId
}
entity "ELearningCourses\nELearningCourse" as T02 {
  * Id
    TenantId
}
entity "LearningCertificates\nLearningCertificate" as T03 {
  * Id
    LearningEnrollmentId
    TenantId
}
entity "LearningEnrollments\nLearningEnrollment" as T04 {
  * Id
    ELearningCourseId
    EmployeeId
    TenantId
}
entity "Lessons\nLesson" as T05 {
  * Id
    ContentFileId
    CourseModuleId
    TenantId
}
entity "MissionFiles\nMissionFile" as T06 {
  * Id
    EmployeeId
    TenantId
}
entity "QualificationCodes\nQualificationCode" as T07 {
  * Id
    TenantId
}
entity "TrainingCourses\nTrainingCourse" as T08 {
  * Id
    ProviderId
    TenantId
}
entity "TrainingEnrollments\nTrainingEnrollment" as T09 {
  * Id
    CertificateFileId
    CourseId
    EmployeeId
    TenantId
}
entity "TrainingNominations\nTrainingNomination" as T10 {
  * Id
    CourseId
    EmployeeId
    TenantId
    TrainingPlanId
}
entity "TrainingPlans\nTrainingPlan" as T11 {
  * Id
    OrgUnitId
    TenantId
}
entity "TrainingProviders\nTrainingProvider" as T12 {
  * Id
    TenantId
}
entity "TrainingResults\nTrainingResult" as T13 {
  * Id
    EnrollmentId
    TenantId
}
entity "AuditLogs\nEntityAuditLog" as T14 {
  * Id
    EntityId
    TenantId
    UserId
}

T01 }o--|| T02 : ELearningCourseId
T03 }o--|| T04 : HR.Training.Domain.Entities.LearningCertificate, LearningEnrollmentId
T04 }o--|| T02 : ELearningCourseId
T05 }o--|| T01 : CourseModuleId
T08 }o--|| T12 : ProviderId
T09 }o--|| T08 : CourseId
T10 }o--|| T08 : CourseId
T10 }o--|| T11 : TrainingPlanId
T13 }o--|| T09 : HR.Training.Domain.Entities.TrainingResult, EnrollmentId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
