@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة gateway_audit_db\nGateway Audit"

entity "audit_legal_holds\nAuditLegalHold" as T01 {
  * Id
    CorrelationId
}
entity "gateway_audit_chain_state\nGatewayAuditChainState" as T02 {
  * ChainKey
}
entity "gateway_audit_entries\nGatewayAuditEntry" as T03 {
  * Id
    CorrelationId
}
entity "security_audit_events\nSecurityAuditEvent" as T04 {
  * Id
    CorrelationId
    TenantId
}
entity "EvidenceArtifacts\nEvidenceArtifact" as T05 {
  * Id
    ArtifactId
    CardId
    ControlId
}
entity "EvidencePackExports\nEvidencePackExport" as T06 {
  * Id
    PackId
}
entity "EvidenceRecords\nEvidenceRecord" as T07 {
  * Id
    CausationId
    CorrelationId
    TenantId
    TimeZoneId
}


note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
