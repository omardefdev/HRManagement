@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة archive_db\nRecords.Archive"

entity "AuditLogs\nEntityAuditLog" as T01 {
  * Id
    EntityId
    TenantId
    UserId
}
entity "ExportJobs\nExportJob" as T02 {
  * Id
    RequestedByUserId
    ResultFileId
    TenantId
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T03 {
  * Id
    MessageId
    TenantId
}
entity "ArchiveChecklists\nArchiveChecklist" as T04 {
  * Id
    CorrelationId
    TenantId
}
entity "ArchiveIndexEntries\nArchiveIndexEntry" as T05 {
  * Id
    ArchiveItemId
    TenantId
}
entity "ArchiveItems\nArchiveItem" as T06 {
  * Id
    ClassificationId
    TenantId
}
entity "CustodyEvents\nCustodyEvent" as T07 {
  * Id
    ActorUserId
    ArchiveItemId
    TenantId
}
entity "DigitalFileRecords\nDigitalFileRecord" as T08 {
  * Id
    ArchiveItemId
    FileId
    TenantId
}
entity "DisposalRecords\nDisposalRecord" as T09 {
  * Id
    ApprovalEvidenceFileId
    ArchiveItemId
    TenantId
}
entity "DocumentClassifications\nDocumentClassification" as T10 {
  * Id
    TenantId
}
entity "LoanRecords\nLoanRecord" as T11 {
  * Id
    ArchiveItemId
    TenantId
}
entity "PhysicalFileRecords\nPhysicalFileRecord" as T12 {
  * Id
    ArchiveItemId
    TenantId
}

T05 }o--|| T06 : ArchiveItemId
T06 }o--|| T10 : ClassificationId
T07 }o--|| T06 : ArchiveItemId
T08 }o--|| T06 : ArchiveItemId
T09 }o--|| T06 : ArchiveItemId
T11 }o--|| T06 : ArchiveItemId
T12 }o--|| T06 : ArchiveItemId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
