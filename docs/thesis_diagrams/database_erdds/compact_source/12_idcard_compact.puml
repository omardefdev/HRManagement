@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة idcard_db\nIDCard"

entity "AuditLogs\nEntityAuditLog" as T01 {
  * Id
    EntityId
    TenantId
    UserId
}
entity "AccessPermissions\nAccessPermission" as T02 {
  * Id
    IssuedCardId
    TenantId
}
entity "CardDeliveryRecords\nCardDeliveryRecord" as T03 {
  * Id
    IssuedCardId
    TenantId
}
entity "CardDesigns\nCardDesign" as T04 {
  * Id
    TenantId
}
entity "CardPermissionSets\nCardPermissionSet" as T05 {
  * Id
    TenantId
}
entity "CardRequests\nCardRequest" as T06 {
  * Id
    EmployeeId
    TenantId
}
entity "IssuedCards\nIssuedCard" as T07 {
  * Id
    CardDesignId
    DeliveryRecordId
    EmployeeId
    TenantId
}
entity "OfficialSealRecords\nOfficialSealRecord" as T08 {
  * Id
    SealFileId
    TenantId
}

T02 }o--|| T07 : IssuedCardId
T07 }o--|| T04 : CardDesignId
T07 }o--|| T03 : IDCard.Domain.Entities.IssuedCard, DeliveryRecordId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
