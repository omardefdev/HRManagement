@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة idcard_db\nIDCard"

entity "AuditLogs\nEntityAuditLog" as T01 {
  * Id
    EntityId
    TenantId
    UserId
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T02 {
  * Id
    MessageId
    TenantId
}
entity "AccessPermissions\nAccessPermission" as T03 {
  * Id
    IssuedCardId
    TenantId
}
entity "CardChecklists\nCardChecklist" as T04 {
  * Id
    CorrelationId
    TenantId
}
entity "CardDeliveryRecords\nCardDeliveryRecord" as T05 {
  * Id
    IssuedCardId
    ReceiptFileId
    TenantId
}
entity "CardDesigns\nCardDesign" as T06 {
  * Id
    TenantId
}
entity "CardPermissionSets\nCardPermissionSet" as T07 {
  * Id
    TenantId
}
entity "CardRequests\nCardRequest" as T08 {
  * Id
    EmployeeId
    IssuedCardId
    TenantId
}
entity "IssuedCards\nIssuedCard" as T09 {
  * Id
    CardDesignId
    DeliveryRecordId
    EmployeeId
    ReplacesCardId
    TenantId
}
entity "OfficialSealRecords\nOfficialSealRecord" as T10 {
  * Id
    SealFileId
    TenantId
}
entity "InboxState\nInboxState" as T11 {
  * Id
    ConsumerId
    LockId
    MessageId
}
entity "OutboxMessage\nOutboxMessage" as T12 {
  * SequenceNumber
    ConversationId
    CorrelationId
    InboxConsumerId
    InboxMessageId
    InitiatorId
    MessageId
    OutboxId
    RequestId
}
entity "OutboxState\nOutboxState" as T13 {
  * OutboxId
    LockId
}

T03 }o--|| T09 : IssuedCardId
T09 }o--|| T06 : CardDesignId
T09 }o--|| T05 : IDCard.Domain.Entities.IssuedCard, DeliveryRecordId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
