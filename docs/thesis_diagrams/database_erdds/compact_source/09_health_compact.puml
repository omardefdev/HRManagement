    TenantId
}
entity "InsuranceContracts\nInsuranceContract" as T05 {
  * Id
    TenantId
}
entity "MedicalCommitteeReports\nMedicalCommitteeReport" as T06 {
  * Id
    MedicalRecordId
    TenantId
}
entity "MedicalRecommendations\nMedicalRecommendation" as T07 {
  * Id
    EmployeeId
