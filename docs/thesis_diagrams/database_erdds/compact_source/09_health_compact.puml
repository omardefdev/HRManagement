    TenantId
}
entity "MedicalRecords\nMedicalRecord" as T08 {
  * Id
    EmployeeId
    TenantId
}
entity "PeriodicMedicalChecks\nPeriodicMedicalCheck" as T09 {
  * Id
    EmployeeId
    TenantId
}
entity "SafetyInspections\nSafetyInspection" as T10 {
