@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة filestorage_db\nFile.Storage"

entity "FileAccessAuditLogs\nFileAccessAuditLog" as T01 {
  * Id
    FileId
    TenantId
    UserId
}
entity "FilePurgeWorkItems\nFilePurgeWorkItem" as T02 {
  * Id
    FileId
    TenantId
}
entity "FileReconcileExceptions\nFileReconcileException" as T03 {
  * Id
    FileId
    TenantId
}
entity "Files\nFileRecord" as T04 {
  * Id
    TenantId
}
entity "FileReferences\nFileReferenceRecord" as T05 {
  * Id
    FileId
    TenantId
}
entity "FileScanResults\nFileScanResult" as T06 {
  * Id
    FileId
    TenantId
}
entity "FileScanWorkItems\nFileScanWorkItem" as T07 {
  * Id
    FileId
    TenantId
}
entity "FileReferenceOutbox\nFileReferenceOutboxMessage" as T08 {
  * Id
    FileId
    TenantId
}
entity "IdempotencyRecords\nIdempotencyRecord" as T09 {
  * Id
    TenantId
}
entity "AuditLogs\nEntityAuditLog" as T10 {
  * Id
    EntityId
    TenantId
    UserId
}
entity "FileAccessGrants\nFileAccessGrant" as T11 {
  * Id
    FileId
    GranteeId
    HolderId
    TenantId
}

T05 }o--|| T04 : FileId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
