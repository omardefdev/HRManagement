@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة analytics_db\nDev.Analytics"

entity "AnalyticsEvents\nAnalyticsEvent" as T01 {
  * Id
    OrgUnitId
    TenantId
}
entity "Dashboards\nDashboard" as T02 {
  * Id
    OwnerId
    TenantId
}
entity "DataRefreshSchedules\nDataRefreshSchedule" as T03 {
  * Id
    TargetReadModelId
    TenantId
}
entity "ETLJobs\nETLJob" as T04 {
  * Id
    TenantId
}
entity "KPIs\nKPI" as T05 {
  * Id
    TenantId
}
entity "ReadModels\nReadModel" as T06 {
  * Id
    TenantId
}
entity "Reports\nReport" as T07 {
  * Id
    TenantId
}
entity "AuditLogs\nEntityAuditLog" as T08 {
  * Id
    EntityId
    TenantId
    UserId
}
entity "ExportJobs\nExportJob" as T09 {
  * Id
    RequestedByUserId
    ResultFileId
    TenantId
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T10 {
  * Id
    MessageId
    TenantId
}

T03 }o--|| T06 : TargetReadModelId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
