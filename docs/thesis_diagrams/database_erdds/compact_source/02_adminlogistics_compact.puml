@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "خريطة ERD المختصرة لقاعدة adminlogistics_db\nAdmin.Logistics"

entity "Assets\nAsset" as T01 {
  * Id
    OriginReceiptRecordId
    OriginSupplyOrderLineId
    TenantId
}
entity "AssetAssignments\nAssetAssignment" as T02 {
  * Id
    AssetId
    EmployeeId
    HandoverFileId
    ReturnFileId
    TenantId
    WorkflowInstanceId
}
entity "AssetLossReports\nAssetLossReport" as T03 {
  * Id
    AssetId
    LossFileId
    TenantId
    WorkflowInstanceId
}
entity "InventoryItems\nInventoryItem" as T04 {
  * Id
    TenantId
}
entity "MaintenanceRecords\nMaintenanceRecord" as T05 {
  * Id
    AssetId
    TenantId
}
entity "ReceiptRecords\nReceiptRecord" as T06 {
  * Id
    InventoryItemId
    SupplyOrderId
    TenantId
}
entity "SupplyOrders\nSupplyOrder" as T07 {
  * Id
    OrgUnitId
    TenantId
}
entity "SupplyOrderLines\nSupplyOrderLine" as T08 {
  * Id
    InventoryItemId
    SupplyOrderId
    TenantId
}
entity "Vendors\nVendor" as T09 {
  * Id
    TenantId
}
entity "AuditLogs\nEntityAuditLog" as T10 {
  * Id
    EntityId
    TenantId
    UserId
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T11 {
  * Id
    MessageId
    TenantId
}

T01 }o--|| T06 : OriginReceiptRecordId
T01 }o--|| T08 : OriginSupplyOrderLineId
T02 }o--|| T01 : AssetId
T03 }o--|| T01 : AssetId
T05 }o--|| T01 : AssetId
T06 }o--|| T04 : InventoryItemId
T06 }o--|| T07 : SupplyOrderId
T08 }o--|| T04 : InventoryItemId
T08 }o--|| T07 : SupplyOrderId

note bottom
الخريطة المختصرة تعرض الجداول والعلاقات الأساسية؛ التفاصيل الكاملة في ملحق ERD.
end note
@enduml
