@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة hr_training_db\nHR.Training / TrainingDbContext"

entity "CourseModules\nCourseModule" as T01 {
  * Id : uuid
    ELearningCourseId : uuid
    TenantId : uuid
}
entity "ELearningCourses\nELearningCourse" as T02 {
  * Id : uuid
    TenantId : uuid
}
entity "LearningCertificates\nLearningCertificate" as T03 {
  * Id : uuid
    LearningEnrollmentId : uuid
    TenantId : uuid
}
entity "LearningEnrollments\nLearningEnrollment" as T04 {
  * Id : uuid
    ELearningCourseId : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "Lessons\nLesson" as T05 {
  * Id : uuid
    ContentFileId : uuid
    CourseModuleId : uuid
    TenantId : uuid
}
entity "MissionFiles\nMissionFile" as T06 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "QualificationCodes\nQualificationCode" as T07 {
  * Id : uuid
    TenantId : uuid
}
entity "TrainingCourses\nTrainingCourse" as T08 {
  * Id : uuid
    ProviderId : uuid
    TenantId : uuid
}
entity "TrainingEnrollments\nTrainingEnrollment" as T09 {
  * Id : uuid
    CertificateFileId : uuid
    CourseId : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "TrainingNominations\nTrainingNomination" as T10 {
  * Id : uuid
    CourseId : uuid
    EmployeeId : uuid
    TenantId : uuid
    TrainingPlanId : uuid
}
entity "TrainingPlans\nTrainingPlan" as T11 {
  * Id : uuid
    OrgUnitId : uuid
    TenantId : uuid
}
entity "TrainingProviders\nTrainingProvider" as T12 {
  * Id : uuid
    TenantId : uuid
}
entity "TrainingResults\nTrainingResult" as T13 {
  * Id : uuid
    EnrollmentId : uuid
    TenantId : uuid
}
entity "AuditLogs\nEntityAuditLog" as T14 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
    UserId : uuid
}

T01 }o--|| T02 : ELearningCourseId
T03 }o--|| T04 : HR.Training.Domain.Entities.LearningCertificate, LearningEnrollmentId
T04 }o--|| T02 : ELearningCourseId
T05 }o--|| T01 : CourseModuleId
T08 }o--|| T12 : ProviderId
T09 }o--|| T08 : CourseId
T10 }o--|| T08 : CourseId
T10 }o--|| T11 : TrainingPlanId
T13 }o--|| T09 : HR.Training.Domain.Entities.TrainingResult, EnrollmentId

note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
