@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة itinfra_db\nIT.Infra / ITInfraDbContext"

entity "AuditLogs\nEntityAuditLog" as T01 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
    UserId : uuid
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T02 {
  * Id : uuid
    MessageId : text
    TenantId : uuid
}
entity "BackupJobs\nBackupJob" as T03 {
  * Id : uuid
    TenantId : uuid
}
entity "EnvironmentConfigurations\nEnvironmentConfiguration" as T04 {
  * Id : uuid
    TenantId : uuid
}
entity "ITSupportTickets\nITSupportTicket" as T05 {
  * Id : uuid
    TenantId : uuid
}
entity "LegacySystems\nLegacySystemRecord" as T06 {
  * Id : uuid
    TenantId : uuid
}
entity "MediaDestructionCertificates\nMediaDestructionCertificate" as T07 {
  * Id : uuid
    LegacySystemId : uuid
    TenantId : uuid
}
entity "SecurityIncidents\nSecurityIncident" as T08 {
  * Id : uuid
    TenantId : uuid
}
entity "ServerDevices\nServerDevice" as T09 {
  * Id : uuid
    TenantId : uuid
}
entity "ShadowOperationChecks\nShadowOperationCheck" as T10 {
  * Id : uuid
    LegacySystemId : uuid
    TenantId : uuid
}
entity "SystemPermissionRecords\nSystemPermissionRecord" as T11 {
  * Id : uuid
    TenantId : uuid
    UserId : uuid
}
entity "UserDevices\nUserDevice" as T12 {
  * Id : uuid
    TenantId : uuid
}


note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
