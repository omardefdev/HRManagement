@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة gateway_audit_db\nGateway Audit / GatewayAuditDbContext"

entity "audit_legal_holds\nAuditLegalHold" as T01 {
  * Id : uuid
    CorrelationId : text
}
entity "gateway_audit_chain_state\nGatewayAuditChainState" as T02 {
  * ChainKey : text
}
entity "gateway_audit_entries\nGatewayAuditEntry" as T03 {
  * Id : bigint
    CorrelationId : text
}
entity "security_audit_events\nSecurityAuditEvent" as T04 {
  * Id : bigint
    CorrelationId : text
    TenantId : uuid
}
entity "EvidenceArtifacts\nEvidenceArtifact" as T05 {
  * Id : uuid
    ArtifactId : text
    CardId : text
    ControlId : text
}
entity "EvidencePackExports\nEvidencePackExport" as T06 {
  * Id : uuid
    PackId : text
}
entity "EvidenceRecords\nEvidenceRecord" as T07 {
  * Id : uuid
    CausationId : text
    CorrelationId : text
    TenantId : uuid
    TimeZoneId : text
}


note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
