@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة archive_db\nRecords.Archive / ArchiveDbContext"

entity "AuditLogs\nEntityAuditLog" as T01 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
    UserId : uuid
}
entity "ExportJobs\nExportJob" as T02 {
  * Id : uuid
    RequestedByUserId : uuid
    ResultFileId : uuid
    TenantId : uuid
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T03 {
  * Id : uuid
    MessageId : text
    TenantId : uuid
}
entity "ArchiveChecklists\nArchiveChecklist" as T04 {
  * Id : uuid
    CorrelationId : uuid
    TenantId : uuid
}
entity "ArchiveIndexEntries\nArchiveIndexEntry" as T05 {
  * Id : uuid
    ArchiveItemId : uuid
    TenantId : uuid
}
entity "ArchiveItems\nArchiveItem" as T06 {
  * Id : uuid
    ClassificationId : uuid
    TenantId : uuid
}
entity "CustodyEvents\nCustodyEvent" as T07 {
  * Id : uuid
    ActorUserId : uuid
    ArchiveItemId : uuid
    TenantId : uuid
}
entity "DigitalFileRecords\nDigitalFileRecord" as T08 {
  * Id : uuid
    ArchiveItemId : uuid
    FileId : uuid
    TenantId : uuid
}
entity "DisposalRecords\nDisposalRecord" as T09 {
  * Id : uuid
    ApprovalEvidenceFileId : uuid
    ArchiveItemId : uuid
    TenantId : uuid
}
entity "DocumentClassifications\nDocumentClassification" as T10 {
  * Id : uuid
    TenantId : uuid
}
entity "LoanRecords\nLoanRecord" as T11 {
  * Id : uuid
    ArchiveItemId : uuid
    TenantId : uuid
}
entity "PhysicalFileRecords\nPhysicalFileRecord" as T12 {
  * Id : uuid
    ArchiveItemId : uuid
    TenantId : uuid
}

T05 }o--|| T06 : ArchiveItemId
T06 }o--|| T10 : ClassificationId
T07 }o--|| T06 : ArchiveItemId
T08 }o--|| T06 : ArchiveItemId
T09 }o--|| T06 : ArchiveItemId
T11 }o--|| T06 : ArchiveItemId
T12 }o--|| T06 : ArchiveItemId

note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
