@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة hr_movements_db\nHR.Movements / MovementsDbContext"

entity "DistributionPlans\nDistributionPlan" as T01 {
  * Id : uuid
    OrgUnitId : uuid
    TenantId : uuid
    TransferRequestId : uuid
}
entity "LoanAssignmentRequests\nLoanAssignmentRequest" as T02 {
  * Id : uuid
    BorrowingOrgUnitId : uuid
    EmployeeId : uuid
    LendingOrgUnitId : uuid
    TenantId : uuid
}
entity "MovementExecutionRecords\nMovementExecutionRecord" as T03 {
  * Id : uuid
    EmployeeId : uuid
    LoanAssignmentRequestId : uuid
    SecondmentRequestId : uuid
    TenantId : uuid
    TransferRequestId : uuid
}
entity "MovementNotices\nMovementNotice" as T04 {
  * Id : uuid
    TenantId : uuid
}
entity "SecondmentRequests\nSecondmentRequest" as T05 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "TransferApprovals\nTransferApproval" as T06 {
  * Id : uuid
    TenantId : uuid
    TransferRequestId : uuid
}
entity "TransferFinancialImpacts\nTransferFinancialImpact" as T07 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
    TransferRequestId : uuid
}
entity "TransferRequests\nTransferRequest" as T08 {
  * Id : uuid
    EmployeeId : uuid
    FromOrgUnitId : uuid
    TenantId : uuid
    ToOrgUnitId : uuid
}
entity "AuditLogs\nEntityAuditLog" as T09 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
    UserId : uuid
}
entity "OrgUnitSnapshots\nOrgUnitSnapshot" as T10 {
  * Id : uuid
    ParentId : uuid
}

T01 }o--|| T08 : TransferRequestId
T03 }o--|| T02 : LoanAssignmentRequestId
T03 }o--|| T05 : SecondmentRequestId
T03 }o--|| T08 : TransferRequestId
T06 }o--|| T08 : TransferRequestId
T07 }o--|| T08 : TransferRequestId

note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
