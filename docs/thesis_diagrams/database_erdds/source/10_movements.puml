@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة movements_db\nHR.Movements / MovementsDbContext"

entity "DistributionPlans\nDistributionPlan" as T01 {
  * Id : uuid
    OrgUnitId : uuid
    TenantId : uuid
    TransferRequestId : uuid
}
entity "LoanAssignmentRequests\nLoanAssignmentRequest" as T02 {
  * Id : uuid
    BorrowingOrgUnitId : uuid
    EmployeeId : uuid
    LendingOrgUnitId : uuid
    TenantId : uuid
}
entity "MovementChecklists\nMovementChecklist" as T03 {
  * Id : uuid
    CorrelationId : uuid
    TenantId : uuid
}
entity "MovementExecutionRecords\nMovementExecutionRecord" as T04 {
  * Id : uuid
    EmployeeId : uuid
    LoanAssignmentRequestId : uuid
    SecondmentRequestId : uuid
    TenantId : uuid
    TransferRequestId : uuid
}
entity "MovementNotices\nMovementNotice" as T05 {
  * Id : uuid
    TenantId : uuid
}
entity "SecondmentRequests\nSecondmentRequest" as T06 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "TransferApprovals\nTransferApproval" as T07 {
  * Id : uuid
    TenantId : uuid
    TransferRequestId : uuid
}
entity "TransferFinancialImpacts\nTransferFinancialImpact" as T08 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
    TransferRequestId : uuid
}
entity "TransferRequests\nTransferRequest" as T09 {
  * Id : uuid
    EmployeeId : uuid
    FromOrgUnitId : uuid
    TenantId : uuid
    ToOrgUnitId : uuid
}
entity "SecondmentSagaStates\nSecondmentSagaState" as T10 {
  * CorrelationId : uuid
    BusinessCorrelationId : text
    EmployeeId : uuid
    SecondmentRequestId : uuid
    TenantId : uuid
    TimeoutTokenId : uuid
}
entity "TransferSagaStates\nTransferSagaState" as T11 {
  * CorrelationId : uuid
    BusinessCorrelationId : text
    EmployeeId : uuid
    FromOrgUnitId : uuid
    TenantId : uuid
    TimeoutTokenId : uuid
    ToOrgUnitId : uuid
    TransferRequestId : uuid
}
entity "IdempotencyRecords\nIdempotencyRecord" as T12 {
  * Id : uuid
    TenantId : uuid
}
entity "AuditLogs\nEntityAuditLog" as T13 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
    UserId : uuid
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T14 {
  * Id : uuid
    MessageId : text
    TenantId : uuid
}
entity "OrgUnitSnapshots\nOrgUnitSnapshot" as T15 {
  * Id : uuid
    ParentId : uuid
    TenantId : uuid
}
entity "ProcessInterventions\nProcessIntervention" as T16 {
  * Id : uuid
    CorrelationId : uuid
    TenantId : uuid
}
entity "InboxState\nInboxState" as T17 {
  * Id : bigint
    ConsumerId : uuid
    LockId : uuid
    MessageId : uuid
}
entity "OutboxMessage\nOutboxMessage" as T18 {
  * SequenceNumber : bigint
    ConversationId : uuid
    CorrelationId : uuid
    InboxConsumerId : uuid
    InboxMessageId : uuid
    InitiatorId : uuid
    MessageId : uuid
    OutboxId : uuid
    RequestId : uuid
}
entity "OutboxState\nOutboxState" as T19 {
  * OutboxId : uuid
    LockId : uuid
}

T01 }o--|| T09 : TransferRequestId
T04 }o--|| T02 : LoanAssignmentRequestId
T04 }o--|| T06 : SecondmentRequestId
T04 }o--|| T09 : TransferRequestId
T07 }o--|| T09 : TransferRequestId
T08 }o--|| T09 : TransferRequestId

note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
