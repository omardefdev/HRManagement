@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة idcard_db\nIDCard / IDCardDbContext"

entity "AuditLogs\nEntityAuditLog" as T01 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
    UserId : uuid
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T02 {
  * Id : uuid
    MessageId : text
    TenantId : uuid
}
entity "AccessPermissions\nAccessPermission" as T03 {
  * Id : uuid
    IssuedCardId : uuid
    TenantId : uuid
}
entity "CardChecklists\nCardChecklist" as T04 {
  * Id : uuid
    CorrelationId : uuid
    TenantId : uuid
}
entity "CardDeliveryRecords\nCardDeliveryRecord" as T05 {
  * Id : uuid
    IssuedCardId : uuid
    ReceiptFileId : uuid
    TenantId : uuid
}
entity "CardDesigns\nCardDesign" as T06 {
  * Id : uuid
    TenantId : uuid
}
entity "CardPermissionSets\nCardPermissionSet" as T07 {
  * Id : uuid
    TenantId : uuid
}
entity "CardRequests\nCardRequest" as T08 {
  * Id : uuid
    EmployeeId : uuid
    IssuedCardId : uuid
    TenantId : uuid
}
entity "IssuedCards\nIssuedCard" as T09 {
  * Id : uuid
    CardDesignId : uuid
    DeliveryRecordId : uuid
    EmployeeId : uuid
    ReplacesCardId : uuid
    TenantId : uuid
}
entity "OfficialSealRecords\nOfficialSealRecord" as T10 {
  * Id : uuid
    SealFileId : uuid
    TenantId : uuid
}
entity "InboxState\nInboxState" as T11 {
  * Id : bigint
    ConsumerId : uuid
    LockId : uuid
    MessageId : uuid
}
entity "OutboxMessage\nOutboxMessage" as T12 {
  * SequenceNumber : bigint
    ConversationId : uuid
    CorrelationId : uuid
    InboxConsumerId : uuid
    InboxMessageId : uuid
    InitiatorId : uuid
    MessageId : uuid
    OutboxId : uuid
    RequestId : uuid
}
entity "OutboxState\nOutboxState" as T13 {
  * OutboxId : uuid
    LockId : uuid
}

T03 }o--|| T09 : IssuedCardId
T09 }o--|| T06 : CardDesignId
T09 }o--|| T05 : IDCard.Domain.Entities.IssuedCard, DeliveryRecordId

note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
