@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة authdirectory_db\nAuth.Directory / AuthDirectoryDbContext"

entity "AuthAuditLogs\nAuthAuditLog" as T01 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
}
entity "AuthTokens\nAuthToken" as T02 {
  * Id : uuid
    TenantId : uuid
    UserId : uuid
}
entity "AuthUsers\nAuthUser" as T03 {
  * Id : uuid
    EmployeeId : uuid
    KeycloakUserId : text
    ScopeOrgUnitId : uuid
    TenantId : uuid
}
entity "DirectoryEntries\nDirectoryEntry" as T04 {
  * Id : uuid
    EmployeeId : uuid
    PrimaryOrgUnitId : uuid
    TenantId : uuid
}
entity "DirectorySyncRecords\nDirectorySyncRecord" as T05 {
  * Id : uuid
    TenantId : uuid
}
entity "PermissionPolicies\nPermissionPolicy" as T06 {
  * Id : uuid
    TenantId : uuid
}
entity "Roles\nRole" as T07 {
  * Id : uuid
    TenantId : uuid
}
entity "UserRoles\nUserRole" as T08 {
  * Id : uuid
    AuthUserId : uuid
    RoleId : uuid
    TenantId : uuid
}
entity "AuditLogs\nEntityAuditLog" as T09 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
    UserId : uuid
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T10 {
  * Id : uuid
    MessageId : text
    TenantId : uuid
}

T02 }o--|| T03 : UserId
T08 }o--|| T03 : AuthUserId
T08 }o--|| T07 : RoleId

note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
