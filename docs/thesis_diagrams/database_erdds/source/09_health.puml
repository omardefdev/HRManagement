@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam dpi 170
skinparam EntityBorderColor #0F6B73
skinparam EntityBackgroundColor #F4FAFA
top to bottom direction
title "ERD الكامل لقاعدة health_db\nHR.Health / HealthDbContext"

entity "FirstAidTrainingRecords\nFirstAidTrainingRecord" as T01 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "HealthRetirementRecords\nHealthRetirementRecord" as T02 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "HealthStatusEntries\nHealthStatusEntry" as T03 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "InsuranceCards\nInsuranceCard" as T04 {
  * Id : uuid
    EmployeeId : uuid
    InsuranceContractId : uuid
    TenantId : uuid
}
entity "InsuranceContracts\nInsuranceContract" as T05 {
  * Id : uuid
    TenantId : uuid
}
entity "MedicalCommitteeReports\nMedicalCommitteeReport" as T06 {
  * Id : uuid
    MedicalRecordId : uuid
    TenantId : uuid
}
entity "MedicalRecommendations\nMedicalRecommendation" as T07 {
  * Id : uuid
    EmployeeId : uuid
    ReportId : uuid
    TenantId : uuid
}
entity "MedicalRecords\nMedicalRecord" as T08 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "PeriodicMedicalChecks\nPeriodicMedicalCheck" as T09 {
  * Id : uuid
    EmployeeId : uuid
    TenantId : uuid
}
entity "SafetyInspections\nSafetyInspection" as T10 {
  * Id : uuid
    TenantId : uuid
}
entity "WorkplaceAccidents\nWorkplaceAccident" as T11 {
  * Id : uuid
    EmployeeId : uuid
    MedicalRecordId : uuid
    TenantId : uuid
}
entity "EmployeeOrgUnitSnapshots\nEmployeeOrgUnitSnapshot" as T12 {
  * EmployeeId : uuid
    PrimaryOrgUnitId : uuid
    TenantId : uuid
}
entity "AuditLogs\nEntityAuditLog" as T13 {
  * Id : uuid
    EntityId : uuid
    TenantId : uuid
    UserId : uuid
}
entity "IntegrationMessageReceipts\nIntegrationMessageReceipt" as T14 {
  * Id : uuid
    MessageId : text
    TenantId : uuid
}
entity "OrgUnitSnapshots\nOrgUnitSnapshot" as T15 {
  * Id : uuid
    ParentId : uuid
    TenantId : uuid
}
entity "InboxState\nInboxState" as T16 {
  * Id : bigint
    ConsumerId : uuid
    LockId : uuid
    MessageId : uuid
}
entity "OutboxMessage\nOutboxMessage" as T17 {
  * SequenceNumber : bigint
    ConversationId : uuid
    CorrelationId : uuid
    InboxConsumerId : uuid
    InboxMessageId : uuid
    InitiatorId : uuid
    MessageId : uuid
    OutboxId : uuid
    RequestId : uuid
}
entity "OutboxState\nOutboxState" as T18 {
  * OutboxId : uuid
    LockId : uuid
}

T04 }o--|| T05 : InsuranceContractId
T06 }o--|| T08 : MedicalRecordId
T07 }o--|| T06 : ReportId

note bottom
يعرض هذا المخطط نموذج البيانات النهائي للسياق، بما يشمل الجداول والمفاتيح والعلاقات الداخلية.
المعرفات مثل EmployeeId أو OrgUnitId التي لا تظهر كعلاقة داخلية هي معرفات تكاملية عابرة للخدمات وليست FK بين قواعد البيانات.
end note
@enduml
