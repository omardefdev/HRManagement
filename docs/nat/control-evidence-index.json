  "lifecycle": [
    { "phase": "Collection", "automated": true, "sources": ["CI/CD", "test-runs", "security-scans", "operational-drills"] },
    { "phase": "Validation", "description": "Schema and completeness check" },
    { "phase": "Submission", "description": "Sealed pack with manifest and top-level hash" },
    { "phase": "Assessment", "description": "Independent review with sampling" },
    { "phase": "Decision", "options": ["Authorize", "Authorize-with-conditions", "Reject"] },
    { "phase": "Maintenance", "description": "Ongoing evidence refresh; gap monitoring" }
  ]
