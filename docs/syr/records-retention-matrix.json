{
  "card": "SYR-015",
  "version": "1.0.0",
  "effectiveDate": "2026-07-31",
  "authority": "Records Authority + Legal + DPO + Audit",
  "description": "Syrian national records retention and disclosure matrix for HR platform record classes",
  "legalReferences": [
    { "id": "LAW-50-2004", "title": "Civil Service Law 50/2004" },
    { "id": "LAW-12-2024", "title": "Personal Data Protection Law 12/2024" },
    { "id": "LEG-001", "title": "Official electronic records retention schedule" }
  ],
  "recordClasses": [
    {
      "code": "employee-file",
      "nameEn": "Employee Personnel File",
      "nameAr": "ملف العامل",
      "retentionYears": 75,
      "trigger": "separation-date",
      "officialCopy": "signed-electronic-record",
      "owner": "HR Records Authority",
      "legalBasis": "Law 50/2004 Art. 172; Records Regulation",
      "dispositionAction": "archive-then-destroy",
      "legalHoldAllowed": true,
      "redactionRules": "Law 12/2024 disclosure limits",
      "backupAnalyticsPolicy": "no-copy-beyond-retention"
    },
    {
      "code": "establishment-register",
      "nameEn": "Establishment / Position Register",
      "nameAr": "سجل الملاك",
      "retentionYears": 50,
      "trigger": "position-closure-date",
      "officialCopy": "signed-electronic-record",
      "owner": "Establishment Authority",
      "legalBasis": "Law 50/2004; Finance Regulations",
      "dispositionAction": "archive-permanent",
      "legalHoldAllowed": true,
      "redactionRules": "public-sector transparency limits",
      "backupAnalyticsPolicy": "mirror-official-copy-only"
    },
    {
      "code": "attendance-record",
      "nameEn": "Time and Attendance Record",
      "nameAr": "سجل الحضور",
      "retentionYears": 10,
      "trigger": "fiscal-year-end",
      "officialCopy": "signed-electronic-record",
      "owner": "Time & Attendance Authority",
      "legalBasis": "Law 50/2004; Decree 188/2025",
      "dispositionAction": "destroy-with-certificate",
      "legalHoldAllowed": true,
      "redactionRules": "employee identity minimization on export",
      "backupAnalyticsPolicy": "aggregates-only-after-3y"
    },
    {
      "code": "payroll-run",
      "nameEn": "Payroll Run and Payslip",
      "nameAr": "دورة الراتب",
      "retentionYears": 15,
      "trigger": "payroll-settlement-date",
      "officialCopy": "signed-electronic-record",
      "owner": "Finance / Payroll Authority",
      "legalBasis": "Financial Regulations; Audit Law",
      "dispositionAction": "destroy-with-certificate",
      "legalHoldAllowed": true,
      "redactionRules": "bank account partial masking",
      "backupAnalyticsPolicy": "control-totals-only-in-analytics"
    },
    {
      "code": "tax-withholding",
      "nameEn": "Income Tax Withholding Record",
      "nameAr": "سجل الضريبة",
      "retentionYears": 15,
      "trigger": "fiscal-year-end",
      "officialCopy": "signed-electronic-record",
      "owner": "Ministry of Finance",
      "legalBasis": "Income Tax Law; Decree 67/2026",
      "dispositionAction": "destroy-with-certificate",
      "legalHoldAllowed": true,
      "redactionRules": "Law 12/2024 tax disclosure",
      "backupAnalyticsPolicy": "no-PII-in-analytics"
    },
    {
      "code": "insurance-contribution",
      "nameEn": "Social Insurance Contribution",
      "nameAr": "سجل التأمين",
      "retentionYears": 50,
      "trigger": "separation-date",
      "officialCopy": "signed-electronic-record",
      "owner": "GOSI / GOIP",
      "legalBasis": "Social Insurance Law; Decree 135/2026",
      "dispositionAction": "archive-permanent",
      "legalHoldAllowed": true,
      "redactionRules": "beneficiary disclosure limits",
      "backupAnalyticsPolicy": "mirror-official-copy-only"
    },
    {
      "code": "pension-payment",
      "nameEn": "Pension Payment Record",
      "nameAr": "سجل المعاش",
      "retentionYears": 75,
      "trigger": "beneficiary-death-date",
      "officialCopy": "signed-electronic-record",
      "owner": "Pensions Authority",
      "legalBasis": "Pension Law; Decree 135/2026",
      "dispositionAction": "archive-permanent",
      "legalHoldAllowed": true,
      "redactionRules": "beneficiary privacy per Law 12/2024",
      "backupAnalyticsPolicy": "no-copy-beyond-retention"
    },
    {
      "code": "administrative-decision",
      "nameEn": "Administrative Decision",
      "nameAr": "القرار الإداري",
      "retentionYears": 30,
      "trigger": "decision-date",
      "officialCopy": "signed-electronic-record",
      "owner": "Issuing Authority",
      "legalBasis": "Law 50/2004; Administrative Procedure Act",
      "dispositionAction": "archive-then-destroy",
      "legalHoldAllowed": true,
      "redactionRules": "appeal and privacy redaction",
      "backupAnalyticsPolicy": "metadata-only-in-analytics"
    },
    {
      "code": "investigation-case",
      "nameEn": "Investigation / Disciplinary Case",
      "nameAr": "ملف التحقيق",
      "retentionYears": 20,
      "trigger": "case-closure-date",
      "officialCopy": "signed-electronic-record",
      "owner": "Employee Relations / Legal",
      "legalBasis": "Law 50/2004 Chapter 12",
      "dispositionAction": "destroy-with-certificate",
      "legalHoldAllowed": true,
      "redactionRules": "strict confidentiality; Law 12/2024",
      "dispositionBlockedUnderHold": true,
      "backupAnalyticsPolicy": "prohibited-in-analytics"
    },
    {
      "code": "complaint-grievance",
      "nameEn": "Complaint and Grievance",
      "nameAr": "الشكوى والتظلم",
      "retentionYears": 10,
      "trigger": "case-closure-date",
      "officialCopy": "signed-electronic-record",
      "owner": "Employee Relations",
      "legalBasis": "Law 50/2004; Law 12/2024 complaint rights",
      "dispositionAction": "destroy-with-certificate",
      "legalHoldAllowed": true,
      "redactionRules": "complainant identity protection",
      "backupAnalyticsPolicy": "prohibited-in-analytics"
    },
    {
      "code": "signature-evidence",
      "nameEn": "Electronic Signature Evidence",
      "nameAr": "دليل التوقيع",
      "retentionYears": 15,
      "trigger": "signature-date",
      "officialCopy": "long-term-signature-proof",
      "owner": "National PKI / Records Authority",
      "legalBasis": "Electronic Signature Law; SIG-001",
      "dispositionAction": "archive-permanent",
      "legalHoldAllowed": true,
      "redactionRules": "certificate chain preserved",
      "backupAnalyticsPolicy": "no-copy-beyond-retention"
    },
    {
      "code": "technical-audit-log",
      "nameEn": "Technical Audit Log",
      "nameAr": "السجل التقني",
      "retentionYears": 7,
      "trigger": "log-event-date",
      "officialCopy": "immutable-log-store",
      "owner": "Platform Security / Audit",
      "legalBasis": "Law 12/2024; Law 20/2022; EVD-002",
      "dispositionAction": "destroy-with-certificate",
      "legalHoldAllowed": true,
      "redactionRules": "secret and credential redaction before disclosure",
      "backupAnalyticsPolicy": "aggregates-only-after-1y"
    }
  ],
  "legalHoldPolicy": {
    "blocksDisposition": true,
    "requiresHoldReference": true,
    "releaseRequiresApprover": true,
    "crossStorePropagation": ["database", "object-store", "search-index", "analytics", "backup"]
  },
  "disclosurePolicy": {
    "authority": "Law 12/2024 Personal Data Protection Authority",
    "requiresLegalBasis": true,
    "redactionBeforeRelease": true,
    "noForeignStandardImport": true
  },
  "disposalPolicy": {
    "requiresApproval": true,
    "requiresCertificate": true,
    "certificateFields": ["recordClass", "volume", "method", "approver", "witnessHash", "completedAt"]
  }
}
