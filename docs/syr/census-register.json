  "description": "Census register structure for Syrian government agencies, workforce, pensioners, and systems",
  "headroomPolicy": {
    "minimumPercent": 50,
    "overrideAuthority": "National Authorization Board",
    "note": "Capacity planning uses census peak × (1 + headroom%). Board may set a higher value."
  },
