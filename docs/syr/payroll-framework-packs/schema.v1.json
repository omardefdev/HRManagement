              "Signed",
              "Interim"
            ]
          },
          "interimExceptionId": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$",
            "description": "Required when legalStatus is Interim: an exception id of the STR-002 control catalog. Absent when Signed."
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decisionId",
          "officialSource",
          "effectiveFrom",
          "owner",
          "approvalStatus"
        ],
        "properties": {
          "decisionId": {
            "type": "string",
            "pattern": "^LD-[A-Z0-9-]{1,61}$"
          },
          "configField": {
            "type": "string",
            "maxLength": 256
          },
          "ruleId": {
            "type": "string",
            "maxLength": 128
          },
          "officialSource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "issueRef": {
            "type": "string",
            "maxLength": 128
          },
          "effectiveFrom": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "approvalStatus": {
            "enum": [
              "ApprovedInterim",
              "PendingEnactment",
              "Superseded",
              "Enacted"
            ]
          },
          "regimeCode": {
            "type": "string",
            "maxLength": 50
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
