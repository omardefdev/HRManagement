      "retentionYears": 15,
      "accessRoles": ["finance-controller", "treasury-liaison", "audit-readonly"],
      "backgroundJobThresholdRows": 10000
    },
    {
      "reportId": "rep-social-insurance-contributions",
      "nameAr": "كشف اشتراكات التأمينات الاجتماعية",
      "nameEn": "Social Insurance Contributions",
      "legalAuthority": "Decree 135/2026 — social insurance amendments",
