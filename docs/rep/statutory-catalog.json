      "grain": "agency-month",
      "asOfRequired": true,
      "drillThrough": ["Employee", "Position", "OrgUnit"],
      "schedule": "monthly-first-business-day",
      "retentionYears": 10,
      "accessRoles": ["reporting-analyst", "agency-hr-director", "finance-controller"],
      "backgroundJobThresholdRows": 5000
    },
    {
