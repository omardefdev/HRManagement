      "effectiveDate": "2026-01-01",
      "goldenDataset": "semantic.social-insurance-contributions",
      "grain": "employee-month",
      "asOfRequired": true,
      "drillThrough": ["ContributionPeriod", "Employee", "Agency"],
      "schedule": "monthly",
      "retentionYears": 15,
      "accessRoles": ["social-insurance-liaison", "finance-controller"],
      "backgroundJobThresholdRows": 10000
    },
    {
      "reportId": "rep-leave-balance",
      "nameAr": "أرصدة الإجازات",
