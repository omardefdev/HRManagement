{
  "card": "STR-007",
  "version": 1,
  "asOfDate": "2026-07-30",
  "allowedBlockerStatuses": ["Blocked", "Waived", "Satisfied", "NotStarted"],
  "requiredKpiFields": [
    "id",
    "name",
    "definition",
    "unit",
    "formula",
    "sourceRef",
    "ownerRole",
    "auditorRole",
    "target",
    "baselineRequired",
    "antiGamingRules",
    "benefitCategory",
    "moduleIds"
  ],
  "forbiddenBenefitMeasures": ["screenCount", "pageCount", "widgetCount"],
  "privacyRules": {
    "tenantScoped": true,
    "minCellSize": 5,
    "forbidCrossTenantRollupWithoutWaiver": true
  },
  "kpis": [
    {
      "id": "hire_cycle_time",
      "name": "Hire cycle time",
      "definition": "Median calendar days from approved vacancy to employee start date",
      "unit": "days",
      "formula": "median(startDate - vacancyApprovedDate)",
      "sourceRef": "HR.Core hiring events / legacy HR extract",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": 45 },
      "baselineRequired": true,
      "antiGamingRules": ["exclude-cancelled-offers", "freeze-definition-before-quarter"],
      "benefitCategory": "time-to-productivity",
      "moduleIds": ["hr-core", "hr-contracts"]
    },
    {
      "id": "separation_cycle_time",
      "name": "Separation cycle time",
      "definition": "Median days from separation request to final payroll/access close",
      "unit": "days",
      "formula": "median(accessClosedAt - separationRequestedAt)",
      "sourceRef": "HR.Movements + Auth.Directory offboarding",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": 10 },
      "baselineRequired": true,
      "antiGamingRules": ["include-all-involuntary", "no-backdate-without-ticket"],
      "benefitCategory": "risk-reduction",
      "moduleIds": ["hr-movements", "auth-directory"]
    },
    {
      "id": "payroll_cycle_time",
      "name": "Payroll cycle time",
      "definition": "Hours from period close to payslip available",
      "unit": "hours",
      "formula": "median(payslipAvailableAt - periodClosedAt)",
      "sourceRef": "Payroll.Domain run ledger",
      "ownerRole": "product-payroll",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": 48 },
      "baselineRequired": true,
      "antiGamingRules": ["exclude-re-runs-after-error", "definition-locked-per-regime"],
      "benefitCategory": "operational-efficiency",
      "moduleIds": ["payroll"]
    },
    {
      "id": "self_service_rate",
      "name": "Self-service rate",
      "definition": "Share of eligible employee transactions completed without clerk",
      "unit": "percent",
      "formula": "selfServiceTxn / eligibleTxn * 100",
      "sourceRef": "ESS portal stub — PROD-003; fixture until portals exist",
      "ownerRole": "product",
      "auditorRole": "audit",
      "target": { "direction": "increase", "value": 40 },
      "baselineRequired": true,
      "antiGamingRules": ["eligible-set-signed", "no-force-self-service-denials"],
      "benefitCategory": "adoption",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "data_error_duplicate_rate",
      "name": "Data error / duplicate rate",
      "definition": "Open duplicate or DQ-fail cases per 1000 active employees",
      "unit": "per_1000",
      "formula": "openDqCases / activeEmployees * 1000",
      "sourceRef": "docs/GOV_003_DATA_QUALITY.md + gov003-data-quality-report",
      "ownerRole": "data",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": 5 },
      "baselineRequired": true,
      "antiGamingRules": ["no-silent-close", "threshold-from-GOV-003"],
      "benefitCategory": "data-quality",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "user_satisfaction",
      "name": "User satisfaction",
      "definition": "Quarterly CSAT mean for agency HR operators (1-5)",
      "unit": "score",
      "formula": "mean(surveyScore)",
      "sourceRef": "UXR survey pack / UXR-001 later",
      "ownerRole": "product",
      "auditorRole": "audit",
      "target": { "direction": "increase", "value": 4.0 },
      "baselineRequired": true,
      "antiGamingRules": ["min-response-rate-30pct", "no-cherry-pick-agencies"],
      "benefitCategory": "experience",
      "moduleIds": ["hr-core", "payroll"]
    },
    {
      "id": "uptime_value",
      "name": "Platform uptime (value)",
      "definition": "Gateway availability as value proxy for national HR access",
      "unit": "percent",
      "formula": "probe_success / probe_total * 100 over 30d",
      "sourceRef": "docs/OBS_SLO_CATALOG.md#j1--gatewayavailability",
      "ownerRole": "sre",
      "auditorRole": "audit",
      "target": { "direction": "increase", "value": 99.5 },
      "baselineRequired": true,
      "antiGamingRules": ["use-OBS-SLO-window", "no-exclude-maintenance-without-change-ticket"],
      "benefitCategory": "reliability",
      "moduleIds": []
    },
    {
      "id": "cost_per_employee",
      "name": "Cost per employee",
      "definition": "Fully loaded annual platform cost divided by active employees",
      "unit": "currency_per_employee",
      "formula": "annualPlatformCost / activeEmployees",
      "sourceRef": "FIN-001 TCO stub — STR-006 budget until FIN-001",
      "ownerRole": "finance",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": null, "note": "target set when FIN-001 lands" },
      "baselineRequired": true,
      "antiGamingRules": ["include-ops-security-backup", "no-dev-only-cost"],
      "benefitCategory": "unit-economics",
      "moduleIds": []
    },
    {
      "id": "agency_onboarding_time",
      "name": "Agency onboarding time",
      "definition": "Calendar days from onboarding kickoff to first successful payroll run",
      "unit": "days",
      "formula": "firstPayrollSuccessAt - onboardingKickoffAt",
      "sourceRef": "ONB / program milestone evidence",
      "ownerRole": "program",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": 90 },
      "baselineRequired": true,
      "antiGamingRules": ["kickoff-date-from-charter", "no-exclude-failed-first-runs"],
      "benefitCategory": "time-to-value",
      "moduleIds": ["payroll", "hr-core"]
    },
    {
      "id": "adoption_rate",
      "name": "Module adoption rate",
      "definition": "Share of entitled agencies actively using core modules in period",
      "unit": "percent",
      "formula": "activeAgencies / entitledAgencies * 100",
      "sourceRef": "STR-003 entitlements + usage events",
      "ownerRole": "product",
      "auditorRole": "audit",
      "target": { "direction": "increase", "value": 70 },
      "baselineRequired": true,
      "antiGamingRules": ["active=min-1-txn-in-period", "entitled-from-STR-003"],
      "benefitCategory": "adoption",
      "moduleIds": ["hr-core", "payroll", "hr-contracts"]
    },
    {
      "id": "recruitment_funnel",
      "name": "Recruitment funnel",
      "definition": "Cohort = applications with AppliedAt in [From, To) and the filters; per stage Applied, Screened, Shortlisted, Interviewed, Assessed, Ranked, OfferIssued, OfferAccepted, Hired: count of cohort applications that reached it (event or documented evidence; reach is monotone; terminal Rejected/Withdrawn/OfferDeclined imply nothing); plus the cohort's current-status distribution",
      "unit": "count",
      "formula": "count(cohort where furthestStage >= stage) per stage; coverage = cohortWithEvents / cohort * 100",
      "sourceRef": "HR.Core RecruitmentApplications + RecruitmentApplicationEvents (PLAN-30) + OfferLetters; HCM-032 FunnelReachRules",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "monitor", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": false,
      "antiGamingRules": ["freeze-definition-before-quarter"],
      "benefitCategory": "operational-efficiency",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_time_to_fill",
      "name": "Recruitment time to fill",
      "definition": "For requisitions filled in [From, To) (the first application of the requisition to reach Hired, Hired time in the period): calendar days from the requisition ApprovedDate (fallback RequestedDate) to the Hired time (StatusChanged -> Hired event; fallback the hired employee CreatedAt). Starts at the approved vacancy like hire_cycle_time, which stays unchanged",
      "unit": "days",
      "formula": "median and P90 (nearest rank) of (hiredDate - approvedDate) per filled requisition; n; fallback counts",
      "sourceRef": "HR.Core RecruitmentRequisitions + RecruitmentApplicationEvents + Employees; HCM-032 TimeToFillRules",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": true,
      "antiGamingRules": ["freeze-definition-before-quarter", "count-fallback-separately"],
      "benefitCategory": "time-to-productivity",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_time_to_hire",
      "name": "Recruitment time to hire",
      "definition": "For applications hired in [From, To): calendar days from AppliedAt to the Hired time (StatusChanged -> Hired event; fallback the hired employee CreatedAt)",
      "unit": "days",
      "formula": "median and P90 (nearest rank) of (hiredDate - appliedDate); n; fallback count",
      "sourceRef": "HR.Core RecruitmentApplications + RecruitmentApplicationEvents + Employees; HCM-032 TimeToFillRules",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": true,
      "antiGamingRules": ["freeze-definition-before-quarter", "count-fallback-separately"],
      "benefitCategory": "time-to-productivity",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_stage_time",
      "name": "Recruitment stage time",
      "definition": "Median calendar days spent in each application status, between consecutive status events (Received, StatusChanged) of cohort applications that have events; event-covered rows only",
      "unit": "days",
      "formula": "median(nextStatusEventDate - statusEventDate) per status; n per status; coverage = cohortWithEvents / cohort * 100",
      "sourceRef": "HR.Core RecruitmentApplicationEvents; HCM-032 TimeToFillRules.StageDurations",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": true,
      "antiGamingRules": ["freeze-definition-before-quarter", "count-fallback-separately"],
      "benefitCategory": "time-to-productivity",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_offer_acceptance_rate",
      "name": "Offer acceptance rate",
      "definition": "Offers whose final outcome happened in [From, To): Accepted / (Accepted + Declined + Expired) * 100; Revoked offers are excluded; the counts are shown",
      "unit": "percent",
      "formula": "accepted / (accepted + declined + expired) * 100",
      "sourceRef": "HR.Core OfferLetters (AcceptedDate, DeclinedAt, ExpiredAt)",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "increase", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": false,
      "antiGamingRules": ["exclude-cancelled-offers", "freeze-definition-before-quarter"],
      "benefitCategory": "operational-efficiency",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_offer_decline_reasons",
      "name": "Offer decline reasons",
      "definition": "Offers declined in [From, To) by DeclineReasonCategory (rows before PLAN-32: uncategorized) and by DeclinedBy (Candidate / HrOnBehalf); expired offers are an outcome, not a reason",
      "unit": "count",
      "formula": "count(declined) group by category; group by declinedBy",
      "sourceRef": "HR.Core OfferLetters (DeclinedAt, DeclineReasonCategory, DeclinedBy)",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "monitor", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": false,
      "antiGamingRules": ["exclude-cancelled-offers", "freeze-definition-before-quarter"],
      "benefitCategory": "operational-efficiency",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_channel_mix",
      "name": "Recruitment channel mix",
      "definition": "Cohort (applications with AppliedAt in [From, To)) by IntakeChannel (Public, Internal, HrEntered, Legacy), with hire rate per channel = cohort applications that reached Hired / cohort applications of the channel * 100",
      "unit": "count",
      "formula": "count(cohort) group by intakeChannel; hired / applied * 100 per channel",
      "sourceRef": "HR.Core RecruitmentApplications.IntakeChannel (PLAN-30)",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "monitor", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": false,
      "antiGamingRules": ["freeze-definition-before-quarter"],
      "benefitCategory": "operational-efficiency",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_appeal_rate",
      "name": "Recruitment appeal rate",
      "definition": "Appeals (Kind = Rejection) filed in [From, To) / applications rejected in [From, To) with an appealable RejectionKind (Recruitment:AppealableRejectionKinds) * 100; outcome distribution of appeals decided in the period; result objections (Kind = ResultObjection) reported separately: filed, upheld, dismissed",
      "unit": "percent",
      "formula": "appealsFiled / appealableRejections * 100",
      "sourceRef": "HR.Core RecruitmentAppeals (PLAN-28, PLAN-31) + RecruitmentApplications (RejectedAt, RejectionKind)",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "monitor", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": false,
      "antiGamingRules": ["freeze-definition-before-quarter"],
      "benefitCategory": "risk-reduction",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_merit_overrides",
      "name": "Merit overrides and exception offers",
      "definition": "Offers created in [From, To) with IsMeritOverride, and with any exception flag (merit override, grade deviation or unverified salary), / offers created in the period * 100",
      "unit": "percent",
      "formula": "meritOverrideOffers / offersCreated * 100; exceptionOffers / offersCreated * 100",
      "sourceRef": "HR.Core OfferLetters (CreatedAt, IsMeritOverride, GradeDeviationReason, SalaryUnverified)",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": false,
      "antiGamingRules": ["freeze-definition-before-quarter"],
      "benefitCategory": "risk-reduction",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_open_vacancies",
      "name": "Open vacancies",
      "definition": "As of today: Vacant funded positions with no requisition in Draft, PendingApproval, Approved or Published and no requisition attached to an open competition line; plus requisitions Published for more than Recruitment:Analytics:StalePublishedDays (default 60); listed oldest first",
      "unit": "count",
      "formula": "count(vacantWithoutRequisition); count(publishedFor > staleDays)",
      "sourceRef": "HR.Core FundedPositions (EST-001) + RecruitmentRequisitions + CompetitionLines",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": false,
      "antiGamingRules": ["freeze-definition-before-quarter"],
      "benefitCategory": "operational-efficiency",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_approval_sla",
      "name": "Recruitment approval SLA",
      "definition": "Recruitment workflow instances: (a) InProgress instances whose current step age exceeds the SLA (step TimeoutHours, else Recruitment:Analytics:ApprovalSlaHours:{code}, else DefaultApprovalSlaHours 48 — organizational policy, not legal); step start = ActionAt of the latest history entry, else StartedAt; (b) for steps completed in [From, To): median and P90 step duration (hours) per workflow code and step",
      "unit": "hours",
      "formula": "count(ageHours > slaHours); median and P90 (nearest rank) of (actionAt - stepStart) per code and step",
      "sourceRef": "HR.Core WorkflowInstances.StepHistoryJson + WorkflowDefinitions.StepsJson; HCM-032 ApprovalSlaRules",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "decrease", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": true,
      "antiGamingRules": ["freeze-definition-before-quarter", "count-fallback-separately"],
      "benefitCategory": "operational-efficiency",
      "moduleIds": ["hr-core"]
    },
    {
      "id": "recruitment_competitions",
      "name": "Recruitment competitions",
      "definition": "Unrestricted users only. Per competition: applicants, admitted (reached Shortlisted), present (an exam paper with attendance Present), passed (outcome Passed in the current published result version), allocated, reserve, recalled, objections filed and upheld",
      "unit": "count",
      "formula": "counts per competition",
      "sourceRef": "HR.Core RecruitmentCompetitions (PLAN-31) + ExamCandidates + CompetitionResults + CompetitionAllocations + CompetitionReserveEntries + RecruitmentAppeals",
      "ownerRole": "product-hr",
      "auditorRole": "audit",
      "target": { "direction": "monitor", "value": null, "note": "TBD — set by product-hr after the first frozen quarter (PLAN-32)" },
      "baselineRequired": false,
      "antiGamingRules": ["freeze-definition-before-quarter"],
      "benefitCategory": "operational-efficiency",
      "moduleIds": ["hr-core"]
    }
  ],
