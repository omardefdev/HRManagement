{
  "$schema": "semantic-layer-v1",
  "card": "ANA-001",
  "description": "National HR analytics semantic layer with governed measures, dimensions, and KPIs",
  "measures": [
    {
      "code": "headcount",
      "name": "Headcount",
      "definition": "Exact count of active employees as-of snapshot date",
      "grain": "monthly",
      "type": "exact_count",
      "owner": "Data Governance",
      "source": "employment_records",
      "reconciles_with": "EST-001 funded positions"
    },
    {
      "code": "fte",
      "name": "Full-Time Equivalent",
      "definition": "Sum of FTE fractions for all active employment records",
      "grain": "monthly",
      "type": "exact_sum",
      "owner": "Data Governance",
      "source": "employment_records"
    },
    {
      "code": "vacancy_rate",
      "name": "Vacancy Rate",
      "definition": "Vacant funded positions / total funded positions × 100",
      "grain": "monthly",
      "type": "ratio",
      "owner": "HR Planning",
      "source": "funded_positions",
      "reconciles_with": "EST-001 position occupancy"
    },
    {
      "code": "payroll_total",
      "name": "Total Payroll Cost",
      "definition": "Sum of gross pay for all processed payroll records in period",
      "grain": "monthly",
      "type": "exact_sum",
      "currency": "SYP",
      "owner": "Finance",
      "source": "payroll_records",
      "reconciles_with": "PAY-002 payroll run totals"
    },
    {
      "code": "turnover_rate",
      "name": "Turnover Rate",
      "definition": "Separations in period / average headcount × 100",
      "grain": "monthly",
      "type": "ratio",
      "owner": "HR Analytics",
      "source": "separation_records"
    },
    {
      "code": "avg_tenure",
      "name": "Average Tenure",
      "definition": "Mean service duration in months for active employees",
      "grain": "monthly",
      "type": "average",
      "owner": "HR Analytics",
      "source": "employment_records"
    },
    {
      "code": "recruitment_funnel",
      "name": "Recruitment Funnel",
      "definition": "Applications with AppliedAt in the period that reached each stage (Applied → Hired); STR-007 recruitment_funnel",
      "grain": "requisition × period",
      "type": "exact_count",
      "owner": "product-hr",
      "source": "HR.Core recruitment_applications + recruitment_application_events",
      "kpi_ref": "docs/str-value/kpi-matrix.json#recruitment_funnel",
      "as_of": "cohort by AppliedAt; stage reached as of the report time",
      "privacy": { "minimum_group_size": 5, "suppress_small_cells": true }
    },
    {
      "code": "recruitment_time_to_fill",
      "name": "Recruitment Time to Fill",
      "definition": "Median and P90 calendar days from requisition approval (fallback request) to the first hire, for requisitions filled in the period",
      "grain": "requisition",
      "type": "median",
      "owner": "product-hr",
      "source": "HR.Core recruitment_requisitions + recruitment_application_events",
      "kpi_ref": "docs/str-value/kpi-matrix.json#recruitment_time_to_fill",
      "as_of": "event timestamp of the hire (late data by event time, not arrival)",
      "privacy": { "minimum_group_size": 5, "suppress_small_cells": true }
    },
    {
      "code": "recruitment_time_to_hire",
      "name": "Recruitment Time to Hire",
      "definition": "Median and P90 calendar days from application to hire, for applications hired in the period",
      "grain": "application (aggregated per requisition)",
      "type": "median",
      "owner": "product-hr",
      "source": "HR.Core recruitment_applications + recruitment_application_events",
      "kpi_ref": "docs/str-value/kpi-matrix.json#recruitment_time_to_hire",
      "as_of": "event timestamp of the hire",
      "privacy": { "minimum_group_size": 5, "suppress_small_cells": true }
    },
    {
      "code": "recruitment_offer_acceptance",
      "name": "Offer Acceptance Rate",
      "definition": "Accepted / (Accepted + Declined + Expired) × 100 for offers settled in the period; revoked offers excluded",
      "grain": "requisition × period",
      "type": "ratio",
      "owner": "product-hr",
      "source": "HR.Core offer_letters",
      "kpi_ref": "docs/str-value/kpi-matrix.json#recruitment_offer_acceptance_rate",
      "as_of": "offer outcome date",
      "privacy": { "minimum_group_size": 5, "suppress_small_cells": true }
    },
    {
      "code": "recruitment_appeal_rate",
      "name": "Recruitment Appeal Rate",
      "definition": "Rejection appeals filed / appealable rejections × 100 in the period",
      "grain": "period",
      "type": "ratio",
      "owner": "product-hr",
      "source": "HR.Core recruitment_appeals + recruitment_applications",
      "kpi_ref": "docs/str-value/kpi-matrix.json#recruitment_appeal_rate",
      "as_of": "filing and rejection dates",
      "privacy": { "minimum_group_size": 5, "suppress_small_cells": true }
    },
    {
      "code": "recruitment_open_vacancies",
      "name": "Open Vacancies",
      "definition": "Vacant funded positions without an active requisition, and requisitions published for more than the stale threshold",
      "grain": "daily (as of today)",
      "type": "exact_count",
      "owner": "product-hr",
      "source": "HR.Core funded_positions + recruitment_requisitions",
      "kpi_ref": "docs/str-value/kpi-matrix.json#recruitment_open_vacancies",
      "reconciles_with": "EST-001 position occupancy",
      "as_of": "report date",
      "privacy": { "minimum_group_size": 5, "suppress_small_cells": true }
    }
  ],
  "dimensions": [
    {
      "code": "agency",
      "name": "Agency/Ministry",
      "scd_type": 2,
      "source": "MDM-001 reference catalogs"
    },
    {
      "code": "governorate",
      "name": "Governorate",
      "scd_type": 1,
      "source": "MDM-001 geographic catalog",
      "values_count": 14
    },
    {
      "code": "grade",
      "name": "Grade/Rank",
      "scd_type": 2,
      "source": "EST-001 job catalog"
    },
    {
      "code": "legal_regime",
      "name": "Legal Regime",
      "scd_type": 2,
      "source": "SYR-003 legal regime registry",
      "values": ["law50", "law53", "special"]
    },
    {
      "code": "gender",
      "name": "Gender",
      "scd_type": 1,
      "source": "employee demographics"
    },
    {
      "code": "age_band",
      "name": "Age Band",
      "scd_type": 0,
      "source": "computed from date of birth",
      "bands": ["18-25", "26-35", "36-45", "46-55", "56-65", "65+"]
    },
    {
      "code": "service_band",
      "name": "Service Duration Band",
      "scd_type": 0,
      "source": "computed from hire date",
      "bands": ["0-2y", "3-5y", "6-10y", "11-20y", "20y+"]
    }
  ],
  "snapshot_policy": {
    "grain": "monthly",
    "as_of_support": true,
    "late_data_handling": "event_timestamp_not_arrival",
    "rebuild_deterministic": true,
    "reconciliation_required": true
  },
  "permissions": {
    "tenant_rls": true,
    "national_aggregate_separate": true,
    "national_aggregate_requires": "national_analytics_role",
    "privacy_controls": {
      "minimum_group_size": 5,
      "suppress_small_cells": true
    }
  }
}
