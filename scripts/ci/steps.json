{
  "card": "QA-034",
  "description": "Single source of the CI build-and-test steps. .github/workflows/ci.yml runs each with `bash scripts/ci/run-steps.sh --step \"<name>\"`; scripts/ci-local.ps1 runs all of them, in this order, in a Linux container. CiStepsParityTests rejects any drift. Fields: name (also the ci.yml step name), kind (guard|build|test|gate), run (bash), env, always (runs even after a failure, like if: always()).",
  "steps": [
    {
      "name": "PowerShell for Linux validation script tests",
      "kind": "build",
      "run": "if command -v pwsh >/dev/null 2>&1 && ! command -v powershell >/dev/null 2>&1; then\n  $(command -v sudo || true) ln -sf \"$(command -v pwsh)\" /usr/local/bin/powershell\nfi"
    },
    {
      "name": "Restore local tools (dotnet-ef)",
      "kind": "build",
      "run": "dotnet tool restore"
    },
    {
      "name": "Guard against wildcard package versions",
      "kind": "guard",
      "run": "set -euo pipefail\nif grep -RInE 'Version=\"(\\*|[0-9]+\\.\\*)\"' --include='*.csproj' .; then\n  echo \"::error::Wildcard PackageReference versions found in .csproj files (DB-001)\"\n  exit 1\nfi\necho \"No wildcard package versions.\""
    },
