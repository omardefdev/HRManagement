    {
      "name": "Install ReportGenerator",
      "kind": "build",
      "run": "dotnet tool install -g dotnet-reportgenerator-globaltool",
      "always": true
    },
    {
      "name": "Generate coverage report",
      "kind": "build",
      "run": "REPORTS=\"$(find . -name 'coverage.cobertura.xml' -path '*/TestResults/*' | sort | paste -sd ';' -)\"\nif [ -n \"$REPORTS\" ]; then\n  reportgenerator \"-reports:$REPORTS\" \"-targetdir:coveragereport\" \"-reporttypes:HtmlInline_AzurePipelines;Cobertura\"\nfi",
      "always": true
    },
    {
      "name": "BLD-002 Docker build validate",
      "kind": "gate",
