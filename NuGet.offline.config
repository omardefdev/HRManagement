<?xml version="1.0" encoding="utf-8"?>
<!--
  SAN-001 — Offline / air-gapped NuGet sources.
  Populate ./.nuget-offline from the sovereign mirror before national builds.
  Public nuget.org is intentionally absent.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="./.nuget-offline" />
    <!-- Uncomment when national registry is provisioned:
    <add key="sovereign-mirror" value="https://SOVEREIGN_NUGET_MIRROR/v3/index.json" />
    -->
  </packageSources>
</configuration>
